# Cloudflare Pages headers.
# Hashed build assets (CSS, JS, self-hosted fonts) are immutable — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static brand assets — cache a day, revalidate.
/*.png
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400

# llms.txt / robots — short cache so updates propagate quickly.
/llms.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# The scroll tour's records — big, fetched only on play, stable by id.
/audio/*
  Cache-Control: public, max-age=604800

# Security headers on every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
