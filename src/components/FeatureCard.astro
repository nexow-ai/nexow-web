---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  title: string;
  body: string;
  tone?: 'light' | 'dark';
}
const { icon, title, body, tone = 'light' } = Astro.props;

const shell =
  tone === 'dark'
    ? 'border-white/10 bg-white/[0.03] hover:bg-white/[0.06]'
    : 'border-ink-900/8 bg-white hover:border-brand-500/30 hover:shadow-lg hover:shadow-brand-900/5';
const titleColor = tone === 'dark' ? 'text-white' : 'text-ink-950';
const bodyColor = tone === 'dark' ? 'text-ink-400' : 'text-ink-600';
const iconTile =
  tone === 'dark'
    ? 'bg-brand-500/15 text-brand-300 ring-1 ring-brand-400/20'
    : 'bg-brand-50 text-brand-600 ring-1 ring-brand-500/10';
---

<div
  class:list={[
    'group relative flex flex-col rounded-2xl border p-6 transition-all duration-300 ease-out-expo hover:-translate-y-1',
    shell,
  ]}
>
  <div class:list={['inline-flex size-11 items-center justify-center rounded-xl', iconTile]}>
    <Icon name={icon} class="size-5.5" />
  </div>
  <h3 class:list={['mt-5 font-display text-lg font-semibold', titleColor]}>{title}</h3>
  <p class:list={['mt-2 text-sm leading-relaxed', bodyColor]}>{body}</p>
</div>
