---
/**
 * Expandable connector detail modal — mirrors the app VenueDetail panel
 * (banner + logo + notes + actions). Populated client-side from card clicks.
 */
import type { SiteContent } from '../i18n/content';
import Icon from './Icon.astro';

interface Props {
  t: SiteContent['connectorsPage'];
}
const { t } = Astro.props;
---

<div
  id="connector-modal"
  class="connector-modal pointer-events-none fixed inset-0 z-50 flex items-end justify-center p-0 opacity-0 sm:items-center sm:p-6"
  data-open="false"
  hidden
  aria-hidden="true"
>
  <button
    type="button"
    id="connector-modal-backdrop"
    class="connector-modal__backdrop absolute inset-0 bg-ink-950/45 backdrop-blur-[2px]"
    tabindex="-1"
    aria-label={t.close}
  ></button>

  <div
    id="connector-modal-panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="connector-modal-title"
    class="connector-modal__panel relative z-10 flex max-h-[min(92vh,720px)] w-full max-w-lg flex-col overflow-hidden rounded-t-3xl border border-ink-900/10 bg-white shadow-2xl shadow-ink-950/20 sm:rounded-3xl"
  >
    <!-- Banner -->
    <div id="connector-modal-banner-wrap" class="relative hidden shrink-0">
      <div class="relative h-28 overflow-hidden bg-ink-100 sm:h-32">
        <img
          id="connector-modal-banner"
          src=""
          alt=""
          class="size-full object-cover object-center"
        />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-white/40 to-transparent"></div>
      </div>
      <button
        type="button"
        data-connector-modal-close
        class="absolute left-3 top-3 inline-flex size-8 items-center justify-center rounded-full bg-white/85 text-ink-700 shadow-sm backdrop-blur-sm transition hover:bg-white hover:text-ink-950"
        aria-label={t.close}
      >
        <Icon name="x" class="size-4" />
      </button>
    </div>

    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
      <div class="px-5 pb-5 pt-4 sm:px-6 sm:pb-6 sm:pt-5">
        <!-- Close when no banner -->
        <button
          type="button"
          id="connector-modal-close-plain"
          data-connector-modal-close
          class="mb-3 inline-flex size-8 items-center justify-center rounded-full text-ink-500 transition hover:bg-ink-900/5 hover:text-ink-950"
          aria-label={t.close}
        >
          <Icon name="x" class="size-4" />
        </button>

        <!-- Identity -->
        <div class="flex items-start gap-3">
          <span
            id="connector-modal-logo-wrap"
            class="inline-flex size-11 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-[#f7fbfb] ring-1 ring-ink-900/10"
          >
            <img
              id="connector-modal-logo"
              src=""
              alt=""
              width="44"
              height="44"
              class="size-full object-cover object-center"
            />
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex min-w-0 items-center gap-1.5">
              <h2 id="connector-modal-title" class="truncate font-display text-lg font-semibold text-ink-950"></h2>
              <a
                id="connector-modal-website-icon"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex shrink-0 rounded-md p-1 text-ink-400 transition hover:bg-ink-900/5 hover:text-ink-950"
                aria-label={t.visitWebsite}
              >
                <Icon name="external" class="size-3.5" />
              </a>
            </div>
            <p id="connector-modal-kind" class="mt-0.5 text-xs text-ink-500"></p>
            <p
              id="connector-modal-soon"
              class="mt-2 hidden inline-flex items-center gap-1.5 rounded-full bg-ink-900/[0.06] px-2 py-0.5 font-mono text-[0.6rem] font-medium uppercase tracking-[0.09em] text-ink-500"
            >
              <span class="size-1.5 rounded-full bg-accent-500/80"></span>
              {t.comingSoon}
            </p>
          </div>
        </div>

        <p id="connector-modal-notes" class="mt-3 text-sm leading-relaxed text-ink-600"></p>

        <div id="connector-modal-assets" class="mt-3 flex flex-wrap gap-1.5"></div>

        <!-- Actions -->
        <div class="mt-6 flex flex-col gap-2.5 sm:flex-row sm:items-center">
          <a
            id="connector-modal-connect"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 flex-1 items-center justify-center gap-2 rounded-full bg-brand-600 px-5 text-sm font-medium text-white shadow-[0_1px_0_rgba(255,255,255,0.18)_inset,0_10px_20px_-14px_var(--color-brand-600)] transition hover:-translate-y-0.5 hover:bg-brand-500"
          >
            <Icon name="plug" class="size-[1.1em]" />
            {t.connect}
          </a>
          <a
            id="connector-modal-website"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 flex-1 items-center justify-center gap-2 rounded-full bg-white px-5 text-sm font-medium text-ink-900 ring-1 ring-ink-900/10 shadow-sm transition hover:-translate-y-0.5 hover:ring-ink-900/20"
          >
            {t.visitWebsite}
            <Icon name="external" class="size-[1.05em]" />
          </a>
        </div>

        <p id="connector-modal-soon-hint" class="mt-3 hidden text-center text-xs text-ink-500">
          {t.comingSoonHint}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .connector-modal[data-open='true'] {
    pointer-events: auto;
    opacity: 1;
  }

  .connector-modal__backdrop {
    opacity: 0;
    transition: opacity 220ms ease;
  }
  .connector-modal[data-open='true'] .connector-modal__backdrop {
    opacity: 1;
  }

  .connector-modal__panel {
    transform: translateY(18px) scale(0.96);
    opacity: 0;
    transition:
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 220ms ease;
  }
  .connector-modal[data-open='true'] .connector-modal__panel {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .connector-modal__backdrop,
    .connector-modal__panel {
      transition: none;
    }
  }
</style>
