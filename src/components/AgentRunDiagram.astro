---
/**
 * "Anatomy of a run" — a scroll-scrubbed diagram of one bot/agent cycle.
 *
 * The wrapper is deliberately taller than the viewport so ScrollMotion can hand
 * it a `--ps` scrub (0 → 1) plus a `data-stage` index; the diagram is pinned
 * with `position: sticky` and *assembles itself* as the reader scrolls — the
 * core wakes, the input wires draw themselves into it, the harness blooms out
 * of it, and the results fly back out to the delivery chips.
 *
 * Every moving part hangs off four local ramps derived from `--ps`: `--k0`…
 * `--k3`, each running 0 → 1 across its own quarter of the scrub. That is the
 * point — *any* amount of scrolling moves something. Reacting only at the four
 * stage boundaries (which is what this used to do) makes a pinned section read
 * as a page that has stopped responding. `data-stage` survives, but only for
 * the ambient loops and the "you are here" accent. Parts stay lit once they
 * arrive, so the last frame of the scrub is the whole run at once.
 *
 * `--psc` (centred scrub) and `--spin` drive the parallax layers *only* — the
 * backdrop rings, the orbiting motes, the grid, the glow. Nothing structural
 * parallaxes, or the wires would tear away from the chips they connect.
 *
 * Without JavaScript, or with reduced motion, `--k0`…`--k3` stay pinned at 1
 * and `--psc` / `--spin` at 0: the wrapper collapses to its natural height and
 * the diagram renders complete and still.
 *
 * Geometry is computed here rather than hand-written so the chip stack, the
 * core and the flow curves can never drift apart. Two renderings share it: a
 * landscape SVG from `md` up, and a stacked layout below that (SVG text does
 * not survive being scaled down to a phone).
 */
import Icon from './Icon.astro';
import { ICON_PATHS } from './icon-paths';

interface Props {
  /** Four inputs, in diagram order: web, socials, markets, stores. */
  sources: string[];
  /** Six harness pieces: model, memory, skills, tools, knowledge, triggers. */
  harness: string[];
  /** Four outputs, in diagram order: widgets, inbox, webhook, database. */
  deliveries: string[];
  stages: { n: string; title: string; body: string }[];
  sourcesLabel: string;
  harnessLabel: string;
  deliveriesLabel: string;
  hint: string;
}
const { sources, harness, deliveries, stages, sourcesLabel, harnessLabel, deliveriesLabel, hint } =
  Astro.props;

const SOURCE_ICONS = ['globe', 'chat', 'chart', 'database'];
const DELIVERY_ICONS = ['layers', 'bell', 'link', 'server'];
const HARNESS_ICONS = ['cpu', 'database', 'wand', 'sliders', 'library', 'bolt'];
const STAGE_ICONS = ['bolt', 'radar', 'cpu', 'send'];

/* ── wide-diagram geometry (viewBox 1000 × 384) ─────────────────────────── */
const CHIP = { w: 246, h: 54, r: 16 };
const TOPS = [44, 132, 220, 308];
const CORE = { x: 500, y: 203, r: 58, ring: 100 };
const IN_X = 22;
const OUT_X = 1000 - IN_X - CHIP.w;
/** Where the four wires meet the core, fanned so they stay readable. */
const ENTRY_Y = [182, 196, 210, 224];

const inChips = sources.map((label, i) => ({
  label,
  icon: SOURCE_ICONS[i],
  top: TOPS[i],
  cy: TOPS[i] + CHIP.h / 2,
}));
const outChips = deliveries.map((label, i) => ({
  label,
  icon: DELIVERY_ICONS[i],
  top: TOPS[i],
  cy: TOPS[i] + CHIP.h / 2,
}));

const inWires = inChips.map(
  (c, i) =>
    `M ${IN_X + CHIP.w + 6} ${c.cy} C ${IN_X + CHIP.w + 90} ${c.cy}, ${CORE.x - 140} ${ENTRY_Y[i]}, ${CORE.x - CORE.r - 4} ${ENTRY_Y[i]}`,
);
const outWires = outChips.map(
  (c, i) =>
    `M ${CORE.x + CORE.r + 4} ${ENTRY_Y[i]} C ${CORE.x + 140} ${ENTRY_Y[i]}, ${OUT_X - 90} ${c.cy}, ${OUT_X - 6} ${c.cy}`,
);

/** Harness dots ride a top arc and a bottom arc, leaving the horizontal axis
 *  free for the wires to reach the core. They are *drawn* at the core and fly
 *  out to these offsets as stage 03 scrubs, so the harness looks like it is
 *  unpacked by the worker rather than parked around it. */
const RING_ANGLES = [-140, -90, -40, 40, 90, 140];
const ringDots = harness.map((label, i) => {
  const a = (RING_ANGLES[i] * Math.PI) / 180;
  return {
    label,
    icon: HARNESS_ICONS[i],
    dx: Math.cos(a) * CORE.ring,
    dy: Math.sin(a) * CORE.ring,
  };
});

/** Motes drifting around the core, at three depths (see `.orbit-*`). */
const MOTES = [
  { r: 128, a: 18, s: 3.2 },
  { r: 128, a: 205, s: 2.2 },
  { r: 166, a: 108, s: 2.6 },
  { r: 166, a: 292, s: 1.9 },
  { r: 202, a: 62, s: 2.4 },
  { r: 202, a: 246, s: 1.7 },
].map((m) => ({
  cx: CORE.x + Math.cos((m.a * Math.PI) / 180) * m.r,
  cy: CORE.y + Math.sin((m.a * Math.PI) / 180) * m.r,
  s: m.s,
  ring: m.r,
}));

/** `translate/scale` that centres a 24×24 icon path on a point. */
const glyph = (x: number, y: number, scale: number) =>
  `translate(${x} ${y}) scale(${scale}) translate(-12 -12)`;

/**
 * A stagger window inside one stage: the element ramps 0 → 1 over
 * `[start, start + span]` of its stage's local progress. Emitted as the two
 * custom properties `--d` is built from, so the sequencing lives in the markup
 * and the easing lives in the stylesheet.
 */
const seq = (start: number, span = 0.5) =>
  `--o:${start.toFixed(3)};--spd:${(1 / span).toFixed(3)}`;

const harnessChips = harness.map((label, i) => ({ label, icon: HARNESS_ICONS[i] }));
---

<div class="run-scroll relative" data-stages="4">
  <div class="run-sticky">
    <div class="run-card relative overflow-hidden rounded-3xl p-3 sm:p-6">
      <!-- parallax backdrop: two grids at different rates, a travelling glow -->
      <div class="grid-far" aria-hidden="true"></div>
      <div class="grid-near" aria-hidden="true"></div>
      <div class="sweep" aria-hidden="true"></div>
      <div class="blob blob-a" aria-hidden="true"></div>
      <div class="blob blob-b" aria-hidden="true"></div>

      <!-- ── landscape diagram (md and up) ────────────────────────────── -->
      <svg
        class="diagram relative hidden h-auto w-full md:block"
        viewBox="0 0 1000 384"
        fill="none"
        aria-hidden="true"
      >
        <!-- backdrop rings + motes, the only layers that parallax -->
        <g class="depth">
          {[132, 168, 206].map((r, i) => <circle class={`bg-ring bg-ring-${i}`} cx={CORE.x} cy={CORE.y} r={r} />)}
          {
            MOTES.map((m, i) => (
              <g class={`orbit orbit-${i % 3}`}>
                <circle class="mote" cx={m.cx} cy={m.cy} r={m.s} style={`--delay:${(i * 0.7).toFixed(2)}s`} />
              </g>
            ))
          }
        </g>

        <text class="col-label s-gather" x={IN_X + 4} y="26" style={seq(0)}>{sourcesLabel}</text>
        <text class="col-label s-act" x={OUT_X + 4} y="26" style={seq(0)}>{deliveriesLabel}</text>

        <!-- wires: drawn on by the scrub, then kept alive by travelling pulses -->
        <g class="wires">
          {
            inWires.map((d, i) => (
              <>
                <path class="wire s-gather" d={d} pathLength="100" style={seq(i * 0.1, 0.55)} />
                <path
                  class="pulse s-gather"
                  d={d}
                  pathLength="100"
                  style={`${seq(i * 0.1 + 0.2, 0.5)};--delay:${(i * 0.28).toFixed(2)}s`}
                />
              </>
            ))
          }
          {
            outWires.map((d, i) => (
              <>
                <path class="wire s-act" d={d} pathLength="100" style={seq(i * 0.1, 0.55)} />
                <path
                  class="pulse s-act"
                  d={d}
                  pathLength="100"
                  style={`${seq(i * 0.1 + 0.2, 0.5)};--delay:${(i * 0.28).toFixed(2)}s`}
                />
              </>
            ))
          }
        </g>

        <!-- input chips -->
        {
          inChips.map((c, i) => (
            <g class="chip s-gather" style={`${seq(i * 0.1, 0.5)};--slide:-22px`}>
              <rect x={IN_X} y={c.top} width={CHIP.w} height={CHIP.h} rx={CHIP.r} />
              <circle class="chip-disc" cx={IN_X + 40} cy={c.cy} r="17" />
              <path
                class="chip-glyph"
                d={ICON_PATHS[c.icon]}
                transform={glyph(IN_X + 40, c.cy, 0.92)}
              />
              <text class="chip-text" x={IN_X + 70} y={c.cy + 5}>
                {c.label}
              </text>
            </g>
          ))
        }

        <!-- output chips -->
        {
          outChips.map((c, i) => (
            <g class="chip s-act" style={`${seq(i * 0.1, 0.5)};--slide:22px`}>
              <rect x={OUT_X} y={c.top} width={CHIP.w} height={CHIP.h} rx={CHIP.r} />
              <circle class="chip-disc" cx={OUT_X + 40} cy={c.cy} r="17" />
              <path
                class="chip-glyph"
                d={ICON_PATHS[c.icon]}
                transform={glyph(OUT_X + 40, c.cy, 0.92)}
              />
              <text class="chip-text" x={OUT_X + 70} y={c.cy + 5}>
                {c.label}
              </text>
            </g>
          ))
        }

        <!-- the worker -->
        <g class="core">
          {
            [0, 1, 2].map((i) => (
              <circle class="tick s-trigger" cx={CORE.x} cy={CORE.y} r={CORE.r} style={seq(i * 0.3, 0.7)} />
            ))
          }
          <circle class="core-halo" cx={CORE.x} cy={CORE.y} r={CORE.r + 26} />
          <circle class="core-ring" cx={CORE.x} cy={CORE.y} r={CORE.ring} />
          <circle class="core-disc" cx={CORE.x} cy={CORE.y} r={CORE.r} />
          <path
            class="core-glyph s-trigger"
            d={ICON_PATHS.bot}
            transform={glyph(CORE.x, CORE.y, 2.5)}
            style={seq(0.1, 0.6)}
          />
          {
            ringDots.map((d, i) => (
              <g
                class="dot s-reason"
                style={`${seq(i * 0.08, 0.5)};--dx:${d.dx.toFixed(1)}px;--dy:${d.dy.toFixed(1)}px`}
              >
                <g class="dot-in" style={`--delay:${(i * 0.16).toFixed(2)}s`}>
                  <circle class="dot-disc" cx={CORE.x} cy={CORE.y} r="16" />
                  <path
                    class="dot-glyph"
                    d={ICON_PATHS[d.icon]}
                    transform={glyph(CORE.x, CORE.y, 0.64)}
                  />
                </g>
              </g>
            ))
          }
        </g>
      </svg>

      <!-- ── stacked diagram (below md) ───────────────────────────────── -->
      <div class="relative md:hidden">
        <p class="stack-label">{sourcesLabel}</p>
        <div class="mt-2 grid grid-cols-2 gap-2">
          {
            inChips.map((c, i) => (
              <span class="stack-chip s-gather" style={seq(i * 0.1, 0.5)}>
                <Icon name={c.icon} class="size-4 shrink-0" />
                <span class="min-w-0 truncate">{c.label}</span>
              </span>
            ))
          }
        </div>

        <div class="rail s-gather" style={seq(0.35, 0.5)}><span class="rail-dot"></span></div>

        <div class="stack-core s-trigger" style={seq(0.1, 0.6)}>
          <span class="stack-core-disc">
            <Icon name="bot" class="size-6" />
          </span>
          <span class="stack-core-ring s-reason" style={seq(0, 0.7)} aria-hidden="true"></span>
        </div>

        <div class="rail s-act" style={seq(0, 0.5)}><span class="rail-dot"></span></div>

        <p class="stack-label">{deliveriesLabel}</p>
        <div class="mt-2 grid grid-cols-2 gap-2">
          {
            outChips.map((c, i) => (
              <span class="stack-chip s-act" style={seq(i * 0.1, 0.5)}>
                <Icon name={c.icon} class="size-4 shrink-0" />
                <span class="min-w-0 truncate">{c.label}</span>
              </span>
            ))
          }
        </div>
      </div>

      <!-- harness row, shared by both renderings -->
      <div class="harness-row relative mt-5 flex flex-wrap items-center justify-center gap-2 pt-5">
        <span class="harness-label">{harnessLabel}</span>
        {
          harnessChips.map((h, i) => (
            <span
              class="harness-chip s-reason"
              style={`${seq(i * 0.07, 0.5)};--delay:${(i * 0.08).toFixed(2)}s`}
            >
              <Icon name={h.icon} class="size-3.5" />
              {h.label}
            </span>
          ))
        }
      </div>
    </div>

    <div class="mt-5">
      <!-- scrub read-out: four segments that fill exactly with the four cards -->
      <div class="segs" aria-hidden="true">
        {stages.map((_, i) => <span class={`seg seg-${i}`}><i></i></span>)}
      </div>

      <!-- stage captions -->
      <div class="grid gap-3 md:grid-cols-4">
        {
          stages.map((s, i) => (
            <div class={`stage stage-${i}`}>
              <div class="flex items-center gap-2">
                <span class="stage-icon">
                  <Icon name={STAGE_ICONS[i]} class="size-3.5" />
                </span>
                <span class="stage-n">{s.n}</span>
                <span class="stage-title">{s.title}</span>
              </div>
              <p class="stage-body">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>

    <p class="run-hint">
      <Icon name="chevron" class="hint-chevron size-3.5" />
      {hint}
    </p>
  </div>
</div>

<style>
  /* The pinned stage only exists when motion is welcome: without JS or with
   * reduced motion the wrapper is just a normal block and every part is lit. */
  .run-scroll {
    /* Scrub-derived inputs. These defaults *are* the finished, still state, so
     * everything downstream can read them unconditionally. */
    --k0: 1;
    --k1: 1;
    --k2: 1;
    --k3: 1;
    --psc: 0; /* centred scrub, -1 → 1 — parallax only */
    --spin: 0turn; /* one full turn across the whole scrub */
    --sweep: 50%; /* travelling highlight, left → right */
    height: auto;
  }
  .run-sticky {
    position: static;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .run-scroll {
      height: 240vh;
      /* ×5, not ×4: each stage finishes assembling about three quarters of the
       * way through its own quarter of the scrub, so the reader gets a beat to
       * read the caption before the next stage starts moving. */
      --k0: clamp(0, calc(var(--ps, 0) * 5), 1);
      --k1: clamp(0, calc((var(--ps, 0) - 0.25) * 5), 1);
      --k2: clamp(0, calc((var(--ps, 0) - 0.5) * 5), 1);
      --k3: clamp(0, calc((var(--ps, 0) - 0.75) * 5), 1);
      --psc: calc(var(--ps, 0) * 2 - 1);
      --spin: calc(var(--ps, 0) * 1turn);
      --sweep: calc(var(--ps, 0) * 100%);
    }
    /* Clears the fixed header (12px offset + 4rem bar). */
    :global(html.js) .run-sticky {
      position: sticky;
      top: 5rem;
    }
    @media (min-width: 768px) {
      :global(html.js) .run-scroll {
        height: 270vh;
      }
      :global(html.js) .run-sticky {
        top: 5.5rem;
      }
    }
  }

  /* ── stage ramps ──────────────────────────────────────────────────────
   * `--d` is the one number every part animates on: its own 0 → 1 arrival
   * ramp, `--o` into its stage and `1 / --spd` long. `--hot` is the separate
   * 0/1 "this is the stage you are reading" accent. */
  .s-trigger { --kk: var(--k0); }
  .s-gather { --kk: var(--k1); }
  .s-reason { --kk: var(--k2); }
  .s-act { --kk: var(--k3); }
  .stage-0,
  .seg-0 { --kk: var(--k0); }
  .stage-1,
  .seg-1 { --kk: var(--k1); }
  .stage-2,
  .seg-2 { --kk: var(--k2); }
  .stage-3,
  .seg-3 { --kk: var(--k3); }

  .s-trigger,
  .s-gather,
  .s-reason,
  .s-act,
  .stage {
    --hot: 0;
    --d: clamp(0, calc((var(--kk, 1) - var(--o, 0)) * var(--spd, 2)), 1);
    transition:
      opacity 0.4s var(--ease-out-expo),
      fill-opacity 0.4s var(--ease-out-expo),
      stroke 0.4s var(--ease-out-expo),
      stroke-opacity 0.4s var(--ease-out-expo),
      color 0.4s var(--ease-out-expo),
      background-color 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo);
  }
  [data-stage='0'] .s-trigger,
  [data-stage='0'] .stage-0,
  [data-stage='1'] .s-gather,
  [data-stage='1'] .stage-1,
  [data-stage='2'] .s-reason,
  [data-stage='2'] .stage-2,
  [data-stage='3'] .s-act,
  [data-stage='3'] .stage-3 {
    --hot: 1;
  }

  /* ── the panel and its parallax layers ────────────────────────────── */
  .run-card {
    border: 1px solid var(--surface-line);
    background: var(--surface);
    box-shadow: 0 24px 60px -30px color-mix(in oklab, var(--color-ink-950) 22%, transparent);
  }
  :global(.dark) .run-card {
    box-shadow: 0 30px 70px -30px #000;
  }

  .grid-far,
  .grid-near,
  .sweep,
  .blob {
    position: absolute;
    pointer-events: none;
  }
  .grid-far,
  .grid-near {
    inset: -20%;
    mask-image: radial-gradient(65% 60% at 50% 45%, black, transparent);
  }
  .grid-far {
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--color-brand-300) 9%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-sky-300) 8%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: calc(var(--psc) * -26px) calc(var(--psc) * -20px);
    opacity: 0.6;
  }
  .grid-near {
    background-image: radial-gradient(
      color-mix(in oklab, var(--color-brand-400) 22%, transparent) 1px,
      transparent 1px
    );
    background-size: 22px 22px;
    background-position: calc(var(--psc) * 58px) calc(var(--psc) * 34px);
    /* Tighter than `.grid-far` so the fine texture stays around the machine
     * instead of speckling the glow in the corners. */
    mask-image: radial-gradient(42% 44% at 50% 45%, black, transparent);
    opacity: 0.3;
  }
  :global(.dark) .grid-far {
    opacity: 0.35;
  }
  :global(.dark) .grid-near {
    opacity: 0.22;
  }
  /* A soft highlight that walks the panel as the run advances — the cheapest
   * possible "this is still moving" signal at any scroll position. */
  .sweep {
    top: -30%;
    bottom: -30%;
    left: var(--sweep);
    width: 46%;
    margin-left: -23%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--color-brand-400) 22%, transparent),
      transparent
    );
    opacity: 0.7;
  }
  :global(.dark) .sweep {
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--color-brand-400) 22%, transparent),
      transparent
    );
  }
  .blob {
    border-radius: 9999px;
    filter: blur(48px);
  }
  .blob-a {
    top: -18%;
    left: 4%;
    height: 46%;
    width: 34%;
    background: radial-gradient(circle, color-mix(in oklab, var(--color-brand-300) 45%, transparent), transparent 70%);
    opacity: 0.5;
    transform: translate3d(calc(var(--psc) * 46px), calc(var(--psc) * -22px), 0);
  }
  .blob-b {
    bottom: -20%;
    right: 2%;
    height: 52%;
    width: 36%;
    background: radial-gradient(circle, color-mix(in oklab, var(--color-sky-300) 42%, transparent), transparent 70%);
    opacity: 0.45;
    transform: translate3d(calc(var(--psc) * -38px), calc(var(--psc) * 26px), 0);
  }

  /* ── landscape SVG ────────────────────────────────────────────────── */
  .diagram {
    font-family: var(--font-mono);
  }
  .col-label {
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--text-muted);
    fill-opacity: calc(0.25 + var(--d) * 0.75);
  }

  /* Backdrop rings and motes: the parallax depth behind the machine. */
  .bg-ring {
    fill: none;
    stroke: color-mix(in oklab, var(--color-brand-500) 14%, transparent);
    stroke-width: 1;
    stroke-dasharray: 1 9;
    transform-box: view-box;
    transform-origin: 500px 203px;
  }
  :global(.dark) .bg-ring {
    stroke: color-mix(in oklab, var(--color-brand-300) 22%, transparent);
  }
  .bg-ring-0 { transform: rotate(calc(var(--spin) * 0.55)); }
  .bg-ring-1 { transform: rotate(calc(var(--spin) * -0.32)); }
  .bg-ring-2 { transform: rotate(calc(var(--spin) * 0.18)); }

  .orbit {
    transform-box: view-box;
    transform-origin: 500px 203px;
  }
  .orbit-0 { transform: rotate(calc(var(--spin) * 0.9)); }
  .orbit-1 { transform: rotate(calc(var(--spin) * -0.6)); }
  .orbit-2 { transform: rotate(calc(var(--spin) * 0.38)); }
  .mote {
    fill: color-mix(in oklab, var(--color-brand-500) 55%, transparent);
    animation: mote-fade 5.5s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  :global(.dark) .mote {
    fill: color-mix(in oklab, var(--color-brand-300) 75%, transparent);
  }
  @keyframes mote-fade {
    0%,
    100% { opacity: 0.25; }
    50% { opacity: 0.8; }
  }

  /* Wires draw themselves along the scrub, then keep a pulse running. */
  .wire {
    stroke: color-mix(in oklab, var(--color-brand-600) 30%, transparent);
    stroke-width: 1.6;
    stroke-dasharray: 100 100;
    stroke-dashoffset: calc((1 - var(--d)) * 100);
    stroke-opacity: calc(0.5 + var(--hot) * 0.5);
  }
  :global(.dark) .wire {
    stroke: color-mix(in oklab, var(--color-brand-400) 55%, transparent);
    stroke-width: 2.25;
    stroke-opacity: calc(0.6 + var(--hot) * 0.4);
  }
  .pulse {
    stroke: var(--color-brand-500);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 7 93;
    stroke-dashoffset: 100;
    opacity: calc(var(--d) * (0.45 + var(--hot) * 0.55));
    animation: wire-run 1.9s linear infinite;
    animation-delay: var(--delay, 0s);
  }
  :global(.dark) .pulse {
    stroke: var(--color-brand-300);
