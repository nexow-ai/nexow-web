---
/**
 * Decorative research board → dashboard mock: a board of links/media/widgets
 * flowing onto a live canvas desk. Illustrative only (aria-hidden).
 */
import Icon from './Icon.astro';
---

<div
  class="relative mx-auto w-full max-w-lg overflow-hidden rounded-3xl border border-ink-900/10 bg-white shadow-xl shadow-ink-950/10"
  aria-hidden="true"
  data-motion="tilt rise"
>
  <div class="flex items-center gap-2 border-b border-ink-900/8 px-4 py-3">
    <Icon name="library" class="size-4 text-brand-600" />
    <span class="font-mono text-xs text-ink-500">board · research desk</span>
    <span class="ml-auto rounded-full bg-brand-50 px-2 py-0.5 font-mono text-[0.65rem] text-brand-700">live</span>
  </div>

  <div class="grid gap-3 p-4 sm:grid-cols-[0.9fr_1.1fr]">
    <!-- Board tiles -->
    <div class="space-y-2.5 rounded-2xl border border-ink-900/8 bg-[#f7fbfb] p-3">
      <p class="font-mono text-[0.65rem] uppercase tracking-wider text-ink-400">Board</p>
      <div class="grid grid-cols-2 gap-2">
        <div class="research-tile rounded-xl border border-ink-900/10 bg-white p-2" style="--d:0s">
          <div class="h-10 rounded-lg bg-gradient-to-br from-brand-200 to-sky-100"></div>
          <p class="mt-1.5 truncate font-mono text-[0.6rem] text-ink-600">widget · heatmap</p>
        </div>
        <div class="research-tile rounded-xl border border-ink-900/10 bg-white p-2" style="--d:0.15s">
          <div class="flex h-10 items-center justify-center rounded-lg bg-ink-950/5">
            <Icon name="link" class="size-4 text-accent-500" />
          </div>
          <p class="mt-1.5 truncate font-mono text-[0.6rem] text-ink-600">yt · brief</p>
        </div>
        <div class="research-tile rounded-xl border border-ink-900/10 bg-white p-2" style="--d:0.3s">
          <div class="h-10 rounded-lg bg-gradient-to-br from-accent-200/80 to-plasma-100"></div>
          <p class="mt-1.5 truncate font-mono text-[0.6rem] text-ink-600">media · clip</p>
        </div>
        <div class="research-tile rounded-xl border border-ink-900/10 bg-white p-2" style="--d:0.45s">
          <div class="flex h-10 items-center gap-1 rounded-lg bg-white p-1.5 ring-1 ring-ink-900/8">
            <span class="h-full flex-1 rounded-sm bg-brand-400/50"></span>
            <span class="h-full flex-1 rounded-sm bg-brand-300/40"></span>
            <span class="h-full flex-1 rounded-sm bg-sky-300/50"></span>
          </div>
          <p class="mt-1.5 truncate font-mono text-[0.6rem] text-ink-600">post · pinned</p>
        </div>
      </div>
    </div>

    <!-- Dashboard -->
    <div class="relative overflow-hidden rounded-2xl border border-ink-900/10 bg-ink-950 p-3 text-white">
      <div
        class="pointer-events-none absolute -right-8 -top-8 size-28 rounded-full opacity-40 blur-2xl"
        style="background:radial-gradient(circle, var(--color-brand-400), transparent 70%)"
      >
      </div>
      <div class="relative flex items-center gap-2">
        <Icon name="layers" class="size-3.5 text-brand-300" />
        <span class="font-mono text-[0.65rem] text-ink-400">dashboard</span>
        <span class="ml-auto font-mono text-[0.6rem] text-brand-300">open on canvas</span>
      </div>
      <div class="relative mt-3 grid grid-cols-3 gap-1.5">
        {
          Array.from({ length: 6 }).map((_, i) => (
            <span
              class:list={[
                'research-cell h-9 rounded-md',
                [0, 3].includes(i)
                  ? 'col-span-2 bg-gradient-to-br from-brand-500/50 to-accent-500/30'
                  : i === 1
                    ? 'bg-white/10'
                    : 'bg-white/[0.06]',
              ]}
              style={`--d:${0.1 + i * 0.08}s`}
            />
          ))
        }
      </div>
      <div class="relative mt-3 flex items-center gap-2 font-mono text-[0.6rem] text-ink-400">
        <span class="inline-flex size-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        streaming · 4 widgets live
      </div>
    </div>
  </div>
</div>

<style>
  .research-tile,
  .research-cell {
    animation: research-in 0.9s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes research-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .is-offscreen .research-tile,
  .is-offscreen .research-cell {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .research-tile,
    .research-cell {
      animation: none;
    }
  }
</style>
