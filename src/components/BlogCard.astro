---
import { type Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import { localizePath, dateLocale } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  featured?: boolean;
}
const { lang, slug, title, description, pubDate, tags, featured = false } = Astro.props;
const t = useContent(lang).blog;
const href = localizePath(`/blog/${slug}`, lang);
const dtFmt = new Intl.DateTimeFormat(dateLocale(lang), {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article
  class:list={[
    'group relative flex flex-col rounded-2xl border border-ink-900/8 bg-white p-7 transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:border-brand-500/30 hover:shadow-lg hover:shadow-brand-900/5',
    featured && 'md:col-span-2 md:flex-row md:items-center md:gap-8',
  ]}
>
  <div class={featured ? 'md:flex-1' : ''}>
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink-500">
      <time datetime={pubDate.toISOString()}>{dtFmt.format(pubDate)}</time>
      {tags[0] && (
        <>
          <span aria-hidden="true">·</span>
          <span class="text-brand-600">#{tags[0]}</span>
        </>
      )}
    </div>
    <h2
      class:list={[
        'mt-3 text-balance font-display font-semibold text-ink-950',
        featured ? 'text-2xl md:text-3xl' : 'text-xl',
      ]}
    >
      <a href={href}>
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h2>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-600">{description}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-brand-700">
      {t.readMore}
      <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</article>
