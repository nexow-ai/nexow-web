---
import { type Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import type { BlogCategory } from '../i18n/blog';
import { localizePath, dateLocale } from '../i18n/utils';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: BlogCategory;
  heroImage?: ImageMetadata;
  featured?: boolean;
  /** Anchor for the blog index section rail. */
  id?: string;
}
const { lang, slug, title, description, pubDate, category, heroImage, featured = false, id } =
  Astro.props;
const t = useContent(lang).blog;
// English labels are merged underneath by `useContent`, so this is always set.
const categoryLabel = t.categories![category];
const href = localizePath(`/blog/${slug}`, lang);
const dtFmt = new Intl.DateTimeFormat(dateLocale(lang), {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article
  id={id}
  class:list={[
    'group relative flex scroll-mt-20 flex-col overflow-hidden rounded-2xl border border-ink-900/8 bg-white transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:border-brand-500/30 hover:shadow-xl hover:shadow-brand-900/5 dark:border-white/10 dark:bg-white/[0.04] dark:hover:border-brand-400/30 dark:hover:shadow-black/40',
    featured && 'md:col-span-2 md:flex-row',
  ]}
>
  {
    heroImage && (
      <div
        class:list={[
          'relative shrink-0 overflow-hidden bg-brand-50 dark:bg-brand-400/10',
          featured && 'md:w-[46%]',
        ]}
      >
        <img
          src={heroImage.src}
          alt=""
          loading="lazy"
          decoding="async"
          width={heroImage.width}
          height={heroImage.height}
          class:list={[
            'w-full object-cover transition-transform duration-[600ms] ease-out-expo group-hover:scale-[1.04]',
            featured ? 'aspect-[16/10] md:h-full md:aspect-auto' : 'aspect-[16/9]',
          ]}
        />
        <div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-white/5" />
        {featured && (
          <span class="absolute left-4 top-4 rounded-full bg-ink-950/70 px-2.5 py-1 font-mono text-[0.65rem] font-medium uppercase tracking-wider text-brand-300 ring-1 ring-white/10 backdrop-blur">
            {t.latest}
          </span>
        )}
      </div>
    )
  }

  <div class:list={['flex flex-1 flex-col p-7', featured && 'md:justify-center md:p-10']}>
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-ink-500">
      <time datetime={pubDate.toISOString()}>{dtFmt.format(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span class="text-brand-600 dark:text-brand-300">{categoryLabel}</span>
    </div>
    <h2
      class:list={[
        'mt-3 text-balance font-display font-semibold text-ink-950 dark:text-white',
        featured ? 'text-2xl md:text-3xl' : 'text-xl',
      ]}
    >
      <a href={href}>
        <span class="absolute inset-0" aria-hidden="true"></span>
        {title}
      </a>
    </h2>
    <p
      class:list={[
        'mt-3 line-clamp-3 leading-relaxed text-ink-600 dark:text-ink-300',
        featured ? 'text-sm md:text-base' : 'text-sm',
      ]}
    >
      {description}
    </p>
    <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-sm font-medium text-brand-700 dark:text-brand-300">
      {t.readMore}
      <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</article>
