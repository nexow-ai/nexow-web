---
import type { Connector } from '../data/connectors';
import type { SiteContent } from '../i18n/content';

interface Props {
  c: Connector;
  t: SiteContent['connectorsPage'];
}
const { c, t } = Astro.props;

const kindLabel = t.kinds[c.kind] ?? c.kind;
const catLabel = t.categories[c.category] ?? c.category;
const assetLabels = c.assets.map((a) => t.assets[a] ?? a);
const shown = assetLabels.slice(0, 3);
const more = assetLabels.length - shown.length;
// Lowercased haystack for the client-side search (matches localized terms too).
const search = [c.name, kindLabel, catLabel, ...assetLabels].join(' ').toLowerCase();
---

<button
  type="button"
  class:list={[
    'connector-card group relative flex flex-col rounded-2xl border border-ink-900/10 bg-white p-5 text-left shadow-sm shadow-ink-950/[0.03] transition-all duration-300 ease-out-expo hover:-translate-y-1 hover:border-brand-400/35 hover:shadow-xl hover:shadow-brand-900/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500',
    c.status === 'soon' && 'opacity-75 hover:opacity-100',
  ]}
  data-category={c.category}
  data-status={c.status}
  data-search={search}
  data-connector-id={c.id}
  aria-haspopup="dialog"
>
  <div class="flex items-start justify-between gap-2">
    <span
      class:list={[
        'inline-flex size-12 items-center justify-center overflow-hidden rounded-xl ring-1 ring-ink-900/10',
        c.logoFit === 'contain' ? 'bg-white p-1.5' : 'bg-[#f7fbfb]',
      ]}
    >
      <img
        src={c.logo}
        alt=""
        loading="lazy"
        decoding="async"
        width="40"
        height="40"
        class:list={[
          'size-full object-center',
          c.logoFit === 'cover' ? 'object-cover' : 'object-contain',
        ]}
      />
    </span>
    {
      c.status === 'soon' && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-ink-900/[0.06] px-2 py-0.5 font-mono text-[0.6rem] font-medium uppercase tracking-[0.09em] text-ink-500">
          <span class="size-1.5 rounded-full bg-accent-500/80"></span>
          {t.comingSoon}
        </span>
      )
    }
  </div>

  <h3 class="mt-4 font-display text-base font-semibold text-ink-950">{c.name}</h3>
  <p class="mt-0.5 text-xs text-ink-500">{kindLabel}</p>

  {
    shown.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {shown.map((a) => (
          <span class="rounded-md border border-ink-900/10 bg-[#f7fbfb] px-1.5 py-0.5 font-mono text-[0.6rem] text-ink-600">{a}</span>
        ))}
        {more > 0 && (
          <span class="rounded-md border border-ink-900/10 bg-[#f7fbfb] px-1.5 py-0.5 font-mono text-[0.6rem] text-ink-500">+{more}</span>
        )}
      </div>
    )
  }

  <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-brand-700 opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
    {t.openDetails}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  </span>
</button>
