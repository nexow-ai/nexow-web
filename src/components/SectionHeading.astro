---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  /** Apply brand → sky → accent gradient to the title. */
  gradientTitle?: boolean;
  class?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  tone = 'light',
  gradientTitle = false,
  class: className = '',
} = Astro.props;

const alignCls = align === 'center' ? 'mx-auto text-center items-center' : 'items-start text-left';
const titleColor = gradientTitle
  ? 'text-gradient'
  : tone === 'dark'
    ? 'text-white'
    : 'text-ink-950 dark:text-white';
const subColor = tone === 'dark' ? 'text-ink-400' : 'text-ink-600 dark:text-ink-300';
---

<div class:list={['flex max-w-2xl flex-col reveal', alignCls, className]}>
  {
    eyebrow && (
      <span class="eyebrow mb-3 inline-flex items-center gap-2 text-brand-600 dark:text-brand-300">
        <span class="h-px w-6 rule-gradient"></span>
        {eyebrow}
      </span>
    )
  }
  <h2 class:list={['text-balance text-3xl sm:text-4xl md:text-[2.75rem] md:leading-[1.05]', titleColor]}>
    {title}
  </h2>
  {subtitle && <p class:list={['mt-4 text-lg leading-relaxed', subColor]}>{subtitle}</p>}
</div>
