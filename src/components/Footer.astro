---
import { SITE, SOCIALS } from '../i18n/config';
import { useContent } from '../i18n/content';
import { getLangFromUrl, localizePath } from '../i18n/utils';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  /** On an already-dark page the footer drops its own background so the page
   *  backdrop (the dot field) runs straight through it. */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const year = 2026;

const localize = (href: string) =>
  href.startsWith('/') ? localizePath(href, lang) : href;
---

<footer
  transition:animate="none"
  class:list={[
    'relative overflow-hidden text-ink-300',
    tone === 'dark' ? 'border-t border-white/8' : 'bg-ink-950',
  ]}
>
  {
    tone !== 'dark' && (
      <div class="bg-grid absolute inset-0 opacity-40 [mask-image:radial-gradient(80%_60%_at_50%_0%,black,transparent)]" />
    )
  }
  <div class="container-page relative py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_2fr]">
      <div class="max-w-sm">
        <Logo lang={lang} tone="light" class="h-8" />
        <p class="mt-5 text-sm leading-relaxed text-ink-400">{t.footer.tagline}</p>
        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-9 items-center justify-center rounded-full ring-1 ring-white/10 text-ink-300 transition-colors hover:bg-white/5 hover:text-white"
                aria-label={s.label}
              >
                <Icon name={s.icon} class="size-4.5" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          t.footer.columns.map((col) => (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-widest text-ink-500">{col.title}</h3>
              <ul class="mt-4 space-y-3">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={localize(l.href)}
                      class="text-sm text-ink-400 transition-colors hover:text-white"
                      {...l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-8">
      <p class="text-xs leading-relaxed text-ink-500">{t.footer.disclaimer}</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-ink-500">
          © {year} {SITE.legalName}. {t.footer.rights}
        </p>
        <p class="font-mono text-xs text-ink-600">{t.footer.builtWith}</p>
      </div>
    </div>
  </div>
</footer>
