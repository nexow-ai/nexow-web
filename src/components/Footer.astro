---
import { SITE, SOCIALS } from '../i18n/config';
import { useContent } from '../i18n/content';
import { getLangFromUrl, localizePath } from '../i18n/utils';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import DotField from './DotField.astro';

const lang = getLangFromUrl(Astro.url);
const t = useContent(lang);
const year = 2026;
const newsletter = t.footer.newsletter;

const localize = (href: string) =>
  href.startsWith('/') ? localizePath(href, lang) : href;
---

<footer
  transition:animate="none"
  class="relative overflow-hidden border-t border-transparent bg-ink-950 text-ink-300 dark:border-white/8 dark:bg-transparent"
>
  {/* Light mode: scoped dark DotField. Dark mode uses Layout's page-wide field. */}
  <DotField
    tone="dark"
    class="absolute inset-0 z-0 opacity-90 [mask-image:radial-gradient(85%_70%_at_50%_0%,black,transparent)] dark:hidden"
  />
  <div class="container-page relative z-10 py-16">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_2fr]">
      <div class="max-w-sm">
        <Logo lang={lang} tone="light" class="h-8" />
        <p class="mt-5 text-sm leading-relaxed text-ink-400">{t.footer.tagline}</p>
        <div class="mt-6 flex flex-wrap items-center gap-2.5">
          {
            SOCIALS.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex size-9 items-center justify-center rounded-full ring-1 ring-white/10 text-ink-300 transition-colors hover:bg-white/5 hover:text-white"
                aria-label={s.label}
              >
                <Icon name={s.icon} class="size-4.5" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          t.footer.columns.map((col) => (
            <div>
              <h3 class="font-mono text-xs uppercase tracking-widest text-ink-500 dark:text-ink-400">{col.title}</h3>
              <ul class="mt-4 space-y-3">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={localize(l.href)}
                      class="text-sm text-ink-400 transition-colors hover:text-white"
                      {...l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    {
      newsletter && (
        <div class="mt-14 max-w-xl">
          <h3 class="font-mono text-xs uppercase tracking-widest text-ink-500 dark:text-ink-400">
            {newsletter.eyebrow}
          </h3>
          <p class="mt-3 font-display text-xl font-semibold tracking-tight text-white sm:text-2xl">
            {newsletter.title}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">{newsletter.subtitle}</p>

          <form
            id="newsletter-form"
            class="mt-6"
            data-endpoint={SITE.newsletterUrl}
            data-source="footer"
            data-invalid={newsletter.invalid}
            data-error={newsletter.error}
            data-success={newsletter.success}
            data-submitting={newsletter.submitting}
            data-submit-label={newsletter.submit}
            novalidate
          >
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
              <label class="sr-only" for="newsletter-email">{newsletter.placeholder}</label>
              <input
                id="newsletter-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="254"
                placeholder={newsletter.placeholder}
                class="h-11 w-full min-w-0 sm:flex-1 rounded-full bg-white/[0.04] px-4 text-sm text-white ring-1 ring-white/10 placeholder:text-ink-500 transition-[box-shadow,background-color] focus:bg-white/[0.07] focus:outline-none focus:ring-2 focus:ring-brand-400/40 disabled:opacity-60"
              />
              <button
                type="submit"
                id="newsletter-submit"
                class="inline-flex h-11 shrink-0 items-center justify-center rounded-full bg-white px-5 text-sm font-medium text-ink-950 transition-all duration-200 hover:bg-white/90 hover:-translate-y-0.5 disabled:pointer-events-none disabled:opacity-60"
              >
                {newsletter.submit}
              </button>
            </div>
            <p
              id="newsletter-status"
              class="mt-3 min-h-[1.25rem] text-sm"
              role="status"
              aria-live="polite"
            ></p>
          </form>
        </div>
      )
    }

    <div class="mt-14 border-t border-white/10 pt-8">
      <p class="text-xs leading-relaxed text-ink-500 dark:text-ink-400">
        <span class="font-medium text-ink-400">{SITE.legalName}</span>
        <span class="mx-2 text-ink-700" aria-hidden="true">·</span>
        <span>{SITE.address}</span>
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs text-ink-500 dark:text-ink-400">
          © {year} {SITE.legalName}. {t.footer.rights}
        </p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <time
            id="footer-clock"
            class="font-mono text-xs tabular-nums text-ink-500 dark:text-ink-400"
            data-locale={lang}
            datetime=""
          ></time>
          <span
            class="status-badge inline-flex items-center gap-1.5 rounded-full bg-emerald-400/[0.08] py-1 pe-2.5 ps-1.5 font-mono text-[0.7rem] text-emerald-300 ring-1 ring-emerald-400/20"
          >
            <svg class="status-rack size-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <rect class="slab" x="1.75" y="1.5" width="10.5" height="3" rx="1.1" />
              <rect class="slab" x="1.75" y="5.5" width="10.5" height="3" rx="1.1" />
              <rect class="slab" x="1.75" y="9.5" width="10.5" height="3" rx="1.1" />
              <circle class="led" cx="10.4" cy="3" r="0.85" />
              <circle class="led" cx="10.4" cy="7" r="0.85" />
              <circle class="led" cx="10.4" cy="11" r="0.85" />
            </svg>
            {t.footer.status}
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Service-health badge: a 3-slab rack whose LEDs blink in sequence, with a
     slow breathing halo on the pill itself. */
  .status-badge {
    animation: status-halo 3.6s ease-in-out infinite;
  }

  .status-rack .slab {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.45;
  }

  .status-rack .led {
    fill: currentColor;
    opacity: 0.35;
    animation: status-led 1.8s ease-in-out infinite;
  }

  .status-rack .led:nth-of-type(2) {
    animation-delay: 0.2s;
  }

  .status-rack .led:nth-of-type(3) {
    animation-delay: 0.4s;
  }

  @keyframes status-led {
    0%,
    55%,
    100% {
      opacity: 0.3;
    }
    25% {
      opacity: 1;
    }
  }

  @keyframes status-halo {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(52 211 153 / 0.14);
    }
    50% {
      box-shadow: 0 0 10px 1px rgb(52 211 153 / 0.22);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-badge,
    .status-rack .led {
      animation: none;
    }
    .status-rack .led {
      opacity: 0.9;
    }
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function setStatus(
    el: HTMLElement | null,
    message: string,
    kind: 'idle' | 'ok' | 'err',
  ) {
    if (!el) return;
    el.textContent = message;
    el.classList.toggle('text-brand-300', kind === 'ok');
    el.classList.toggle('text-red-400', kind === 'err');
    el.classList.toggle('text-ink-500', kind === 'idle');
  }

  function initNewsletterForm() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const endpoint = form.dataset.endpoint ?? '';
    const source = form.dataset.source ?? 'footer';
    const input = form.querySelector<HTMLInputElement>('#newsletter-email');
    const submit = form.querySelector<HTMLButtonElement>('#newsletter-submit');
    const status = form.querySelector<HTMLElement>('#newsletter-status');
    if (!input || !submit || !endpoint) return;

    const labels = {
      invalid: form.dataset.invalid ?? 'Enter a valid email address.',
      error: form.dataset.error ?? 'Something went wrong. Please try again.',
      success: form.dataset.success ?? 'You’re in. Thanks for subscribing.',
      submitting: form.dataset.submitting ?? 'Subscribing…',
      submit: form.dataset.submitLabel ?? 'Subscribe',
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = input.value.trim().toLowerCase();
      if (!email || email.length > 254 || !EMAIL_RE.test(email)) {
        setStatus(status, labels.invalid, 'err');
        input.focus();
        return;
      }

      submit.disabled = true;
      input.disabled = true;
      submit.textContent = labels.submitting;
      setStatus(status, '', 'idle');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email, source }),
        });

        if (!res.ok) {
          const payload = (await res.json().catch(() => null)) as {
            statusMessage?: string;
            message?: string;
          } | null;
          const msg =
            payload?.statusMessage ||
            payload?.message ||
            (res.status === 400 ? labels.invalid : labels.error);
          setStatus(status, msg, 'err');
          return;
        }

        setStatus(status, labels.success, 'ok');
        input.value = '';
      } catch {
        setStatus(status, labels.error, 'err');
      } finally {
        submit.disabled = false;
        input.disabled = false;
        submit.textContent = labels.submit;
      }
    });
  }

  let clockTimer: number | null = null;

  function formatClock(locale: string, now: Date) {
    try {
      return new Intl.DateTimeFormat(locale, {
        weekday: 'short',
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(now);
    } catch {
      return now.toISOString().replace('T', ' ').slice(0, 19);
    }
  }

  function tickClock(el: HTMLTimeElement) {
    const now = new Date();
    el.dateTime = now.toISOString();
    el.textContent = formatClock(el.dataset.locale || 'en', now);
  }

  function initFooterClock() {
    if (clockTimer != null) {
      window.clearInterval(clockTimer);
      clockTimer = null;
    }
    const el = document.getElementById('footer-clock') as HTMLTimeElement | null;
    if (!el) return;
    tickClock(el);
    clockTimer = window.setInterval(() => tickClock(el), 1000);
  }

  document.addEventListener('astro:page-load', () => {
    initNewsletterForm();
    initFooterClock();
  });
</script>
