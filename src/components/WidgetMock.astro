---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import CandlestickChart from './CandlestickChart.astro';

interface Props {
  promptExample: string;
  promptPlaceholder: string;
  class?: string;
}
const { promptExample, class: className = '' } = Astro.props;
---

<div class:list={['relative', className]}>
  <!-- Ambient glow behind the mock -->
  <div class="glow-brand pointer-events-none absolute -inset-10 -z-10 opacity-70"></div>

  <!-- Product card -->
  <div
    class="relative overflow-hidden rounded-2xl bg-ink-900 shadow-2xl shadow-black/60 ring-1 ring-white/10"
  >
    <div class="bg-grid absolute inset-0 opacity-30"></div>

    <!-- Window chrome -->
    <div class="relative flex items-center gap-2 border-b border-white/5 px-4 py-3">
      <span class="size-3 rounded-full bg-rose-500/80"></span>
      <span class="size-3 rounded-full bg-amber-400/80"></span>
      <span class="size-3 rounded-full bg-emerald-400/80"></span>
      <div class="ml-3 flex items-center gap-1.5 text-ink-400">
        <BrandMark class="size-3.5 text-brand-400" />
        <span class="font-mono text-xs tracking-tight">nexow · canvas</span>
      </div>
      <span class="ml-auto flex items-center gap-1.5 rounded-full bg-white/5 px-2.5 py-1 font-mono text-[0.65rem] text-ink-400">
        <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span> live
      </span>
    </div>

    <!-- Prompt bar (JS types the example; static text without JS) -->
    <div class="relative px-4 pt-4">
      <div
        class="flex items-center gap-3 rounded-xl border border-white/10 bg-ink-850 px-3.5 py-3 ring-1 ring-brand-500/0 transition-shadow"
      >
        <BrandMark class="size-4 shrink-0 text-brand-400" />
        <p class="min-w-0 flex-1 truncate text-sm text-ink-200">
          <span data-typed data-text={promptExample}>{promptExample}</span><span
            class="caret-blink ml-0.5 inline-block h-4 w-px translate-y-0.5 bg-brand-400"></span>
        </p>
        <span
          class="hidden shrink-0 items-center gap-1.5 rounded-lg bg-brand-500 px-3 py-1.5 text-xs font-semibold text-white sm:inline-flex"
        >
          <Icon name="sparkles" class="size-3.5" /> Generate
        </span>
      </div>
    </div>

    <!-- Generated widget -->
    <div class="relative m-4 rounded-xl border border-white/5 bg-ink-850/60 p-4">
      <div class="flex items-start justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-sm font-semibold text-white">BTC-USD</span>
            <span class="rounded bg-white/5 px-1.5 py-0.5 font-mono text-[0.65rem] text-ink-400">Coinbase</span>
          </div>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="font-mono text-xl font-semibold text-white">68,420.15</span>
            <span class="font-mono text-xs font-medium text-emerald-400">+2.14%</span>
          </div>
        </div>
        <div class="flex gap-1">
          {['1H', '4H', '1D'].map((tf, i) => (
            <span
              class:list={[
                'rounded px-2 py-1 font-mono text-[0.65rem]',
                i === 2 ? 'bg-brand-500/20 text-brand-300' : 'text-ink-500',
              ]}
            >
              {tf}
            </span>
          ))}
        </div>
      </div>

      <CandlestickChart class="mt-3 h-40 w-full text-white" width={560} height={200} animate />

      <!-- indicator row -->
      <div class="mt-3 flex items-center gap-4 border-t border-white/5 pt-3 font-mono text-[0.65rem] text-ink-400">
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent-400"></span>EMA 9</span>
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-brand-400"></span>up</span>
        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-rose-400"></span>down</span>
        <span class="ml-auto">RSI <span class="text-brand-300">58.3</span></span>
      </div>
    </div>
  </div>

  <!-- Floating order-book widget -->
  <div
    class="absolute -bottom-6 -left-6 hidden w-52 rotate-[-3deg] rounded-xl border border-white/10 bg-ink-800/90 p-3 shadow-xl shadow-black/50 backdrop-blur-sm sm:block"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between font-mono text-[0.65rem] text-ink-400">
      <span>ETH-PERP · Deribit</span>
      <span class="text-emerald-400">●</span>
    </div>
    <div class="mt-2 space-y-1">
      {[
        ['bid', '3,842.5', 'text-emerald-400', '78%'],
        ['ask', '3,843.0', 'text-rose-400', '52%'],
        ['bid', '3,842.0', 'text-emerald-400', '34%'],
      ].map(([side, px, color, w]) => (
        <div class="relative flex items-center justify-between overflow-hidden rounded px-2 py-1 font-mono text-[0.65rem]">
          <span class:list={['absolute inset-y-0 left-0 opacity-10', color.replace('text-', 'bg-')]} style={`width:${w}`}></span>
          <span class="relative text-ink-300">{side}</span>
          <span class:list={['relative', color]}>{px}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Floating signal chip -->
  <div
    class="absolute -right-4 -top-5 hidden rotate-[2.5deg] items-center gap-2.5 rounded-xl border border-white/10 bg-ink-800/90 px-3.5 py-2.5 shadow-xl shadow-black/50 backdrop-blur-sm lg:flex"
    aria-hidden="true"
  >
    <span class="flex size-7 items-center justify-center rounded-lg bg-brand-500/15 text-brand-300">
      <Icon name="bolt" class="size-3.5" />
    </span>
    <div class="font-mono text-[0.65rem] leading-tight">
      <p class="text-ink-300">EURUSD · alert</p>
      <p class="text-emerald-400">crossed 1.0850 ▲</p>
    </div>
  </div>
</div>

<script>
  let typedObserver: IntersectionObserver | null = null;

  function initWidgetTyped() {
    typedObserver?.disconnect();
    typedObserver = null;

    const typed = document.querySelector<HTMLElement>('[data-typed]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!typed || reduced) return;

    const text = typed.dataset.text ?? '';
    typedObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        typedObserver?.disconnect();
        typedObserver = null;
        typed.textContent = '';
        let i = 0;
        const tick = () => {
          typed.textContent = text.slice(0, ++i);
          if (i < text.length) setTimeout(tick, 18 + Math.random() * 40);
        };
        setTimeout(tick, 350);
      },
      { threshold: 0.4 },
    );
    typedObserver.observe(typed);
  }

  document.addEventListener('astro:page-load', initWidgetTyped);
</script>
