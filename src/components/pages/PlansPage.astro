---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { localizePath } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import Faq from '../sections/Faq.astro';
import CtaBand from '../sections/CtaBand.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).plansPage;
const localize = (href: string) => (href.startsWith('/') ? localizePath(href, lang) : href);

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: t.meta.title,
  itemListElement: t.tiers.map((tier) => ({
    '@type': 'Offer',
    name: tier.name,
    description: tier.tagline,
    price: tier.priceMonthly === 'Custom' || tier.priceMonthly === 'A medida' || tier.priceMonthly === 'Sur mesure' ? '0' : tier.priceMonthly.replace(/[^0-9.]/g, '') || '0',
    priceCurrency: 'USD',
  })),
};
---

<Layout
  lang={lang}
  route="/plans"
  title={t.meta.title}
  description={t.meta.description}
  schema={[offerSchema]}
  theme="dark"
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-950 pt-32 pb-10 text-white sm:pt-40">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="glow-brand absolute -top-24 left-1/2 size-[680px] -translate-x-1/2 opacity-30 blur-2xl"></div>
      <div class="bg-grid absolute inset-0 opacity-50 [mask-image:radial-gradient(70%_55%_at_50%_10%,black,transparent)]"></div>
    </div>
    <div class="container-page relative text-center">
      <span class="eyebrow inline-flex items-center gap-2 text-brand-400">
        <span class="h-px w-6 bg-brand-400/50"></span>
        {t.hero.badge}
        <span class="h-px w-6 bg-brand-400/50"></span>
      </span>
      <h1 class="mx-auto mt-4 max-w-3xl font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl md:text-6xl">
        {t.hero.title}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-ink-300">{t.hero.subtitle}</p>
    </div>
  </section>

  <!-- Coming soon notice -->
  <div class="container-page pb-8">
    <p class="reveal mx-auto flex max-w-2xl items-start gap-3 rounded-2xl border border-brand-500/20 bg-brand-500/5 px-5 py-4 text-sm leading-relaxed text-ink-300">
      <Icon name="sparkles" class="mt-0.5 size-4 shrink-0 text-brand-400" />
      <span>{t.comingSoon}</span>
    </p>
  </div>

  <!-- Highlights -->
  <section class="bg-ink-950 pb-12 text-white">
    <div class="container-page">
      <h2 class="reveal text-center font-display text-2xl font-semibold text-white sm:text-3xl">{t.highlights.title}</h2>
      <div class="reveal-stagger mt-10 grid gap-4 sm:grid-cols-3">
        {
          t.highlights.items.map((item) => (
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-brand-500/10 text-brand-400 ring-1 ring-brand-500/20">
                <Icon name={item.icon} class="size-5" />
              </span>
              <h3 class="mt-4 font-display text-lg font-semibold text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-400">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Billing toggle -->
  <div id="plans-billing" data-mode="monthly" class="container-page flex justify-center bg-ink-950 pb-8 text-white">
    <div class="inline-flex items-center rounded-full border border-white/10 bg-white/5 p-1">
      <button
        type="button"
        data-billing="monthly"
        aria-pressed="true"
        class="rounded-full px-5 py-2 text-sm font-medium text-ink-300 transition-colors aria-[pressed=true]:bg-white aria-[pressed=true]:text-ink-950"
      >
        {t.billing.monthly}
      </button>
      <button
        type="button"
        data-billing="yearly"
        aria-pressed="false"
        class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium text-ink-300 transition-colors aria-[pressed=true]:bg-white aria-[pressed=true]:text-ink-950"
      >
        {t.billing.yearly}
        <span class="rounded-full bg-brand-500/20 px-1.5 py-0.5 font-mono text-[0.6rem] text-brand-300">{t.billing.save}</span>
      </button>
    </div>
  </div>

  <!-- Plan cards -->
  <section class="bg-ink-950 pb-16 text-white">
    <div class="container-page">
      <div class="reveal-stagger grid items-start gap-5 lg:grid-cols-4">
        {
          t.tiers.map((tier) => {
            const featured = tier.featured;
            const isExternal = tier.ctaHref.startsWith('http') || tier.ctaHref.startsWith('mailto');
            return (
              <div
                class:list={[
                  'relative flex flex-col rounded-3xl border p-7',
                  featured
                    ? 'border-transparent bg-white/[0.06] shadow-2xl shadow-brand-500/10 ring-1 ring-brand-500/40 lg:-mt-4 lg:mb-4'
                    : 'border-white/10 bg-white/[0.02]',
                ]}
              >
                {featured && tier.badge && (
                  <span class="absolute -top-3 left-7 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-brand-500 to-accent-500 px-3 py-1 text-xs font-semibold text-white">
                    <Icon name="sparkles" class="size-3.5" /> {tier.badge}
                  </span>
                )}
                <div class="flex items-center justify-between gap-2">
                  <h3 class="font-display text-xl font-semibold text-white">{tier.name}</h3>
                  {!featured && tier.badge && (
                    <span class="rounded-full bg-accent-500/15 px-2 py-0.5 font-mono text-[0.6rem] font-medium uppercase tracking-wider text-accent-300">
                      {tier.badge}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-sm text-ink-400">{tier.tagline}</p>

                <div class="mt-5 flex items-baseline gap-1.5">
                  <span class="font-display text-4xl font-bold text-white">
                    <span data-price="monthly">{tier.priceMonthly}</span>
                    <span data-price="yearly" class="hidden">{tier.priceYearly}</span>
                  </span>
                  {tier.cadence && <span class="text-sm text-ink-500">{tier.cadence}</span>}
                </div>
                <p data-billed class="mt-1 hidden font-mono text-[0.7rem] text-ink-500">{tier.billedYearly ?? ' '}</p>

                {tier.stats && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {tier.stats.map((s) => (
                      <span class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-0.5 font-mono text-[0.65rem] text-ink-300">{s}</span>
                    ))}
                  </div>
                )}

                <a
                  href={localize(tier.ctaHref)}
                  target={isExternal ? '_blank' : undefined}
                  rel={isExternal ? 'noopener noreferrer' : undefined}
                  class:list={[
                    'mt-6 inline-flex h-11 items-center justify-center rounded-full px-5 text-sm font-medium transition-all hover:-translate-y-0.5',
                    featured
                      ? 'bg-brand-600 text-white hover:bg-brand-500'
                      : 'bg-white/10 text-white ring-1 ring-white/15 hover:bg-white/15',
                  ]}
                >
                  {tier.cta}
                </a>

                {tier.note && <p class="mt-6 text-xs font-medium text-ink-400">{tier.note}</p>}
                <ul class="mt-3 space-y-3">
                  {tier.features.map((f) => (
                    <li class="flex items-start gap-2.5 text-sm">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-brand-400" />
                      <span class="text-ink-300">{f}</span>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Included in every plan -->
  <section class="border-t border-white/5 bg-ink-950 py-16 text-white">
    <div class="container-page">
      <h2 class="reveal text-center font-display text-xl font-semibold text-white sm:text-2xl">{t.included.title}</h2>
      <ul class="reveal-stagger mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-x-8 gap-y-3">
        {
          t.included.items.map((item) => (
            <li class="flex items-center gap-2 text-sm text-ink-300">
              <Icon name="check" class="size-4 shrink-0 text-brand-400" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq lang={lang} items={t.faq} eyebrow="FAQ" title={t.faqTitle} subtitle="" tone="dark" />
  <CtaBand lang={lang} />
</Layout>

<script>
  const root = document.getElementById('plans-billing');
  if (root) {
    const scope = root.closest('main') ?? document;
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-billing]');
    const apply = (mode: string) => {
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.billing === mode)));
      scope.querySelectorAll<HTMLElement>('[data-price="monthly"]').forEach((el) => el.classList.toggle('hidden', mode !== 'monthly'));
      scope.querySelectorAll<HTMLElement>('[data-price="yearly"]').forEach((el) => el.classList.toggle('hidden', mode !== 'yearly'));
      scope.querySelectorAll<HTMLElement>('[data-billed]').forEach((el) => el.classList.toggle('hidden', mode !== 'yearly'));
    };
    btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.billing ?? 'monthly')));
  }
</script>
