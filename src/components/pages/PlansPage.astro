---
/**
 * /plans — the whole commercial story, in the order people ask it:
 *
 *   pick a tier → see every difference → understand the game layer that comes
 *   free with all of them → learn what a credit is → what is included → FAQ.
 *
 * The reputation / badge / reward stretch is one dark stage in the middle; it is
 * the part of the product that is hardest to explain in a bullet, so it gets the
 * interactive treatment (a live points simulator and 34 flippable badges).
 */
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { getPageBadgeIcon } from '../../i18n/page-badge-icons';
import { LEVELS, TOTAL_REWARD_CREDITS, TOTAL_REWARD_TOKENS, ALL_BADGES } from '../../data/gamification';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import PlanTiers from '../sections/PlanTiers.astro';
import PlanMatrix from '../sections/PlanMatrix.astro';
import ReputationLab from '../sections/ReputationLab.astro';
import BadgeVault from '../sections/BadgeVault.astro';
import RewardLedger from '../sections/RewardLedger.astro';
import CreditEconomy from '../sections/CreditEconomy.astro';
import Faq from '../sections/Faq.astro';
import CtaBand from '../sections/CtaBand.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const t = c.plansPage;

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: t.meta.title,
  itemListElement: t.tiers.map((tier) => ({
    '@type': 'Offer',
    name: tier.name,
    description: tier.tagline,
    price:
      tier.priceMonthly === 'Custom' || tier.priceMonthly === 'A medida' || tier.priceMonthly === 'Sur mesure'
        ? '0'
        : tier.priceMonthly.replace(/[^0-9.]/g, '') || '0',
    priceCurrency: 'USD',
  })),
};

// Plan FAQ structured data (SEO / GEO), mirroring the home page's FAQPage.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

// The four numbers that make the game layer concrete, teased right under the
// hero so nobody has to scroll to learn it exists.
const teasers = [
  { icon: 'award', value: ALL_BADGES.length, label: c.rewards.badges.unit },
  { icon: 'trophy', value: LEVELS.length, label: c.rewards.levels.unit },
  { icon: 'coins', value: TOTAL_REWARD_CREDITS, label: c.rewards.ledger.creditsLabel, soon: true },
  { icon: 'vault', value: TOTAL_REWARD_TOKENS, label: c.rewards.ledger.tokensLabel, soon: true },
];

const sections = [
  { id: 'tiers', label: t.hero.badge },
  { id: 'compare', label: t.matrix.eyebrow },
  { id: 'rewards', label: c.rewards.eyebrow },
  { id: 'credits', label: c.rewards.credits.eyebrow },
  { id: 'faq', label: t.faqTitle },
  { id: 'cta', label: c.home.cta.primary },
];
---

<Layout
  lang={lang}
  route="/plans"
  title={t.meta.title}
  description={t.meta.description}
  schema={[offerSchema, faqSchema]}
  sections={sections}
>
  <PageHero badge={t.hero.badge} icon={getPageBadgeIcon('/plans')} title={t.hero.title} subtitle={t.hero.subtitle} />

  <!-- Game-layer teaser: the reward numbers, above the fold-ish. -->
  <div class="container-page -mt-6 pb-8">
    <a
      href="#rewards"
      class="reveal group mx-auto flex max-w-3xl flex-wrap items-center justify-center gap-x-8 gap-y-4 rounded-2xl border border-ink-900/10 bg-white px-6 py-5 shadow-sm shadow-ink-950/[0.03] transition-colors hover:border-brand-500/30"
    >
      {
        teasers.map((item) => (
          <span class="flex items-center gap-2.5">
            <Icon name={item.icon} class="size-4 shrink-0 text-brand-600" />
            <span class="flex flex-col leading-tight">
              <span class="font-display text-lg font-bold tabular-nums text-ink-950">
                {item.value.toLocaleString(lang)}
              </span>
              <span class="flex items-center gap-1.5 text-[0.7rem] uppercase tracking-wider text-ink-500">
                {item.label}
                {item.soon && (
                  <span class="rounded-full bg-accent-500/10 px-1.5 font-mono text-[0.55rem] font-medium text-accent-600">
                    {c.rewards.planned}
                  </span>
                )}
              </span>
            </span>
          </span>
        ))
      }
      <span class="flex items-center gap-1.5 text-sm font-medium text-brand-700 transition-transform group-hover:translate-x-0.5">
        {c.rewards.eyebrow}
        <Icon name="arrow" class="size-4" />
      </span>
    </a>
  </div>

  <PlanTiers lang={lang} />

  <!-- Highlights -->
  <section class="pb-12">
    <div class="container-page">
      <h2 class="reveal text-center font-display text-2xl font-semibold text-ink-950 sm:text-3xl">{t.highlights.title}</h2>
      <div class="reveal-stagger mt-10 grid gap-4 sm:grid-cols-3">
        {
          t.highlights.items.map((item) => (
            <div class="rounded-2xl border border-ink-900/10 bg-white p-6 shadow-sm">
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-500/15">
                <Icon name={item.icon} class="size-5" />
              </span>
              <h3 class="mt-4 font-display text-lg font-semibold text-ink-950">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Coming soon notice -->
  <div class="container-page pb-8">
    <p class="reveal mx-auto flex max-w-2xl items-start gap-3 rounded-2xl border border-brand-500/20 bg-brand-50 px-5 py-4 text-sm leading-relaxed text-ink-600">
      <Icon name="sparkles" class="mt-0.5 size-4 shrink-0 text-brand-600" />
      <span>{t.comingSoon}</span>
    </p>
  </div>

  <PlanMatrix lang={lang} />

  <!-- The game layer: reputation → badges → rewards, on one dark stage. -->
  <div id="rewards" class="scroll-mt-20">
    <ReputationLab lang={lang} />
    <BadgeVault lang={lang} />
    <RewardLedger lang={lang} />
  </div>

  <CreditEconomy lang={lang} />

  <!-- Included in every plan -->
  <section class="border-t border-ink-900/8 bg-ink-50 py-16">
    <div class="container-page">
      <h2 class="reveal text-center font-display text-xl font-semibold text-ink-950 sm:text-2xl">{t.included.title}</h2>
      <ul class="reveal-stagger mx-auto mt-8 flex max-w-3xl flex-wrap justify-center gap-x-8 gap-y-3">
        {
          t.included.items.map((item) => (
            <li class="flex items-center gap-2 text-sm text-ink-600">
              <Icon name="check" class="size-4 shrink-0 text-brand-500" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq lang={lang} items={t.faq} title={t.faqTitle} subtitle="" group="plans-faq" />
  <CtaBand lang={lang} />
</Layout>
