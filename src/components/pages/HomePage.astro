---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { CONNECTOR_LIVE_COUNT } from '../../data/connectors';
import Layout from '../../layouts/Layout.astro';
import Hero from '../sections/Hero.astro';
import World from '../world/World.astro';
import ActWidget from '../acts/ActWidget.astro';
import ActCanvas from '../acts/ActCanvas.astro';
import ActConnectors from '../acts/ActConnectors.astro';
import ActBots from '../acts/ActBots.astro';
import ActAgents from '../acts/ActAgents.astro';
import ActUseCases from '../acts/ActUseCases.astro';
import Features from '../sections/Features.astro';
import Privacy from '../sections/Privacy.astro';
import Plans from '../sections/Plans.astro';
import RewardsTeaser from '../sections/RewardsTeaser.astro';
import Faq from '../sections/Faq.astro';
import CtaBand from '../sections/CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const t = c.home;

// Structured data for SEO + GEO (LLM answer engines).
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  url: SITE.url,
  description: t.meta.description,
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '69.99',
    priceCurrency: 'USD',
    offerCount: c.plansPage.tiers.length,
  },
  featureList: [
    ...(t.features.groups?.flatMap((g) => g.items.map((f) => f.title)) ??
      t.features.items.map((f) => f.title)),
    `${CONNECTOR_LIVE_COUNT} ${t.connectors.countLabel}`,
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: lang,
};

/**
 * Right-rail stops. One per act plus the two ends — thirteen entries used to
 * collide with the hero mock below 1620px, and a rail that lists every band is
 * a symptom of a page built out of bands.
 */
const acts = t.acts;
const sections = [
  { id: 'hero', label: t.hero.titleLead.replace(/\.$/, '') },
  { id: 'widget', label: acts?.widget.eyebrow ?? 'Say it' },
  { id: 'app-showcase', label: acts?.canvas.eyebrow ?? 'Arrange it' },
  { id: 'connectors', label: acts?.connectors.eyebrow ?? 'Wire it' },
  { id: 'automate', label: acts?.bots.eyebrow ?? 'Watch it' },
  { id: 'bots-agents', label: acts?.agents.eyebrow ?? 'Reason about it' },
  { id: 'use-cases', label: acts?.useCases.eyebrow ?? 'Point it anywhere' },
  { id: 'plans', label: t.plans.eyebrow },
];
---

<Layout
  lang={lang}
  route="/"
  title={t.meta.title}
  description={t.meta.description}
  schema={[websiteSchema, softwareSchema, faqSchema]}
  sections={sections}
  world
>
  {/*
    One continuous dark interior, opening on the hero rather than below it. The
    scenes run without a heading cadence or a band between them on purpose —
    that repetition is what made this page read as a longer version of /about.
    Order is load-bearing: `WorldField` maps scene *i* to formation *i*.
  */}
  <World>
    <Hero lang={lang} />
    <ActWidget lang={lang} />
    <ActCanvas lang={lang} />
    <ActConnectors lang={lang} />
    <ActBots lang={lang} />
    <ActAgents lang={lang} />
    <ActUseCases lang={lang} />
  </World>

  {/* Inverted: the opposite theme to the page, so the first section after the
      world is a hard band — dark on light, light on dark. See `.tone-invert` in
      global.css. `RewardsTeaser` further down is a permanent dark band, which
      gives the light theme its second one without two dark blocks touching. */}
  <div class="tone-invert">
    <Features lang={lang} />
  </div>
  <Privacy lang={lang} />
  <Plans lang={lang} />
  <RewardsTeaser lang={lang} />
  <Faq lang={lang} group="home-faq" />
  <CtaBand lang={lang} />
</Layout>
