---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { CONNECTOR_LIVE_COUNT } from '../../data/connectors';
import Layout from '../../layouts/Layout.astro';
import Hero from '../sections/Hero.astro';
import World from '../world/World.astro';
import PlaygroundSpan from '../acts/PlaygroundSpan.astro';
import ActConnectors from '../acts/ActConnectors.astro';
import ActBots from '../acts/ActBots.astro';
import ActAgents from '../acts/ActAgents.astro';
import ActDao from '../acts/ActDao.astro';
import ActUseCases from '../acts/ActUseCases.astro';
import Features from '../sections/Features.astro';
import Privacy from '../sections/Privacy.astro';
import Plans from '../sections/Plans.astro';
import RewardsTeaser from '../sections/RewardsTeaser.astro';
import Faq from '../sections/Faq.astro';
import CtaBand from '../sections/CtaBand.astro';
import Footer from '../Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const t = c.home;

// Structured data for SEO + GEO (LLM answer engines).
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  url: SITE.url,
  description: t.meta.description,
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '69.99',
    priceCurrency: 'USD',
    offerCount: c.plansPage.tiers.length,
  },
  featureList: [
    ...(t.features.groups?.flatMap((g) => g.items.map((f) => f.title)) ??
      t.features.items.map((f) => f.title)),
    `${CONNECTOR_LIVE_COUNT} ${t.connectors.countLabel}`,
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: lang,
};

/**
 * Right-rail stops: one per story act, then the later rooms, then the footer.
 * Labels are chrome ("Hero", "DAO"), not the scene headlines — those already
 * sit in the copy. Below 1620px the rail parks the words and shows them on
 * hover, so a longer list does not print over the hero mock.
 */
const rail = t.rail;
const sections = [
  { id: 'hero', label: rail?.hero ?? 'Hero' },
  { id: 'widget', label: rail?.widget ?? 'Widget' },
  { id: 'app-showcase', label: rail?.canvas ?? 'Canvas' },
  { id: 'connectors', label: rail?.connectors ?? 'Connectors' },
  { id: 'automate', label: rail?.bots ?? 'Bots' },
  { id: 'bots-agents', label: rail?.agents ?? 'Agents' },
  { id: 'dao', label: rail?.dao ?? 'DAO' },
  { id: 'use-cases', label: rail?.useCases ?? 'Use cases' },
  { id: 'features', label: rail?.features ?? 'Features' },
  { id: 'privacy', label: rail?.privacy ?? 'Privacy' },
  { id: 'plans', label: rail?.plans ?? 'Plans' },
  { id: 'rewards', label: rail?.rewards ?? 'Rewards' },
  { id: 'faq', label: rail?.faq ?? 'FAQ' },
  { id: 'footer', label: rail?.footer ?? 'Footer' },
];
---

<Layout
  lang={lang}
  route="/"
  title={t.meta.title}
  description={t.meta.description}
  schema={[websiteSchema, softwareSchema, faqSchema]}
  sections={sections}
  world
>
  {/*
    One continuous interior, opening on the hero and never leaving the room.
    The scenes run without a heading cadence or a band between them on purpose.
    Order is load-bearing: `WorldField` maps scene *i* to formation *i*.
  */}
  <World>
    <Hero lang={lang} />
    <PlaygroundSpan lang={lang} />
    <ActConnectors lang={lang} />
    <ActBots lang={lang} />
    <ActAgents lang={lang} />
    <ActDao lang={lang} />
    {/* Two opposite-tone rooms, not a stripe every other scene. The page
        theme holds from the hero through the ledger; this invert is the
        mid-page breath (the horizon, then the atelier). Privacy through
        FAQ comes back to the page, then the close inverts again. */}
    <div class="tone-invert">
      <ActUseCases lang={lang} />
      <Features lang={lang} />
    </div>
    <Privacy lang={lang} />
    <Plans lang={lang} />
    <RewardsTeaser lang={lang} />
    <Faq lang={lang} group="home-faq" appear />
    <div class="tone-invert">
      <CtaBand lang={lang} appear />
      <div data-world-scene class="world-close">
        <Footer />
      </div>
    </div>
  </World>
</Layout>
