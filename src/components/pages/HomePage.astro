---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../sections/Hero.astro';
import TickerTape from '../sections/TickerTape.astro';
import Stats from '../sections/Stats.astro';
import Showcase from '../sections/Showcase.astro';
import Features from '../sections/Features.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import Automate from '../sections/Automate.astro';
import Connectors from '../sections/Connectors.astro';
import Network from '../sections/Network.astro';
import Privacy from '../sections/Privacy.astro';
import Plans from '../sections/Plans.astro';
import Roadmap from '../sections/Roadmap.astro';
import Faq from '../sections/Faq.astro';
import CtaBand from '../sections/CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const t = c.home;

// Structured data for SEO + GEO (LLM answer engines).
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  url: SITE.url,
  description: t.meta.description,
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '0',
    highPrice: '69.99',
    priceCurrency: 'USD',
    offerCount: c.plansPage.tiers.length,
  },
  featureList: [
    ...t.features.items.map((f) => f.title),
    ...t.automate.items.map((i) => i.title),
    ...t.network.items.map((i) => i.title),
    `${t.connectors.count}+ ${t.connectors.countLabel}`,
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: lang,
};
---

<Layout
  lang={lang}
  route="/"
  title={t.meta.title}
  description={t.meta.description}
  schema={[websiteSchema, softwareSchema, faqSchema]}
  theme="dark"
>
  <Hero lang={lang} />
  <TickerTape lang={lang} />
  <Stats lang={lang} />
  <Showcase lang={lang} />
  <Features lang={lang} />
  <HowItWorks lang={lang} />
  <Automate lang={lang} />
  <Connectors lang={lang} tone="dark" />
  <Network lang={lang} />
  <Privacy lang={lang} />
  <Plans lang={lang} />
  <Roadmap lang={lang} />
  <Faq lang={lang} tone="dark" />
  <CtaBand lang={lang} />
</Layout>
