---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = useContent(lang).privacyPage;
---

<Layout lang={lang} route="/privacy" title={copy.meta.title} description={copy.meta.description}>
  <PageHero badge={copy.badge} title={copy.title} subtitle={copy.subtitle} />

  <section class="container-page pb-24">
    <div class="mx-auto max-w-2xl">
      <p class="font-mono text-sm text-ink-500">{copy.updated}</p>
      <div class="mt-8 space-y-10">
        {
          copy.sections.map((s) => (
            <div class="reveal">
              <h2 class="font-display text-xl font-semibold text-ink-950">{s.h}</h2>
              <p class="mt-3 leading-relaxed text-ink-600">{s.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
