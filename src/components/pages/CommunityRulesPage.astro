---
/**
 * /community-rules — the house rules for the feed, the marketplace and the
 * automations. Written to be read once and remembered: a three-line summary,
 * eight rules with their own animated glyph, the rules bots have to follow,
 * the enforcement ladder, and where to send a report or an appeal.
 *
 * Every list is index-aligned with the art (see `CommunityRulesPageContent`),
 * so locales translate wording and never reorder entries.
 */
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { getPageBadgeIcon } from '../../i18n/page-badge-icons';
import { localizePath } from '../../i18n/utils';
import { signupAppUrl } from '../../lib/appDeepLinks';
import Layout from '../../layouts/Layout.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import FeatureCard from '../FeatureCard.astro';
import RuleGlyph from '../RuleGlyph.astro';
import RulesScene from '../RulesScene.astro';
import EnforcementLadder from '../EnforcementLadder.astro';
import CtaBand from '../sections/CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).communityRulesPage;
const badgeIcon = getPageBadgeIcon('/community-rules');

/**
 * Glyph per rule, in `rules.items` order. Locale-neutral on purpose: a
 * translation swaps the words, never which picture belongs to which rule.
 */
const RULE_KINDS = [
  'ship',
  'lineage',
  'label',
  'claims',
  'sandbox',
  'limits',
  'listing',
  'respect',
] as const;

/** The summary trio reuses three rule glyphs — useful, honest, human. */
const TLDR_KINDS = ['ship', 'lineage', 'respect'] as const;

/** Report goes through the contact form; appeals reply to the support inbox. */
const REPORT_HREFS = [localizePath('/contact', lang), `mailto:${SITE.supportEmail}`];

/** Legal rail, in `report.legal` order. */
const LEGAL_HREFS = ['/terms', '/acceptable-use', '/privacy'];

const sections = [
  { id: 'hero', label: t.hero.badge },
  { id: 'tldr', label: t.tldr.eyebrow },
  { id: 'rules', label: t.rules.eyebrow },
  { id: 'bots', label: t.bots.eyebrow },
  { id: 'enforcement', label: t.enforcement.eyebrow },
  { id: 'report', label: t.report.eyebrow },
  { id: 'cta', label: t.cta.primary },
];
---

<Layout
  lang={lang}
  route="/community-rules"
  title={t.meta.title}
  description={t.meta.description}
  sections={sections}
>
  <!-- Hero -->
  <section id="hero" class="relative scroll-mt-20 overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-24">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="absolute inset-0 opacity-20 [mask-image:radial-gradient(62%_52%_at_50%_6%,black,transparent)]"
        style="background-image:linear-gradient(to right, color-mix(in oklab, var(--color-brand-300) 10%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in oklab, var(--color-brand-300) 10%, transparent) 1px, transparent 1px); background-size:64px 64px"
      >
      </div>
      <div class="aurora-mesh absolute inset-[-10%]"></div>
    </div>

    <div class="container-page relative text-center">
      <span
        class="enter inline-flex items-center gap-1.5 rounded-full border border-brand-300/40 bg-brand-50/90 px-3 py-1 font-mono text-xs font-medium uppercase tracking-wider text-brand-700 backdrop-blur dark:border-white/8 dark:bg-brand-400/12 dark:text-brand-300"
        style="--enter-delay:0.05s"
      >
        {badgeIcon && <Icon name={badgeIcon} class="size-3.5 shrink-0" />}
        {t.hero.badge}
      </span>
      <h1 class="mx-auto mt-8 max-w-4xl text-center font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink-950 sm:mt-9 sm:text-5xl md:text-6xl dark:text-white">
        <span class="block" data-text-appear data-text-appear-delay="0.12">{t.hero.titleLead}</span>
        <span class="block text-gradient-live" data-text-appear data-text-appear-delay="0.22">
          {t.hero.titleGradient}
        </span>
        <span
          class="mt-2 block text-2xl text-ink-500 sm:text-3xl md:text-4xl dark:text-ink-400"
          data-text-appear
          data-text-appear-delay="0.32"
        >
          <span aria-hidden="true">— </span>{t.hero.titleTail}
        </span>
      </h1>
      <p
        class="enter mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300"
        style="--enter-delay:0.42s"
      >
        {t.hero.subtitle}
      </p>
      <div class="enter mt-10 flex flex-wrap items-center justify-center gap-3" style="--enter-delay:0.52s">
        <Button href="#rules" size="lg" variant="gradient" iconRight="arrow">{t.hero.ctaPrimary}</Button>
        <Button href={localizePath('/contact', lang)} variant="secondary" size="lg" icon="megaphone">
          {t.hero.ctaSecondary}
        </Button>
      </div>
      <p class="enter mt-6 font-mono text-xs text-ink-500 dark:text-ink-400" style="--enter-delay:0.6s">
        {t.hero.updated}
      </p>

      <div class="enter mt-14 sm:mt-16" style="--enter-delay:0.68s">
        <RulesScene />
      </div>
    </div>
    <div class="hairline-gold absolute inset-x-0 bottom-0"></div>
  </section>

  <!-- The short version -->
  <section id="tldr" class="relative scroll-mt-20 overflow-hidden py-20 sm:py-28">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="animate-glow absolute top-1/2 -right-40 size-[420px] -translate-y-1/2 blur-2xl glow-brand"></div>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow={t.tldr.eyebrow}
        title={t.tldr.title}
        subtitle={t.tldr.subtitle}
        gradientTitle
        class="mx-auto"
      />
      <ul class="reveal-stagger mx-auto mt-14 grid max-w-5xl gap-5 sm:grid-cols-3">
        {
          t.tldr.items.map((item, i) => (
            <li class="group relative overflow-hidden rounded-3xl border border-ink-900/8 bg-white p-6 shadow-sm shadow-ink-950/[0.03] transition-all duration-300 hover:-translate-y-1 hover:border-brand-300/50 hover:shadow-lg hover:shadow-brand-500/10 dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40">
              <RuleGlyph kind={TLDR_KINDS[i] ?? 'ship'} />
              <h3 class="mt-5 font-display text-lg font-semibold text-ink-950 dark:text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- The rules -->
  <section
    id="rules"
    class="relative scroll-mt-20 overflow-hidden border-y border-brand-100/80 bg-[#f7fbfb]/70 py-24 sm:py-32 dark:border-white/8 dark:bg-white/[0.015]"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="animate-glow absolute top-1/3 -left-40 size-[460px] blur-2xl glow-brand"></div>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow={t.rules.eyebrow}
        title={t.rules.title}
        subtitle={t.rules.subtitle}
        gradientTitle
        class="mx-auto"
      />
      <ol class="reveal-stagger mx-auto mt-16 grid max-w-6xl gap-5 lg:grid-cols-2">
        {
          t.rules.items.map((rule, i) => (
            <li class="group relative flex gap-5 overflow-hidden rounded-3xl border border-ink-900/8 bg-white p-6 shadow-sm shadow-ink-950/[0.03] transition-all duration-300 hover:-translate-y-1 hover:border-brand-300/50 hover:shadow-lg hover:shadow-brand-500/10 sm:p-7 dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40">
              <span
                class="pointer-events-none absolute -top-4 right-2 font-display text-7xl font-semibold text-brand-500/[0.07] transition-colors duration-300 group-hover:text-brand-500/[0.13] dark:text-white/[0.05] dark:group-hover:text-brand-300/10"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <RuleGlyph kind={RULE_KINDS[i] ?? 'ship'} class="mt-1" />
              <div class="relative min-w-0">
                <h3 class="font-display text-lg font-semibold text-ink-950 sm:text-xl dark:text-white">
                  {rule.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-600 sm:text-base dark:text-ink-300">{rule.body}</p>
                <p class="mt-4 flex items-start gap-2 font-mono text-xs leading-relaxed text-brand-700 dark:text-brand-300">
                  <span aria-hidden="true" class="select-none opacity-60">//</span>
                  {rule.note}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Automations -->
  <section id="bots" class="relative scroll-mt-20 overflow-hidden py-24 sm:py-32">
    <div class="container-page relative">
      <SectionHeading
        eyebrow={t.bots.eyebrow}
        title={t.bots.title}
        subtitle={t.bots.subtitle}
        gradientTitle
        class="mx-auto"
      />
      <div class="reveal-stagger mx-auto mt-16 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {t.bots.items.map((item) => <FeatureCard icon={item.icon} title={item.title} body={item.body} />)}
      </div>
    </div>
  </section>

  <!-- Enforcement -->
  <section
    id="enforcement"
    class="relative scroll-mt-20 overflow-hidden border-y border-brand-100/80 bg-[#f7fbfb]/70 py-24 sm:py-32 dark:border-white/8 dark:bg-white/[0.015]"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="animate-glow absolute bottom-0 right-0 size-[420px] blur-2xl glow-accent"></div>
    </div>
    <div class="container-page relative">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
        <div class="reveal min-w-0" data-motion="slide-l">
          <SectionHeading
            eyebrow={t.enforcement.eyebrow}
            title={t.enforcement.title}
            subtitle={t.enforcement.subtitle}
            align="left"
            gradientTitle
            class="max-w-xl"
          />
          <ol class="mt-11 space-y-5">
            {
              t.enforcement.steps.map((step) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 font-mono text-xs font-semibold text-brand-700 ring-1 ring-brand-200/80 dark:bg-brand-400/12 dark:text-brand-300 dark:ring-brand-400/25">
                    {step.n}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-display text-base font-semibold text-ink-950 dark:text-white">{step.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="mt-9 flex items-start gap-3 rounded-2xl border border-brand-200/70 bg-brand-50/60 p-4 text-sm leading-relaxed text-ink-700 dark:border-brand-400/20 dark:bg-brand-400/[0.07] dark:text-ink-300">
            <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-white text-brand-700 ring-1 ring-brand-200/80 dark:bg-white/10 dark:text-brand-300 dark:ring-brand-400/25">
              <Icon name="shield" class="size-3.5" />
            </span>
            {t.enforcement.note}
          </p>
        </div>
        <div class="reveal min-w-0" data-motion="slide-r">
          <div class="rounded-3xl border border-ink-900/8 bg-white/80 p-6 shadow-sm shadow-ink-950/[0.03] backdrop-blur sm:p-8 dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40">
            <EnforcementLadder />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reports & appeals -->
  <section id="report" class="relative scroll-mt-20 overflow-hidden py-24 sm:py-32">
    <div class="container-page relative">
      <SectionHeading
        eyebrow={t.report.eyebrow}
        title={t.report.title}
        subtitle={t.report.subtitle}
        gradientTitle
        class="mx-auto"
      />
      <div class="reveal-stagger mx-auto mt-14 grid max-w-4xl gap-5 sm:grid-cols-2">
        {
          t.report.cards.map((card, i) => (
            <div class="group flex flex-col rounded-3xl border border-ink-900/8 bg-white p-7 shadow-sm shadow-ink-950/[0.03] transition-all duration-300 hover:-translate-y-1 hover:border-brand-300/50 hover:shadow-lg hover:shadow-brand-500/10 dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40">
              <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 ring-1 ring-brand-200/80 dark:bg-brand-400/12 dark:text-brand-300 dark:ring-brand-400/25">
                <Icon name={i === 0 ? 'megaphone' : 'scroll'} class="size-5" />
              </span>
              <h3 class="mt-5 font-display text-lg font-semibold text-ink-950 dark:text-white">{card.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{card.body}</p>
              <div class="mt-6">
                <Button
                  href={REPORT_HREFS[i] ?? localizePath('/contact', lang)}
                  variant={i === 0 ? 'primary' : 'secondary'}
                  size="sm"
                  iconRight="arrow"
                >
                  {card.cta}
                </Button>
              </div>
            </div>
          ))
        }
      </div>

      <div class="reveal mx-auto mt-16 max-w-4xl rounded-3xl border border-ink-900/8 bg-[#f7fbfb]/80 p-7 sm:p-8 dark:border-white/10 dark:bg-white/[0.03]">
        <h3 class="font-mono text-xs uppercase tracking-widest text-ink-500 dark:text-ink-400">
          {t.report.legalTitle}
        </h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-3">
          {
            t.report.legal.map((doc, i) => (
              <li>
                <a
                  href={localizePath(LEGAL_HREFS[i] ?? '/legal', lang)}
                  class="group flex h-full flex-col rounded-2xl border border-transparent bg-white/70 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-300/50 hover:bg-white dark:bg-white/[0.03] dark:hover:border-brand-400/30 dark:hover:bg-white/[0.06]"
                >
                  <span class="flex items-center gap-2 font-display text-sm font-semibold text-ink-950 group-hover:text-brand-800 dark:text-white dark:group-hover:text-brand-300">
                    {doc.label}
                    <Icon name="arrow" class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5" />
                  </span>
                  <span class="mt-1.5 text-xs leading-relaxed text-ink-600 dark:text-ink-400">{doc.body}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBand
    lang={lang}
    title={t.cta.title}
    subtitle={t.cta.subtitle}
    primary={t.cta.primary}
    primaryHref={signupAppUrl()}
    primaryIcon="rocket"
    secondary={t.cta.secondary}
    secondaryHref={localizePath('/community', lang)}
  />
</Layout>
