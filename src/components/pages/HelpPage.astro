---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { getPageBadgeIcon } from '../../i18n/page-badge-icons';
import { localizePath } from '../../i18n/utils';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../sections/CtaBand.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const t = c.helpPage!;
const localize = (href: string) =>
  href.startsWith('/') ? localizePath(href, lang) : href;

const sections = [
  { id: 'guides', label: t.hero.badge },
  { id: 'cta', label: t.cta },
];
---

<Layout lang={lang} route="/help" title={t.meta.title} description={t.meta.description} sections={sections}>
  <PageHero
    badge={t.hero.badge}
    icon={getPageBadgeIcon('/help')}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
  />

  <section id="guides" class="container-page scroll-mt-20 pb-16">
    <div class="reveal-stagger mx-auto grid max-w-5xl gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.guides.map((g) => {
          const external = g.href.startsWith('http');
          return (
            <a
              href={localize(g.href)}
              class="group flex flex-col rounded-2xl border border-ink-900/10 bg-white p-6 shadow-sm shadow-ink-950/[0.03] transition-colors hover:border-brand-500/30 dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40 dark:hover:border-brand-400/30"
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="inline-flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-500/15 dark:bg-brand-400/12 dark:text-brand-300 dark:ring-brand-400/25">
                <Icon name={g.icon} class="size-5" />
              </span>
              <h2 class="mt-4 font-display text-lg font-semibold text-ink-950 dark:text-white">{g.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{g.body}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 transition-transform group-hover:translate-x-0.5 dark:text-brand-300">
                {g.cta}
                <Icon name="arrow" class="size-3.5" />
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <CtaBand
    lang={lang}
    title={t.ctaTitle}
    subtitle={t.ctaBody}
    primary={t.cta}
    primaryHref={localizePath('/contact', lang)}
    secondary={c.nav.launch}
    secondaryHref={SITE.appUrl}
  />
</Layout>
