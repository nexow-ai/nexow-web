---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import Faq from '../sections/Faq.astro';
import CtaBand from '../sections/CtaBand.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).pricing;
---

<Layout lang={lang} route="/pricing" title={t.meta.title} description={t.meta.description}>
  <PageHero badge={t.hero.badge} title={t.hero.title} subtitle={t.hero.subtitle} />

  <section class="container-page pb-12">
    <div class="reveal-stagger grid items-start gap-6 lg:grid-cols-3">
      {
        t.tiers.map((tier) => {
          const featured = tier.featured;
          const isExternal = tier.ctaHref.startsWith('http');
          return (
            <div
              class:list={[
                'relative flex flex-col rounded-3xl border p-8',
                featured
                  ? 'border-transparent bg-ink-950 text-white shadow-2xl shadow-ink-950/30 ring-1 ring-brand-500/30 lg:-mt-4 lg:mb-4'
                  : 'border-ink-900/10 bg-white',
              ]}
            >
              {featured && (
                <span class="absolute -top-3 left-8 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-brand-500 to-accent-500 px-3 py-1 text-xs font-semibold text-white">
                  <Icon name="sparkles" class="size-3.5" /> {tier.tagline}
                </span>
              )}
              <h3 class:list={['font-display text-xl font-semibold', featured ? 'text-white' : 'text-ink-950']}>
                {tier.name}
              </h3>
              {!featured && <p class="mt-1 text-sm text-ink-500">{tier.tagline}</p>}
              <div class="mt-5 flex items-baseline gap-2">
                <span class:list={['font-display text-4xl font-bold', featured ? 'text-white' : 'text-ink-950']}>
                  {tier.price}
                </span>
                {tier.cadence && (
                  <span class:list={['text-sm', featured ? 'text-ink-400' : 'text-ink-500']}>
                    {tier.cadence}
                  </span>
                )}
              </div>

              <a
                href={tier.ctaHref}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class:list={[
                  'mt-6 inline-flex h-11 items-center justify-center rounded-full px-5 text-sm font-medium transition-all hover:-translate-y-0.5',
                  featured
                    ? 'bg-white text-ink-950 hover:bg-white/90'
                    : 'bg-brand-600 text-white hover:bg-brand-500',
                ]}
              >
                {tier.cta}
              </a>

              <ul class="mt-8 space-y-3">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm">
                    <Icon
                      name="check"
                      class:list={['mt-0.5 size-4 shrink-0', featured ? 'text-brand-400' : 'text-brand-500']}
                    />
                    <span class={featured ? 'text-ink-200' : 'text-ink-700'}>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>

  <Faq lang={lang} items={t.faq} eyebrow="FAQ" title={t.faqTitle} subtitle="" />
  <CtaBand lang={lang} />
</Layout>
