---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { getPageBadgeIcon } from '../../i18n/page-badge-icons';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import FeatureCard from '../FeatureCard.astro';
import CtaBand from '../sections/CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).about;

const sections = [
  { id: 'hero', label: t.hero.badge },
  { id: 'mission', label: t.missionTitle },
  { id: 'values', label: t.valuesTitle },
  { id: 'cta', label: t.cta },
];
---

<Layout lang={lang} route="/about" title={t.meta.title} description={t.meta.description} sections={sections}>
  <PageHero badge={t.hero.badge} icon={getPageBadgeIcon('/about')} title={t.hero.title} subtitle={t.hero.subtitle} />

  <section id="mission" class="container-page scroll-mt-20 py-12 sm:py-16">
    <div class="reveal mx-auto max-w-3xl">
      <h2 class="font-display text-2xl font-semibold text-ink-950 sm:text-3xl dark:text-white">{t.missionTitle}</h2>
      <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink-600 dark:text-ink-300">
        {t.mission.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="values" class="container-page scroll-mt-20 py-16 sm:py-20">
    <h2 class="reveal text-center font-display text-2xl font-semibold text-ink-950 sm:text-3xl dark:text-white">
      {t.valuesTitle}
    </h2>
    <div class="reveal-stagger mx-auto mt-12 grid max-w-5xl gap-5 sm:grid-cols-2">
      {t.values.map((v) => <FeatureCard icon={v.icon} title={v.title} body={v.body} />)}
    </div>
  </section>

  <CtaBand lang={lang} title={t.ctaTitle} subtitle={t.ctaBody} primary={t.cta} primaryIcon="rocket" />
</Layout>
