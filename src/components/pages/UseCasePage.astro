---
import { type Lang } from '../../i18n/config';
import { useContent, type UseCaseLandingContent } from '../../i18n/content';
import { getPageBadgeIcon } from '../../i18n/page-badge-icons';
import { localizePath } from '../../i18n/utils';
import { promptAppUrl } from '../../lib/appDeepLinks';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import CtaBand from '../sections/CtaBand.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import AppVideo from '../AppVideo.astro';

interface Props {
  lang: Lang;
  slug: 'traders' | 'founders' | 'builders';
}
const { lang, slug } = Astro.props;
const pages = useContent(lang).useCasePages!;
const t: UseCaseLandingContent = pages[slug];
const route = `/for/${slug}`;
const appHref = promptAppUrl(t.prompt);
const secondaryHref =
  slug === 'traders'
    ? localizePath('/connectors', lang)
    : slug === 'founders'
      ? `${localizePath('/', lang)}#app-showcase`
      : localizePath('/community', lang);

const sections = [
  { id: 'prompt', label: t.hero.badge },
  { id: 'cta', label: t.ctaPrimary },
];
---

<Layout lang={lang} route={route} title={t.meta.title} description={t.meta.description} sections={sections}>
  <PageHero
    badge={t.hero.badge}
    icon={getPageBadgeIcon(route)}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
  />

  {
    t.video && (
      <section class="container-page pb-10">
        <div class="mx-auto max-w-4xl">
          <AppVideo slug={t.video.slug} alt={t.video.alt} frame="browser" title="nexow" eager>
            {t.video.caption}
          </AppVideo>
        </div>
      </section>
    )
  }

  <section id="prompt" class="container-page scroll-mt-20 pb-12">
    <div class="reveal mx-auto max-w-2xl">
      <div class="rounded-2xl border border-ink-900/10 bg-white p-5 shadow-sm sm:p-6 dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40">
        <p class="font-mono text-[0.65rem] uppercase tracking-widest text-ink-400">Try this prompt</p>
        <p class="mt-3 font-mono text-sm leading-relaxed text-ink-700 sm:text-base dark:text-ink-300">{t.prompt}</p>
        <div class="mt-5">
          <Button href={appHref} size="md" external iconRight="arrow">
            {t.ctaPrimary}
          </Button>
        </div>
      </div>

      {
        t.steps && (
          <ol class="mt-10 grid gap-3 sm:grid-cols-3">
            {t.steps.map((s, i) => (
              <li class="rounded-xl border border-ink-900/10 p-4 text-sm leading-relaxed text-ink-700 dark:border-white/10 dark:text-ink-300">
                <span class="font-mono text-xs text-brand-700 dark:text-brand-300">0{i + 1}</span>
                <p class="mt-1.5">{s}</p>
              </li>
            ))}
          </ol>
        )
      }

      <ul class="mt-10 space-y-4">
        {
          t.points.map((p) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-700 sm:text-base dark:text-ink-300">
              <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 ring-1 ring-brand-200/80 dark:bg-brand-400/12 dark:text-brand-300 dark:ring-brand-400/25">
                <Icon name="check" class="size-3.5" />
              </span>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    lang={lang}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    primary={t.ctaPrimary}
    primaryHref={appHref}
    secondary={t.ctaSecondary}
    secondaryHref={secondaryHref}
  />
</Layout>
