---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import PlaygroundMock from '../PlaygroundMock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.hero;
---

<section class="relative overflow-hidden bg-[#f7fbfb] pt-32 pb-14 text-ink-950 sm:pt-40 sm:pb-18">
  <!-- Backdrop: soft workspace wash + quiet grid -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="aurora-a absolute -top-48 left-[4%] h-[620px] w-[620px] rounded-full opacity-35 blur-3xl"
      style="background:radial-gradient(circle at 42% 40%, color-mix(in oklab, var(--color-brand-200) 72%, white), transparent 68%)"
    >
    </div>
    <div
      class="aurora-b absolute -top-36 right-[0%] h-[680px] w-[680px] rounded-full opacity-28 blur-3xl"
      style="background:radial-gradient(circle at 60% 40%, color-mix(in oklab, var(--color-sky-200) 70%, white), transparent 68%)"
    >
    </div>
    <div
      data-motion="sink-lg"
      class="absolute inset-0 opacity-45 [mask-image:radial-gradient(80%_60%_at_50%_16%,black,transparent)]"
      style="background-image:linear-gradient(to right, color-mix(in oklab, var(--color-brand-300) 13%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in oklab, var(--color-sky-300) 12%, transparent) 1px, transparent 1px); background-size:56px 56px"
    ></div>
    <div class="hairline-gold absolute inset-x-0 bottom-0 opacity-60"></div>
  </div>

  <div class="container-page relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
      <!-- Copy -->
      <div class="max-w-xl">
        <a
          href={SITE.appUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 rounded-full border border-brand-200/80 bg-white/75 py-1.5 pl-2 pr-3.5 text-sm font-medium text-ink-600 shadow-sm backdrop-blur transition-colors hover:border-brand-300"
        >
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 px-2 py-0.5 text-xs font-semibold text-brand-700">
            <span class="size-1.5 animate-pulse rounded-full bg-brand-500"></span>
            {t.badge}
          </span>
          <Icon name="arrow" class="size-3.5 text-ink-400 transition-transform group-hover:translate-x-0.5" />
        </a>

        <h1 class="mt-7 font-display text-5xl font-semibold leading-[1.04] tracking-tight text-ink-950 sm:text-6xl lg:text-[4.1rem]">
          {t.titleLead}<br />
          <span class="text-gradient">{t.titleGradient}</span><br />
          {t.titleTail}
        </h1>

        <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-600">
          {t.subtitle}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href={SITE.appUrl} size="lg" external iconRight="arrow">
            {t.ctaPrimary}
          </Button>
          <Button href="#app-showcase" variant="secondary" size="lg" icon="sparkles">
            {t.ctaSecondary}
          </Button>
        </div>

        <p class="mt-7 font-mono text-xs leading-relaxed text-ink-500">
          {t.note}
        </p>
      </div>

      <!-- Product mock -->
      <div class="reveal lg:pl-4">
        <div data-motion="tilt-lg rise depth" style="--m-persp:1100px">
          <PlaygroundMock promptExample={t.promptExample} />
        </div>
      </div>
    </div>
  </div>
</section>
