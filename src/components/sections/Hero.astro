---
/**
 * Scene 0 of the world — the opening beat, not a landing-page hero.
 *
 * The old one carried a badge, a three-line headline, a kicker, a forty-word
 * subtitle, a composer, a label, twelve example chips, a "more" chip, a second
 * CTA, a trust note and a full product mock, on a light gradient wash. That is
 * eleven things competing for one screen, and none of them won.
 *
 * What is left is what the reader actually needs before they scroll: the
 * headline, the promise, one thing to type into, a ring of live SVG
 * dashboards, a row of starter chips, and a way down. The composer cycles
 * through those examples so the opening screen keeps showing what “anything”
 * looks like. Everything else is still on the page — the product is shown
 * six times over in the acts below.
 *
 * The composer is not decoration. Typing into it charges the matter behind the
 * headline (`data-world-charge`, read by `WorldField`), and sending throws a
 * shockwave through it (`nexow:world-send`), so the one interaction in the hero
 * is also the page's thesis: your words give the material a shape.
 *
 * Follows the page theme. Most of the world does too — only the mid-page
 * breath and the close invert, so the room is mainly one tone with two
 * contrast beats rather than a stripe every other scene.
 */
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { promptAppUrl } from '../../lib/appDeepLinks';
import Icon from '../Icon.astro';
import SocialLinks from '../SocialLinks.astro';
import HeroDashboards from './HeroDashboards.astro';

/** Icon → dashboard scene in HeroDashboards. Locale-agnostic. */
const SCENE_BY_ICON: Record<string, string> = {
  candlestick: 'trading',
  lineChart: 'portfolio',
  radar: 'geo',
  cloudSun: 'orbit',
  grid: 'network',
  flame: 'neural',
  newspaper: 'news',
  rocket: 'avionics',
  activity: 'signals',
  earth: 'macro',
  target: 'predict',
  wallet: 'portfolio',
  play: 'go',
  music: 'video',
  databaseZap: 'onchain',
  database: 'database',
  heart: 'signals',
  mapPin: 'flights',
  creditCard: 'portfolio',
  github: 'ai',
  users: 'chat',
  sun: 'energy',
  monitor: 'tv',
  banknote: 'forex',
  hourglass: 'math',
  pen: 'ai',
  signal: 'signals',
  wheat: 'sports',
  trophy: 'chess',
  layers: 'model3d',
  gem: 'metals',
  factory: 'metals',
  server: 'server',
  cpu: 'server',
  bot: 'bots',
  chat: 'chat',
  youtube: 'tv',
};

/** First row of chips; the rest sit behind “more”. */
const HERO_EXAMPLES_VISIBLE = 10;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.hero;
const defaultPromptUrl = promptAppUrl(t.promptExample);
/** Two sentences stay two lines, even when the viewport could fit one. */
const title = t.title.includes('\n')
  ? t.title
  : t.title.replace(/^(.+?[.!?。．])\s+/, '$1\n');

const examples = t.promptExamples ?? [];
const extraCount = Math.max(0, examples.length - HERO_EXAMPLES_VISIBLE);

/** Entrance order. The headline leads, everything else follows it up. */
const D = {
  title: '0.10s',
  kicker: '0.28s',
  forge: '0.40s',
  examples: '0.52s',
  note: '0.64s',
  socials: '0.72s',
  cue: '0.80s',
};
---

<section id="hero" class="hero" data-world-scene aria-labelledby="hero-title">
  {/* A soft well of ink under the type. The matter passes behind the headline
      at full strength; without this the brightest instances cross the glyphs
      and the first line of the page becomes the least readable thing on it. */}
  <div class="hero__veil" aria-hidden="true"></div>
  <HeroDashboards />

  <div class="container-page hero__inner">
    <h1
      id="hero-title"
      class="hero__title"
      data-text-appear
      data-text-appear-delay={D.title}
    >
      {title}
    </h1>

    {
      t.titleKicker && (
        <p class="enter hero__kicker" style={`--enter-delay:${D.kicker}`}>
          {t.titleKicker}
        </p>
      )
    }

    <!-- Live prompt → app: deep-links with ?prompt= (see appDeepLinks.promptAppUrl). -->
    <form
      id="forge"
      class="enter hero__forge"
      style={`--enter-delay:${D.forge}`}
      data-app-base={SITE.appUrl}
      action={defaultPromptUrl}
      method="get"
      target="_blank"
    >
      <label class="sr-only" for="hero-prompt">{t.promptPlaceholder}</label>
      <div class="hero__composer">
        <Icon name="sparkles" />
        <textarea
          id="hero-prompt"
          name="prompt"
          rows="1"
          maxlength="500"
          placeholder={t.promptPlaceholder}
          data-world-charge
          class="hero__input"
        >{t.promptExample}</textarea>
        <button type="submit" class="hero__send">
          <span>{t.ctaPrimary}</span>
          <Icon name="rocket" />
        </button>
      </div>
    </form>

    {
      examples.length > 0 && (
        <div
          class="enter hero__examples"
          style={`--enter-delay:${D.examples}`}
          role="group"
          aria-label={t.promptExamplesLabel ?? t.promptPlaceholder}
        >
          {examples.map((example, i) => (
            <button
              type="button"
              data-prompt-example
              data-prompt={example.prompt}
              data-hero-scene={SCENE_BY_ICON[example.icon] ?? 'ai'}
              aria-pressed="false"
              title={example.prompt}
              class:list={['hero__chip', i >= HERO_EXAMPLES_VISIBLE && 'hero__chip--extra']}
            >
              <Icon name={example.icon} />
              {example.label}
            </button>
          ))}
          {extraCount > 0 && (
            <button
              type="button"
              class="hero__more"
              data-hero-more
              aria-expanded="false"
            >
              {t.promptExamplesMore ?? 'More examples'}
              <span class="hero__more-count">+{extraCount}</span>
            </button>
          )}
        </div>
      )
    }

    <p class="enter hero__note" style={`--enter-delay:${D.note}`}>{t.note}</p>

    <div class="enter hero__socials" style={`--enter-delay:${D.socials}`}>
      <SocialLinks landmark={false} label="Follow Nexow" />
    </div>
  </div>

  <a class="enter hero__cue" href="#widget" style={`--enter-delay:${D.cue}`}>
    <span class="hero__cue-label">{t.ctaSecondary}</span>
    <span class="hero__cue-rail" aria-hidden="true"><span class="hero__cue-dot"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* svh, not vh: on iOS the collapsing address bar makes `100vh` taller than
     * the screen, which pushes the scroll cue below the fold on the one screen
     * where it has a job to do. */
    min-height: 100svh;
    overflow-x: clip;
    overflow-y: visible;
    padding-block: 9rem max(7rem, calc(5.5rem + env(safe-area-inset-bottom, 0px)));
    color: var(--w-text);
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Two layers. The ellipse holds the headline; the vertical wash carries
     * that protection down over the composer, the chips and the note, which
     * the ellipse alone left sitting on bare screens.
     *
     * Both are deliberately weak. At full strength they hid the matter they
     * were meant to sit in front of, and the opening screen lost the one thing
     * it is there to show. The type keeps its own protection below. */
    background:
      radial-gradient(
        62% 46% at 50% 40%,
        color-mix(in oklab, var(--w-surface) 52%, transparent),
        color-mix(in oklab, var(--w-surface) 26%, transparent) 50%,
        transparent 80%
      ),
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in oklab, var(--w-surface) 20%, transparent) 24%,
        color-mix(in oklab, var(--w-surface) 24%, transparent) 76%,
        transparent
      );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__title {
    width: 100%;
    max-width: 24ch;
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 0.5rem + 6.4vw, 4.5rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-align: center;
    /* Honor the forced break after the first sentence. Global `h1` balance
       would otherwise keep both on one line once the font fits. */
    white-space: pre-line;
    text-wrap: unset;
    color: var(--w-text);
    /* Carries the readability the veil used to buy with opacity, but only
       where there are glyphs, so the matter stays visible around them. */
    text-shadow: 0 2px 26px color-mix(in oklab, var(--w-surface) 82%, transparent);
  }

  .hero__kicker {
    width: 100%;
    max-width: 36rem;
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.86rem + 0.6vw, 1.3rem);
    font-weight: 400;
    text-align: center;
    /* ink-200 on ink-950 measures well clear of AA; the muted token does not. */
    color: var(--w-text-2);
    text-shadow: 0 1px 18px color-mix(in oklab, var(--w-surface) 80%, transparent);
  }

  /* ---- composer ---- */

  .hero__forge {
    width: min(100%, 42rem);
    margin-top: 2.6rem;
  }

  .hero__composer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1px solid var(--w-line);
    border-radius: 1.15rem;
    background: var(--w-panel);
    box-shadow: 0 24px 60px -30px var(--w-shadow);
    transition:
      border-color 0.3s var(--ease-out-expo),
      box-shadow 0.3s var(--ease-out-expo);
  }

  .hero__composer:focus-within {
    border-color: color-mix(in oklab, var(--color-brand-400) 55%, transparent);
    box-shadow:
      0 24px 60px -30px var(--w-shadow),
      0 0 0 1px color-mix(in oklab, var(--color-brand-400) 35%, transparent);
  }

  /* `Icon.astro` renders the svg, so it never carries this file's scope hash and
   * a class passed to <Icon> would not match. Reach it structurally instead —
   * which is also why every icon rule here is a child selector. */
  .hero__composer > :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--w-accent);
  }

  .hero__input {
    flex: 1 1 auto;
    min-width: 0;
    /* Two lines reserved so cycling prompts of different lengths do not
       shove the chips. Script still grows past this up to max-height. */
    min-height: 2.85rem;
    max-height: 7.5rem;
    padding-block: 0.55rem;
    border: 0;
    background: transparent;
    color: var(--w-text-3);
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: start;
    resize: none;
    overflow-y: auto;
    transition:
      opacity 0.38s var(--ease-out-expo),
      filter 0.38s var(--ease-out-expo),
      transform 0.38s var(--ease-out-expo);
  }

  .hero__input.is-swap {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(5px);
  }

  .hero__input::placeholder {
    color: var(--w-text-4);
  }

  .hero__input:focus {
    outline: none;
  }

  .hero__send {
    display: inline-flex;
    flex: none;
    align-items: center;
    align-self: stretch;
    gap: 0.5rem;
    padding-inline: 1.15rem;
    border-radius: 0.85rem;
    background: linear-gradient(100deg, var(--grad-a), var(--grad-b) 52%, var(--grad-c));
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: filter 0.2s var(--ease-out-expo), transform 0.2s var(--ease-out-expo);
  }

  .hero__send:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .hero__send > :global(svg) {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.2s var(--ease-out-expo);
  }

  .hero__send:hover > :global(svg) {
    transform: translate(1px, -2px);
  }

  /* Below 30rem the button under the field beats a button squeezed beside it. */
  @media (max-width: 30rem) {
    .hero__composer {
      flex-direction: column;
      align-items: stretch;
      padding: 0.85rem;
    }
    .hero__composer > :global(svg) {
      display: none;
    }
    .hero__send {
      justify-content: center;
      min-height: 2.75rem;
      padding-block: 0.75rem;
    }
  }

  /* ---- starter prompts ---- */

  .hero__examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    max-width: 48rem;
  }

  .hero__examples:not(.is-open) .hero__chip--extra {
    display: none;
  }

  .hero__examples.is-open .hero__more {
    display: none;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--w-line);
    border-radius: 999px;
    background: var(--w-panel-2);
    color: var(--w-text-2);
    font-size: 0.78rem;
    font-weight: 500;
    transition:
      border-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo),
      transform 0.2s var(--ease-out-expo);
  }

  .hero__chip:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-brand-400) 45%, transparent);
    color: var(--w-text);
  }

  .hero__chip[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--color-brand-400) 60%, transparent);
    background: color-mix(in oklab, var(--color-brand-400) 14%, transparent);
    color: var(--w-text);
  }

  .hero__chip > :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    flex: none;
    color: var(--w-accent);
  }

  .hero__more {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px dashed color-mix(in oklab, var(--color-brand-400) 45%, var(--w-line));
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-brand-400) 8%, var(--w-panel-2));
    color: var(--w-text-2);
    font-size: 0.78rem;
    font-weight: 500;
    transition:
      border-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo),
      transform 0.2s var(--ease-out-expo);
  }

  .hero__more:hover {
    transform: translateY(-2px);
    color: var(--w-text);
  }

  .hero__more-count {
    color: var(--w-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .hero__note {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--w-text-4);
    text-shadow: 0 1px 14px color-mix(in oklab, var(--w-surface) 80%, transparent);
  }

  .hero__socials {
    margin-top: 1.35rem;
  }

  /* ---- the way down ---- */

  .hero__cue {
    position: absolute;
    z-index: 1;
    inset-inline: 0;
    bottom: max(2rem, calc(1.15rem + env(safe-area-inset-bottom, 0px)));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    color: var(--w-text-4);
    transition: color 0.25s var(--ease-out-expo);
  }

  .hero__cue:hover {
    color: var(--w-text);
  }

  .hero__cue-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__cue-rail {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: linear-gradient(to bottom, var(--w-rail), transparent);
  }

  .hero__cue-dot {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 0.9rem;
    background: linear-gradient(to bottom, transparent, var(--color-brand-400));
    animation: hero-cue 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes hero-cue {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(275%);
      opacity: 0;
    }
  }

  /* The cue is the one thing here that loops. Under reduced motion it holds
     still rather than disappearing — it is navigation, not decoration. */
  @media (prefers-reduced-motion: reduce) {
    .hero__cue-dot {
      animation: none;
      top: 35%;
      opacity: 1;
    }
  }

  @media (max-width: 767.98px) {
    .hero {
      justify-content: flex-start;
      padding-block: 6.5rem max(3.25rem, calc(2.25rem + env(safe-area-inset-bottom, 0px)));
    }

    .hero__forge {
      margin-top: 1.6rem;
    }

    .hero__kicker {
      margin-top: 1.1rem;
    }

    /* In flow, not pinned over the socials — on a phone the cue used to land
       on the last row of marks. */
    .hero__cue {
      position: static;
      margin-top: 1.75rem;
    }

    .hero__cue-rail {
      height: 1.85rem;
    }

    .hero__socials {
      margin-top: 1.1rem;
    }

    .hero__note {
      margin-top: 1.25rem;
    }
  }

  @media (min-width: 768px) and (pointer: fine) {
    .hero__chip,
    .hero__more {
      min-height: 0;
      padding: 0.4rem 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__input,
    .hero__input.is-swap {
      transition: none;
      filter: none;
      transform: none;
      opacity: 1;
    }
  }

  /* Short viewports (landscape phones) cannot afford a full-height opening.
     Drop the cue and let the hero be as tall as its content. */
  @media (max-height: 40rem) {
    .hero {
      min-height: 0;
      padding-block: 6.5rem 2.5rem;
    }
    .hero__cue-rail {
      display: none;
    }
  }

  @media (max-height: 34rem) {
    .hero__cue {
      display: none;
    }
  }
</style>

<script>
  function initHeroForge() {
    const form = document.getElementById('forge') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const base = (form.dataset.appBase || 'https://x.nexow.ai').replace(/\/$/, '');
    const input = form.querySelector<HTMLTextAreaElement>('#hero-prompt');
    if (!input) return;

    /** `/?signup&prompt=…` — mirrors appDeepLinks.promptAppUrl (bare `signup` flag). */
    const promptUrl = (prompt: string) => {
      const params = new URLSearchParams();
      params.set('signup', '');
      if (prompt) params.set('prompt', prompt);
      const qs = params
        .toString()
        .split('&')
        .map((part) => (part.endsWith('=') ? part.slice(0, -1) : part))
        .join('&');
      return `${base}/?${qs}`;
    };

    /** One line at rest, growing to the CSS max-height as the prompt does. */
    const autosize = () => {
      input.style.height = 'auto';
      input.style.height = `${input.scrollHeight}px`;
    };

    const syncLinks = () => {
      form.action = promptUrl(input.value.trim());
    };

    const chips = Array.from(form.parentElement?.querySelectorAll<HTMLButtonElement>('[data-prompt-example]') ?? []);
    const examplesRoot = form.parentElement?.querySelector<HTMLElement>('.hero__examples');
    const more = examplesRoot?.querySelector<HTMLButtonElement>('[data-hero-more]');
    const boards = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-board]'));
    const boardIds = boards.map((board) => board.dataset.heroBoard ?? '').filter(Boolean);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const markActive = (active: HTMLButtonElement | null) => {
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip === active)));
    };

    const applyBoards = (scene: string) => {
      if (!boards.length || !boardIds.length) return;
      const current = boardIds.includes(scene) ? scene : boardIds[0];
      const start = boardIds.indexOf(current);
      const shown = [0, 1, 2, 3].map((offset) => boardIds[(start + offset) % boardIds.length]);
      boards.forEach((board) => {
        const id = board.dataset.heroBoard ?? '';
        const slot = shown.indexOf(id);
        const on = slot !== -1;
        board.classList.toggle('is-shown', on);
        board.classList.toggle('is-current', id === current);
        if (on) board.dataset.slot = String(slot);
        else board.removeAttribute('data-slot');
      });
    };

    const applyPrompt = (prompt: string, scene: string, chip: HTMLButtonElement | null) => {
      input.value = prompt;
      markActive(chip);
      applyBoards(scene);
      syncLinks();
      autosize();
      input.dispatchEvent(new Event('input', { bubbles: true }));
    };

    more?.addEventListener('click', () => {
      examplesRoot?.classList.add('is-open');
      more.setAttribute('aria-expanded', 'true');
    });

    let cycleTimer = 0;
    let swapping = false;
    let paused = false;
    let dirty = false;
    /** Start before chip 0 so the first tick lands on the first visible example. */
    let index = -1;

    const wait = (ms: number) => new Promise<void>((resolve) => window.setTimeout(resolve, ms));

    const showChip = async (next: number, animate: boolean) => {
      const chip = chips[next];
      if (!chip || swapping) return;
      index = next;
      const prompt = chip.dataset.prompt ?? '';
      const scene = chip.dataset.heroScene ?? 'ai';
      if (animate && !reduced) {
        swapping = true;
        input.classList.add('is-swap');
        await wait(280);
        applyPrompt(prompt, scene, chip);
        input.classList.remove('is-swap');
        swapping = false;
      } else {
        applyPrompt(prompt, scene, chip);
      }
    };

    const armCycle = () => {
      window.clearTimeout(cycleTimer);
      if (reduced || paused || dirty || document.hidden || !chips.length) return;
      cycleTimer = window.setTimeout(() => {
        void showChip((index + 1) % chips.length, true).then(armCycle);
      }, 3200 + Math.random() * 1800);
    };

    chips.forEach((chip, i) => {
      chip.addEventListener('click', () => {
        dirty = false;
        paused = true;
        window.clearTimeout(cycleTimer);
        void showChip(i, true).then(() => {
          input.focus({ preventScroll: true });
          const prompt = chip.dataset.prompt ?? '';
          input.setSelectionRange(prompt.length, prompt.length);
        });
      });
    });

    input.addEventListener('focus', () => {
      paused = true;
      window.clearTimeout(cycleTimer);
    });

    input.addEventListener('blur', () => {
      paused = false;
      if (!dirty) armCycle();
    });

    input.addEventListener('input', () => {
      if (swapping) return;
      const value = input.value.trim();
      const match = chips.find((chip) => chip.dataset.prompt === value) ?? null;
      dirty = !match;
      markActive(match);
      if (match) {
        index = chips.indexOf(match);
        applyBoards(match.dataset.heroScene ?? 'ai');
      }
      syncLinks();
      autosize();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      document.dispatchEvent(new CustomEvent('nexow:world-send'));
      window.open(promptUrl(input.value.trim()), '_blank', 'noopener,noreferrer');
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearTimeout(cycleTimer);
      else if (!paused && !dirty) armCycle();
    });

    const seed = chips.find((chip) => chip.dataset.prompt === input.value.trim());
    applyBoards(seed?.dataset.heroScene ?? 'ai');
    markActive(seed ?? null);
    autosize();
    window.addEventListener('resize', autosize);
    armCycle();
  }

  document.addEventListener('astro:page-load', initHeroForge);
</script>
