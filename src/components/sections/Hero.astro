---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import WidgetMock from '../WidgetMock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.hero;
---

<section class="relative overflow-hidden bg-ink-950 pt-32 pb-16 text-white sm:pt-40 sm:pb-24">
  <!-- Backdrop: aurora blobs + grid + noise -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="aurora-a absolute -top-40 left-[8%] h-[560px] w-[560px] rounded-full opacity-25 blur-3xl"
      style="background:radial-gradient(circle at 40% 40%, var(--color-brand-500), transparent 65%)"
    >
    </div>
    <div
      class="aurora-b absolute -top-24 right-[4%] h-[640px] w-[640px] rounded-full opacity-20 blur-3xl"
      style="background:radial-gradient(circle at 60% 40%, var(--color-accent-500), transparent 65%)"
    >
    </div>
    <div class="bg-grid absolute inset-0 opacity-60 [mask-image:radial-gradient(75%_60%_at_50%_20%,black,transparent)]"></div>
    <div class="bg-noise absolute inset-0 opacity-[0.35] mix-blend-overlay"></div>
    <!-- Horizon hairline -->
    <div class="hairline-glow absolute inset-x-0 bottom-0"></div>
  </div>

  <div class="container-page relative">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
      <!-- Copy -->
      <div class="max-w-xl">
        <a
          href={SITE.appUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 py-1.5 pl-2 pr-3.5 text-sm font-medium text-ink-200 backdrop-blur transition-colors hover:border-brand-400/40"
        >
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500/15 px-2 py-0.5 text-xs font-semibold text-brand-300">
            <span class="size-1.5 animate-pulse rounded-full bg-brand-400"></span>
            {t.badge}
          </span>
          <Icon name="arrow" class="size-3.5 text-ink-400 transition-transform group-hover:translate-x-0.5" />
        </a>

        <h1 class="mt-7 font-display text-5xl font-semibold leading-[1.04] tracking-tight text-white sm:text-6xl lg:text-[4.1rem]">
          {t.titleLead}<br />
          <span class="text-gradient">{t.titleGradient}</span><br />
          {t.titleTail}
        </h1>

        <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-300">
          {t.subtitle}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href={SITE.appUrl} size="lg" external iconRight="arrow">
            {t.ctaPrimary}
          </Button>
          <Button href="#showcase" variant="outline" size="lg" icon="chart">
            {t.ctaSecondary}
          </Button>
        </div>

        <p class="mt-7 font-mono text-xs leading-relaxed text-ink-500">
          {t.note}
        </p>
      </div>

      <!-- Product mock -->
      <div class="reveal lg:pl-4">
        <WidgetMock promptExample={t.promptExample} promptPlaceholder={t.promptPlaceholder} />
      </div>
    </div>
  </div>
</section>
