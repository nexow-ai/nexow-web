---
/**
 * Scene 0 of the world — the opening beat, not a landing-page hero.
 *
 * The old one carried a badge, a three-line headline, a kicker, a forty-word
 * subtitle, a composer, a label, twelve example chips, a "more" chip, a second
 * CTA, a trust note and a full product mock, on a light gradient wash. That is
 * eleven things competing for one screen, and none of them won.
 *
 * What is left is what the reader actually needs before they scroll: the
 * headline, the promise, one thing to type into, four examples of what to type,
 * and a way down. Everything cut is still on the page — the product is shown
 * six times over in the acts below, which is where showing it belongs.
 *
 * The composer is not decoration. Typing into it charges the matter behind the
 * headline (`data-world-charge`, read by `WorldField`), and sending throws a
 * shockwave through it (`nexow:world-send`), so the one interaction in the hero
 * is also the page's thesis: your words give the material a shape.
 *
 * Dark in both themes — see `World.astro` for why.
 */
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { promptAppUrl } from '../../lib/appDeepLinks';
import Icon from '../Icon.astro';
import SocialLinks from '../SocialLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.hero;
const defaultPromptUrl = promptAppUrl(t.promptExample);

/** Four starter prompts, not twelve. A wall of chips is a menu, not an example. */
const examples = (t.promptExamples ?? []).slice(0, 4);

/** Entrance order. The headline leads, everything else follows it up. */
const D = {
  line1: '0.10s',
  line2: '0.20s',
  lineWatch: '0.28s',
  line3: '0.40s',
  kicker: '0.58s',
  forge: '0.70s',
  examples: '0.80s',
  note: '0.90s',
  socials: '0.96s',
  cue: '1.02s',
};
---

<section id="hero" class="hero" data-world-scene aria-labelledby="hero-title">
  {/* A soft well of ink under the type. The matter passes behind the headline
      at full strength; without this the brightest instances cross the glyphs
      and the first line of the page becomes the least readable thing on it. */}
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="container-page hero__inner">
    <h1 id="hero-title" class="hero__title">
      {/* Four beats, four hues: gold for the proverb, red→orange for the
          build line, cyan for the lit hero, magenta for the close. Each
          drifts on its own clock so they never lock into one wash. */}
      <span class="hero__line hero__grad hero__grad--oil" data-text-appear data-text-appear-delay="0.10">{t.titleLead}</span>{' '}
      <span class="hero__line hero__grad hero__grad--use" data-text-appear data-text-appear-delay="0.20">{t.titleGradient}</span>{' '}
      {
        t.titleWatch && (
          <span
            class="hero__line hero__grad hero__grad--watch"
            data-text={t.titleWatch}
            data-text-appear
            data-text-appear-delay="0.28"
          >
            {t.titleWatch}
          </span>
        )
      }{' '}
      <span class="hero__line hero__grad hero__grad--act" data-text-appear data-text-appear-delay={t.titleWatch ? '0.40' : '0.30'}>{t.titleTail}</span>
    </h1>

    {
      t.titleKicker && (
        <p class="enter hero__kicker" style={`--enter-delay:${D.kicker}`}>
          {t.titleKicker}
        </p>
      )
    }

    <!-- Live prompt → app: deep-links with ?prompt= (see appDeepLinks.promptAppUrl). -->
    <form
      id="forge"
      class="enter hero__forge"
      style={`--enter-delay:${D.forge}`}
      data-app-base={SITE.appUrl}
      action={defaultPromptUrl}
      method="get"
      target="_blank"
    >
      <label class="sr-only" for="hero-prompt">{t.promptPlaceholder}</label>
      <div class="hero__composer">
        <Icon name="sparkles" />
        <textarea
          id="hero-prompt"
          name="prompt"
          rows="1"
          maxlength="500"
          placeholder={t.promptPlaceholder}
          data-world-charge
          class="hero__input"
        >{t.promptExample}</textarea>
        <button type="submit" class="hero__send">
          <span>{t.ctaPrimary}</span>
          <Icon name="rocket" />
        </button>
      </div>
    </form>

    {
      examples.length > 0 && (
        <div
          class="enter hero__examples"
          style={`--enter-delay:${D.examples}`}
          role="group"
          aria-label={t.promptExamplesLabel ?? t.promptPlaceholder}
        >
          {examples.map((example) => (
            <button
              type="button"
              data-prompt-example
              data-prompt={example.prompt}
              aria-pressed="false"
              title={example.prompt}
              class="hero__chip"
            >
              <Icon name={example.icon} />
              {example.label}
            </button>
          ))}
        </div>
      )
    }

    <p class="enter hero__note" style={`--enter-delay:${D.note}`}>{t.note}</p>

    <div class="enter hero__socials" style={`--enter-delay:${D.socials}`}>
      <SocialLinks landmark={false} label="Follow Nexow" />
    </div>
  </div>

  <a class="enter hero__cue" href="#widget" style={`--enter-delay:${D.cue}`}>
    <span class="hero__cue-label">{t.ctaSecondary}</span>
    <span class="hero__cue-rail" aria-hidden="true"><span class="hero__cue-dot"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* svh, not vh: on iOS the collapsing address bar makes `100vh` taller than
     * the screen, which pushes the scroll cue below the fold on the one screen
     * where it has a job to do. */
    min-height: 100svh;
    padding-block: 9rem 7rem;
    color: var(--w-text);
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Two layers. The ellipse holds the headline; the vertical wash carries
     * that protection down over the composer, the chips and the note, which
     * the ellipse alone left sitting on bare screens.
     *
     * Both are deliberately weak. At full strength they hid the matter they
     * were meant to sit in front of, and the opening screen lost the one thing
     * it is there to show. The type keeps its own protection below. */
    background:
      radial-gradient(
        62% 46% at 50% 40%,
        color-mix(in oklab, var(--w-surface) 52%, transparent),
        color-mix(in oklab, var(--w-surface) 26%, transparent) 50%,
        transparent 80%
      ),
      linear-gradient(
        to bottom,
        transparent,
        color-mix(in oklab, var(--w-surface) 20%, transparent) 24%,
        color-mix(in oklab, var(--w-surface) 24%, transparent) 76%,
        transparent
      );
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__title {
    display: grid;
    max-width: 34ch;
    font-family: var(--font-display);
    /* Supporting lines sit under the lit hero title. Locales whose lead-in
     * runs long still wrap; the watch line sizes itself. */
    font-size: clamp(1.2rem, 0.5rem + 3.4vw, 2.35rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
    /* Carries the readability the veil used to buy with opacity, but only
       where there are glyphs, so the matter stays visible around them. */
    text-shadow: 0 2px 26px color-mix(in oklab, var(--w-surface) 82%, transparent);
  }

  .hero__line {
    display: block;
  }

  .hero__grad {
    background-image: linear-gradient(
      100deg,
      var(--ga),
      var(--gb) 30%,
      var(--gc) 55%,
      var(--gb) 78%,
      var(--ga)
    );
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    animation: gradient-drift 14s ease-in-out infinite;
    /* Dark punch from the title, plus a halo in the line's own hue so the
       screens behind cannot flatten the glyphs into the world. */
    text-shadow:
      0 2px 26px color-mix(in oklab, var(--w-surface) 82%, transparent),
      0 0 38px color-mix(in oklab, var(--gb) 55%, transparent);
  }

  /* Light theme needs the deep stops; dark theme needs the luminous ones. */
  .hero__grad--oil {
    --ga: var(--color-gold-700);
    --gb: var(--color-amber-600);
    --gc: var(--color-amber-500);
    animation-duration: 16s;
  }

  .hero__grad--use {
    --ga: var(--color-rose-700);
    --gb: var(--color-rose-600);
    --gc: var(--color-amber-500);
    /* Horizontal red → orange. Red holds through BUILD so the line does
       not collapse into a single peach wash. */
    background-image: linear-gradient(90deg, var(--ga) 0%, var(--gb) 42%, var(--gc) 100%);
    background-size: 100% 100%;
    animation: none;
  }

  /* One idea: a searchlight crossing the hero title. The specular lives in
     the glyphs; a soft flare rides with it so the line reads as lit, not
     just recolored. */
  .hero__grad--watch {
    --ga: var(--color-brand-700);
    --gb: var(--color-sky-600);
    --gc: var(--color-accent-600);
    position: relative;
    isolation: isolate;
    margin-block: 0.02em 0.04em;
    font-size: clamp(2.05rem, 0.5rem + 6.4vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.96;
    background-image:
      linear-gradient(
        108deg,
        transparent 28%,
        color-mix(in oklab, white 70%, var(--gb)) 44%,
        #fff 50%,
        color-mix(in oklab, white 62%, var(--ga)) 56%,
        transparent 72%
      ),
      linear-gradient(
        100deg,
        var(--ga),
        var(--gb) 28%,
        color-mix(in oklab, white 42%, var(--gb)) 50%,
        var(--gc) 72%,
        var(--ga)
      );
    background-size: 280% 160%, 240% 100%;
    animation: hero-watch-light 3.8s var(--ease-out-expo) infinite;
    text-shadow:
      0 2px 28px color-mix(in oklab, var(--w-surface) 82%, transparent),
      0 0 22px color-mix(in oklab, var(--gb) 60%, transparent),
      0 0 58px color-mix(in oklab, white 36%, var(--gb));
  }

  .hero__grad--watch::before {
    content: '';
    position: absolute;
    top: -8%;
    left: -22%;
    z-index: 1;
    width: 1.15em;
    height: 116%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      color-mix(in oklab, white 92%, var(--gb)) 0%,
      color-mix(in oklab, white 55%, var(--gb)) 22%,
      color-mix(in oklab, var(--gb) 48%, transparent) 48%,
      transparent 74%
    );
    filter: blur(14px);
    mix-blend-mode: plus-lighter;
    pointer-events: none;
    animation: hero-watch-flare 3.8s var(--ease-out-expo) infinite;
  }

  .hero__grad--watch::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      108deg,
      transparent 32%,
      color-mix(in oklab, white 82%, var(--gb)) 46%,
      #fff 50%,
      color-mix(in oklab, white 70%, var(--ga)) 54%,
      transparent 68%
    );
    background-size: 280% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    pointer-events: none;
    animation: hero-watch-sheen 3.8s var(--ease-out-expo) infinite;
  }

  .hero__grad--act {
    --ga: var(--color-plasma-600);
    --gb: var(--color-violet-600);
    --gc: var(--color-rose-500);
    animation-duration: 18s;
    animation-delay: -9.2s;
  }

  :global(.dark) .hero__grad--oil {
    --ga: var(--color-amber-200);
    --gb: var(--color-gold-300);
    --gc: var(--color-amber-400);
  }

  :global(.dark) .hero__grad--use {
    --ga: var(--color-rose-600);
    --gb: var(--color-rose-500);
    --gc: var(--color-amber-400);
  }

  :global(.dark) .hero__grad--watch {
    --ga: var(--color-brand-200);
    --gb: var(--color-sky-300);
    --gc: var(--color-sky-400);
  }

  :global(.dark) .hero__grad--act {
    --ga: var(--color-plasma-300);
    --gb: var(--color-plasma-400);
    --gc: var(--color-violet-400);
  }

  @keyframes hero-watch-light {
    0% {
      background-position: 145% 50%, 0% 50%;
      filter: brightness(1);
    }
    32% {
      background-position: 42% 50%, 30% 50%;
      filter: brightness(1.42);
    }
    52% {
      background-position: -18% 50%, 58% 50%;
      filter: brightness(1.18);
    }
    72%,
    100% {
      background-position: -48% 50%, 100% 50%;
      filter: brightness(1);
    }
  }

  @keyframes hero-watch-sheen {
    0% {
      background-position: 145% 50%;
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    52% {
      background-position: -18% 50%;
      opacity: 0.85;
    }
    72%,
    100% {
      background-position: -48% 50%;
      opacity: 0;
    }
  }

  @keyframes hero-watch-flare {
    0% {
      left: -22%;
      opacity: 0;
    }
    16% {
      opacity: 1;
    }
    52% {
      left: 78%;
      opacity: 0.75;
    }
    72%,
    100% {
      left: 112%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__grad {
      animation: none;
    }
    .hero__grad--watch {
      background-position: 42% 50%, 30% 50%;
      filter: none;
    }
    .hero__grad--watch::before,
    .hero__grad--watch::after {
      animation: none;
      opacity: 0;
    }
  }

  .hero__kicker {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.86rem + 0.6vw, 1.3rem);
    font-weight: 400;
    /* ink-200 on ink-950 measures well clear of AA; the muted token does not. */
    color: var(--w-text-2);
    text-shadow: 0 1px 18px color-mix(in oklab, var(--w-surface) 80%, transparent);
  }

  /* ---- composer ---- */

  .hero__forge {
    width: min(100%, 42rem);
    margin-top: 2.6rem;
  }

  .hero__composer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1px solid var(--w-line);
    border-radius: 1.15rem;
    background: var(--w-panel);
    box-shadow: 0 24px 60px -30px var(--w-shadow);
    transition:
      border-color 0.3s var(--ease-out-expo),
      box-shadow 0.3s var(--ease-out-expo);
  }

  .hero__composer:focus-within {
    border-color: color-mix(in oklab, var(--color-brand-400) 55%, transparent);
    box-shadow:
      0 24px 60px -30px var(--w-shadow),
      0 0 0 1px color-mix(in oklab, var(--color-brand-400) 35%, transparent);
  }

  /* `Icon.astro` renders the svg, so it never carries this file's scope hash and
   * a class passed to <Icon> would not match. Reach it structurally instead —
   * which is also why every icon rule here is a child selector. */
  .hero__composer > :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--w-accent);
  }

  .hero__input {
    flex: 1 1 auto;
    min-width: 0;
    /* Grown by script to fit its content; one line is the resting state. */
    max-height: 7.5rem;
    padding-block: 0.55rem;
    border: 0;
    background: transparent;
    color: var(--w-text-3);
    font-size: 0.95rem;
    line-height: 1.5;
    text-align: start;
    resize: none;
    overflow-y: auto;
  }

  .hero__input::placeholder {
    color: var(--w-text-4);
  }

  .hero__input:focus {
    outline: none;
  }

  .hero__send {
    display: inline-flex;
    flex: none;
    align-items: center;
    align-self: stretch;
    gap: 0.5rem;
    padding-inline: 1.15rem;
    border-radius: 0.85rem;
    background: linear-gradient(100deg, var(--grad-a), var(--grad-b) 52%, var(--grad-c));
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: filter 0.2s var(--ease-out-expo), transform 0.2s var(--ease-out-expo);
  }

  .hero__send:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .hero__send > :global(svg) {
    flex: none;
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.2s var(--ease-out-expo);
  }

  .hero__send:hover > :global(svg) {
    transform: translate(1px, -2px);
  }

  /* Below 30rem the button under the field beats a button squeezed beside it. */
  @media (max-width: 30rem) {
    .hero__composer {
      flex-direction: column;
      align-items: stretch;
      padding: 0.85rem;
    }
    .hero__composer > :global(svg) {
      display: none;
    }
    .hero__send {
      justify-content: center;
      padding-block: 0.7rem;
    }
  }

  /* ---- starter prompts ---- */

  .hero__examples {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--w-line);
    border-radius: 999px;
    background: var(--w-panel-2);
    color: var(--w-text-2);
    font-size: 0.78rem;
    font-weight: 500;
    transition:
      border-color 0.2s var(--ease-out-expo),
      color 0.2s var(--ease-out-expo),
      transform 0.2s var(--ease-out-expo);
  }

  .hero__chip:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--color-brand-400) 45%, transparent);
    color: var(--w-text);
  }

  .hero__chip[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--color-brand-400) 60%, transparent);
    background: color-mix(in oklab, var(--color-brand-400) 14%, transparent);
    color: var(--w-text);
  }

  .hero__chip > :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
    flex: none;
    color: var(--w-accent);
  }

  .hero__note {
    margin-top: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--w-text-4);
    text-shadow: 0 1px 14px color-mix(in oklab, var(--w-surface) 80%, transparent);
  }

  .hero__socials {
    margin-top: 1.35rem;
  }

  /* ---- the way down ---- */

  .hero__cue {
    position: absolute;
    inset-inline: 0;
    bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    color: var(--w-text-4);
    transition: color 0.25s var(--ease-out-expo);
  }

  .hero__cue:hover {
    color: var(--w-text);
  }

  .hero__cue-label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero__cue-rail {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: linear-gradient(to bottom, var(--w-rail), transparent);
  }

  .hero__cue-dot {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 0.9rem;
    background: linear-gradient(to bottom, transparent, var(--color-brand-400));
    animation: hero-cue 2.4s var(--ease-out-expo) infinite;
  }

  @keyframes hero-cue {
    0% {
      transform: translateY(-100%);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(275%);
      opacity: 0;
    }
  }

  /* The cue is the one thing here that loops. Under reduced motion it holds
     still rather than disappearing — it is navigation, not decoration. */
  @media (prefers-reduced-motion: reduce) {
    .hero__cue-dot {
      animation: none;
      top: 35%;
      opacity: 1;
    }
  }

  /* Short viewports (landscape phones) cannot afford a full-height opening.
     Drop the cue and let the hero be as tall as its content. */
  @media (max-height: 34rem) {
    .hero {
      min-height: 0;
      padding-block: 7rem 3rem;
    }
    .hero__cue {
      display: none;
    }
  }
</style>

<script>
  function initHeroForge() {
    const form = document.getElementById('forge') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const base = (form.dataset.appBase || 'https://x.nexow.ai').replace(/\/$/, '');
    const input = form.querySelector<HTMLTextAreaElement>('#hero-prompt');
    if (!input) return;

    /** `/?signup&prompt=…` — mirrors appDeepLinks.promptAppUrl (bare `signup` flag). */
    const promptUrl = (prompt: string) => {
      const params = new URLSearchParams();
      params.set('signup', '');
      if (prompt) params.set('prompt', prompt);
      const qs = params
        .toString()
        .split('&')
        .map((part) => (part.endsWith('=') ? part.slice(0, -1) : part))
        .join('&');
      return `${base}/?${qs}`;
    };

    /** One line at rest, growing to the CSS max-height as the prompt does. */
    const autosize = () => {
      input.style.height = 'auto';
      input.style.height = `${input.scrollHeight}px`;
    };

    const syncLinks = () => {
      form.action = promptUrl(input.value.trim());
    };

    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-prompt-example]'));
    const markActive = (active: HTMLButtonElement | null) => {
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip === active)));
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const prompt = chip.dataset.prompt ?? '';
        input.value = prompt;
        markActive(chip);
        syncLinks();
        autosize();
        // Let the world hear it: `WorldField` charges the matter off `input`.
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus({ preventScroll: true });
        input.setSelectionRange(prompt.length, prompt.length);
      });
    });

    input.addEventListener('input', () => {
      const value = input.value.trim();
      markActive(chips.find((chip) => chip.dataset.prompt === value) ?? null);
      syncLinks();
      autosize();
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      // The shockwave fires whether or not the popup is allowed through.
      document.dispatchEvent(new CustomEvent('nexow:world-send'));
      window.open(promptUrl(input.value.trim()), '_blank', 'noopener,noreferrer');
    });

    autosize();
    window.addEventListener('resize', autosize);
  }

  document.addEventListener('astro:page-load', initHeroForge);
</script>
