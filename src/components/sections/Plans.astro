---
/**
 * Plans, on the home page.
 *
 * The cards are the very same component /plans uses (`PlanTiers embedded`), so
 * the home page never shows a thinner, out-of-date version of the pricing: same
 * accents, same icons, same feature lists, same billing toggle. What is left
 * here is the section frame — heading, aurora, and the link on to the full
 * comparison matrix.
 */
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { localizePath } from '../../i18n/utils';
import SectionHeading from '../SectionHeading.astro';
import PlanTiers from './PlanTiers.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const t = c.home.plans;
---

<section id="plans" class="relative overflow-x-clip py-20 text-ink-950 sm:py-24 dark:text-white">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div
      data-motion="sink-lg"
      class="aurora-a absolute -top-24 left-[10%] size-[460px] rounded-full opacity-40 blur-3xl dark:opacity-30"
      style="background:radial-gradient(circle, var(--aurora-1), transparent 65%)"
    >
    </div>
    <div
      data-motion="rise-lg"
      class="aurora-b absolute bottom-0 right-[8%] size-[420px] rounded-full opacity-30 blur-3xl dark:opacity-25"
      style="background:radial-gradient(circle, var(--aurora-2), transparent 65%)"
    >
    </div>
  </div>

  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />
  </div>

  <PlanTiers lang={lang} embedded />

  <div class="container-page">
    <div class="reveal mt-8 text-center">
      <a
        href={localizePath('/plans', lang)}
        class="inline-flex items-center gap-1.5 font-medium text-brand-700 transition-colors hover:text-brand-600 dark:text-brand-300"
      >
        {t.cta}
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
