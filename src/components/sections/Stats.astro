---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const stats = useContent(lang).home.stats;
---

<section class="relative bg-ink-950 py-16 sm:py-20">
  <div class="container-page">
    <dl class="reveal-stagger grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col items-center text-center">
            <dd class="font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">
              {s.prefix && <span class="text-ink-500">{s.prefix}</span>}<span
                data-countup
                data-target={s.n}
              >
                {s.n}
              </span><span class="text-gradient">{s.suffix ?? ''}</span>
            </dd>
            <dt class="mt-3 max-w-[16rem] text-sm leading-snug text-ink-400">{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  let statsObserver: IntersectionObserver | null = null;

  function initStatsCountup() {
    statsObserver?.disconnect();
    statsObserver = null;

    const els = document.querySelectorAll<HTMLElement>('[data-countup]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!els.length || reduced || !('IntersectionObserver' in window)) return;

    statsObserver = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          statsObserver?.unobserve(e.target);
          const el = e.target as HTMLElement;
          const target = Number(el.dataset.target ?? '0');
          const dur = 1400;
          const t0 = performance.now();
          const frame = (now: number) => {
            const p = Math.min(1, (now - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 4);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => statsObserver!.observe(el));
  }

  document.addEventListener('astro:page-load', initStatsCountup);
</script>
