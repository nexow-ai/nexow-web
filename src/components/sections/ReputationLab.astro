---
/**
 * Reputation, explained — the opening panel of the dark "game layer" stage.
 *
 * Three parts: the real point weights (straight from the app's POINT_WEIGHTS),
 * a live simulator that runs the same arithmetic in the browser so a visitor can
 * watch their own level move, and the five-level ladder.
 *
 * Nothing here is illustrative: the weights, the badge bonuses and the level
 * thresholds are the numbers `app/utils/reputation.ts` computes with.
 */
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import {
  LEVELS,
  POINT_WEIGHTS,
  SIM_ACTIONS,
  TIER_BONUS,
  RARE_BONUS,
  LEGENDARY_BONUS,
  MAX_BADGE_POINTS,
  type StatKey,
} from '../../data/gamification';
import Icon from '../Icon.astro';
import Hex from '../Hex.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).rewards;

/** Weights, heaviest first — the table reads as a "what is worth most" ranking. */
const weights = (Object.entries(POINT_WEIGHTS) as [StatKey, number][]).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);

const bonuses = [
  { key: 'tiered' as const, points: TIER_BONUS, icon: 'award' },
  { key: 'rare' as const, points: RARE_BONUS, icon: 'gem' },
  { key: 'legendary' as const, points: LEGENDARY_BONUS, icon: 'crown' },
];

/** Handed to the simulator script: thresholds + the already-translated names. */
const simConfig = {
  levels: LEVELS.map((l) => ({ id: l.id, min: l.min, name: t.levels.names[l.id], from: l.from, to: l.to })),
  next: t.points.simNext,
  maxed: t.points.simMaxed,
};
---

<section class="relative overflow-hidden bg-ink-950 pt-20 pb-16 text-white sm:pt-28">
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-[0.35]" aria-hidden="true"></div>
  <div class="bg-noise pointer-events-none absolute inset-0 opacity-[0.15]" aria-hidden="true"></div>
  <div
    class="glow-accent aurora-a pointer-events-none absolute -top-32 left-1/2 -z-0 h-[520px] w-[820px] -translate-x-1/2 opacity-50"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative">
    <!-- Section identity -->
    <div class="reveal mx-auto max-w-3xl text-center">
      <span class="eyebrow text-brand-400">{t.eyebrow}</span>
      <h2 class="mt-4 font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-300">{t.subtitle}</p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <span class="badge-status" data-status="live">
          <span class="size-1.5 animate-pulse rounded-full bg-brand-400"></span>
          {t.live}
        </span>
        <span class="badge-status" data-status="soon">
          <span class="size-1.5 rounded-full bg-accent-400"></span>
          {t.planned}
        </span>
      </div>
    </div>

    <!-- Weights + simulator -->
    <div class="mt-14 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
      <!-- What each action is worth -->
      <div class="card-dark reveal p-7">
        <h3 class="font-display text-xl font-semibold text-white">{t.points.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-300">{t.points.body}</p>

        <p class="mt-6 text-[0.7rem] font-semibold uppercase tracking-wider text-ink-400">{t.points.tableTitle}</p>
        <ul class="mt-3 grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
          {
            weights.map(([stat, points]) => (
              <li class="flex items-baseline justify-between gap-3 border-b border-white/[0.06] py-1.5">
                <span class="min-w-0 truncate text-sm text-ink-200">{t.badges.stats[stat]}</span>
                <span class="shrink-0 font-mono text-sm font-semibold text-brand-300">+{points}</span>
              </li>
            ))
          }
        </ul>

        <p class="mt-6 text-[0.7rem] font-semibold uppercase tracking-wider text-ink-400">{t.points.bonusTitle}</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-3">
          {
            bonuses.map((b) => (
              <div class="rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5">
                <Icon name={b.icon} class="size-4 text-accent-300" />
                <p class="mt-1.5 font-mono text-lg font-semibold text-white">+{b.points}</p>
                <p class="text-[0.7rem] text-ink-400">{t.badges.rarity[b.key]}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-3 text-xs leading-relaxed text-ink-400">
          {t.points.bonusBody.replace('{n}', MAX_BADGE_POINTS.toLocaleString(lang))}
        </p>
      </div>

      <!-- Live simulator -->
      <div id="rep-sim" class="card-dark reveal relative overflow-hidden p-7">
        <span
          class="glow-brand pointer-events-none absolute -right-24 -top-24 size-72 opacity-40"
          aria-hidden="true"></span>

        <div class="relative flex items-start justify-between gap-4">
          <div>
            <h3 class="font-display text-xl font-semibold text-white">{t.points.simTitle}</h3>
            <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-300">{t.points.simBody}</p>
          </div>
          <button
            type="button"
            data-sim-reset
            class="shrink-0 rounded-full border border-white/12 px-3 py-1.5 text-xs font-medium text-ink-300 transition-colors hover:border-white/25 hover:text-white"
          >
            {t.points.simReset}
          </button>
        </div>

        <!-- Score readout -->
        <div class="relative mt-6 flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
          <span data-sim-hex>
            <Hex icon="award" from={LEVELS[0].from} to={LEVELS[0].to} size="lg" ink="#fff7ec" />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-ink-400">{t.points.label}</p>
            <p class="font-display text-3xl font-bold tabular-nums text-white">
              <span data-sim-points>0</span>
              <span class="ms-1 text-base font-medium text-ink-400">{t.points.unit}</span>
            </p>
            <p class="mt-0.5 truncate text-xs text-ink-300">
              <span data-sim-level class="font-medium text-white">{t.levels.names.bronze}</span>
              <span data-sim-next class="text-ink-400"></span>
            </p>
            <div class="mt-2.5 h-1.5 overflow-hidden rounded-full bg-white/10">
              <div data-sim-bar class="h-full w-0 rounded-full bg-brand-400 transition-[width] duration-500 ease-out"></div>
            </div>
          </div>
        </div>

        <!-- Action chips -->
        <div class="relative mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            SIM_ACTIONS.map((a) => (
              <button
                type="button"
                data-sim-action={a.stat}
                data-points={a.points}
                class="group relative flex flex-col items-start gap-1 rounded-xl border border-white/10 bg-white/[0.03] px-3 py-2.5 text-left transition-all hover:-translate-y-0.5 hover:border-brand-400/45 hover:bg-white/[0.06] active:translate-y-0"
              >
                <span class="flex w-full items-center justify-between">
                  <Icon name={a.icon} class="size-4 text-brand-300" />
                  <span
                    data-sim-count
                    class="rounded-full bg-brand-400/15 px-1.5 py-0.5 font-mono text-[0.6rem] font-semibold text-brand-300 opacity-0 transition-opacity"
                  >
                    0
                  </span>
                </span>
                <span class="text-[0.72rem] leading-tight text-ink-200">{t.badges.stats[a.stat]}</span>
                <span class="font-mono text-[0.65rem] text-ink-400">+{a.points} {t.points.unit}</span>
              </button>
            ))
          }
        </div>

        <p class="relative mt-3 text-center text-[0.7rem] text-ink-500">{t.points.simHint}</p>
      </div>
    </div>

    <!-- Level ladder -->
    <div class="reveal mt-6 rounded-2xl border border-white/10 bg-white/[0.03] p-7">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <h3 class="font-display text-xl font-semibold text-white">{t.levels.title}</h3>
        <p class="max-w-md text-sm leading-relaxed text-ink-400">{t.levels.body}</p>
      </div>

      <ol class="mt-7 grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          LEVELS.map((level, i) => (
            <li class="relative flex flex-col items-center gap-2.5 rounded-2xl border border-white/[0.07] bg-white/[0.02] px-3 py-5 text-center">
              <span class="relative">
                <span
                  class="aura pointer-events-none absolute -inset-3 rounded-full blur-lg"
                  style={`background:radial-gradient(circle, ${level.to}, transparent 70%);--d:${i * 320}ms`}
                  aria-hidden="true"
                />
                <Hex
                  icon={level.icon}
                  from={level.from}
                  to={level.to}
                  size="lg"
                  ink={i === 4 ? '#f6efff' : i === 0 ? '#fff7ec' : '#131722'}
                  delay={i * 320}
                />
              </span>
              <span class="font-display text-base font-semibold text-white">{t.levels.names[level.id]}</span>
              <span class="font-mono text-[0.7rem] text-ink-400">
                {t.levels.at.replace('{n}', level.min.toLocaleString(lang))}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="rep-sim-config" set:html={JSON.stringify(simConfig)}></script>

<script>
  /**
   * Points simulator. Runs the app's own arithmetic — tap counts × real weights,
   * bucketed into the real level bands — so the number a visitor watches climb
   * is the number Nexow would compute for that activity.
   */
  interface SimLevel {
    id: string;
    min: number;
    name: string;
    from: string;
    to: string;
  }

  let simAbort: AbortController | undefined;

  function initRepSim() {
    simAbort?.abort();
    simAbort = new AbortController();
    const { signal } = simAbort;

    const root = document.getElementById('rep-sim');
    const configEl = document.getElementById('rep-sim-config');
    if (!root || !configEl?.textContent) return;

    const config = JSON.parse(configEl.textContent) as {
      levels: SimLevel[];
      next: string;
      maxed: string;
    };

    const pointsEl = root.querySelector<HTMLElement>('[data-sim-points]');
    const levelEl = root.querySelector<HTMLElement>('[data-sim-level]');
    const nextEl = root.querySelector<HTMLElement>('[data-sim-next]');
    const barEl = root.querySelector<HTMLElement>('[data-sim-bar]');
    const hexEl = root.querySelector<HTMLElement>('[data-sim-hex] .hex');
    const actions = root.querySelectorAll<HTMLButtonElement>('[data-sim-action]');

    const counts = new Map<string, number>();

    function render() {
      let points = 0;
      for (const btn of actions) {
        const stat = btn.dataset.simAction ?? '';
        const n = counts.get(stat) ?? 0;
        points += n * Number(btn.dataset.points ?? 0);

        const chip = btn.querySelector<HTMLElement>('[data-sim-count]');
        if (chip) {
          chip.textContent = String(n);
          chip.style.opacity = n > 0 ? '1' : '0';
        }
      }

      // Highest band whose floor the score has cleared.
      let index = 0;
      for (let i = 0; i < config.levels.length; i++) {
        if (points >= config.levels[i].min) index = i;
      }
      const level = config.levels[index];
      const next = config.levels[index + 1];
      const progress = next ? Math.min(1, (points - level.min) / (next.min - level.min)) : 1;

      if (pointsEl) pointsEl.textContent = points.toLocaleString();
      if (levelEl) levelEl.textContent = level.name;
      if (nextEl) {
        nextEl.textContent = next
          ? ` · ${config.next.replace('{n}', (next.min - points).toLocaleString()).replace('{level}', next.name)}`
          : ` · ${config.maxed}`;
      }
      if (barEl) barEl.style.width = `${Math.round(progress * 100)}%`;
      if (hexEl) {
        hexEl.style.setProperty('--from', level.from);
        hexEl.style.setProperty('--to', level.to);
        hexEl.style.setProperty('--hex-ink', index === 0 || index === 4 ? '#fff7ec' : '#131722');
      }
    }

    actions.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const stat = btn.dataset.simAction ?? '';
          counts.set(stat, (counts.get(stat) ?? 0) + 1);
          render();
        },
        { signal },
      );
    });

    root.querySelector<HTMLButtonElement>('[data-sim-reset]')?.addEventListener(
      'click',
      () => {
        counts.clear();
        render();
      },
      { signal },
    );

    render();
  }

  document.addEventListener('astro:page-load', initRepSim);
</script>
