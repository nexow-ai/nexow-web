/* ---- signals: FFT bars with two carriers, waterfall, QPSK constellation ---- */
const FFT = Array.from({ length: 39 }, (_, i) => {
  const peaks = 30 * Math.exp(-((i - 14) ** 2) / 7) + 24 * Math.exp(-((i - 28) ** 2) / 5);
  return f1(Math.min(54, 5 + 11 * rnd(i) + peaks));
});
