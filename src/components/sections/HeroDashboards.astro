const f1 = (n: number) => Number(n.toFixed(1));
/** Deterministic 0..1 noise so every build renders the same pixels. */
const rnd = (i: number) => {
  const s = Math.sin(i * 127.1 + 311.7) * 43758.5453;
  return s - Math.floor(s);
};
/**
 * A spark that closes on itself. Harmonics whose periods divide the window
 * mean the last sample equals the one before the first, and the extra wrap
 * point carries the line into the next copy — so two sets translated one
 * width apart (.roll-x) run as one endless trace. Returns the path and the
 * width of a set, which is also the distance the loop travels.
 */
const loopSpark = (seed: number, n: number, x0: number, y0: number, dx: number, amp: number) => {
  const at = (i: number) => {
    const a = ((i % n) / n) * Math.PI * 2;
    return (
      Math.sin(a + seed) * 0.56 +
      Math.sin(2 * a + seed * 1.7) * 0.27 +
      Math.sin(3 * a + seed * 2.3) * 0.16 +
      Math.sin(5 * a + seed * 3.1) * 0.09
    );
  };
  return {
    d: Array.from(
      { length: n + 1 },
      (_, i) => `${i ? 'L' : 'M'}${f1(x0 + i * dx)} ${f1(y0 - at(i) * amp)}`,
    ).join(''),
    w: f1(n * dx),
  };
};

/* ---- world landmask (equirectangular, 46×19, lat 84°N..51°S) ----
 * Rendered as one dotted stroke per land run: `stroke-dasharray: 0 <pitch>`
 * with round caps turns each horizontal run into a row of dots, which keeps
 * ~700 map dots down to ~60 path elements. */
const WORLD = [
  '........####......###.........#####.###.......',
  '......########...####........#########.##.....',
  '.....#########..#####..##..#############......',
  '....##########...###....##..##############....',
  '.....#########..........###.##############....',
  '......#######...........####.#############....',
  '......#######...........###..####.#######.....',
  '.......######.........######.###.#######......',
  '.........####..........#####.###.###..###.....',
  '...........##...........#####..##..##.##......',
  '...........###..........####...#...#..###.....',
  '.............#####......####........#####.....',
  '.............######.....####.........###......',
  '.............#####......####..........##......',
  '..............####.......###.........#####....',
  '..............##.........##..........######...',
  '..............##........................##...#',
  '..............#.............................#.',
  '..............#...............................',
];
const worldRuns = (x0: number, y0: number, cw: number, rh: number) => {
  const runs: string[] = [];
  WORLD.forEach((row, r) => {
    const y = f1(y0 + r * rh);
    let c = 0;
    while (c < row.length) {
      if (row[c] === '#') {
        let e = c;
        while (e + 1 < row.length && row[e + 1] === '#') e++;
        runs.push(
          e === c
            ? `M${f1(x0 + c * cw)} ${y}h.01`
            : `M${f1(x0 + c * cw)} ${y}H${f1(x0 + e * cw)}`,
        );
        c = e + 1;
      } else c++;
    }
  });
  return runs;
};
