/* ---- trading: candles + EMA/VWAP + volume + RSI + book + positions ---- */
/* The session is a loop: the chart renders two sets of prints and slides
 * exactly one (.roll-x), so the series has to close on itself or the wrap
 * shows as a gap. Three harmonics over the window do that — the last bar's
 * close is the first bar's open, and every derived line is a circular window
 * of the same series, so they close too. */
const CANDLE_N = 18;
const CANDLES = Array.from({ length: CANDLE_N }, (_, i) => {
  const a = (i / CANDLE_N) * Math.PI * 2;
  const wave = 21 * Math.sin(a) + 8.5 * Math.sin(2 * a + 1.1) + 4.5 * Math.sin(3 * a + 2.3);
  /* Grain is safe here: both sets read the same array, so whatever a bar is
     it is again one window later. */
  return f1(64 + wave + (rnd(i + 30) - 0.5) * 9);
});
const candleY = (v: number) => 86 - v * 0.52;
const candleBodies = CANDLES.map((c, i) => {
  const prev = CANDLES[(i + CANDLE_N - 1) % CANDLE_N];
  const top = candleY(Math.max(c, prev));
  const h = Math.max(5, candleY(Math.min(c, prev)) - top + 4);
  return { x: 8 + i * 8.8, top, h, up: c >= prev };
});
/** Circular mean over `w` bars — periodic in, periodic out. */
const smooth = (w: number) =>
  CANDLES.map((_, i) => {
    let sum = 0;
    for (let k = 0; k < w; k++) sum += CANDLES[(i + CANDLE_N - k) % CANDLE_N];
    return sum / w;
  });
/** One point past the end (the next set's first bar) so the line crosses the
 * seam instead of stopping a step short of it. */
const wrapLine = (vals: number[]) =>
