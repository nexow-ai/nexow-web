/* ---- model3d: icosahedron subdivided once (42 verts / 120 edges / 80 tris),
 * rotated, orthographically projected, edges binned by depth. ---- */
const PHI = (1 + Math.sqrt(5)) / 2;
const vnorm = (v: number[]) => {
  const l = Math.hypot(v[0], v[1], v[2]);
  return [v[0] / l, v[1] / l, v[2] / l];
};
const icoVerts = [
  [-1, PHI, 0], [1, PHI, 0], [-1, -PHI, 0], [1, -PHI, 0],
  [0, -1, PHI], [0, 1, PHI], [0, -1, -PHI], [0, 1, -PHI],
  [PHI, 0, -1], [PHI, 0, 1], [-PHI, 0, -1], [-PHI, 0, 1],
].map(vnorm);
const icoFaces = [
  [0, 11, 5], [0, 5, 1], [0, 1, 7], [0, 7, 10], [0, 10, 11],
  [1, 5, 9], [5, 11, 4], [11, 10, 2], [10, 7, 6], [7, 1, 8],
  [3, 9, 4], [3, 4, 2], [3, 2, 6], [3, 6, 8], [3, 8, 9],
  [4, 9, 5], [2, 4, 11], [6, 2, 10], [8, 6, 7], [9, 8, 1],
];
const midCache = new Map<string, number>();
const midpoint = (a: number, b: number) => {
  const key = a < b ? `${a}-${b}` : `${b}-${a}`;
  let i = midCache.get(key);
  if (i === undefined) {
    i = icoVerts.length;
    icoVerts.push(
      vnorm([
        (icoVerts[a][0] + icoVerts[b][0]) / 2,
        (icoVerts[a][1] + icoVerts[b][1]) / 2,
        (icoVerts[a][2] + icoVerts[b][2]) / 2,
      ]),
    );
    midCache.set(key, i);
  }
  return i;
};
const subFaces: number[][] = [];
for (const [a, b, c] of icoFaces) {
  const ab = midpoint(a, b);
  const bc = midpoint(b, c);
  const ca = midpoint(c, a);
  subFaces.push([a, ab, ca], [b, bc, ab], [c, ca, bc], [ab, bc, ca]);
}
const edgeSet = new Set<string>();
for (const face of subFaces) {
  for (let i = 0; i < 3; i++) {
    const a = face[i];
    const b = face[(i + 1) % 3];
    edgeSet.add(a < b ? `${a}-${b}` : `${b}-${a}`);
  }
}
const AX = 0.42;
const AY = -0.58;
const cax = Math.cos(AX), sax = Math.sin(AX), cay = Math.cos(AY), say = Math.sin(AY);
const project = ([x, y, z]: number[], s: number, cx: number, cy: number) => {
  const x1 = x * cay + z * say;
  const z1 = -x * say + z * cay;
  const y2 = y * cax - z1 * sax;
  const z2 = y * sax + z1 * cax;
  return { X: f1(cx + x1 * s), Y: f1(cy - y2 * s), z: z2 };
};
const meshProj = icoVerts.map((v) => project(v, 38, 88, 80));
const meshPaths = ['', '', ''];
for (const e of edgeSet) {
  const [a, b] = e.split('-').map(Number);
  const z = (meshProj[a].z + meshProj[b].z) / 2;
  const bin = z > 0.3 ? 0 : z > -0.3 ? 1 : 2;
  meshPaths[bin] += `M${meshProj[a].X} ${meshProj[a].Y}L${meshProj[b].X} ${meshProj[b].Y}`;
}
