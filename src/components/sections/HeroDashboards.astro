<style>
  .hero-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }

  .hero-board {
    position: absolute;
    display: none;
    width: min(21rem, 36vw);
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--w-text) 12%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in oklab, var(--w-panel) 88%, transparent);
    box-shadow: 0 16px 36px -24px var(--w-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    filter: blur(0.4px);
    transform-origin: center;
    transition:
      opacity 0.7s var(--ease-out-expo),
      filter 0.7s var(--ease-out-expo),
      transform 0.7s var(--ease-out-expo);
  }

  :global(html.dark) .hero-board {
    border-color: color-mix(in oklab, var(--w-text) 38%, transparent);
  }

  .hero-board.is-shown {
    display: block;
    opacity: 0.76;
    animation: hero-board-float 8s ease-in-out infinite alternate;
  }

  .hero-board.is-current {
    opacity: 0.97;
    filter: blur(0);
    z-index: 1;
  }

  .hero-board[data-slot='0'] {
    top: 10%;
    left: max(0.75rem, calc(50% - 40rem));
    transform: rotate(-2.5deg);
    animation-delay: 0s;
  }

  .hero-board[data-slot='1'] {
    top: 7%;
    right: max(0.75rem, calc(50% - 39rem));
    left: auto;
    transform: rotate(2deg) scale(0.94);
    animation-delay: -2.2s;
  }

  .hero-board[data-slot='2'] {
    bottom: 16%;
    left: max(1rem, calc(50% - 38rem));
    transform: rotate(2deg) scale(1.35);
    transform-origin: bottom left;
    animation-delay: -4.1s;
  }

  .hero-board[data-slot='3'] {
    bottom: 14%;
    right: max(0.6rem, calc(50% - 40rem));
    left: auto;
    transform: rotate(-2deg) scale(1.44);
    transform-origin: bottom right;
    animation-delay: -1.1s;
  }

  .hero-board.is-current[data-slot='0'] {
    transform: rotate(-1.5deg) scale(1.03);
  }
  .hero-board.is-current[data-slot='1'] {
    transform: rotate(1.2deg) scale(1);
  }
  .hero-board.is-current[data-slot='2'] {
    transform: rotate(1.2deg) scale(1.44);
  }
  .hero-board.is-current[data-slot='3'] {
    transform: rotate(-1.2deg) scale(1.52);
  }

  @keyframes hero-board-float {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -6px;
    }
  }

  /* A rake of light across the glass, so the card itself has a pulse even
     where the instrument on it is a table of numbers. Slot-phased with the
     float so the four never sheen together. */
  .hero-board.is-shown::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      104deg,
      transparent 40%,
      color-mix(in oklab, var(--w-text) 7%, transparent) 50%,
      transparent 60%
    );
    pointer-events: none;
    animation: hero-board-sheen 9s ease-in-out var(--sheen, 0s) infinite;
  }
  .hero-board[data-slot='1']::after {
    --sheen: -2.2s;
  }
  .hero-board[data-slot='2']::after {
    --sheen: -4.4s;
  }
  .hero-board[data-slot='3']::after {
    --sheen: -6.6s;
  }
  @keyframes hero-board-sheen {
    0% {
      opacity: 0;
      translate: -60% 0;
    }
    12%,
    46% {
      opacity: 1;
    }
    64%,
    100% {
      opacity: 0;
      translate: 60% 0;
    }
  }

  .hero-board__bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.65rem;
    border-bottom: 1px solid var(--w-line);
  }

  .hero-board__live-dot {
    display: block;
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--color-brand-400);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brand-400) 22%, transparent);
    animation: hero-dot-beat 2.4s ease-out infinite;
  }
  @keyframes hero-dot-beat {
    0% {
      box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-brand-400) 42%, transparent);
    }
    45%,
    100% {
      box-shadow: 0 0 0 5px color-mix(in oklab, var(--color-brand-400) 0%, transparent);
    }
  }

  .hero-board__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--w-text-2);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-board__live {
    animation: hero-meta-blink 3.6s steps(1, end) infinite;
    color: var(--w-accent);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @keyframes hero-meta-blink {
    0%,
    88% {
      opacity: 1;
    }
    94% {
      opacity: 0.32;
    }
    100% {
      opacity: 1;
    }
  }

  .hero-board__svg {
    display: block;
    width: 100%;
    height: auto;
    padding: 0.28rem 0.4rem 0.4rem;
    --pg-line: var(--w-line);
    --pg-ink: color-mix(in oklab, var(--w-text) 14%, transparent);
    --pg-ink-dim: color-mix(in oklab, var(--w-text) 8%, transparent);
    --pg-br: var(--color-brand-500);
    --pg-br-soft: color-mix(in oklab, var(--color-brand-500) 22%, transparent);
    --pg-ac: var(--color-accent-500);
    --pg-ac-soft: color-mix(in oklab, var(--color-accent-500) 24%, transparent);
  }

  :global(.dark) .hero-board__svg {
    --pg-br: var(--color-brand-400);
    --pg-ac: var(--color-accent-400);
  }

  /* ---- fills & strokes ---- */

  .f-brand {
    fill: var(--pg-br);
  }
  .f-accent {
    fill: var(--pg-ac);
  }
  .f-ink {
    fill: color-mix(in oklab, var(--w-text) 45%, transparent);
  }
  .f-br {
    fill: var(--pg-br-soft);
  }
  .f-ac {
    fill: var(--pg-ac-soft);
  }
  .f-soft {
    fill: var(--pg-ink-dim);
  }
  .track {
    fill: var(--pg-ink-dim);
  }
  .panel {
    fill: color-mix(in oklab, var(--w-panel) 70%, transparent);
    stroke: var(--pg-line);
    stroke-width: 1;
  }
  .panel.lit {
    stroke: color-mix(in oklab, var(--pg-br) 65%, transparent);
  }
  .frame {
    fill: none;
    stroke: var(--pg-line);
    stroke-width: 1;
  }
  .ln {
    fill: none;
    stroke: var(--pg-line);
    stroke-width: 1.1;
    stroke-linecap: round;
  }
  .ln.thin {
    stroke-width: 0.7;
  }
  .ln.dash {
    stroke-dasharray: 3 4;
  }
  .ln.dash.thin {
    stroke-width: 0.6;
    stroke-dasharray: 2 4;
  }
  .ln.dash.acc {
    stroke: color-mix(in oklab, var(--pg-ac) 60%, transparent);
    stroke-width: 0.8;
    stroke-dasharray: 3 3;
  }
  .stroke-br,
  .stroke-ac,
  .stroke-ink,
  .stroke-dim {
    fill: none;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stroke-br {
    stroke: var(--pg-br);
  }
  .stroke-ac {
    stroke: var(--pg-ac);
  }
  .stroke-ink {
    stroke: color-mix(in oklab, var(--w-text) 55%, transparent);
    stroke-width: 1;
  }
  .stroke-dim {
    stroke: color-mix(in oklab, var(--w-text) 26%, transparent);
    stroke-width: 0.9;
  }
  .area {
    fill: color-mix(in oklab, var(--color-brand-500) 14%, transparent);
  }
  .area-ac {
    fill: color-mix(in oklab, var(--color-accent-500) 14%, transparent);
  }

  .lbl {
    fill: var(--w-text-2);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 7px;
    letter-spacing: 0.02em;
  }
  .lbl.xs {
    font-size: 5.6px;
    letter-spacing: 0.03em;
  }
  .lbl.em {
    fill: var(--w-text);
    font-weight: 600;
  }
  .lbl.dim {
    fill: var(--w-text-4);
  }
  .lbl.up {
    fill: var(--pg-br);
  }
  .lbl.dn {
    fill: var(--pg-ac);
  }
  .lbl.tag {
    fill: var(--w-surface);
    font-size: 5.6px;
    font-weight: 700;
  }

  /* ---- world map & links ---- */

  .land {
    fill: none;
    stroke: color-mix(in oklab, var(--w-text) 36%, transparent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 0 3.55;
  }
  .land.land--sm {
    stroke-width: 1.15;
    stroke-dasharray: 0 3.13;
    stroke: color-mix(in oklab, var(--w-text) 26%, transparent);
  }
  .arc {
    fill: none;
    stroke: color-mix(in oklab, var(--pg-br) 75%, transparent);
    stroke-width: 0.9;
    stroke-linecap: round;
    stroke-dasharray: 3 4;
    animation: hb-dash-flow 0.9s linear var(--d, 0s) infinite;
  }
  .dash-flow {
    stroke-dasharray: 3 4;
    animation: hb-dash-flow 0.9s linear infinite;
  }
  /* The accent rule is more specific and would keep its 3 3 pattern, which
     does not divide the 7px the flow travels — the dashes would jump once a
     second. Restate the pitch the flow expects. */
  .ln.dash.acc.dash-flow {
    stroke-dasharray: 3 4;
  }
  @keyframes hb-dash-flow {
    to {
      stroke-dashoffset: -7;
    }
  }
  .ping-ring {
    fill: none;
    stroke: var(--pg-br);
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: hb-ping-ring 2.6s ease-out infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes hb-ping-ring {
    0% {
      opacity: 0.9;
      transform: scale(0.35);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(2.1);
    }
  }
  /* Riders follow their path via offset-path; hidden where unsupported so the
     dot never parks at the SVG origin. */
  .path-rider {
    display: none;
  }
  @supports (offset-distance: 0%) {
    .path-rider {
      display: initial;
      offset-rotate: 0deg;
      animation: hb-offset var(--t, 16s) linear var(--d, 0s) infinite;
    }
  }
  @keyframes hb-offset {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  /* ---- radar ---- */

  .tickring {
    fill: none;
    stroke: color-mix(in oklab, var(--w-text) 30%, transparent);
    stroke-width: 4;
  }
  .tickring.thin {
    stroke-width: 3;
  }
  .sweep {
    transform-origin: 76px 82px;
    animation: hb-spin 5s linear infinite;
  }
  .spin-var {
    animation: hb-spin var(--t, 10s) linear infinite;
  }
  .spin-var.rev {
    animation-direction: reverse;
  }
  @keyframes hb-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .blip {
    animation: hb-blip 5s linear var(--d, 0s) infinite;
  }
  @keyframes hb-blip {
    0% {
      opacity: 1;
    }
    45%,
    96% {
      opacity: 0.38;
    }
    100% {
      opacity: 1;
    }
  }
  .ctc-hos {
    fill: var(--pg-ac-soft);
    stroke: var(--pg-ac);
    stroke-width: 1.1;
  }
  .ctc-frd {
    fill: var(--pg-br-soft);
    stroke: var(--pg-br);
    stroke-width: 1.1;
  }
  .ctc-unk {
    fill: none;
    stroke: color-mix(in oklab, var(--w-text) 60%, transparent);
    stroke-width: 1.1;
  }
  .ctc-obj {
    fill: none;
    stroke: var(--pg-ac);
    stroke-width: 1.2;
  }
  .vec {
    stroke: color-mix(in oklab, var(--w-text) 40%, transparent);
    stroke-width: 0.8;
    stroke-linecap: round;
  }

  /* ---- avionics ---- */

  .sky {
    fill: color-mix(in oklab, var(--color-accent-500) 16%, transparent);
  }
  .gnd {
    fill: color-mix(in oklab, var(--w-text) 12%, transparent);
  }
  .horizon {
    animation: hb-horizon 11s ease-in-out infinite alternate;
  }
  @keyframes hb-horizon {
    from {
      transform: rotate(-4deg) translateY(-2px);
    }
    to {
      transform: rotate(3deg) translateY(2.5px);
    }
  }
  .fd {
    fill: none;
    stroke: var(--pg-ac);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .tape {
    animation: hb-tape 7s ease-in-out infinite alternate;
  }
  .tape.rev-tape {
    animation-direction: alternate-reverse;
  }
  @keyframes hb-tape {
    from {
      transform: translateY(-5px);
    }
    to {
      transform: translateY(4px);
    }
  }
  .hdg {
    animation: hb-hdg 9s ease-in-out infinite alternate;
  }
  @keyframes hb-hdg {
    from {
      transform: translateX(-6px);
    }
    to {
      transform: translateX(5px);
    }
  }

  /* ---- 3d mesh ---- */

  .mesh-f,
  .mesh-m,
  .mesh-b {
    fill: none;
    stroke-linecap: round;
  }
  .mesh-f {
    stroke: var(--pg-br);
    stroke-width: 0.8;
  }
  .mesh-m {
    stroke: color-mix(in oklab, var(--pg-br) 55%, transparent);
    stroke-width: 0.6;
  }
  .mesh-b {
    stroke: color-mix(in oklab, var(--w-text) 16%, transparent);
    stroke-width: 0.5;
  }
  .bbox {
    fill: none;
    stroke: color-mix(in oklab, var(--w-text) 22%, transparent);
    stroke-width: 0.5;
    stroke-dasharray: 2 3;
  }
  .wobble {
    animation: hb-wobble 12s ease-in-out infinite alternate;
  }
  @keyframes hb-wobble {
    from {
      transform: rotate(-6deg);
    }
    to {
      transform: rotate(6deg);
    }
  }
  .dim-line {
    stroke: color-mix(in oklab, var(--w-text) 35%, transparent);
    stroke-width: 0.6;
  }

  /* ---- signals ---- */

  .w0 {
    fill: color-mix(in oklab, var(--w-text) 5%, transparent);
  }
  .w1 {
    fill: color-mix(in oklab, var(--color-brand-500) 16%, transparent);
  }
  .w2 {
    fill: color-mix(in oklab, var(--color-brand-500) 38%, transparent);
  }
  .w3 {
    fill: color-mix(in oklab, var(--color-accent-500) 55%, transparent);
  }
  .wf-row {
    animation: hb-wf 1.9s linear var(--d, 0s) infinite;
  }
  @keyframes hb-wf {
    0% {
      opacity: 0.25;
    }
    14% {
      opacity: 1;
    }
    100% {
      opacity: 0.25;
    }
  }

  /* ---- neural ---- */

  .nedge {
    fill: none;
    stroke: color-mix(in oklab, var(--w-text) 12%, transparent);
    stroke-width: 0.45;
  }
  .nedge.pulse {
    stroke: var(--pg-br);
    stroke-width: 0.6;
    opacity: 0;
    animation: hb-pulse 2.6s linear var(--d, 0s) infinite;
  }
  @keyframes hb-pulse {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 0.85;
    }
    28%,
    100% {
      opacity: 0;
    }
  }
  .node {
    fill: var(--w-panel);
    stroke: var(--pg-br);
    stroke-width: 1;
  }

  /* ---- network ---- */

  .pkt {
    animation: hb-pkt var(--t, 1.8s) linear var(--d, 0s) infinite;
  }
  @keyframes hb-pkt {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    14% {
      opacity: 1;
    }
    86% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(var(--tx, 0px), var(--ty, 0px));
    }
  }
  .led {
    animation: hb-led 2.4s linear var(--d, 0s) infinite;
  }
  @keyframes hb-led {
    0%,
    72% {
      opacity: 1;
    }
    86% {
      opacity: 0.25;
    }
    100% {
      opacity: 1;
    }
  }

  /* ---- tacsim ---- */

  .corner {
    fill: none;
    stroke: var(--pg-br);
    stroke-width: 1.2;
  }
  .contour {
    fill: none;
    stroke: color-mix(in oklab, var(--w-text) 18%, transparent);
    stroke-width: 0.7;
    stroke-dasharray: 5 3;
  }
  .wp {
    fill: none;
    stroke: color-mix(in oklab, var(--pg-br) 60%, transparent);
    stroke-width: 0.8;
    stroke-dasharray: 3 3;
  }
  .sensor-cone {
    fill: color-mix(in oklab, var(--color-brand-500) 8%, transparent);
  }
  .patrol {
    animation: hb-patrol 9s linear infinite;
  }
  @keyframes hb-patrol {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    5% {
      opacity: 1;
    }
    34% {
      transform: translate(36px, -18px);
    }
    66% {
      transform: translate(68px, -32px);
    }
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(98px, -52px);
    }
  }
  .cool {
    fill: none;
    stroke: var(--pg-br);
    stroke-width: 2.4;
    animation: hb-cool 3.2s linear infinite;
  }
  @keyframes hb-cool {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* ---- investment desks ---- */

  /* Donut segments: the keyframe only supplies `from`, so each circle animates
     to its own dasharray attribute — one rule serves every allocation. */
  .seg {
    fill: none;
    stroke-width: 8;
    /* Round caps (inherited from the stroke classes) put a blob at every
       segment boundary at this width. */
    stroke-linecap: butt;
    animation: hb-seg 1s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-seg {
    from {
      stroke-dasharray: 0 100;
    }
  }
  .needle {
    animation: hb-needle var(--t, 6s) ease-in-out infinite alternate;
  }
  @keyframes hb-needle {
    from {
      transform: rotate(var(--a0, -16deg));
    }
    to {
      transform: rotate(var(--a1, 16deg));
    }
  }
  /* Tape prints are rendered twice; one full set of travel per loop lands the
     wrap on identical pixels. */
  .tape-roll {
    animation: hb-roll var(--t, 7s) linear infinite;
  }
  @keyframes hb-roll {
    to {
      transform: translateY(var(--sh, -104px));
    }
  }
  .fill-loop {
    transform-box: fill-box;
    transform-origin: left center;
    animation: hb-fill-loop var(--t, 12s) linear infinite;
  }
  @keyframes hb-fill-loop {
    from {
      transform: scaleX(0.02);
    }
    to {
      transform: scaleX(1);
    }
  }
  .hot {
    animation: hb-hot 2.8s linear var(--d, 0s) infinite;
  }
  @keyframes hb-hot {
    0%,
    8% {
      opacity: 1;
    }
    16% {
      opacity: 0.3;
    }
    24%,
    100% {
      opacity: 1;
    }
  }

  /* ---- shared entrances & loops ---- */

  .fade {
    animation: hb-fade 0.5s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .slide {
    animation: hb-slide 0.55s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-slide {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .pop {
    transform-box: fill-box;
    transform-origin: center;
    animation: hb-pop 0.48s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-pop {
    from {
      opacity: 0;
      transform: scale(0.55);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .grow-y {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: hb-grow-y 0.6s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-grow-y {
    from {
      opacity: 0.3;
      transform: scaleY(0.06);
    }
    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }
  .grow-x {
    transform-box: fill-box;
    transform-origin: left center;
    animation: hb-grow-x 0.7s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-grow-x {
    from {
      transform: scaleX(0.04);
    }
    to {
      transform: scaleX(1);
    }
  }
  .draw {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: hb-draw 1.35s var(--ease-out-expo) var(--d, 0s) both;
  }
  @keyframes hb-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .draw-loop {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: hb-plot 9s linear infinite;
  }
  @keyframes hb-plot {
    0% {
      stroke-dashoffset: 100;
    }
    72%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  .caret {
    animation: hb-caret 1.1s linear infinite;
  }
  @keyframes hb-caret {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .eq-bar {
    transform-box: fill-box;
    transform-origin: center bottom;
    animation: hb-eq var(--t, 1.2s) ease-in-out infinite alternate;
    animation-delay: var(--d, 0s);
  }
  @keyframes hb-eq {
    from {
      transform: scaleY(var(--s, 0.22));
    }
    to {
      transform: scaleY(1);
    }
  }

  /* ---- live loops ----
   * A board that only plays an entrance is a screenshot, and four of them
   * ring the composer for as long as anyone reads the headline. Everything
   * below is a seamless infinite loop parameterised by `--t` (period) and
   * `--d` (phase), so one rule dresses a whole panel and the hero still ships
   * static SVG plus keyframes — no runtime JS behind the instruments.
   *
   * Every loop is written so its t=0 frame is a legible one: the atlas
   * (src/lib/worldBoards.ts) reveals a hidden board and snapshots it in the
   * same task, which reads each animation at time zero.
   */

  /* Stacked readouts — N variants share one slot and exactly one is lit, so a
     price ticks instead of sitting there. Phase each sibling by t/N. */
  .cyc2,
  .cyc3,
  .cyc4 {
    opacity: 0;
    animation-duration: var(--t, 3.2s);
    animation-delay: var(--d, 0s);
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }
  .cyc2 {
    animation-name: hb-cyc2;
  }
  .cyc3 {
    animation-name: hb-cyc3;
  }
  .cyc4 {
    animation-name: hb-cyc4;
  }
  @keyframes hb-cyc2 {
    0%,
    49.9% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hb-cyc3 {
    0%,
    33.2% {
      opacity: 1;
    }
    33.4%,
    100% {
      opacity: 0;
    }
  }
  @keyframes hb-cyc4 {
    0%,
    24.9% {
      opacity: 1;
    }
    25%,
    100% {
      opacity: 0;
    }
  }

  /* A print lands: the row lights, then decays. */
  .flash {
    opacity: 0;
    animation: hb-flash var(--t, 3.4s) linear var(--d, 0s) infinite;
  }
  @keyframes hb-flash {
    0% {
      opacity: 0.8;
    }
    22% {
      opacity: 0.3;
    }
    46%,
    100% {
      opacity: 0;
    }
  }

  /* Seamless travel: the content is rendered twice and one full set of travel
     lands the wrap on identical pixels (the .tape-roll trick, sideways). */
  .roll-x {
    animation: hb-roll-x var(--t, 14s) linear infinite;
  }
  @keyframes hb-roll-x {
    to {
      transform: translateX(var(--sx, -100px));
    }
  }

  /* A read head crossing a plot. */
  .scan {
    animation: hb-scan var(--t, 7s) linear var(--d, 0s) infinite;
  }
  @keyframes hb-scan {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    7%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(var(--sx, 150px));
    }
  }

  /* A meter that keeps rebalancing. */
  .pulse-x {
    transform-box: fill-box;
    transform-origin: left center;
