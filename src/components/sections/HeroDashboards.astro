/* ---- math: Lorenz attractor integrated here, projected x–z ---- */
const lorenzPath = (() => {
  let x = 1, y = 1, z = 20;
  const dt = 0.006;
  const pts: string[] = [];
  for (let i = 0; i < 4400; i++) {
    const dx = 10 * (y - x);
    const dy = x * (28 - z) - y;
    const dz = x * y - (8 / 3) * z;
    x += dx * dt;
    y += dy * dt;
    z += dz * dt;
    if (i > 200 && i % 12 === 0) pts.push(`${pts.length ? 'L' : 'M'}${f1(88 + x * 4.1)} ${f1(152 - z * 3)}`);
  }
  return pts.join('');
})();
