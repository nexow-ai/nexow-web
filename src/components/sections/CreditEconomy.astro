---
/**
 * What a credit is worth — the honest version.
 *
 * Nexow prices a credit as one Sonnet output token of real provider cost, then
 * sells it at a fixed margin, so every plan grant and every pack carries the
 * same rate. That rate, the tokens-per-credit table and the pack grants are all
 * derived here from the same constants the billing engine uses; nothing is a
 * hand-typed marketing number.
 */
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import {
  USD_PER_MILLION_CREDITS,
  TOKENS_PER_CREDIT,
  CREDIT_PACKS,
  packCredits,
  packDiscountPct,
} from '../../data/gamification';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).rewards.credits;

const nf = (n: number) => n.toLocaleString(lang);
const usd = (n: number) => n.toLocaleString(lang, { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });

const packs = CREDIT_PACKS.map((pack) => ({
  ...pack,
  credits: packCredits(pack),
  discount: packDiscountPct(pack),
}));

/** Widest bar in the tokens table, so the rows read as a comparison. */
const maxTokens = Math.max(...TOKENS_PER_CREDIT.map((m) => m.tokens));
---

<section class="bg-white py-20 sm:py-24">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.body} />

    <div class="reveal-stagger mt-12 grid gap-5 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)]">
      <!-- The rate -->
      <div class="relative overflow-hidden rounded-3xl border border-ink-900/10 bg-ink-950 p-8 text-white">
        <div class="bg-grid pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"></div>
        <div class="glow-brand pointer-events-none absolute -left-16 -top-20 size-64 opacity-60 animate-glow" aria-hidden="true">
        </div>
        <div class="relative">
          <span class="coin-spin inline-flex size-12 items-center justify-center rounded-full bg-gradient-to-br from-brand-300 to-brand-600 text-ink-950">
            <Icon name="coins" class="size-6" />
          </span>
          <p class="mt-6 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
            {t.rate.replace('{usd}', usd(USD_PER_MILLION_CREDITS))}
          </p>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-300">{t.rateNote}</p>
        </div>
      </div>

      <!-- Tokens per credit -->
      <div class="rounded-3xl border border-ink-900/10 bg-white p-8 shadow-sm shadow-ink-950/[0.03]">
        <h3 class="font-display text-lg font-semibold text-ink-950">{t.tokensTitle}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">{t.tokensNote}</p>

        <ul class="mt-6 space-y-3.5">
          {
            TOKENS_PER_CREDIT.map((m, i) => (
              <li>
                <div class="flex items-baseline justify-between gap-3">
                  <span class="text-sm font-medium text-ink-800">{m.model}</span>
                  <span class="font-mono text-sm text-ink-600">
                    {/* One decimal throughout, so "1 tokens" never happens and
                        the column stays aligned. */}
                    <span class="font-semibold text-ink-950">{m.tokens.toFixed(1)}</span> {t.tokensUnit}
                  </span>
                </div>
                <span class="mt-1.5 block h-1.5 overflow-hidden rounded-full bg-ink-100">
                  <span
                    class="bar-grow block h-full rounded-full bg-gradient-to-r from-brand-400 to-accent-500"
                    style={`width:${Math.max(6, Math.round((m.tokens / maxTokens) * 100))}%;--d:${i * 90}ms`}
                  />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Packs -->
    <div class="mt-14">
      <div class="reveal flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <h3 class="font-display text-xl font-semibold text-ink-950">{t.packsTitle}</h3>
        <p class="max-w-md text-sm text-ink-600">{t.packsNote}</p>
      </div>

      <div class="stage-3d reveal-stagger mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          packs.map((pack) => (
            <article
              data-tilt
              class:list={[
                'tilt relative flex flex-col rounded-2xl border p-6',
                pack.featured
                  ? 'border-brand-500/30 bg-brand-50 ring-1 ring-brand-500/20'
                  : 'border-ink-900/10 bg-white shadow-sm shadow-ink-950/[0.03]',
              ]}
            >
              <span class="tilt-sheen" aria-hidden="true" />
              <div class="tilt-layer" style="--z:18px">
                {pack.discount > 0 && (
                  <span class="absolute right-5 top-5 rounded-full bg-brand-500/12 px-2 py-0.5 font-mono text-[0.6rem] font-semibold uppercase tracking-wider text-brand-700">
                    {t.packSave.replace('{n}', String(pack.discount))}
                  </span>
                )}
                <p class="font-display text-3xl font-bold tabular-nums text-ink-950">{nf(pack.credits)}</p>
                <p class="mt-0.5 font-mono text-[0.7rem] uppercase tracking-wider text-ink-500">{t.packUnit}</p>
                <p class="mt-4 text-lg font-semibold text-ink-950">{usd(pack.priceUsd)}</p>
                <p class="mt-1 flex items-center gap-1.5 text-xs text-ink-500">
                  <Icon name="history" class="size-3.5" />
                  {t.packTtl}
                </p>
                <a
                  href="https://x.nexow.ai"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-700 transition-colors hover:text-brand-600"
                >
                  {t.packCta}
                  <Icon name="arrow" class="size-4" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
