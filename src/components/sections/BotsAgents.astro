---
/**
 * Bots & Agents deep-dive: what the two kinds of teammate actually are, a
 * scroll-scrubbed anatomy of one run, and the use-case gallery that shows the
 * loop is not a trading feature.
 *
 * Note the section is `overflow-x-clip`, never `overflow-hidden` — an
 * `overflow: hidden` ancestor silently disables the `position: sticky` the run
 * diagram is pinned with.
 */
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { en } from '../../i18n/locales/en';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import AgentRunDiagram from '../AgentRunDiagram.astro';
import UseCaseScene from '../UseCaseScene.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Locales without a translation fall back to the English strings.
const t = useContent(lang).home.botsAgents ?? en.home.botsAgents!;

const KIND_ICONS = ['bolt', 'cpu'];
---

<section
  id="bots-agents"
  class="relative overflow-x-clip border-y border-ink-900/5 dark:border-white/8 bg-[#f7fbfb]/70 dark:bg-white/[0.02] py-20 text-ink-950 dark:text-white sm:py-24"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      data-motion="sink-lg"
      class="aurora-a absolute -top-24 right-[6%] h-[520px] w-[520px] rounded-full opacity-40 blur-3xl dark:opacity-35"
      style="background:radial-gradient(circle at 50% 45%, var(--color-brand-200), transparent 68%)"
    >
    </div>
    <div
      data-motion="rise-lg"
      class="aurora-b absolute bottom-0 left-[2%] h-[460px] w-[460px] rounded-full opacity-30 blur-3xl dark:opacity-25"
      style="background:radial-gradient(circle at 50% 45%, var(--color-sky-200), transparent 68%)"
    >
    </div>
  </div>

  <div class="container-page relative">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <!-- ── bot vs agent ──────────────────────────────────────────────── -->
    <div class="mt-12 grid gap-4 lg:grid-cols-2">
      {
        t.kinds.map((kind, i) => (
          <div class="reveal">
            <article
              data-motion={i === 0 ? 'rise' : 'sink'}
              class="flex h-full flex-col rounded-2xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] p-7 shadow-sm shadow-ink-950/[0.03] dark:shadow-black/40"
            >
              <div class="flex items-center gap-3">
                <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
                  <Icon name={KIND_ICONS[i]} class="size-5.5" />
                </span>
                <span class="rounded-full border border-ink-900/10 dark:border-white/10 bg-[#f7fbfb] dark:bg-white/[0.02] px-2.5 py-1 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-ink-500 dark:text-ink-400">
                  {kind.badge}
                </span>
              </div>
              <h3 class="mt-5 font-display text-2xl font-semibold text-ink-950 dark:text-white">{kind.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{kind.body}</p>
              <ul class="mt-6 space-y-3 border-t border-ink-900/8 dark:border-white/8 pt-6">
                {kind.points.map((p) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
                      <Icon name="check" class="size-3.5" />
                    </span>
                    <span class="text-sm leading-relaxed text-ink-700 dark:text-ink-200">{p}</span>
                  </li>
                ))}
              </ul>
            </article>
          </div>
        ))
      }
    </div>

    <!-- ── anatomy of a run ──────────────────────────────────────────── -->
    <div class="mt-20 sm:mt-24">
      <SectionHeading eyebrow={t.run.eyebrow} title={t.run.title} subtitle={t.run.subtitle} />
      <div class="mx-auto mt-10 max-w-4xl xl:max-w-5xl">
        <AgentRunDiagram
          sources={t.run.sources}
          harness={t.run.harness}
          deliveries={t.run.deliveries}
          stages={t.run.stages}
          sourcesLabel={t.run.sourcesLabel}
          harnessLabel={t.run.harnessLabel}
          deliveriesLabel={t.run.deliveriesLabel}
          hint={t.run.hint}
        />
      </div>
    </div>

    <!-- ── use cases ─────────────────────────────────────────────────── -->
    <div class="mt-20 sm:mt-24">
      <SectionHeading
        eyebrow={t.cases.eyebrow}
        title={t.cases.title}
        subtitle={t.cases.subtitle}
      />

      <div class="reveal-stagger mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.cases.items.map((item, i) => (
            <div class="flex">
              <article
                data-motion="rise"
                style={`--m-shift:${-10 - (i % 4) * 9}px`}
                class="group flex flex-1 flex-col overflow-hidden rounded-2xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] shadow-sm shadow-ink-950/[0.03] dark:shadow-black/40 transition-shadow duration-300 hover:shadow-lg hover:shadow-ink-950/[0.07]"
              >
                <div class="relative border-b border-ink-900/8 dark:border-white/8 bg-[#f9fdfd] dark:bg-white/[0.03] px-5 pb-4 pt-5">
                  <span
                    class:list={[
                      'absolute right-4 top-4 rounded-full px-2 py-0.5 font-mono text-[0.55rem] uppercase tracking-[0.12em]',
                      item.kind === 'bot'
                        ? 'bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25'
                        : 'bg-accent-50 dark:bg-accent-400/12 text-accent-700 dark:text-accent-300 ring-1 ring-accent-200/80 dark:ring-accent-400/25',
                    ]}
                  >
                    {item.kind === 'bot' ? t.cases.botLabel : t.cases.agentLabel}
                  </span>
                  <UseCaseScene scene={item.scene} class="mt-2" />
                </div>

                <div class="flex flex-1 flex-col p-5">
                  <h3 class="font-display text-lg font-semibold text-ink-950 dark:text-white">{item.title}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{item.body}</p>
                  <p class="mt-4 rounded-lg border border-ink-900/8 dark:border-white/8 bg-[#f7fbfb] dark:bg-white/[0.02] px-3 py-2 font-mono text-[0.65rem] leading-relaxed text-ink-600 dark:text-ink-300">
                    {item.recipe}
                  </p>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ── more ideas ────────────────────────────────────────────────── -->
    <div class="reveal mt-14 rounded-2xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] p-7">
      <h3 class="text-center font-display text-lg font-semibold text-ink-950 dark:text-white">{t.more.title}</h3>
      <div class="mt-5 flex flex-wrap justify-center gap-2">
        {
          t.more.items.map((idea) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-ink-900/10 dark:border-white/10 bg-[#f7fbfb] dark:bg-white/[0.02] px-3 py-1.5 font-mono text-[0.68rem] text-ink-600 dark:text-ink-300">
              <span class="text-brand-600 dark:text-brand-300">›</span>
              {idea}
            </span>
          ))
        }
      </div>
    </div>

    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-3">
      <Button href={SITE.appUrl} size="lg" external iconRight="arrow">{t.cta}</Button>
      <p class="w-full text-center font-mono text-xs text-ink-500 dark:text-ink-400 sm:w-auto sm:text-left">
        {t.ctaNote}
      </p>
    </div>
  </div>
</section>
