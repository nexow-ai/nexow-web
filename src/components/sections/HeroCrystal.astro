---
/**
 * The one object on the opening screen, and nowhere else.
 *
 * It replaces the world field: a fixed, full-viewport WebGL canvas that ran
 * from the header to the footer, morphed one solid through six shapes,
 * carried a wall of rasterised dashboards and a field of luminous hairlines,
 * and never stopped drawing. What is left is a single shape in the hero that
 * turns slowly and fades out as the hero scrolls away. Below the hero there is
 * no canvas at all.
 *
 * Three looks are on trial, picked without a redeploy by `?crystal=`:
 *
 *   a     a sober polyhedron: thin lit edges, near-clear faces, one brand
 *         colour, eight facets (the default)
 *   b     the Nexow mark, extruded, in matte metal, swaying slowly
 *   c     a glass sphere with a soft glow that leans toward the pointer
 *   none  no object, only the world's dark wash
 *
 * COST, by construction
 *   · the canvas is the hero's box, not the viewport, and scrolls with it
 *   · one program per page (only the chosen variant is compiled), at most
 *     two draw calls a frame, zero per-frame uploads
 *   · DPR capped at 1.5 (1 on a phone or a coarse pointer), and a governor
 *     that drops the backing store to half when frames run long
 *   · the loop runs only while the hero is on screen; with no scroll, pointer
 *     or key for a few seconds it drops to 30 fps, and after a while it stops
 *     until the next input
 *   · reduced motion: one still frame, never a loop
 *
 * Hand-rolled WebGL rather than three.js for the same reason as before: zero
 * external origins, and the payload budget in tests/build/payload.test.ts.
 */
---

<div class="hero-crystal" data-hero-crystal aria-hidden="true">
  <canvas class="hero-crystal__canvas"></canvas>
</div>

<script>
  /* Tagged so `src/lib/vite-glsl-strip.mjs` ships the GLSL without its
   * comments; at runtime `String.raw` is an identity for these literals. */
  const glsl = String.raw;

  type Variant = 'a' | 'b' | 'c' | 'none';
  const VARIANTS: readonly Variant[] = ['a', 'b', 'c', 'none'];

  /** No input for this long and the loop drops to 30 fps… */
  const IDLE_SLOW_MS = 2500;
  /** …and for this long, it stops until the next input. */
  const IDLE_STOP_MS = 15000;

  /** The object's half-height in CSS px: at most this, at least the floor,
   *  and never more than ~0.62 of the headline's height. */
  const RADIUS_MAX = 90;
  const RADIUS_MIN = 44;
  /** Clear space kept between the object and any block of copy. */
  const GAP = 28;

  function pickVariant(): Variant {
    const q = new URLSearchParams(window.location.search).get('crystal');
    return VARIANTS.includes(q as Variant) ? (q as Variant) : 'a';
  }

  /* ---------------------------------------------------------------- *
   * Shaders
   * ---------------------------------------------------------------- */

  /* Meshes (a and b). The camera sits on +Z looking at the origin; uOff
     moves the projected object onto the headline in NDC, so placement never
     touches the perspective. */
  const MESH_VERT = glsl`
    precision highp float;
    attribute vec3 aPos;
    attribute vec3 aNrm;
    attribute vec3 aEdge;
    uniform mat4 uProj;
    uniform mat4 uModel;
    /* mediump: a uniform both stages declare must agree on precision. */
    uniform mediump float uCamZ;
    uniform vec2 uOff;
    varying vec3 vN;
    varying vec3 vP;
    varying vec3 vE;
    void main() {
      vec4 wp = uModel * vec4(aPos, 1.0);
      vN = normalize((uModel * vec4(aNrm, 0.0)).xyz);
      vP = wp.xyz;
      vE = aEdge;
      gl_Position = uProj * vec4(wp.xyz - vec3(0.0, 0.0, uCamZ), 1.0);
      gl_Position.xy += uOff * gl_Position.w;
    }
  `;

  /* a — the edges are the object. Each fragment knows its distance to the
     nearest real edge (baked per corner, see mesh()); fwidth turns that into
     a line of constant pixel width at any size. Faces keep only a breath of
     film, stronger at grazing angles, so the volume reads without filling. */
  const EDGE_FRAG = glsl`
    #extension GL_OES_standard_derivatives : enable
    precision mediump float;
    uniform vec3 uColor;
    uniform float uLight;
    uniform float uCamZ;
    varying vec3 vN;
    varying vec3 vP;
    varying vec3 vE;
    void main() {
      float ed = min(min(vE.x, vE.y), vE.z);
      #ifdef GL_OES_standard_derivatives
      float w = max(fwidth(ed), 1e-4);
      #else
      float w = 0.012;
      #endif
      float line = 1.0 - smoothstep(w * 0.7, w * 2.0, ed);
      float glow = 1.0 - smoothstep(0.0, w * 10.0, ed);
      vec3 n = normalize(vN);
      if (!gl_FrontFacing) n = -n;
      vec3 V = normalize(vec3(0.0, 0.0, uCamZ) - vP);
      float fres = pow(1.0 - abs(dot(n, V)), 3.0);
      float back = gl_FrontFacing ? 1.0 : 0.4;
      float film = 0.03 + 0.09 * fres;
      float a = (line * 0.8 + glow * glow * mix(0.22, 0.12, uLight) + film) * back;
      a = clamp(a, 0.0, 1.0);
      vec3 col = mix(uColor, vec3(1.0), line * 0.3 * (1.0 - uLight));
      gl_FragColor = vec4(col * a, a);
    }
  `;

  /* b — matte metal. Two soft lights, a wide low highlight, a brand rim at
     grazing angles and a faint bevel on the real edges. Opaque, depth-tested. */
  const METAL_FRAG = glsl`
    #extension GL_OES_standard_derivatives : enable
    precision mediump float;
    uniform vec3 uBase;
    uniform vec3 uColor;
    uniform float uLight;
    uniform float uCamZ;
    varying vec3 vN;
    varying vec3 vP;
    varying vec3 vE;
    void main() {
      vec3 n = normalize(vN);
      vec3 V = normalize(vec3(0.0, 0.0, uCamZ) - vP);
      vec3 L1 = normalize(vec3(-0.5, 0.75, 0.65));
      vec3 L2 = normalize(vec3(0.7, -0.25, 0.45));
      float d1 = max(dot(n, L1), 0.0);
      float d2 = max(dot(n, L2), 0.0);
      float spec = pow(max(dot(n, normalize(L1 + V)), 0.0), 16.0);
      float fres = pow(1.0 - max(dot(n, V), 0.0), 2.5);
      vec3 col = uBase * (0.26 + 0.6 * d1 + 0.2 * d2)
        + vec3(spec) * mix(0.28, 0.18, uLight)
        + uColor * fres * mix(0.7, 0.45, uLight);
      float ed = min(min(vE.x, vE.y), vE.z);
      #ifdef GL_OES_standard_derivatives
      float w = max(fwidth(ed), 1e-4);
      #else
      float w = 0.01;
      #endif
      col += vec3(1.0) * (1.0 - smoothstep(w * 0.5, w * 1.5, ed)) * mix(0.14, 0.08, uLight);
      gl_FragColor = vec4(col, 1.0);
    }
  `;

  /* c — a glass sphere, solved per pixel on one quad around it: Fresnel rim,
     a highlight that leans with the pointer, light pooling on the far side,
     and a soft halo outside. Analytic, so no mesh and no MSAA. */
  const ORB_VERT = glsl`
    precision highp float;
    attribute vec2 aCorner;
    uniform vec2 uCenter;
    uniform vec2 uHalf;
    uniform mediump float uSpan;
    varying vec2 vP;
    void main() {
      vP = aCorner * uSpan;
      gl_Position = vec4(uCenter + aCorner * uHalf, 0.0, 1.0);
    }
  `;

  const ORB_FRAG = glsl`
    precision mediump float;
    uniform vec3 uColor;
    uniform float uLight;
    uniform float uSpan;
    uniform float uBreath;
    uniform vec2 uTilt;
    varying vec2 vP;
    void main() {
      float r = length(vP);
      float halo = exp(-2.4 * max(r - 0.9, 0.0)) * (1.0 - smoothstep(uSpan * 0.55, uSpan, r));
      float ha = halo * mix(0.16, 0.1, uLight) * uBreath;
      vec4 outC = vec4(uColor * ha, ha);
      if (r < 1.0) {
        vec3 n = vec3(vP, sqrt(1.0 - r * r));
        float fres = pow(1.0 - n.z, 2.4);
        vec3 L = normalize(vec3(-0.45 + uTilt.x * 0.35, 0.6 + uTilt.y * 0.35, 0.7));
        float spec = pow(max(dot(reflect(-L, n), vec3(0.0, 0.0, 1.0)), 0.0), 60.0);
        float pool = pow(max(dot(n, normalize(vec3(-L.xy, 0.5))), 0.0), 3.0);
        float edge = 1.0 - smoothstep(0.985, 1.0, r);
        float sa = (0.05 + fres * mix(0.6, 0.5, uLight) + pool * 0.12) * edge;
        vec3 sc = mix(uColor, vec3(1.0), fres * mix(0.35, 0.0, uLight));
        vec4 glass = vec4(sc * sa, sa);
        float s = spec * mix(0.9, 0.55, uLight) * edge;
        glass = vec4(glass.rgb * (1.0 - s) + vec3(s), glass.a + s * (1.0 - glass.a));
        outC = glass + outC * (1.0 - glass.a);
      }
      gl_FragColor = outC;
    }
  `;

  /* ---------------------------------------------------------------- *
   * Geometry
   * ---------------------------------------------------------------- */

  type V3 = number[];

  /**
   * Flat-shaded triangles, nine floats per corner: position, normal, and the
   * corner's height to each of the triangle's three edges (zero on the edges
   * it touches), which interpolates to the distance from any point on the
   * face to each edge. `keep` bit i says whether the edge opposite corner i is
   * a real edge; the others (fan spokes, quad diagonals, soft seams) are held
   * far away so they never draw.
   */
  function mesh(build: (tri: (a: V3, b: V3, c: V3, keep: number, centre: V3) => void) => void) {
    const MASK = 9;
    const out: number[] = [];
    build((A, B, C, keep, centre) => {
      const sub = (p: V3, q: V3) => [p[0] - q[0], p[1] - q[1], p[2] - q[2]];
      const u = sub(B, A);
      const w = sub(C, A);
      let n = [u[1] * w[2] - u[2] * w[1], u[2] * w[0] - u[0] * w[2], u[0] * w[1] - u[1] * w[0]];
      const mid = [(A[0] + B[0] + C[0]) / 3 - centre[0], (A[1] + B[1] + C[1]) / 3 - centre[1], (A[2] + B[2] + C[2]) / 3 - centre[2]];
      /* Wound outward (CCW from outside), so the cull passes are honest. */
      if (n[0] * mid[0] + n[1] * mid[1] + n[2] * mid[2] < 0) {
        [B, C] = [C, B];
        keep = (keep & 1) | ((keep & 2) << 1) | ((keep & 4) >> 1);
        n = [-n[0], -n[1], -n[2]];
      }
      const l = Math.hypot(n[0], n[1], n[2]) || 1;
      const P = [A, B, C];
      for (let i = 0; i < 3; i++) {
        const e = [0, 0, 0];
        for (let j = 0; j < 3; j++) {
          if (!(keep & (1 << j))) e[j] = MASK;
          else if (j === i) {
            const o0 = P[(j + 1) % 3];
            const o1 = P[(j + 2) % 3];
            e[j] = l / (Math.hypot(o1[0] - o0[0], o1[1] - o0[1], o1[2] - o0[2]) || 1);
          }
        }
        out.push(P[i][0], P[i][1], P[i][2], n[0] / l, n[1] / l, n[2] / l, e[0], e[1], e[2]);
      }
    });
    return new Float32Array(out);
  }

  /** a — an octahedron drawn out along Y: eight facets, twelve edges. */
  function gem() {
    const v = [[1, 0, 0], [-1, 0, 0], [0, 1.3, 0], [0, -1.3, 0], [0, 0, 1], [0, 0, -1]];
    const f = [
      [0, 2, 4], [2, 1, 4], [1, 3, 4], [3, 0, 4],
      [2, 0, 5], [1, 2, 5], [3, 1, 5], [0, 3, 5],
    ];
    return mesh((tri) => {
      for (const [a, b, c] of f) tri(v[a], v[b], v[c], 7, [0, 0, 0]);
    });
  }

  /**
   * b — the Nexow mark (public/favicon.png, 593×750), traced as two convex
   * outlines: the long spike, a lens from tip to tip, and the short stroke
   * that crosses it. Each is extruded into a slab; the spike's slab is a hair
   * deeper so its faces win where the two overlap, as it does in the mark.
   */
  function mark() {
    const S = 2 / 750;
    const px = (x: number, y: number): [number, number] => [(x - 300) * S, (375 - y) * S];
    /* Spike: tips at the corners of the mark, widest through the crossing. */
    const t0 = px(58, 738);
    const t1 = px(552, 15);
    const dx = t1[0] - t0[0];
    const dy = t1[1] - t0[1];
    const len = Math.hypot(dx, dy);
    const nx = -dy / len;
    const ny = dx / len;
    const half = 15 * S;
    const N = 18;
    const spike: [number, number][] = [];
    for (let k = 0; k <= N; k++) {
      const t = k / N;
      const w = half * Math.pow(Math.sin(Math.PI * t), 0.85);
      spike.push([t0[0] + dx * t + nx * w, t0[1] + dy * t + ny * w]);
    }
    for (let k = N - 1; k >= 1; k--) {
      const t = k / N;
      const w = half * Math.pow(Math.sin(Math.PI * t), 0.85);
      spike.push([t0[0] + dx * t - nx * w, t0[1] + dy * t - ny * w]);
    }
    const stroke = [px(197, 271), px(250, 271), px(395, 482), px(342, 485)];

    return mesh((tri) => {
      const slab = (outline: [number, number][], depth: number, sharpSides: boolean) => {
        const cx = outline.reduce((s, p) => s + p[0], 0) / outline.length;
        const cy = outline.reduce((s, p) => s + p[1], 0) / outline.length;
        const c = [cx, cy, 0];
        const F = outline.map(([x, y]) => [x, y, depth]);
        const B = outline.map(([x, y]) => [x, y, -depth]);
        const n = outline.length;
        /* Front and back: fans, spokes masked. */
        for (const face of [F, B]) {
          for (let i = 1; i < n - 1; i++) {
            tri(face[0], face[i], face[i + 1], 1 | (i === 1 ? 4 : 0) | (i + 1 === n - 1 ? 2 : 0), c);
          }
        }
        /* Sides: two triangles per edge; the rims are real edges, the seams
           between side quads only where the outline actually turns. */
        const seam = (k: number) => sharpSides || k === 0 || k === N;
        for (let i = 0; i < n; i++) {
          const j = (i + 1) % n;
          tri(F[i], F[j], B[j], 4 | (seam(j) ? 1 : 0), c);
          tri(F[i], B[j], B[i], 1 | (seam(i) ? 2 : 0), c);
        }
      };
      slab(spike, 0.075, false);
      slab(stroke, 0.06, true);
    });
  }

  /* ---------------------------------------------------------------- *
   * Maths
   * ---------------------------------------------------------------- */

  function perspective(out: Float32Array, fovy: number, aspect: number, near: number, far: number) {
    const f = 1 / Math.tan(fovy / 2);
    out.fill(0);
    out[0] = f / aspect;
    out[5] = f;
    out[10] = (far + near) / (near - far);
    out[11] = -1;
    out[14] = (2 * far * near) / (near - far);
  }

  /** Yaw, then pitch, then a uniform scale. */
  function model(out: Float32Array, ry: number, rx: number, s: number) {
    const cy = Math.cos(ry);
    const sy = Math.sin(ry);
    const cx = Math.cos(rx);
    const sx = Math.sin(rx);
    out.set([
      cy * s, 0, -sy * s, 0,
      sy * sx * s, cx * s, cy * sx * s, 0,
      sy * cx * s, -sx * s, cy * cx * s, 0,
      0, 0, 0, 1,
    ]);
  }

  function compile(gl: WebGLRenderingContext, vsrc: string, fsrc: string) {
    const prog = gl.createProgram();
    if (!prog) return null;
    for (const [type, src] of [
      [gl.VERTEX_SHADER, vsrc],
      [gl.FRAGMENT_SHADER, fsrc],
    ] as const) {
      const sh = gl.createShader(type);
      if (!sh) return null;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.error('[hero-crystal] shader failed to compile:', gl.getShaderInfoLog(sh));
        return null;
      }
      gl.attachShader(prog, sh);
      gl.deleteShader(sh);
    }
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      console.error('[hero-crystal] program failed to link:', gl.getProgramInfoLog(prog));
      return null;
    }
    return prog;
  }

  /** A token's colour as linear-ish 0..1 RGB, read off a probe outside the world. */
  function readColor(probe: HTMLElement, token: string): [number, number, number] {
    probe.style.color = `var(${token})`;
    const m = getComputedStyle(probe).color.match(/[\d.]+/g);
    if (!m || m.length < 3) return [1, 0.44, 0.22];
    return [Number(m[0]) / 255, Number(m[1]) / 255, Number(m[2]) / 255];
  }

  /* ---------------------------------------------------------------- *
   * The field
   * ---------------------------------------------------------------- */

  type Handle = { stop: () => void };
  let handles: Handle[] = [];

  function start(root: HTMLElement): Handle | null {
    const variant = pickVariant();
    root.dataset.crystal = variant;
    if (variant === 'none') return null;

    const canvas = root.querySelector<HTMLCanvasElement>('canvas');
    const hero = root.parentElement;
    if (!canvas || !hero) return null;

    const gl = canvas.getContext('webgl', {
      alpha: true,
      premultipliedAlpha: true,
      /* The metal mark has hard silhouettes; the lines and the orb are
         antialiased in their shaders and need no MSAA. */
      antialias: variant === 'b',
      depth: variant === 'b',
      powerPreference: 'low-power',
    }) as WebGLRenderingContext | null;
    if (!gl) return null;
    gl.getExtension('OES_standard_derivatives');

    const isMesh = variant !== 'c';
    const prog = isMesh
      ? compile(gl, MESH_VERT, variant === 'a' ? EDGE_FRAG : METAL_FRAG)
      : compile(gl, ORB_VERT, ORB_FRAG);
    if (!prog) return null;
    gl.useProgram(prog);
    const u = (n: string) => gl.getUniformLocation(prog, n);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    let vertexCount = 4;
    if (isMesh) {
      const data = variant === 'a' ? gem() : mark();
      gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
      vertexCount = data.length / 9;
      ([['aPos', 0], ['aNrm', 12], ['aEdge', 24]] as const).forEach(([name, off]) => {
        const loc = gl.getAttribLocation(prog, name);
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 3, gl.FLOAT, false, 36, off);
      });
    } else {
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'aCorner');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    }

    const CAM_Z = 7;
    const FOVY = 0.5;
    const proj = new Float32Array(16);
    const mdl = new Float32Array(16);
    if (isMesh) gl.uniform1f(u('uCamZ'), CAM_Z);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
    if (variant === 'b') {
      gl.disable(gl.BLEND);
      gl.enable(gl.DEPTH_TEST);
      gl.enable(gl.CULL_FACE);
    }

    /* ---- colour: one brand hue, read from the root rather than from
       inside the world, which remaps the brand tokens per section ---- */
    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;opacity:0;pointer-events:none';
    document.body.appendChild(probe);
    let light = 0;
    function paintTheme() {
      light = document.documentElement.classList.contains('dark') ? 0 : 1;
      gl!.uniform3fv(u('uColor'), readColor(probe, light ? '--color-brand-600' : '--color-brand-400'));
      gl!.uniform1f(u('uLight'), light);
      if (variant === 'b') gl!.uniform3fv(u('uBase'), light ? [0.3, 0.32, 0.36] : [0.72, 0.74, 0.78]);
    }
    paintTheme();

    /* ---- size and placement ----
     * Never on the copy. The object stands beside the headline, on its end
     * side, at the height of its two lines; if that column is too narrow it
     * shrinks, then tries the space above the headline, and if there is no
     * room anywhere (a phone, a narrow tablet) it is simply not drawn. */
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const title = hero.querySelector<HTMLElement>('#hero-title');
    const copy = ['#hero-title', '.hero__kicker', '#forge', '.hero__examples']
      .map((sel) => hero.querySelector<HTMLElement>(sel))
      .filter((el): el is HTMLElement => !!el);
    const header = document.querySelector<HTMLElement>('header');
    let cssW = 1;
    let cssH = 1;
    let renderScale = 1;
    /** Where the object stands, in NDC, and its half-height in CSS px. */
    let anchorX = 0;
    let anchorY = 0;
    let radiusPx = 0;
    let placed = false;

    type Box = { l: number; t: number; r: number; b: number };
    /** An element's ink box in hero space. The headline is measured by its
     *  text, not its element, whose 24ch box is wider than the words. */
    function boxOf(el: HTMLElement, h: DOMRect): Box {
      let r = el.getBoundingClientRect();
      if (el === title) {
        const range = document.createRange();
        range.selectNodeContents(el);
        const tr = range.getBoundingClientRect();
        if (tr.width > 0) r = tr;
      }
      return { l: r.left - h.left, t: r.top - h.top, r: r.right - h.left, b: r.bottom - h.top };
    }

    function place() {
      placed = false;
      if (!title) return;
      const h = hero!.getBoundingClientRect();
      const blocks = copy.map((el) => boxOf(el, h));
      const t = blocks[0];
      const rtl = document.documentElement.dir === 'rtl';
      /* Clear of the fixed header, and of the section rail on wide screens. */
      const top = (header?.offsetHeight ?? 72) + 12;
      const inset = cssW >= 1024 ? 96 : 20;
      const fits = (cx: number, cy: number, r: number) =>
        cx - r >= inset &&
        cx + r <= cssW - inset &&
        cy - r >= top &&
        blocks.every((b) => cx + r + GAP <= b.l || cx - r - GAP >= b.r || cy + r + GAP <= b.t || cy - r - GAP >= b.b);
      const maxR = Math.min(RADIUS_MAX, (t.b - t.t) * 0.62);
      const spots = (r: number): [number, number][] => [
        /* Beside the headline, on its end side, level with its two lines. */
        [rtl ? t.l - GAP - r - 1 : t.r + GAP + r + 1, (t.t + t.b) / 2],
        /* Above it, centred. */
        [(t.l + t.r) / 2, t.t - GAP - r - 1],
      ];
      for (let r = maxR; r >= RADIUS_MIN; r -= 4) {
        for (const [cx, cy] of spots(r)) {
          if (!fits(cx, cy, r)) continue;
          anchorX = (cx / cssW) * 2 - 1;
          anchorY = 1 - (cy / cssH) * 2;
          radiusPx = r;
          placed = true;
          /* The slot, in hero px — what the e2e suite checks against the copy. */
          root.dataset.crystalBox = [cx - r, cy - r, cx + r, cy + r].map(Math.round).join(',');
          return;
        }
      }
      delete root.dataset.crystalBox;
    }

    function resize() {
      cssW = Math.max(1, hero!.clientWidth);
      cssH = Math.max(1, hero!.clientHeight);
      const small = coarse || cssW < 768;
      const dpr = Math.min(window.devicePixelRatio || 1, small ? 1 : 1.5) * renderScale;
      canvas!.width = Math.max(1, Math.round(cssW * dpr));
      canvas!.height = Math.max(1, Math.round(cssH * dpr));
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
      place();
      if (isMesh) {
        perspective(proj, FOVY, cssW / cssH, 0.1, 50);
        gl!.uniformMatrix4fv(u('uProj'), false, proj);
      }
    }
    resize();

    /* ---- the loop ---- */
    let raf = 0;
    let onScreen = true;
    let fade = 1;
    let clock = 0;
    let lastTick = 0;
    let lastDraw = 0;
    let lastInput = performance.now();
    let frameEma = 1 / 60;
    let lastGovern = 0;
    let calmSince = 0;
    let ptrAimX = 0;
    let ptrAimY = 0;
    let ptrX = 0;
    let ptrY = 0;

    function draw() {
      const g = gl!;
      g.clearColor(0, 0, 0, 0);
      g.clear(g.COLOR_BUFFER_BIT | (variant === 'b' ? g.DEPTH_BUFFER_BIT : 0));
      if (!placed) return;
      const t = clock;
      if (isMesh) {
        const half = Math.tan(FOVY / 2) * CAM_Z;
        const scale = (radiusPx / (cssH / 2)) * half / (variant === 'a' ? 1.3 : 1);
        if (variant === 'a') {
          model(mdl, t * 0.16 + ptrX * 0.25, 0.32 + Math.sin(t * 0.21) * 0.06 - ptrY * 0.12, scale);
        } else {
          /* A sway, not a spin, and a narrow one: at rest the mark faces the
             reader, and it never turns more than ~20° away (cos 20° ≈ 0.94),
             so the spike and the short stroke always read as two branches
             of an X rather than collapsing into one bar. */
          model(mdl, Math.sin(t * 0.3) * 0.26 + ptrX * 0.08, Math.sin(t * 0.23) * 0.08 - ptrY * 0.06, scale);
        }
        g.uniformMatrix4fv(u('uModel'), false, mdl);
        g.uniform2f(u('uOff'), anchorX, anchorY);
        if (variant === 'a') {
          /* Back faces first, then the front: the far edges sit behind. */
          g.enable(g.CULL_FACE);
          g.cullFace(g.FRONT);
          g.drawArrays(g.TRIANGLES, 0, vertexCount);
          g.cullFace(g.BACK);
          g.drawArrays(g.TRIANGLES, 0, vertexCount);
        } else {
          g.drawArrays(g.TRIANGLES, 0, vertexCount);
        }
      } else {
        /* The glass is half the slot and its halo fills the rest, so the
           glow stops where the clear space around the copy does. */
        const span = 1.7;
        const orb = radiusPx * 0.52;
        const rx = (orb / cssW) * 2;
        const ry = (orb / cssH) * 2;
        /* The orb leans toward the pointer by a tenth of its slot at most;
           with no pointer it drifts on its own, just as slowly. */
        const lean = radiusPx * 0.1;
        const dx = coarse ? Math.sin(t * 0.13) : ptrX;
        const dy = coarse ? Math.sin(t * 0.17 + 1) : ptrY;
        g.uniform2f(u('uCenter'), anchorX + ((dx * lean) / cssW) * 2, anchorY + ((dy * lean) / cssH) * 2);
        g.uniform2f(u('uHalf'), rx * span, ry * span);
        g.uniform1f(u('uSpan'), span);
        g.uniform1f(u('uBreath'), 0.9 + 0.1 * Math.sin(t * 0.5));
        g.uniform2f(u('uTilt'), ptrX, ptrY);
        g.drawArrays(g.TRIANGLE_STRIP, 0, 4);
      }
    }

    function frame(now: number) {
      raf = 0;
      if (!onScreen || fade <= 0 || document.hidden || !placed) return;
      const idleFor = now - lastInput;
      if (idleFor > IDLE_STOP_MS) return;
      /* Calm: half the frames once nothing has moved for a while. */
      if (idleFor > IDLE_SLOW_MS && now - lastDraw < 1000 / 30 - 4) {
        raf = requestAnimationFrame(frame);
        return;
      }
      const raw = lastTick ? (now - lastTick) / 1000 : 0;
      const dt = Math.min(0.05, raw || 1 / 60);
      lastTick = now;
      clock += dt;

      /* Governor: only judged while every frame is drawn. Runs long and the
         backing store steps down, as far as half; comfortable for a while
         and it climbs back. */
      if (raw > 0 && raw < 0.25 && idleFor <= IDLE_SLOW_MS) {
        frameEma += (raw - frameEma) * 0.1;
        if (now - lastGovern > 800) {
          lastGovern = now;
          if (frameEma > 1 / 45 && renderScale > 0.5) {
            renderScale = Math.max(0.5, renderScale - 0.1);
            calmSince = now;
            resize();
          } else if (frameEma < 1 / 57 && renderScale < 1 && now - calmSince > 4000) {
            renderScale = Math.min(1, renderScale + 0.1);
            calmSince = now;
            resize();
          }
        }
      }

      const k = 1 - Math.exp(-2.2 * dt);
      ptrX += (ptrAimX - ptrX) * k;
      ptrY += (ptrAimY - ptrY) * k;
      draw();
      lastDraw = now;
      raf = requestAnimationFrame(frame);
    }

    function wake() {
      if (still || raf || !placed || !onScreen || fade <= 0 || document.hidden) return;
      lastTick = 0;
      raf = requestAnimationFrame(frame);
    }

    function sleep() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    /** Fades out across the hero's own height as the reader scrolls past it. */
    function onScroll() {
      lastInput = performance.now();
      const p = window.scrollY / Math.max(1, cssH);
      const e = Math.min(1, Math.max(0, (p - 0.08) / 0.62));
      const next = 1 - e * e * (3 - 2 * e);
      if (next !== fade) {
        fade = next;
        canvas!.style.opacity = fade.toFixed(3);
      }
      if (fade > 0) wake();
      else sleep();
    }

    function onInput() {
      lastInput = performance.now();
      wake();
    }

    function onPointer(e: PointerEvent) {
      ptrAimX = (e.clientX / window.innerWidth) * 2 - 1;
      ptrAimY = 1 - (e.clientY / window.innerHeight) * 2;
      onInput();
    }

    function onVisibility() {
      if (document.hidden) sleep();
      else onInput();
    }

    let themeRaf = 0;
    function onTheme() {
      if (themeRaf) return;
      themeRaf = requestAnimationFrame(() => {
        themeRaf = 0;
        paintTheme();
        draw();
      });
    }

    const ro = new ResizeObserver(() => {
      resize();
      draw();
      wake();
    });
    ro.observe(hero);
    if (title) ro.observe(title);

    const io = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) wake();
      else sleep();
    });
    io.observe(hero);

    const themeObserver = new MutationObserver(onTheme);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    document.addEventListener('nexow:themechange', onTheme);
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('visibilitychange', onVisibility);
    if (!still) {
      if (!coarse) window.addEventListener('pointermove', onPointer, { passive: true });
      window.addEventListener('keydown', onInput, { passive: true });
      window.addEventListener('touchstart', onInput, { passive: true });
    }
    const onLost = (e: Event) => {
      e.preventDefault();
      sleep();
      root.classList.remove('is-on');
    };
    canvas.addEventListener('webglcontextlost', onLost);

    /* Reduced motion: one composed frame, redrawn only when the theme or
       the size changes. Otherwise the loop. */
    clock = still ? 4 : 0;
    onScroll();
    draw();
    root.classList.add('is-on');
    if (!still) wake();

    return {
      stop() {
        sleep();
        if (themeRaf) cancelAnimationFrame(themeRaf);
        ro.disconnect();
        io.disconnect();
        themeObserver.disconnect();
        document.removeEventListener('nexow:themechange', onTheme);
        window.removeEventListener('scroll', onScroll);
        document.removeEventListener('visibilitychange', onVisibility);
        window.removeEventListener('pointermove', onPointer);
        window.removeEventListener('keydown', onInput);
        window.removeEventListener('touchstart', onInput);
        canvas.removeEventListener('webglcontextlost', onLost);
        probe.remove();
        gl.deleteBuffer(buf);
        gl.deleteProgram(prog);
        gl.getExtension('WEBGL_lose_context')?.loseContext();
      },
    };
  }

  function teardown() {
    for (const h of handles) h.stop();
    handles = [];
  }

  function init() {
    teardown();
    for (const root of document.querySelectorAll<HTMLElement>('[data-hero-crystal]')) {
      const h = start(root);
      if (h) handles.push(h);
    }
  }

  const win = window as unknown as { __nexowCrystalStop?: () => void };
  win.__nexowCrystalStop?.();
  win.__nexowCrystalStop = teardown;

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
  import.meta.hot?.dispose(() => {
    if (win.__nexowCrystalStop === teardown) delete win.__nexowCrystalStop;
    teardown();
  });
</script>

<style>
  /* The hero's own box, behind its veil and its type. Not fixed: it scrolls
   * away with the hero, and nothing below the hero ever has a canvas. */
  .hero-crystal {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out-expo);
  }

  .hero-crystal.is-on {
    opacity: 1;
  }

  /* Opacity here is written from the scroll, so it carries no transition. */
  .hero-crystal__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-crystal {
      transition: none;
    }
  }
</style>
