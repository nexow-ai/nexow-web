---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';
import BotFlowMock from '../BotFlowMock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.automate;
const [bots, agents, copilot] = t.items;
const statusLabel = (s: 'live' | 'soon') => (s === 'live' ? t.liveLabel : t.soonLabel);
---

<section id="automate" class="relative overflow-x-clip bg-white py-20 text-ink-950 sm:py-24 dark:bg-transparent dark:text-white">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="reveal-stagger mt-10 grid gap-4 lg:grid-cols-2">
      <div class="flex flex-col gap-6 rounded-2xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] p-7 shadow-sm shadow-ink-950/[0.03] dark:shadow-black/40 sm:flex-row sm:items-start lg:col-span-2">
        <div class="max-w-sm">
          <div class="flex items-center gap-3">
            <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
              <Icon name={bots.icon} class="size-5.5" />
            </span>
            <span class="badge-status" data-status={bots.status}>
              <span class:list={['size-1.5 rounded-full', bots.status === 'live' ? 'animate-pulse bg-brand-500' : 'bg-accent-500']}></span>
              {statusLabel(bots.status)}
            </span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold text-ink-950 dark:text-white">{bots.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{bots.body}</p>
        </div>
        <div class="min-w-0 flex-1 self-stretch" data-motion="breathe tilt" style="--m-persp:1200px">
          <BotFlowMock />
        </div>
      </div>

      {[agents, copilot].map((item, idx) => (
        <div class="flex flex-col rounded-2xl border border-ink-900/10 dark:border-white/10 bg-[#f7fbfb] dark:bg-white/[0.02] p-7 shadow-sm shadow-ink-950/[0.03] dark:shadow-black/40">
          <div class="flex items-center gap-3">
            <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
              <Icon name={item.icon} class="size-5.5" />
            </span>
            <span class="badge-status" data-status={item.status}>
              <span class:list={['size-1.5 rounded-full', item.status === 'live' ? 'animate-pulse bg-brand-500' : 'bg-accent-500']}></span>
              {statusLabel(item.status)}
            </span>
          </div>
          <h3 class="mt-5 font-display text-xl font-semibold text-ink-950 dark:text-white">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{item.body}</p>

          <div class:list={['mt-5', idx === 0 ? 'flex flex-wrap gap-2' : 'flex flex-col gap-2']} aria-hidden="true">
            {idx === 0
              ? t.harnessChips.map((h) => (
                  <span class="rounded-full border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] px-2.5 py-1 font-mono text-[0.65rem] text-ink-600 dark:text-ink-300">{h}</span>
                ))
              : t.copilotPrompts.map((q) => (
                  <span class="inline-flex items-center gap-2 rounded-lg border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] px-3 py-1.5 font-mono text-[0.7rem] text-ink-600 dark:text-ink-300">
                    <span class="text-brand-600 dark:text-brand-300">›</span> {q}
                  </span>
                ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
