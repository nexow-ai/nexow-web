---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.roadmap;
// The full list reads like an inventory on the home page: keep the three
// strongest shipped proofs and the two nearest milestones.
const items = [
  ...t.items.filter((i) => i.status === 'shipped').slice(0, 3),
  ...t.items.filter((i) => i.status === 'soon').slice(0, 2),
];
---

<section id="roadmap" class="relative bg-[#f7fbfb]/70 py-24 text-ink-950 sm:py-32 dark:bg-white/[0.015] dark:text-white">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="reveal-stagger mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => {
          const shipped = item.status === 'shipped';
          return (
            <div
              class:list={[
                'relative flex flex-col rounded-2xl border p-6 shadow-sm shadow-ink-950/[0.03] dark:shadow-black/40',
                shipped
                  ? 'border-brand-200 dark:border-brand-400/30 bg-white dark:bg-white/[0.04]'
                  : 'border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04]',
              ]}
            >
              <div class="flex items-center justify-between">
                <span
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 font-mono text-[0.65rem] font-medium uppercase tracking-wider',
                    shipped ? 'bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300' : 'bg-sky-50 dark:bg-sky-400/12 text-sky-700 dark:text-sky-300',
                  ]}
                >
                  <span class:list={['size-1.5 rounded-full', shipped ? 'bg-brand-500' : 'animate-pulse bg-sky-500']} />
                  {shipped ? t.shipped : t.soon}
                </span>
                {shipped && <Icon name="check" class="size-4 text-brand-600 dark:text-brand-300" />}
              </div>
              <h3 class="mt-4 font-display text-lg font-semibold text-ink-950 dark:text-white">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{item.body}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
