---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.how;

const STEP_ICONS = ['wand', 'cpu', 'layers'];
---

<section id="how" class="relative overflow-x-clip bg-[#f7fbfb]/70 py-20 text-ink-950 sm:py-24 dark:bg-white/[0.015] dark:text-white">
  <div class="container-page relative">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <ol class="reveal-stagger mt-10 grid gap-5 md:grid-cols-3">
      {
        t.steps.map((step, i) => (
          <li class="relative">
            {i < t.steps.length - 1 && (
              <span class="absolute -right-6 top-10 z-10 hidden text-brand-500/60 md:block" aria-hidden="true">
                <Icon name="arrow" class="size-5" />
              </span>
            )}
            <div
              data-motion="rise"
              style={`--m-shift:${-12 - i * 11}px`}
              class="flex h-full flex-col items-start rounded-2xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] p-7 shadow-sm shadow-ink-950/[0.03] dark:shadow-black/40"
            >
              <div class="flex items-center gap-4">
                <span class="inline-flex size-14 items-center justify-center rounded-2xl bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
                  <Icon name={STEP_ICONS[i]} class="size-6" />
                </span>
                <span class="font-mono text-sm tracking-[0.2em] text-ink-400 dark:text-ink-500">{step.n}</span>
              </div>
              <h3 class="mt-6 font-display text-xl font-semibold text-ink-950 dark:text-white">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600 dark:text-ink-300">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
