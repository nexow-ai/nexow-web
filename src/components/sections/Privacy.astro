---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.privacy;
---

<section class="relative overflow-hidden bg-ink-900 py-24 text-white sm:py-32">
  <div class="pointer-events-none absolute -left-40 top-1/2 size-[500px] -translate-y-1/2 rounded-full bg-[radial-gradient(circle,var(--color-brand-500),transparent_60%)] opacity-15 blur-2xl"></div>
  <div class="container-page relative">
    <div class="grid items-center gap-14 lg:grid-cols-2">
      <!-- Copy -->
      <div class="reveal max-w-xl">
        <span class="eyebrow inline-flex items-center gap-2 text-brand-400">
          <span class="h-px w-6 bg-brand-400/50"></span>
          {t.eyebrow}
        </span>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl md:text-[2.75rem] md:leading-[1.05]">
          {t.title}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-300">{t.body}</p>

        <ul class="mt-8 space-y-3.5">
          {
            t.points.map((p) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-500/20 text-brand-300">
                  <Icon name="check" class="size-3.5" />
                </span>
                <span class="text-sm leading-relaxed text-ink-200">{p}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Visual: private-mode terminal -->
      <div class="reveal">
        <div class="relative mx-auto max-w-md overflow-hidden rounded-2xl border border-white/10 bg-ink-950 shadow-2xl shadow-black/40">
          <div class="flex items-center gap-2 border-b border-white/5 px-4 py-3">
            <Icon name="lock" class="size-4 text-brand-400" />
            <span class="font-mono text-xs text-ink-300">settings · private mode</span>
            <span class="ml-auto rounded-full bg-brand-500/15 px-2 py-0.5 font-mono text-[0.65rem] text-brand-300">local</span>
          </div>
          <div class="space-y-3 p-5 font-mono text-xs">
            <div class="flex items-center justify-between">
              <span class="text-ink-500">anthropic_api_key</span>
              <span class="text-ink-300">sk-ant-••••••••••••</span>
            </div>
            <div class="h-px bg-white/5"></div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500">codegen</span>
              <span class="inline-flex items-center gap-1.5 text-brand-300"><span class="size-1.5 rounded-full bg-brand-400"></span>your browser</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500">widgets · versions · logs</span>
              <span class="text-ink-300">IndexedDB</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500">venue connections</span>
              <span class="text-ink-300">browser-direct</span>
            </div>
            <div class="h-px bg-white/5"></div>
            <div class="flex items-center justify-between">
              <span class="text-ink-400">bytes sent to nexow servers</span>
              <span class="text-lg font-bold text-brand-400">0</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
