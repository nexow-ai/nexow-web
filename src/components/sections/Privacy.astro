---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { localizePath } from '../../i18n/utils';
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import SecurityDiagram from '../SecurityDiagram.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.privacy;
const securityHref = localizePath('/security', lang);
---

<section id="privacy" class="relative overflow-x-clip border-y border-ink-900/5 bg-[#f7fbfb]/70 py-20 text-ink-950 sm:py-24 dark:border-white/8 dark:bg-white/[0.015] dark:text-white">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="aurora-a absolute -left-40 top-1/2 size-[500px] -translate-y-1/2 rounded-full opacity-50 blur-3xl dark:opacity-40"
      style="background:radial-gradient(circle, var(--aurora-1), transparent 60%)"
    ></div>
    <div
      class="aurora-b absolute -right-32 top-[20%] size-[420px] rounded-full opacity-35 blur-3xl dark:opacity-30"
      style="background:radial-gradient(circle, var(--aurora-3), transparent 65%)"
    ></div>
  </div>
  <div class="container-page relative">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-10">
      {/*
        The two columns scroll at different rates (`lead` / `lag` in
        global.css), so the claim and the diagram that illustrates it separate
        and re-align as the band passes instead of travelling as one slab.
      */}
      <!-- Copy -->
      <div class="reveal min-w-0 max-w-xl" data-motion="lead">
        <span class="eyebrow inline-flex items-center gap-2 text-brand-700 dark:text-brand-300">
          <span class="h-px w-6 bg-brand-500/50"></span>
          {t.eyebrow}
        </span>
        <h2 class="mt-3 font-display text-3xl font-semibold tracking-tight sm:text-4xl md:text-[2.75rem] md:leading-[1.05]">
          {t.title}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600 dark:text-ink-300">{t.body}</p>

        <ul class="mt-8 space-y-3.5">
          {
            t.points.map((p) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-400/12 text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
                  <Icon name="check" class="size-3.5" />
                </span>
                <span class="text-sm leading-relaxed text-ink-700 dark:text-ink-200">{p}</span>
              </li>
            ))
          }
        </ul>

        {/*
          Trust marks sit with the boundaries copy rather than in their own band:
          the claim and the audit that backs it read as one statement.
        */}
        <div class="mt-8 border-t border-ink-900/8 pt-6 dark:border-white/10">
          <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-600 dark:text-ink-400">
            {t.certificationsLabel}
          </h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              t.certifications.map((c) => (
                <li class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-800 ring-1 ring-brand-200/80 dark:bg-brand-400/12 dark:text-brand-200 dark:ring-brand-400/25">
                  <Icon name="check" class="size-3" />
                  {c}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8">
          <Button href={securityHref} variant="secondary" size="md" iconRight="arrow">
            {t.cta}
          </Button>
        </div>
      </div>

      <!-- Visual: animated trust-boundary diagram + workspace panel -->
      <div class="reveal relative min-w-0" data-motion="lag">
        <SecurityDiagram />

        <div
          data-motion="breathe tilt"
          style="--m-persp:1200px"
          class="relative z-10 mx-auto mt-2 max-w-sm overflow-hidden rounded-2xl border border-ink-900/10 bg-white shadow-xl shadow-ink-950/10 dark:border-white/10 dark:bg-ink-950/85 dark:shadow-black/50 dark:backdrop-blur-md sm:mt-0 sm:-translate-y-4"
        >
          <div class="flex items-center gap-2 border-b border-ink-900/8 px-4 py-3 dark:border-white/8">
            <Icon name="lock" class="size-4 text-brand-700 dark:text-brand-300" />
            <span class="font-mono text-xs text-ink-500 dark:text-ink-400">settings · workspace security</span>
            <span class="ml-auto rounded-full bg-brand-50 px-2 py-0.5 font-mono text-[0.65rem] text-brand-700 dark:bg-brand-400/12 dark:text-brand-300">scoped</span>
          </div>
          <div class="space-y-3 p-5 font-mono text-xs">
            <div class="flex items-center justify-between">
              <span class="text-ink-500 dark:text-ink-400">credential vault</span>
              <span class="text-ink-700 dark:text-ink-200">encrypted</span>
            </div>
            <div class="h-px bg-ink-900/8 dark:bg-white/8"></div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500 dark:text-ink-400">widget runtime</span>
              <span class="inline-flex items-center gap-1.5 text-brand-700 dark:text-brand-300"><span class="size-1.5 rounded-full bg-brand-500"></span>sandboxed</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500 dark:text-ink-400">widgets · versions · logs</span>
              <span class="text-ink-700 dark:text-ink-200">workspace history</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500 dark:text-ink-400">connections</span>
              <span class="text-ink-700 dark:text-ink-200">least privilege</span>
            </div>
            <div class="h-px bg-ink-900/8 dark:bg-white/8"></div>
            <div class="flex items-center justify-between">
              <span class="text-ink-500 dark:text-ink-400">sync status</span>
              <span class="text-lg font-bold text-brand-700 dark:text-brand-300">ready</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
