---
import { type Lang } from '../../i18n/config';
import { useContent, CONNECTOR_GROUPS } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  /** 'dark' renders the terminal-style variant used on the home page. */
  tone?: 'light' | 'dark';
}
const { lang, tone = 'light' } = Astro.props;
const t = useContent(lang).home.connectors;
const count = t.count;
const dark = tone === 'dark';
---

<section
  id="connectors"
  class:list={['relative py-24 sm:py-32', dark && 'bg-ink-950 text-white']}
>
  {
    !dark && (
      <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(50%_100%_at_50%_0%,var(--color-accent-50),transparent)]" />
    )
  }
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} tone={tone} />

    <div class="reveal mt-6 flex justify-center">
      <span
        class:list={[
          'inline-flex items-baseline gap-2 font-display text-sm',
          dark ? 'text-ink-400' : 'text-ink-500',
        ]}
      >
        <span class="text-gradient text-3xl font-bold">{count}+</span>
        {t.countLabel}
      </span>
    </div>

    <div class="reveal-stagger mx-auto mt-12 max-w-4xl space-y-8">
      {
        CONNECTOR_GROUPS.map((group) => (
          <div>
            <h3
              class:list={[
                'eyebrow flex items-center gap-3',
                dark ? 'text-brand-400' : 'text-brand-600',
              ]}
            >
              {t.groups[group.key]}
              <span class:list={['h-px flex-1', dark ? 'bg-white/10' : 'bg-ink-900/10']} />
            </h3>
            <div class="mt-4 flex flex-wrap gap-2.5">
              {group.venues.map((name) => (
                <span
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full border px-4 py-2 font-mono text-[0.8rem] font-medium transition-all duration-200 hover:-translate-y-0.5',
                    dark
                      ? 'border-white/10 bg-white/[0.03] text-ink-200 hover:border-brand-400/40 hover:bg-white/[0.06]'
                      : 'border-ink-900/8 bg-white text-ink-800 shadow-sm hover:border-brand-500/30 hover:shadow-md',
                  ]}
                >
                  <span class="size-1.5 rounded-full bg-brand-500/80" />
                  {name}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p
      class:list={[
        'reveal mx-auto mt-10 flex max-w-2xl items-start justify-center gap-2 text-center text-sm',
        dark ? 'text-ink-500' : 'text-ink-500',
      ]}
    >
      <Icon name="globe" class="mt-0.5 size-4 shrink-0 opacity-60" />
      {t.note}
    </p>
  </div>
</section>
