---
import { type Lang } from '../../i18n/config';
import { useContent, CONNECTORS } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.connectors;
const count = CONNECTORS.length;
---

<section id="connectors" class="relative py-24 sm:py-32">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(50%_100%_at_50%_0%,var(--color-accent-50),transparent)]"></div>
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="reveal mt-6 flex justify-center">
      <span class="inline-flex items-baseline gap-2 font-display text-sm text-ink-500">
        <span class="text-3xl font-bold text-gradient">{count}+</span>
        {t.eyebrow.toLowerCase()}
      </span>
    </div>

    <div class="reveal-stagger mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
      {
        CONNECTORS.map((name) => (
          <div class="group flex items-center gap-2.5 rounded-xl border border-ink-900/8 bg-white px-4 py-3 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-500/30 hover:shadow-md">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-500/10">
              <Icon name="plug" class="size-3.5" />
            </span>
            <span class="truncate font-mono text-[0.8rem] font-medium text-ink-800">{name}</span>
          </div>
        ))
      }
    </div>

    <p class="reveal mx-auto mt-8 max-w-2xl text-center text-sm text-ink-500">{t.note}</p>
  </div>
</section>
