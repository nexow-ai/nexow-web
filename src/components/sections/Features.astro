---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { localizePath } from '../../i18n/utils';
import { resolveFeatureMapGroups } from '../../lib/featureMap';
import SectionHeading from '../SectionHeading.astro';
import FeatureMap from '../FeatureMap.astro';
import Button from '../Button.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.features;
const en = useContent('en').home.features;
const explore = useContent(lang).nav.links.find((l) => l.href === '/features')?.label ?? 'Features';
const mapUi = t.map ?? en.map!;
const groups = resolveFeatureMapGroups(t, en);
---

<section id="features" class="relative overflow-x-clip bg-[#f7fbfb] py-20 text-ink-950 sm:py-24 dark:bg-white/[0.015] dark:text-white">
  <div class="container-page relative">
    <!-- Plain ink title + solid eyebrow (no gradient text / chip fill) -->
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="mt-10 sm:mt-12">
      <FeatureMap
        lang={lang}
        groups={groups}
        hint={mapUi.hint}
        moreLabel={mapUi.moreLabel}
        openLabel={mapUi.openLabel}
        closeLabel={mapUi.closeLabel}
      />
    </div>

    <div class="reveal mt-12 flex justify-center sm:mt-14">
      <Button href={localizePath('/features', lang)} variant="gradient" iconRight="arrow">
        {explore}
      </Button>
    </div>
  </div>
</section>
