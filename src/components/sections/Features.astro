---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home.features;

const items = t.items;
---

<section id="features" class="relative overflow-hidden bg-[#f7fbfb] py-20 text-ink-950 sm:py-24">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute inset-0 opacity-35 [mask-image:radial-gradient(70%_55%_at_50%_20%,black,transparent)]"
      style="background-image:linear-gradient(to right, color-mix(in oklab, var(--color-brand-300) 12%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in oklab, var(--color-sky-300) 10%, transparent) 1px, transparent 1px); background-size:56px 56px"
    ></div>
  </div>

  <div class="container-page relative">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} subtitle={t.subtitle} />

    <div class="reveal-stagger mt-10 grid gap-4 md:grid-cols-2">
      {
        items.map((item, i) => (
          <article class:list={[
            'rounded-2xl border border-ink-900/10 bg-white p-6 shadow-sm shadow-ink-950/[0.03]',
            i === 0 && 'md:col-span-2 lg:col-span-1',
          ]}>
            <div class="flex items-start gap-4">
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-200/80">
                <Icon name={item.icon} class="size-5.5" />
              </span>
              <div>
                <h3 class="font-display text-xl font-semibold text-ink-950">{item.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
              </div>
            </div>

            {i === 0 && (
              <div class="mt-6 rounded-xl border border-ink-900/10 bg-[#f7fbfb] p-4 font-mono text-[0.72rem] leading-relaxed text-ink-700">
                <p><span class="text-brand-700">prompt</span> make a soft habit planner with streaks</p>
                <div class="my-3 h-px bg-ink-900/8"></div>
                <p><span class="text-sky-700">widget</span> generated · sandboxed · saved to library</p>
              </div>
            )}

            {i === 3 && (
              <div class="mt-6 grid grid-cols-3 gap-2 rounded-xl border border-ink-900/10 bg-[#f7fbfb] p-3">
                <div class="col-span-2 flex h-14 items-end gap-1 rounded-lg bg-white p-2">
                  {[35, 55, 40, 70, 52, 80].map((v) => (
                    <span class="w-full rounded-sm bg-brand-300" style={`height:${v}%`}></span>
                  ))}
                </div>
                <div class="rounded-lg bg-sky-100"></div>
                <div class="rounded-lg border border-dashed border-ink-900/15 p-2 text-center font-mono text-[0.6rem] text-ink-500">
                  + widget
                </div>
                <div class="col-span-2 rounded-lg bg-brand-100"></div>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
