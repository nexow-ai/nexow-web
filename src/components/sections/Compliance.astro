---
/**
 * Audited standards on /security.
 *
 * The status pill deliberately distinguishes a certification an accredited
 * auditor issues from a regulation we comply with — GDPR is the latter, and
 * conflating the two is the usual way a trust page stops being trustworthy.
 */
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { localizePath } from '../../i18n/utils';
import Icon from '../Icon.astro';
import Button from '../Button.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).securityPage!.compliance;
---

{/* Only a top rule — the principles section below supplies the next one. */}
<section
  id="compliance"
  class="scroll-mt-20 border-t border-ink-900/5 py-16 sm:py-20 dark:border-white/8"
>
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="eyebrow inline-flex items-center gap-2 text-brand-700 dark:text-brand-300">
        <span class="h-px w-6 bg-brand-500/50"></span>
        {t.eyebrow}
        <span class="h-px w-6 bg-brand-500/50"></span>
      </span>
      <h2 class="mt-3 font-display text-2xl font-semibold text-ink-950 sm:text-3xl dark:text-white">
        {t.title}
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-600 dark:text-ink-300">{t.subtitle}</p>
    </div>

    <ul class="reveal-stagger mx-auto mt-12 grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item) => (
          <li class="flex flex-col rounded-2xl border border-ink-900/10 bg-white p-6 shadow-sm shadow-ink-950/[0.03] dark:border-white/10 dark:bg-white/[0.04] dark:shadow-black/40">
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700 ring-1 ring-brand-200/80 dark:bg-brand-400/12 dark:text-brand-300 dark:ring-brand-400/25">
              <Icon name={item.icon} class="size-5" />
            </span>

            <h3 class="mt-4 font-display text-lg font-semibold text-ink-950 dark:text-white">
              {item.standard}
            </h3>

            <span class="mt-2 inline-flex w-fit items-center gap-1.5 rounded-full bg-brand-50 px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-wider text-brand-800 ring-1 ring-brand-200/80 dark:bg-brand-400/12 dark:text-brand-200 dark:ring-brand-400/25">
              <Icon name="check" class="size-3" />
              {item.status}
            </span>

            <p class="mt-3 text-sm leading-relaxed text-ink-700 dark:text-ink-300">{item.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="reveal mx-auto mt-10 flex max-w-2xl flex-col items-center gap-6 text-center">
      <p class="text-sm leading-relaxed text-ink-600 dark:text-ink-400">{t.note}</p>
      {/*
        Deep-link the topic so a report request arrives routed rather than
        defaulting to "Support"; the contact page preselects a known `type`.
      */}
      <Button
        href={`${localizePath('/contact', lang)}?type=sales`}
        variant="secondary"
        size="md"
        iconRight="arrow"
      >
        {t.cta}
      </Button>
    </div>
  </div>
</section>
