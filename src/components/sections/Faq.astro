---
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import SectionHeading from '../SectionHeading.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  /** Override the FAQ list (used by the plans page). */
  items?: { q: string; a: string }[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  /** 'dark' renders the terminal-style variant used on the home page. */
  tone?: 'light' | 'dark';
  /** Shared <details name> so only one item is open at a time. */
  group?: string;
}
const { lang, tone = 'light', group = 'faq' } = Astro.props;
const home = useContent(lang).home.faq;
const items = Astro.props.items ?? home.items;
const eyebrow = Astro.props.eyebrow ?? home.eyebrow;
const title = Astro.props.title ?? home.title;
const subtitle = Astro.props.subtitle ?? home.subtitle;
const dark = tone === 'dark';
---

<section id="faq" class:list={['py-20 sm:py-24', dark && 'text-white']}>
  <div class="container-page">
    <SectionHeading eyebrow={eyebrow} title={title} subtitle={subtitle} tone={tone} />

    <div
      class:list={[
        'reveal mx-auto mt-10 max-w-3xl divide-y rounded-2xl border',
        dark
          ? 'divide-white/8 border-white/10 bg-white/[0.02]'
          : 'divide-ink-900/8 dark:divide-white/8 border-ink-900/8 dark:border-white/8 bg-white dark:bg-white/[0.04]',
      ]}
    >
      {
        items.map((item) => (
          <details name={group} class="group px-5 sm:px-6">
            <summary
              class:list={[
                'flex cursor-pointer list-none items-center justify-between gap-4 py-5 outline-none transition-colors [&::-webkit-details-marker]:hidden',
                'focus-visible:rounded-lg focus-visible:ring-2 focus-visible:ring-brand-400/50 focus-visible:ring-offset-2',
                dark ? 'focus-visible:ring-offset-ink-950' : 'focus-visible:ring-offset-white dark:focus-visible:ring-offset-ink-950',
              ]}
            >
              <span
                class:list={[
                  'font-display text-base font-semibold text-balance',
                  dark ? 'text-white' : 'text-ink-950 dark:text-white',
                ]}
              >
                {item.q}
              </span>
              <span
                class:list={[
                  'inline-flex size-7 shrink-0 items-center justify-center rounded-full transition-transform duration-300 group-open:rotate-180',
                  dark ? 'bg-white/8 text-ink-300' : 'bg-ink-900/5 dark:bg-white/8 text-ink-500 dark:text-ink-400',
                ]}
                aria-hidden="true"
              >
                <Icon name="chevron" class="size-4" />
              </span>
            </summary>
            <p
              class:list={[
                'pb-5 pr-11 text-sm leading-relaxed text-pretty',
                dark ? 'text-ink-400 dark:text-ink-500' : 'text-ink-600 dark:text-ink-300',
              ]}
            >
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
