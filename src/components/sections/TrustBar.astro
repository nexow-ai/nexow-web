---
import { type Lang } from '../../i18n/config';
import { useContent, CONNECTORS } from '../../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).home;
// Duplicate the list so the marquee can loop seamlessly at -50%.
const loop = [...CONNECTORS, ...CONNECTORS];
---

<section class="border-y border-ink-900/5 bg-slate-50/70 py-8" aria-label={t.ticker.label}>
  <div class="container-page">
    <p class="text-center text-sm text-ink-500">{t.trust}</p>
  </div>
  <div
    class="group relative mt-6 overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]"
  >
    <div class="flex w-max animate-marquee items-center gap-3 group-hover:[animation-play-state:paused]">
      {
        loop.map((name) => (
          <span class="inline-flex shrink-0 items-center gap-2 rounded-full border border-ink-900/8 bg-white px-4 py-2 font-mono text-sm text-ink-600 shadow-sm">
            <span class="size-1.5 rounded-full bg-brand-500/70" />
            {name}
          </span>
        ))
      }
    </div>
  </div>
</section>
