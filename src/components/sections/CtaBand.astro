---
import { SITE, type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { localizePath } from '../../i18n/utils';
import Button from '../Button.astro';
import BrandMark from '../BrandMark.astro';

interface Props {
  lang: Lang;
  /** Use the generic home CTA (default) or provide explicit copy. */
  title?: string;
  subtitle?: string;
  primary?: string;
  secondary?: string;
  secondaryHref?: string;
}
const { lang } = Astro.props;
const home = useContent(lang).home.cta;
const title = Astro.props.title ?? home.title;
const subtitle = Astro.props.subtitle ?? home.subtitle;
const primary = Astro.props.primary ?? home.primary;
const secondary = Astro.props.secondary ?? home.secondary;
const secondaryHref = Astro.props.secondaryHref ?? localizePath('/features', lang);
---

<section class="relative overflow-hidden bg-white py-20 text-ink-950 sm:py-28">
  <!-- Backdrop: soft grid + wash -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hairline-gold absolute inset-x-0 top-0 opacity-70"></div>
    <div
      class="absolute inset-0 opacity-35 [mask-image:radial-gradient(60%_60%_at_50%_50%,black,transparent)]"
      style="background-image:linear-gradient(to right, color-mix(in oklab, var(--color-brand-300) 12%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in oklab, var(--color-sky-300) 10%, transparent) 1px, transparent 1px); background-size:56px 56px"
    ></div>
    <div
      class="aurora-a absolute left-1/2 top-1/2 size-[700px] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-45 blur-3xl"
      style="background:radial-gradient(circle, var(--color-brand-100), transparent 60%)"
    >
    </div>
    <div
      class="aurora-b absolute left-[30%] top-1/2 size-[500px] -translate-y-1/2 rounded-full opacity-30 blur-3xl"
      style="background:radial-gradient(circle, var(--color-sky-100), transparent 60%)"
    >
    </div>
  </div>

  <div class="container-page relative">
    <div class="reveal mx-auto flex max-w-2xl flex-col items-center text-center">
      <span data-motion="breathe-lg" class="inline-block">
        <BrandMark class="h-16 w-auto" title="Nexow" />
      </span>
      <h2 class="mt-8 text-balance font-display text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
        {title}
      </h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-600">{subtitle}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button href={SITE.appUrl} size="lg" external iconRight="arrow">
          {primary}
        </Button>
        <Button href={secondaryHref} variant="secondary" size="lg">
          {secondary}
        </Button>
      </div>
    </div>
  </div>
</section>
