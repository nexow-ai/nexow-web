---
/**
 * The badge vault — all 34 achievements, flippable.
 *
 * Front: hex medallion, badge name, how-to (the action that earns it), unlock
 * thresholds beside each tier, and the reward ladder payout (points, credits,
 * NXW). Back: denser TRACKS + UNLOCKS AT detail with the same per-tier rewards.
 *
 * Flip is CSS on hover/focus; the click handler toggles `data-flipped` so touch
 * visitors get the same card back without a hover state to fight.
 */
import { type Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import {
  TIERED_BADGES,
  RARE_BADGES,
  LEGENDARY_BADGES,
  RARITY_COLORS,
  RARITY_POINTS,
  REWARD_LADDER,
  type BadgeSpec,
  type RewardRow,
} from '../../data/gamification';
import Icon from '../Icon.astro';
import Hex from '../Hex.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const rewards = useContent(lang).rewards;
const t = rewards.badges;
const ledger = rewards.ledger;

const badges: BadgeSpec[] = [...TIERED_BADGES, ...RARE_BADGES, ...LEGENDARY_BADGES];

const RARITIES = [
  { key: 'tiered' as const, icon: 'award', count: TIERED_BADGES.length },
  { key: 'rare' as const, icon: 'gem', count: RARE_BADGES.length },
  { key: 'legendary' as const, icon: 'crown', count: LEGENDARY_BADGES.length },
];

const FILTERS = [
  { key: 'all', count: badges.length },
  ...RARITIES.map((r) => ({ key: r.key, count: r.count })),
];

/** Ink that stays legible on each rarity's gradient. */
const INK: Record<string, string> = { tiered: '#3d2b05', rare: '#eff6ff', legendary: '#f6efff' };

/** Tier labels for the card back — tiered badges list three, medals list one. */
const tierLabels = [t.tiers.bronze, t.tiers.silver, t.tiers.gold];

const TIER_KEYS = ['bronze', 'silver', 'gold'] as const;

/** Ladder rows that apply to a badge — three tiers, or one medal payout. */
function rewardRowsFor(badge: BadgeSpec): RewardRow[] {
  if (badge.rarity === 'tiered') {
    return REWARD_LADDER.filter((r) => (TIER_KEYS as readonly string[]).includes(r.key));
  }
  return REWARD_LADDER.filter((r) => r.key === badge.rarity);
}

const nf = (n: number) => n.toLocaleString(lang);

/** Short tier label on the dense front face. */
const tierShort: Record<(typeof TIER_KEYS)[number], string> = {
  bronze: t.tiers.bronze,
  silver: t.tiers.silver,
  gold: t.tiers.gold,
};
---

<section class="relative overflow-hidden bg-ink-950 py-16 text-white">
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-[0.35]" aria-hidden="true"></div>

  <div class="container-page relative">
    <div class="reveal flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-xl">
        <h3 class="font-display text-2xl font-semibold text-white sm:text-3xl">{t.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-300">{t.body}</p>
      </div>
      <p class="shrink-0 font-mono text-xs text-ink-400">{t.flipHint}</p>
    </div>

    <!-- Rarity legend -->
    <div class="reveal-stagger mt-8 grid gap-3 sm:grid-cols-3">
      {
        RARITIES.map((r, i) => {
          const bronze = REWARD_LADDER.find((row) => row.key === 'bronze')!;
          const gold = REWARD_LADDER.find((row) => row.key === 'gold')!;
          const medal = REWARD_LADDER.find((row) => row.key === r.key);
          return (
            <div
              class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.03] p-4"
              style={`--from:${RARITY_COLORS[r.key].from};--to:${RARITY_COLORS[r.key].to}`}
            >
              <Hex
                icon={r.icon}
                from={RARITY_COLORS[r.key].from}
                to={RARITY_COLORS[r.key].to}
                ink={INK[r.key]}
                size="lg"
                delay={i * 400}
                class="hex-float"
              />
              <div class="min-w-0">
                <p class="flex flex-wrap items-center gap-2 font-display text-sm font-semibold text-white">
                  {t.rarity[r.key]}
                  <span class="rounded-full bg-white/[0.07] px-1.5 py-0.5 font-mono text-[0.6rem] font-medium text-ink-300">
                    {t.worth.replace('{n}', String(RARITY_POINTS[r.key]))}
                  </span>
                </p>
                <p class="mt-1 text-xs leading-relaxed text-ink-400">{t.rarityBody[r.key]}</p>
                <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-0.5 font-mono text-[0.65rem]">
                  {r.key === 'tiered' ? (
                    <>
                      <span class="text-brand-300">
                        {nf(bronze.credits)}–{nf(gold.credits)} {ledger.creditsLabel}
                      </span>
                      <span class="text-ink-600" aria-hidden="true">·</span>
                      <span class="text-accent-300">
                        {nf(bronze.tokens)}–{nf(gold.tokens)} {ledger.tokensLabel}
                      </span>
                    </>
                  ) : (
                    <>
                      <span class="text-brand-300">{nf(medal!.credits)} {ledger.creditsLabel}</span>
                      <span class="text-ink-600" aria-hidden="true">·</span>
                      <span class="text-accent-300">{nf(medal!.tokens)} {ledger.tokensLabel}</span>
                    </>
                  )}
                </p>
              </div>
            </div>
          );
        })
      }
    </div>

    <!-- Filters -->
    <div id="badge-filters" class="reveal mt-8 flex flex-wrap items-center gap-2">
      {
        FILTERS.map((f, i) => (
          <button
            type="button"
            data-badge-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="inline-flex items-center gap-1.5 rounded-full border border-white/12 px-3.5 py-1.5 text-sm font-medium text-ink-300 transition-colors hover:border-white/25 hover:text-white aria-[pressed=true]:border-transparent aria-[pressed=true]:bg-white aria-[pressed=true]:text-ink-950"
          >
            {t.filters[f.key as keyof typeof t.filters]}
            <span class="font-mono text-[0.65rem] opacity-60">{f.count}</span>
          </button>
        ))
      }
    </div>

    <!-- The vault -->
    <div id="badge-grid" class="mt-6 grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
      {
        badges.map((badge, i) => {
          const colors = RARITY_COLORS[badge.rarity];
          const tiered = badge.rarity === 'tiered';
          const rows = rewardRowsFor(badge);
          const track = t.stats[badge.stat];
          const how = t.how?.[badge.stat] ?? track;
          return (
            <button
              type="button"
              class="flip group min-h-64 w-full text-left"
              data-badge
              data-rarity={badge.rarity}
              data-flipped="false"
              aria-label={`${t.names[badge.id]} — ${how}; ${t.unlocks} ${badge.thresholds.map((n) => nf(n)).join(', ')}`}
            >
              <span class="flip-inner block h-full min-h-64 w-full">
                {/* Front — how-to + exact thresholds + rewards always visible */}
                <span
                  class="flip-face relative z-[1] flex h-full min-h-64 w-full flex-col rounded-xl border border-white/10 bg-white/[0.03] p-2.5 transition-colors group-hover:border-white/20"
                  style={`background-image:linear-gradient(180deg, color-mix(in oklab, ${colors.to} 16%, transparent), transparent 55%)`}
                >
                  <span class="flex flex-col items-center gap-2 text-center">
                    <span class="relative my-0.5">
                      <span
                        class="aura pointer-events-none absolute -inset-4 rounded-full blur-lg"
                        style={`background:radial-gradient(circle, ${colors.to}, transparent 70%);--d:${(i % 8) * 300}ms`}
                        aria-hidden="true"
                      />
                      <Hex
                        icon={badge.icon}
                        from={colors.from}
                        to={colors.to}
                        ink={INK[badge.rarity]}
                        size="lg"
                        delay={(i % 8) * 300}
                        class="hex-float"
                      />
                    </span>
                    <span class="font-display text-xs font-semibold leading-tight text-white">{t.names[badge.id]}</span>
                    <span class="block text-[0.6rem] leading-snug text-ink-300">{how}</span>
                  </span>

                  <span class="mt-auto flex w-full flex-col gap-1 border-t border-white/[0.06] pt-2">
                    <span class="block text-[0.55rem] uppercase tracking-wider text-ink-500">{t.unlocks}</span>
                    {tiered ? (
                      <span class="flex flex-col gap-1">
                        {rows.map((row, ri) => (
                          <span class="grid grid-cols-[auto_minmax(0,1fr)_auto_auto] items-baseline gap-x-1.5 font-mono text-[0.58rem] leading-none">
                            <span class="flex items-center gap-1 text-ink-400">
                              <span
                                class="size-1 shrink-0 rounded-full"
                                style={`background:${RARITY_COLORS[row.key as (typeof TIER_KEYS)[number]].from}`}
                                aria-hidden="true"
                              />
                              <span class="truncate">{tierShort[row.key as (typeof TIER_KEYS)[number]]}</span>
                            </span>
                            <span class="tabular-nums text-xs font-semibold text-white">{nf(badge.thresholds[ri])}</span>
                            <span class="tabular-nums text-brand-300">{nf(row.credits)}</span>
                            <span class="w-4 text-end tabular-nums text-accent-300">{nf(row.tokens)}</span>
                          </span>
                        ))}
                      </span>
                    ) : (
                      <span class="flex flex-col gap-1">
                        <span class="flex items-baseline justify-between gap-1.5 font-mono text-[0.58rem]">
                          <span class="text-ink-400">{t.rarity[badge.rarity]}</span>
                          <span class="text-xs font-semibold tabular-nums text-white">{nf(badge.thresholds[0])}</span>
                        </span>
                        <span class="flex flex-wrap items-center gap-x-1 gap-y-0.5 font-mono text-[0.58rem]">
                          <span class="text-ink-300">{t.worth.replace('{n}', String(rows[0].points))}</span>
                          <span class="text-ink-600" aria-hidden="true">·</span>
                          <span class="text-brand-300">{nf(rows[0].credits)}</span>
                          <span class="text-ink-600" aria-hidden="true">·</span>
                          <span class="text-accent-300">{nf(rows[0].tokens)} {ledger.tokensLabel}</span>
                        </span>
                      </span>
                    )}
                    {tiered && (
                      <span class="mt-0.5 flex items-center gap-1 text-[0.55rem] text-ink-500">
                        <Icon name="bolt" class="size-2" />
                        {t.worth.replace('{n}', String(RARITY_POINTS.tiered))}
                        <span class="ms-auto text-ink-600">
                          <span class="text-brand-300">{ledger.creditsLabel}</span>
                          {' / '}
                          <span class="text-accent-300">{ledger.tokensLabel}</span>
                        </span>
                      </span>
                    )}
                  </span>
                </span>

                {/* Back — tracks + thresholds + full per-tier rewards */}
                <span
                  class="flip-face flip-back flex h-full min-h-64 w-full flex-col justify-between rounded-xl border p-2.5"
                  style={`border-color:color-mix(in oklab, ${colors.to} 45%, transparent);background-image:linear-gradient(160deg, color-mix(in oklab, ${colors.to} 22%, #0b0d13), #0b0d13)`}
                >
                  <span class="block">
                    <span class="block font-display text-xs font-semibold text-white">{t.names[badge.id]}</span>
                    <span class="mt-1 block text-[0.55rem] uppercase tracking-wider text-ink-400">{t.tracks}</span>
                    <span class="block text-[0.65rem] leading-snug text-ink-200">{track}</span>
                    <span class="mt-1 block text-[0.6rem] leading-snug text-ink-300">{how}</span>
                  </span>

                  <span class="block">
                    <span class="block text-[0.55rem] uppercase tracking-wider text-ink-400">{t.unlocks}</span>
                    <span class="mt-1 flex flex-col gap-1">
                      {badge.thresholds.map((n, ti) => {
                        const row = rows[ti] ?? rows[0];
                        const label = tiered ? tierLabels[ti] : t.rarity[badge.rarity];
                        const pipKey = tiered ? TIER_KEYS[ti] : badge.rarity;
                        return (
                          <span class="block">
                            <span class="flex items-baseline justify-between gap-1.5 font-mono text-[0.62rem]">
                              <span class="flex items-center gap-1 text-ink-300">
                                {tiered && (
                                  <span
                                    class="size-1 rounded-full"
                                    style={`background:${RARITY_COLORS[pipKey].from}`}
                                    aria-hidden="true"
                                  />
                                )}
                                {label}
                              </span>
                              <span class="font-semibold text-white">{n.toLocaleString(lang)}</span>
                            </span>
                            <span class="mt-0.5 flex flex-wrap items-center gap-x-1 ps-2.5 font-mono text-[0.55rem]">
                              <span class="text-ink-400">{t.worth.replace('{n}', String(row.points))}</span>
                              <span class="text-ink-600" aria-hidden="true">·</span>
                              <span class="text-brand-300">{nf(row.credits)} {ledger.creditsLabel}</span>
                              <span class="text-ink-600" aria-hidden="true">·</span>
                              <span class="text-accent-300">{nf(row.tokens)} {ledger.tokensLabel}</span>
                            </span>
                          </span>
                        );
                      })}
                    </span>
                  </span>
                </span>
              </span>
            </button>
          );
        })
      }
    </div>

    <p class="reveal mt-5 text-center font-mono text-xs text-ink-500">
      {t.count.replace('{n}', String(badges.length))}
    </p>
  </div>
</section>

<script>
  // Rarity filter + tap-to-flip. Hover flip is pure CSS; the click handler only
  // exists so touch devices (which have no hover) can still read a card back.
  let vaultAbort: AbortController | undefined;

  function initBadgeVault() {
    vaultAbort?.abort();
    vaultAbort = new AbortController();
    const { signal } = vaultAbort;

    const grid = document.getElementById('badge-grid');
    const filters = document.querySelectorAll<HTMLButtonElement>('[data-badge-filter]');
    if (!grid) return;

    const cards = grid.querySelectorAll<HTMLElement>('[data-badge]');

    filters.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const want = btn.dataset.badgeFilter ?? 'all';
          filters.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.badgeFilter === want)));
          cards.forEach((card) => {
            const match = want === 'all' || card.dataset.rarity === want;
            card.classList.toggle('hidden', !match);
            card.dataset.flipped = 'false';
          });
        },
        { signal },
      );
    });

    cards.forEach((card) => {
      card.addEventListener(
        'click',
        () => {
          const open = card.dataset.flipped === 'true';
          cards.forEach((c) => (c.dataset.flipped = 'false'));
          card.dataset.flipped = open ? 'false' : 'true';
        },
        { signal },
      );
    });
  }

  document.addEventListener('astro:page-load', initBadgeVault);
</script>
