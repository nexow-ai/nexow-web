---
/**
 * Decorative "connections panel" mock — window with a search bar, category tabs
 * and a grid of real venue logos. Purely presentational (aria-hidden).
 */
import { CONNECTORS, CONNECTOR_COUNT, CONNECTOR_LIVE_COUNT } from '../data/connectors';
import { useContent } from '../i18n/content';
import { type Lang } from '../i18n/config';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useContent(lang).connectorsPage;

const byId = Object.fromEntries(CONNECTORS.map((c) => [c.id, c]));
const pick = ['coinbase', 'binance', 'oanda', 'interactive_brokers', 'kraken', 'kalshi', 'polygon_io', 'postgres', 'twitter']
  .map((id) => byId[id])
  .filter(Boolean);
---

<div
  class="relative mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-white/10 bg-ink-950 shadow-2xl shadow-black/40"
  aria-hidden="true"
>
  <div class="flex items-center gap-2 border-b border-white/5 px-4 py-3">
    <Icon name="plug" class="size-4 text-brand-400" />
    <span class="font-mono text-xs text-ink-400">connections</span>
    <span class="ml-auto font-mono text-[0.65rem] text-ink-500">
      <span class="text-brand-300">{CONNECTOR_LIVE_COUNT}</span> live · {CONNECTOR_COUNT}
    </span>
  </div>

  <div class="p-4">
    <!-- search -->
    <div class="relative">
      <Icon name="search" class="pointer-events-none absolute left-3 top-1/2 size-3.5 -translate-y-1/2 text-ink-500" />
      <div class="flex h-9 items-center rounded-lg border border-white/10 bg-white/[0.03] pl-9 pr-3 font-mono text-xs text-ink-500">
        {t.searchPlaceholder}
      </div>
    </div>

    <!-- tabs -->
    <div class="mt-3 flex gap-1.5">
      {
        [t.categories.finance, t.categories.data, t.categories.socials].map((label, i) => (
          <span
            class:list={[
              'rounded-full px-2.5 py-1 font-mono text-[0.65rem]',
              i === 0 ? 'bg-brand-500/15 text-brand-300' : 'border border-white/10 text-ink-400',
            ]}
          >
            {label}
          </span>
        ))
      }
    </div>

    <!-- logo grid -->
    <div class="mt-3 grid grid-cols-3 gap-2">
      {
        pick.map((c) => (
          <div class="flex items-center gap-2 rounded-xl border border-white/8 bg-white/[0.02] p-2">
            <span class="inline-flex size-7 shrink-0 items-center justify-center overflow-hidden rounded-md bg-white p-1">
              <img src={c.logo} alt="" width="20" height="20" loading="lazy" decoding="async" class="size-full object-contain" />
            </span>
            <span class="min-w-0 flex-1 truncate font-mono text-[0.6rem] text-ink-300">{c.name}</span>
            <span class="size-1.5 shrink-0 rounded-full bg-brand-400"></span>
          </div>
        ))
      }
    </div>
  </div>
</div>
