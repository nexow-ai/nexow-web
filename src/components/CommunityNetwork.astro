---
/**
 * Community hero atmosphere — soft light planes and a few refined arcs.
 * Spacious, brand-first; no constellation / wire-graph clutter.
 * Pauses when `.is-offscreen` (ScrollMotion) or prefers-reduced-motion.
 */
---

<div
  class="community-aura pointer-events-none absolute inset-0 overflow-hidden"
  aria-hidden="true"
  data-motion="dim"
  data-community-aura
>
  <!-- Soft glow planes -->
  <div
    class="caura-plane caura-plane--a absolute left-1/2 top-[-8%] size-[min(92vw,720px)] -translate-x-1/2 rounded-full opacity-70 blur-3xl"
    style="background:radial-gradient(circle at 50% 42%, color-mix(in oklab, var(--color-brand-200) 75%, transparent), transparent 68%)"
  >
  </div>
  <div
    class="caura-plane caura-plane--b absolute left-[8%] top-[18%] size-[min(55vw,380px)] rounded-full opacity-45 blur-3xl"
    style="background:radial-gradient(circle at 40% 40%, color-mix(in oklab, var(--color-sky-200) 70%, transparent), transparent 70%)"
  >
  </div>
  <div
    class="caura-plane caura-plane--c absolute right-[4%] top-[12%] size-[min(58vw,400px)] rounded-full opacity-40 blur-3xl"
    style="background:radial-gradient(circle at 60% 40%, color-mix(in oklab, var(--color-accent-200) 65%, transparent), transparent 70%)"
  >
  </div>

  <!-- Refined horizon arcs — premium, quiet -->
  <svg
    class="caura-svg absolute left-1/2 top-[6%] h-[min(58vw,420px)] w-[min(118%,880px)] -translate-x-1/2"
    viewBox="0 0 880 420"
    fill="none"
  >
    <defs>
      <linearGradient id="caura-arc" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0"></stop>
        <stop offset="28%" stop-color="var(--color-brand-400)" stop-opacity="0.45"></stop>
        <stop offset="50%" stop-color="var(--color-sky-400)" stop-opacity="0.55"></stop>
        <stop offset="72%" stop-color="var(--color-accent-400)" stop-opacity="0.4"></stop>
        <stop offset="100%" stop-color="var(--color-accent-400)" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient id="caura-arc-soft" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--color-brand-300)" stop-opacity="0"></stop>
        <stop offset="50%" stop-color="var(--color-brand-400)" stop-opacity="0.28"></stop>
        <stop offset="100%" stop-color="var(--color-sky-300)" stop-opacity="0"></stop>
      </linearGradient>
      <radialGradient id="caura-core" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-brand-300)" stop-opacity="0.55"></stop>
        <stop offset="55%" stop-color="var(--color-brand-400)" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="var(--color-brand-500)" stop-opacity="0"></stop>
      </radialGradient>
      <filter id="caura-soft" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- Soft core light behind the headline -->
    <ellipse class="caura-core" cx="440" cy="168" rx="160" ry="90" fill="url(#caura-core)"></ellipse>

    <!-- Wide horizon bowls -->
    <path
      class="caura-arc"
      pathLength="1"
      d="M80 210 C 220 110 360 90 440 90 C 520 90 660 110 800 210"
      stroke="url(#caura-arc)"
      stroke-width="1.6"
      stroke-linecap="round"
    >
    </path>
    <path
      class="caura-arc caura-arc--2"
      pathLength="1"
      d="M140 248 C 260 168 360 148 440 148 C 520 148 620 168 740 248"
      stroke="url(#caura-arc-soft)"
      stroke-width="1.2"
      stroke-linecap="round"
    >
    </path>
    <path
      class="caura-arc caura-arc--3"
      pathLength="1"
      d="M210 286 C 300 230 380 210 440 210 C 500 210 580 230 670 286"
      stroke="url(#caura-arc-soft)"
      stroke-width="1"
      stroke-linecap="round"
      opacity="0.7"
    >
    </path>

    <!-- Quiet accent marks (not a graph) -->
    <circle class="caura-dot" cx="440" cy="90" r="3.2" fill="var(--color-brand-400)" filter="url(#caura-soft)"></circle>
    <circle class="caura-dot caura-dot--late" cx="300" cy="132" r="2.2" fill="var(--color-sky-400)" opacity="0.7"></circle>
    <circle class="caura-dot caura-dot--late" cx="580" cy="132" r="2.2" fill="var(--color-accent-400)" opacity="0.65"></circle>
  </svg>

  <!-- Soft fade so copy stays crisp -->
  <div
    class="absolute inset-0"
    style="background:radial-gradient(65% 50% at 50% 28%, transparent 20%, color-mix(in oklab, white 55%, transparent) 78%, white 100%)"
  >
  </div>
</div>

<style>
  .caura-plane {
    will-change: transform, opacity;
  }
  .caura-plane--a {
    animation: caura-drift-a 22s ease-in-out infinite;
  }
  .caura-plane--b {
    animation: caura-drift-b 26s ease-in-out infinite;
  }
  .caura-plane--c {
    animation: caura-drift-c 30s ease-in-out infinite;
  }

  .caura-core {
    animation: caura-breathe 10s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  .caura-arc {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: caura-draw 2.2s var(--ease-out-expo) 0.15s forwards;
  }
  .caura-arc--2 {
    animation-delay: 0.35s;
  }
  .caura-arc--3 {
    animation-delay: 0.55s;
  }

  .caura-dot {
    animation: caura-dot-in 1s var(--ease-out-expo) 0.9s both;
  }
  .caura-dot--late {
    animation-delay: 1.15s;
  }

  @keyframes caura-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes caura-dot-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes caura-breathe {
    0%,
    100% {
      opacity: 0.85;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @keyframes caura-drift-a {
    0%,
    100% {
      transform: translate3d(-50%, 0, 0) scale(1);
      opacity: 0.65;
    }
    50% {
      transform: translate3d(-50%, 2%, 0) scale(1.05);
      opacity: 0.8;
    }
  }
  @keyframes caura-drift-b {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 0.4;
    }
    50% {
      transform: translate3d(3%, -2%, 0);
      opacity: 0.55;
    }
  }
  @keyframes caura-drift-c {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 0.35;
    }
    50% {
      transform: translate3d(-2%, 3%, 0);
      opacity: 0.5;
    }
  }

  .is-offscreen .caura-plane,
  .is-offscreen .caura-core,
  .is-offscreen .caura-arc,
  .is-offscreen .caura-dot {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .caura-plane,
    .caura-core,
    .caura-dot {
      animation: none;
    }
    .caura-arc {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 640px) {
    .caura-svg {
      opacity: 0.75;
      top: 2%;
    }
    .caura-plane--b,
    .caura-plane--c {
      opacity: 0.28;
    }
  }
</style>
