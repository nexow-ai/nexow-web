---
/**
 * Decorative candlestick chart rendered as inline SVG. Data is generated with a
 * seeded PRNG so the build is deterministic (no Math.random at build time).
 * Purely presentational — marked aria-hidden.
 */
interface Props {
  width?: number;
  height?: number;
  count?: number;
  seed?: number;
  class?: string;
}
const { width = 520, height = 260, count = 44, seed = 7, class: className } = Astro.props;

// Deterministic LCG.
let s = seed * 2654435761;
const rand = () => {
  s = (s * 1103515245 + 12345) & 0x7fffffff;
  return s / 0x7fffffff;
};

// Random-walk OHLC with a gentle uptrend.
interface Candle { o: number; h: number; l: number; c: number; }
const candles: Candle[] = [];
let price = 100;
for (let i = 0; i < count; i++) {
  const drift = 0.35;
  const vol = 2.6;
  const o = price;
  const move = (rand() - 0.5) * vol + drift;
  const c = Math.max(20, o + move);
  const h = Math.max(o, c) + rand() * vol * 0.8;
  const l = Math.min(o, c) - rand() * vol * 0.8;
  candles.push({ o, h, l, c });
  price = c;
}

const pad = { top: 12, right: 10, bottom: 12, left: 10 };
const iw = width - pad.left - pad.right;
const ih = height - pad.top - pad.bottom;
const hi = Math.max(...candles.map((d) => d.h));
const lo = Math.min(...candles.map((d) => d.l));
const range = hi - lo || 1;
const y = (v: number) => pad.top + ih - ((v - lo) / range) * ih;
const step = iw / count;
const bodyW = Math.max(2.5, step * 0.58);

// EMA(9) overlay.
const ema: number[] = [];
const k = 2 / (9 + 1);
candles.forEach((d, i) => {
  ema.push(i === 0 ? d.c : d.c * k + ema[i - 1] * (1 - k));
});
const emaPath = ema
  .map((v, i) => `${i === 0 ? 'M' : 'L'}${(pad.left + i * step + step / 2).toFixed(1)} ${y(v).toFixed(1)}`)
  .join(' ');

const up = '#10c5a3';
const down = '#f43f5e';
const gridId = `grid-${seed}`;
---

<svg
  viewBox={`0 0 ${width} ${height}`}
  class={className}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="none"
>
  <defs>
    <linearGradient id={`ema-${seed}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#6366f1" stop-opacity="0.5" />
      <stop offset="1" stop-color="#8189fc" />
    </linearGradient>
  </defs>

  <!-- gridlines -->
  {
    [0.25, 0.5, 0.75].map((f) => (
      <line
        x1={pad.left}
        x2={width - pad.right}
        y1={pad.top + ih * f}
        y2={pad.top + ih * f}
        stroke="currentColor"
        stroke-opacity="0.08"
        stroke-width="1"
      />
    ))
  }

  <!-- candles -->
  {
    candles.map((d, i) => {
      const cx = pad.left + i * step + step / 2;
      const rising = d.c >= d.o;
      const color = rising ? up : down;
      const yO = y(d.o);
      const yC = y(d.c);
      const top = Math.min(yO, yC);
      const bh = Math.max(1.5, Math.abs(yC - yO));
      return (
        <g stroke={color} fill={color}>
          <line x1={cx} x2={cx} y1={y(d.h)} y2={y(d.l)} stroke-width="1" opacity="0.9" />
          <rect x={cx - bodyW / 2} y={top} width={bodyW} height={bh} rx="0.8" opacity="0.95" />
        </g>
      );
    })
  }

  <!-- EMA -->
  <path d={emaPath} stroke={`url(#ema-${seed})`} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
