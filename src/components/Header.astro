---
import { SITE, languages, type Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import { getNavIcon } from '../i18n/nav-icons';
import { getLangFromUrl, getRouteFromUrl, localizePath } from '../i18n/utils';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /**
   * Route the language switcher should point at, when it differs from the
   * current one — a page with no localized twin (404) sends you to the
   * locale home rather than a URL that does not exist.
   */
  switchRoute?: string;
  /**
   * Locales where `switchRoute` exists. Locales outside this list are sent to
   * the section index instead — a blog post with no Japanese translation links
   * at `/ja/blog`, not at a Japanese URL that 404s.
   */
  availableLangs?: Lang[];
}

const lang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url);
const { switchRoute = route, availableLangs } = Astro.props;
const t = useContent(lang);

/** `/blog/a-post` → `/blog`; the nearest page every locale is known to have. */
const sectionRoute = `/${switchRoute.split('/').filter(Boolean)[0] ?? ''}`;

const links = t.nav.links.map((l) => ({
  ...l,
  icon: getNavIcon(l.href),
  url: l.href.startsWith('/') ? localizePath(l.href, lang) : l.href,
  active: route === l.href || (l.href !== '/' && route.startsWith(l.href)),
}));

const otherLangs = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => ({
    code: l,
    label: languages[l],
    url: localizePath(!availableLangs || availableLangs.includes(l) ? switchRoute : sectionRoute, l),
  }));
const themeToDark = t.nav.themeToDark ?? 'Switch to dark mode';
const themeToLight = t.nav.themeToLight ?? 'Switch to light mode';
/* Optional, English fallback: no locale bundle has to change for this to ship. */
const tourPlay = t.nav.tourPlay ?? 'Play the tour';
const tourStop = t.nav.tourStop ?? 'Stop the tour';
/** Visible label next to the play icon — home only. */
const tourPlayMe = t.nav.tourPlayMe ?? 'Play Me';
const isHome = route === '/';
const switchLang = t.nav.switchLang ?? 'Switch language';
const primaryNav = t.nav.primaryNav ?? 'Primary';
const mobileNav = t.nav.mobileNav ?? 'Mobile';
---

<header id="site-header" transition:animate="none" class="fixed inset-x-0 top-0 z-50" data-hidden="false">
  <div class="container-page" id="site-header-bar">
    <nav
      class="flex h-16 items-center justify-between rounded-full border border-transparent px-2.5 pl-3 transition-all duration-300 sm:px-3 sm:pl-4"
      id="site-nav"
      aria-label={primaryNav}
    >
      <Logo lang={lang} class="h-7" shortcut="0" />

      <!-- Desktop nav — `lg` not `md`: seven links plus the language picker and
           the CTA need ~870px, so at 768px they would run off the right edge.
           Between `lg` and `xl` the row runs compact so the longest locales
           (el, ru) still fit at 1024; `xl` restores the roomier spacing. -->
      <ul class="hidden items-center gap-0.5 lg:flex xl:gap-1">
        {
          links.map((l, i) => {
            const key = String(i + 1);
            const icon = l.active ? l.icon : undefined;
            return (
              <li>
                <a
                  href={l.url}
                  data-nav-key={key}
                  aria-keyshortcuts={key}
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full px-2 py-2 text-[0.8125rem] font-medium transition-colors xl:px-3.5 xl:text-sm',
                    l.active
                      ? 'text-brand-600 dark:text-brand-300'
                      : 'text-ink-600 hover:text-ink-950 dark:text-ink-300 dark:hover:text-white',
                  ]}
                  aria-current={l.active ? 'page' : undefined}
                >
                  {icon ? (
                    <Icon name={icon} class="size-4 shrink-0" />
                  ) : (
                    <kbd class="nav-kbd" aria-hidden="true">
                      {key}
                    </kbd>
                  )}
                  {l.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="flex items-center gap-1.5 sm:gap-2">
        {/* Hands-free scroll, on every route. It only leaves the header on a
            page with nowhere to scroll — `data-short`; see `global.css`. */}
        <button
          type="button"
          id="tour-toggle"
          class:list={[
            'tour-toggle chrome-hit items-center justify-center rounded-full text-ink-800 hover:bg-ink-900/5 dark:text-ink-200 dark:hover:bg-white/10',
            isHome && 'tour-toggle--labeled',
          ]}
          data-tour-control
          aria-pressed="false"
          aria-label={tourPlay}
          data-play-label={tourPlay}
          data-stop-label={tourStop}
        >
          {
            isHome && (
              <span class="tour-toggle__label" aria-hidden="true">
                {tourPlayMe}
              </span>
            )
          }
          <Icon name="play" class="tour-toggle__play size-4" />
          <Icon name="pause" class="tour-toggle__stop size-4" />
        </button>

        <ThemeToggle toDarkLabel={themeToDark} toLightLabel={themeToLight} />

        <details class="group relative hidden sm:block">
          <summary
            class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-2 font-mono text-xs font-medium uppercase tracking-wider text-ink-600 transition-colors hover:text-ink-950 dark:text-ink-300 dark:hover:text-white [&::-webkit-details-marker]:hidden"
            aria-label={switchLang}
          >
            <Icon name="globe" class="size-4" />
            {lang}
          </summary>
          <ul
            class="absolute right-0 top-full z-50 mt-2 min-w-[8rem] overflow-hidden rounded-xl border border-ink-900/10 bg-white py-1 shadow-lg dark:border-white/10 dark:bg-ink-900"
          >
            {
              otherLangs.map((l) => (
                <li>
                  <a
                    href={l.url}
                    class="block px-4 py-2 font-mono text-xs uppercase tracking-wider text-ink-600 transition-colors hover:bg-ink-900/5 hover:text-ink-950 dark:text-ink-300 dark:hover:bg-white/10 dark:hover:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        {/* The wrapper — not a `hidden` class on the Button — owns the hiding:
            Button's base sets `inline-flex`, and between two display utilities
            the stylesheet order wins, so `hidden` on the Button never applied
            and the CTA stayed on screen at phone widths. */}
        <span class="hidden sm:inline-flex">
          <Button href={SITE.appUrl} size="sm" external iconRight="rocket">
            {t.nav.launch}
          </Button>
        </span>

        <!-- Mobile toggle -->
        <button
          type="button"
          id="menu-toggle"
          class="chrome-hit inline-flex items-center justify-center rounded-full text-ink-800 hover:bg-ink-900/5 lg:hidden dark:text-ink-200 dark:hover:bg-white/10"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.nav.menu}
        >
          <Icon name="menu" class="size-6" />
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="mobile-menu fixed inset-0 z-40 hidden bg-white/98 backdrop-blur-md lg:hidden dark:bg-ink-950/98"
    hidden
  >
    <div class="mobile-menu__bar container-page flex h-16 items-center justify-between">
      <Logo lang={lang} class="h-7" shortcut="0" />
      <button
        type="button"
        id="menu-close"
        class="chrome-hit inline-flex items-center justify-center rounded-full text-ink-800 hover:bg-ink-900/5 dark:text-ink-200 dark:hover:bg-white/10"
        aria-label={t.nav.close}
      >
        <Icon name="x" class="size-6" />
      </button>
    </div>
    <nav class="container-page mobile-menu__nav flex flex-col gap-1" aria-label={mobileNav}>
      {
        links.map((l, i) => {
          const key = String(i + 1);
          const icon = l.active ? l.icon : undefined;
          return (
            <a
              href={l.url}
              data-nav-key={key}
              aria-keyshortcuts={key}
              class:list={[
                'flex min-h-11 items-center gap-3 border-b border-ink-900/5 py-3.5 font-display text-2xl font-semibold text-ink-900 dark:border-white/10 dark:text-white',
                l.active && 'text-brand-600 dark:text-brand-300',
              ]}
              aria-current={l.active ? 'page' : undefined}
            >
              {icon ? (
                <Icon name={icon} class="size-6 shrink-0" />
              ) : (
                <kbd class="nav-kbd nav-kbd--lg" aria-hidden="true">
                  {key}
                </kbd>
              )}
              {l.label}
            </a>
          );
        })
      }
      <div class="mobile-menu__foot mt-6 flex flex-col gap-4 pb-2">
        <Button href={SITE.appUrl} size="lg" external iconRight="rocket">
          {t.nav.launch}
        </Button>
        <div class="mobile-langs" role="list">
          {
            otherLangs.map((l) => (
              <a href={l.url} class="mobile-lang" lang={l.code} role="listitem" title={l.label}>
                <span aria-hidden="true">{l.code}</span>
                <span class="sr-only">{l.label}</span>
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Only the bar translates — the mobile menu stays a viewport-anchored overlay. */
  #site-header-bar {
    padding-top: max(0.75rem, env(safe-area-inset-top, 0px));
    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 250ms ease;
    will-change: transform;
  }

  /* Sixteen locales used to print as a wrapping sentence under the CTA — on a
   * 568px phone that put half of them below the fold with no way to scroll.
   * The sheet itself scrolls; the bar sticks so close stays in reach. */
  .mobile-menu {
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
  }

  .mobile-menu__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgb(255 255 255 / 0.98);
  }

  :global(.dark) .mobile-menu__bar {
    background: color-mix(in oklab, var(--color-ink-950) 98%, transparent);
  }

  .mobile-langs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.75rem, 1fr));
    gap: 0.4rem;
  }

  .mobile-lang {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.7rem;
    border: 1px solid color-mix(in oklab, var(--color-ink-900) 10%, transparent);
    background: color-mix(in oklab, var(--color-ink-900) 4%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-700);
  }

  :global(.dark) .mobile-lang {
    border-color: rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.06);
    color: var(--color-ink-200);
  }

  #site-header[data-hidden='true'] #site-header-bar {
    transform: translateY(-130%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header-bar {
      transition: none;
    }
  }

  /* Shortcut chip — same 16px box as the active-page icon, so swapping
     kbd → icon on the current route does not shift the label. */
  .nav-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    border-radius: 0.28rem;
    border: 1px solid color-mix(in oklab, var(--color-ink-900) 14%, transparent);
    background: color-mix(in oklab, var(--color-ink-900) 4%, transparent);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-ink-900) 8%, transparent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-ink-500);
  }

  .nav-kbd--lg {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.35rem;
    font-size: 0.75rem;
  }

  :global(.dark) .nav-kbd {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.1);
    color: var(--color-ink-200);
  }

  a:hover .nav-kbd,
  a:focus-visible .nav-kbd {
    border-color: color-mix(in oklab, var(--color-ink-900) 28%, transparent);
    color: var(--color-ink-800);
  }

  :global(.dark) a:hover .nav-kbd,
  :global(.dark) a:focus-visible .nav-kbd {
    border-color: rgb(255 255 255 / 0.32);
    color: white;
  }

  /* On a band of the opposite tone the bar paints in that tone instead
     (`components/ChromeTone.astro`), and the chip follows it. */
  :global(html.dark) #site-nav.chrome-invert .nav-kbd {
    border-color: color-mix(in oklab, var(--color-ink-900) 14%, transparent);
    background: color-mix(in oklab, var(--color-ink-900) 4%, transparent);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-ink-900) 8%, transparent);
    color: var(--color-ink-500);
  }

  :global(html:not(.dark)) #site-nav.chrome-invert .nav-kbd {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.1);
    color: var(--color-ink-200);
  }

  :global(html.dark) #site-nav.chrome-invert a:hover .nav-kbd,
  :global(html.dark) #site-nav.chrome-invert a:focus-visible .nav-kbd {
    border-color: color-mix(in oklab, var(--color-ink-900) 28%, transparent);
    color: var(--color-ink-800);
  }

  :global(html:not(.dark)) #site-nav.chrome-invert a:hover .nav-kbd,
  :global(html:not(.dark)) #site-nav.chrome-invert a:focus-visible .nav-kbd {
    border-color: rgb(255 255 255 / 0.32);
    color: white;
  }

  /* Home world: the bar is transparent over ink until the first scroll, so
     the light-theme chip would sit too dark on the sky. */
  :global(html[data-world]:not(.dark)) #site-header:not(.is-scrolled) .nav-kbd {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.08);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.1);
    color: var(--color-ink-300);
  }

  :global(html[data-world]:not(.dark)) #site-header:not(.is-scrolled) a:hover .nav-kbd,
  :global(html[data-world]:not(.dark)) #site-header:not(.is-scrolled) a:focus-visible .nav-kbd {
    border-color: rgb(255 255 255 / 0.4);
    color: white;
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  /**
   * Hands-free scroll tour, on every page of the site.
   *
   * The home page is a scroll-driven story with holds built into it, but the
   * rest of the site is worth reading through the same way — so the play
   * button ships with the header everywhere. This advances the scroll at a
   * real-world speed and gets out of the way the moment the visitor touches
   * anything.
   *
   * The button is in the header from the server, not granted by this script:
   * the only thing measuring does is take it back off a page with nowhere to
   * scroll, so a script that fails to run leaves a working button rather than
   * an empty header on every route.
   *
   * The pace lives in `lib/tour`: a base speed in CSS pixels per second, not
   * per frame, so a 120Hz laptop and a 60Hz monitor travel the page at the
   * same rate — scaled by the transport's rate (`x0.25` … `x2`). Time left is
   * distance over that speed, which the foot-of-screen transport
   * (`TourHud.astro`) counts down.
   */
  import { secondsLeft, TOUR_SPEED, tourRate, worthTouring } from '../lib/tour';

  let tourAbort: AbortController | undefined;
  let tourRaf = 0;
  let tourRo: ResizeObserver | undefined;

  function initTour() {
    tourAbort?.abort();
    if (tourRaf) cancelAnimationFrame(tourRaf);
    tourRaf = 0;
    tourRo?.disconnect();
    tourRo = undefined;
    tourAbort = new AbortController();
    const { signal } = tourAbort;

    const btn = document.getElementById('tour-toggle');
    if (!btn) return;

    let playing = false;
    let last = 0;
    /** The whole second the countdown last announced. */
    let shown = -1;

    const maxScroll = () =>
      Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

    /** The transport stamps `data-rate`; fall back to the module if it is gone. */
    const paceOf = () => {
      const stamped = Number(document.querySelector<HTMLElement>('[data-tour-action="pace"]')?.dataset.rate);
      return stamped > 0 ? stamped : tourRate();
    };
    const speed = () => TOUR_SPEED * paceOf();

    /** The countdown, sent on only when the second it shows has changed. */
    const tell = (y: number, max: number) => {
      const remaining = secondsLeft(y, max, speed());
      const whole = Math.ceil(remaining);
      if (whole === shown) return;
      shown = whole;
      document.dispatchEvent(new CustomEvent('nexow:tourtime', { detail: { remaining } }));
    };

    const setPlaying = (on: boolean) => {
      playing = on;
      btn.setAttribute('aria-pressed', String(on));
      const label = on ? btn.dataset.stopLabel : btn.dataset.playLabel;
      if (label) btn.setAttribute('aria-label', label);
      /* `scroll-behavior: smooth` is on the document for anchor jumps; left on,
       * it would fight a per-frame scrollBy into a stutter. */
      document.documentElement.style.scrollBehavior = on ? 'auto' : '';
      // The deck listens: the soundtrack follows the tour (`TourSound.astro`).
      document.dispatchEvent(new CustomEvent('nexow:tour', { detail: { playing: on } }));
    };

    const stop = () => {
      if (!playing) return;
      if (tourRaf) cancelAnimationFrame(tourRaf);
      tourRaf = 0;
      last = 0;
      setPlaying(false);
    };

    /* Whether this page has anywhere to travel. Re-read rather than assumed:
     * a lazy image, a font, a phone rotating or an accordion opening all move
     * the end of the page, so a route that was too short a moment ago can
     * become worth touring without a reload. */
    const measure = () => {
      const short = !worthTouring(maxScroll());
      btn.toggleAttribute('data-short', short);
      // The button just left the header; the tour cannot outlive it.
      if (short) stop();
    };

    /** The tour's own controls: this button and the transport at the foot. */
    const fromTourControl = (e: Event) =>
      e.target instanceof Element && !!e.target.closest('[data-tour-control]');

    const step = (now: number) => {
      tourRaf = 0;
      if (!playing) return;
      // Clamped: a background tab or a long task must not teleport the page.
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
      last = now;

      // Read every frame: a page that grows under the tour — a lazy image, a
      // font — moves the end of the story, and the countdown with it.
      const max = maxScroll();
      const next = window.scrollY + speed() * dt;
      if (next >= max) {
        window.scrollTo(0, max);
        tell(max, max);
        stop();
        return;
      }
      window.scrollTo(0, next);
      tell(next, max);
      tourRaf = requestAnimationFrame(step);
    };

    const toggle = () => {
      if (playing) {
        stop();
        return;
      }
      // Reached the end already? Start the tour over rather than do nothing.
      if (window.scrollY >= maxScroll() - 2) window.scrollTo(0, 0);
      shown = -1;
      setPlaying(true);
      tell(window.scrollY, maxScroll());
      last = 0;
      tourRaf = requestAnimationFrame(step);
    };

    btn.addEventListener('click', toggle, { signal });
    // The transport at the foot of the screen drives the same tour.
    document.addEventListener('nexow:tourtoggle', toggle, { signal });
    // Recount at once: speed() reads the transport's data-rate every frame.
    document.addEventListener(
      'nexow:tourpace',
      () => {
        shown = -1;
        if (playing) tell(window.scrollY, maxScroll());
      },
      { signal },
    );

    /* Any intent to move the page yourself ends the tour. The tour's own
     * controls are excluded so their pointerdown does not cancel the click
     * they are about to make. `wheel` and `touchstart` stay passive, so this
     * never delays a scroll. */
    for (const evt of ['wheel', 'touchstart', 'pointerdown'] as const) {
      window.addEventListener(
        evt,
        (e) => {
          if (fromTourControl(e)) return;
          stop();
        },
        { passive: true, signal },
      );
    }
    window.addEventListener(
      'keydown',
      (e) => {
        // A control's own Enter/Space is a toggle, not an escape.
        if (fromTourControl(e)) return;
        stop();
      },
      { signal },
    );
    // Nothing to watch in a hidden tab.
    document.addEventListener('visibilitychange', () => document.hidden && stop(), { signal });

    measure();
    /* The document box covers the page growing; `resize` covers the viewport
     * getting taller without it, which is the phone-browser chrome sliding
     * away and is not a box change the observer sees. */
    if ('ResizeObserver' in window) {
      tourRo = new ResizeObserver(measure);
      tourRo.observe(document.documentElement);
    }
    window.addEventListener('resize', measure, { passive: true, signal });
  }

  document.addEventListener('astro:page-load', initTour);
  /* A module that finishes evaluating after `astro:page-load` has already gone
   * by would otherwise never wire the button up. Re-running is free: the first
   * thing `initTour` does is abandon whatever it set up last time. */
  if (document.readyState !== 'loading') initTour();
  document.addEventListener('astro:before-swap', () => {
    if (tourRaf) cancelAnimationFrame(tourRaf);
    tourRaf = 0;
    tourAbort?.abort();
    tourRo?.disconnect();
    tourRo = undefined;
    document.documentElement.style.scrollBehavior = '';
  });
</script>

<script>
  // Header: solidify on scroll, hide on scroll down / reveal on scroll up,
  // plus mobile menu toggle. Re-inits on view transitions.
  import { CHROME_TONE_EVENT } from '../lib/chrome-tone';

  let headerAbort: AbortController | undefined;

  const lightSolid = ['bg-white/95', 'backdrop-blur-md', '!border-ink-900/10', 'shadow-sm'] as const;
  const darkSolid = [
    'bg-ink-900/92',
    'backdrop-blur-md',
    '!border-white/10',
    'shadow-lg',
    'shadow-black/20',
  ] as const;
  const allSolid = [...lightSolid, ...darkSolid];

  // Distance from top below which the header always stays visible.
  const REVEAL_ZONE = 96;
  // Minimum scroll delta before we react, so tiny jitters don't flip the header.
  const DELTA = 6;

  function initHeader() {
    /* Attach the new listeners before aborting the old ones. Aborting first
     * left a gap during view transitions where digit shortcuts did nothing —
     * URL already updated, `astro:page-load` still mid-flight. */
    const next = new AbortController();
    const { signal } = next;

    const header = document.getElementById('site-header');
    const nav = document.getElementById('site-nav');
    if (!header || !nav) return;

    const menu = document.getElementById('mobile-menu');
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');

    let lastY = Math.max(0, window.scrollY);
    let ticking = false;

    const setHidden = (hidden: boolean) => {
      header.dataset.hidden = String(hidden);
    };

    /* The pill's tone: the page theme, unless the bar is currently over a band
     * of the opposite one (`components/ChromeTone.astro`), in which case it
     * takes that band's — the same flip the `dark:` utilities inside the bar
     * make on their own. */
    const overDark = () =>
      document.documentElement.classList.contains('dark') !== nav.classList.contains('chrome-invert');

    const paintSolid = () => {
      const solid = window.scrollY > 8;
      allSolid.forEach((c) => nav.classList.remove(c));
      if (solid) {
        const classes = overDark() ? darkSolid : lightSolid;
        classes.forEach((c) => nav.classList.add(c));
      }
      header.classList.toggle('is-scrolled', solid);
    };

    const update = () => {
      ticking = false;
      paintSolid();

      const y = Math.max(0, window.scrollY);
      const menuOpen = !!menu && !menu.hidden;

      if (y <= REVEAL_ZONE || menuOpen) {
        setHidden(false);
        lastY = y;
        return;
      }

      const diff = y - lastY;
      if (Math.abs(diff) < DELTA) return;
      setHidden(diff > 0);
      lastY = y;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    document.addEventListener('nexow:themechange', paintSolid, { signal });
    // The band under the bar changed tone; the pill has to follow it.
    document.addEventListener(CHROME_TONE_EVENT, paintSolid, { signal });
    // Keyboard users tabbing back into the header should never chase a hidden bar.
    header.addEventListener('focusin', () => setHidden(false), { signal });

    const setMenu = (open: boolean) => {
      if (!menu) return;
      menu.hidden = !open;
      menu.classList.toggle('hidden', !open);
      toggle?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) setHidden(false);
    };
    toggle?.addEventListener('click', () => setMenu(true), { signal });
    close?.addEventListener('click', () => setMenu(false), { signal });
    menu?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setMenu(false), { signal }),
    );
    const typingIn = (el: EventTarget | null) => {
      if (!(el instanceof HTMLElement)) return false;
      if (el.isContentEditable) return true;
      const tag = el.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    };

    const samePath = (href: string) => {
      const there = new URL(href, location.href).pathname.replace(/\/+$/, '') || '/';
      const here = location.pathname.replace(/\/+$/, '') || '/';
      return there === here;
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
      if (e.defaultPrevented || e.repeat) return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      if (!/^[0-6]$/.test(e.key)) return;
      if (typingIn(e.target)) return;

      const link = header.querySelector(`[data-nav-key="${e.key}"]`);
      if (!(link instanceof HTMLAnchorElement) || samePath(link.href)) return;

      e.preventDefault();
      setMenu(false);
      /* `HTMLElement.click()` on the logo after a ClientRouter hop from home
       * can fire without changing the URL — the transition layer sometimes
       * drops the synthetic activation. `navigate` is the supported API. */
      navigate(link.href);
    }, { signal });

    headerAbort?.abort();
    headerAbort = next;
  }

  document.addEventListener('astro:before-preparation', () => {
    document.body.style.overflow = '';
    const menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.hidden = true;
      menu.classList.add('hidden');
      document.getElementById('menu-toggle')?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('astro:page-load', initHeader);
</script>
