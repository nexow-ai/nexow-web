---
import { SITE, languages, type Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import { getNavIcon } from '../i18n/nav-icons';
import { getLangFromUrl, getRouteFromUrl, localizePath } from '../i18n/utils';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  /** Chrome tone: 'dark' for dark pages (home), 'light' elsewhere. */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';

const lang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url);
const t = useContent(lang);

const links = t.nav.links.map((l) => ({
  ...l,
  icon: getNavIcon(l.href),
  url: l.href.startsWith('/') ? localizePath(l.href, lang) : l.href,
  active: route === l.href || (l.href !== '/' && route.startsWith(l.href)),
}));

const otherLangs = (Object.keys(languages) as Lang[]).filter((l) => l !== lang);
---

<header id="site-header" transition:animate="none" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-page">
    <nav
      class="mt-3 flex h-16 items-center justify-between rounded-full border border-transparent px-3 pl-4 transition-all duration-300"
      id="site-nav"
      data-tone={tone}
      aria-label="Primary"
    >
      <Logo lang={lang} tone={dark ? 'light' : 'dark'} class="h-7" />

      <!-- Desktop nav -->
      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.url}
                class:list={[
                  'inline-flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium transition-colors',
                  dark
                    ? l.active
                      ? 'text-brand-300'
                      : 'text-ink-300 hover:text-white'
                    : l.active
                      ? 'text-brand-600'
                      : 'text-ink-600 hover:text-ink-950',
                ]}
                aria-current={l.active ? 'page' : undefined}
              >
                {l.active && l.icon && <Icon name={l.icon} class="size-4 shrink-0" />}
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <details class="group relative hidden sm:block">
          <summary
            class:list={[
              'flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-2 font-mono text-xs font-medium uppercase tracking-wider transition-colors [&::-webkit-details-marker]:hidden',
              dark ? 'text-ink-300 hover:text-white' : 'text-ink-600 hover:text-ink-950',
            ]}
            aria-label="Switch language"
          >
            <Icon name="globe" class="size-4" />
            {lang}
          </summary>
          <ul
            class:list={[
              'absolute right-0 top-full z-50 mt-2 min-w-[8rem] overflow-hidden rounded-xl border py-1 shadow-lg',
              dark ? 'border-white/10 bg-ink-900' : 'border-ink-900/10 bg-white',
            ]}
          >
            {
              otherLangs.map((l) => (
                <li>
                  <a
                    href={localizePath(route, l)}
                    class:list={[
                      'block px-4 py-2 font-mono text-xs uppercase tracking-wider transition-colors',
                      dark ? 'text-ink-300 hover:bg-white/10 hover:text-white' : 'text-ink-600 hover:bg-ink-900/5 hover:text-ink-950',
                    ]}
                  >
                    {languages[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <Button href={SITE.appUrl} size="sm" external iconRight="arrow" class="hidden sm:inline-flex">
          {t.nav.launch}
        </Button>

        <!-- Mobile toggle -->
        <button
          type="button"
          id="menu-toggle"
          class:list={[
            'inline-flex size-10 items-center justify-center rounded-full md:hidden',
            dark ? 'text-ink-200 hover:bg-white/10' : 'text-ink-800 hover:bg-ink-900/5',
          ]}
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.nav.menu}
        >
          <Icon name="menu" class="size-6" />
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class:list={[
      'fixed inset-0 z-40 hidden backdrop-blur-md md:hidden',
      dark ? 'bg-ink-950/98' : 'bg-white/98',
    ]}
    hidden
  >
    <div class="container-page flex h-16 items-center justify-between pt-3">
      <Logo lang={lang} tone={dark ? 'light' : 'dark'} class="h-7" />
      <button
        type="button"
        id="menu-close"
        class:list={[
          'inline-flex size-10 items-center justify-center rounded-full',
          dark ? 'text-ink-200 hover:bg-white/10' : 'text-ink-800 hover:bg-ink-900/5',
        ]}
        aria-label={t.nav.close}
      >
        <Icon name="x" class="size-6" />
      </button>
    </div>
    <nav class="container-page mt-8 flex flex-col gap-1" aria-label="Mobile">
      {
        links.map((l) => (
          <a
            href={l.url}
            class:list={[
              'flex items-center gap-3 py-4 font-display text-2xl font-semibold',
              dark ? 'border-b border-white/10 text-white' : 'border-b border-ink-900/5 text-ink-900',
              l.active && (dark ? 'text-brand-300' : 'text-brand-600'),
            ]}
            aria-current={l.active ? 'page' : undefined}
          >
            {l.active && l.icon ? (
              <Icon name={l.icon} class="size-6 shrink-0" />
            ) : null}
            {l.label}
          </a>
        ))
      }
      <div class="mt-6 flex flex-col gap-3">
        <Button href={SITE.appUrl} size="lg" external iconRight="arrow">
          {t.nav.launch}
        </Button>
        <div class="flex flex-wrap items-center gap-3 py-2">
          {
            otherLangs.map((l) => (
              <a
                href={localizePath(route, l)}
                class:list={[
                  'inline-flex items-center gap-2 font-mono text-sm uppercase tracking-wider',
                  dark ? 'text-ink-300' : 'text-ink-600',
                ]}
              >
                <Icon name="globe" class="size-4" />
                {languages[l]}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  // Header: solidify on scroll + mobile menu toggle. Re-inits on view transitions.
  let headerAbort: AbortController | undefined;

  function initHeader() {
    headerAbort?.abort();
    headerAbort = new AbortController();
    const { signal } = headerAbort;

    const header = document.getElementById('site-header');
    const nav = document.getElementById('site-nav');
    if (!header || !nav) return;

    const darkNav = nav.dataset.tone === 'dark';
    const solidClasses = darkNav
      ? ['bg-ink-900/92', 'backdrop-blur-md', '!border-white/10', 'shadow-lg', 'shadow-black/20']
      : ['bg-white/95', 'backdrop-blur-md', '!border-ink-900/10', 'shadow-sm'];
    const onScroll = () => {
      const solid = window.scrollY > 8;
      solidClasses.forEach((c) => nav.classList.toggle(c, solid));
      header.classList.toggle('is-scrolled', solid);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true, signal });

    const menu = document.getElementById('mobile-menu');
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');
    const setMenu = (open: boolean) => {
      if (!menu) return;
      menu.hidden = !open;
      menu.classList.toggle('hidden', !open);
      toggle?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle?.addEventListener('click', () => setMenu(true), { signal });
    close?.addEventListener('click', () => setMenu(false), { signal });
    menu?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setMenu(false), { signal }),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
    }, { signal });
  }

  document.addEventListener('astro:before-preparation', () => {
    document.body.style.overflow = '';
    const menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.hidden = true;
      menu.classList.add('hidden');
      document.getElementById('menu-toggle')?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('astro:page-load', initHeader);
</script>
