---
import { SITE, languages, type Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import { getNavIcon } from '../i18n/nav-icons';
import { getLangFromUrl, getRouteFromUrl, localizePath } from '../i18n/utils';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /**
   * Route the language switcher should point at, when it differs from the
   * current one — a page with no localized twin (404) sends you to the
   * locale home rather than a URL that does not exist.
   */
  switchRoute?: string;
  /**
   * Locales where `switchRoute` exists. Locales outside this list are sent to
   * the section index instead — a blog post with no Japanese translation links
   * at `/ja/blog`, not at a Japanese URL that 404s.
   */
  availableLangs?: Lang[];
}

const lang = getLangFromUrl(Astro.url);
const route = getRouteFromUrl(Astro.url);
const { switchRoute = route, availableLangs } = Astro.props;
const t = useContent(lang);

/** `/blog/a-post` → `/blog`; the nearest page every locale is known to have. */
const sectionRoute = `/${switchRoute.split('/').filter(Boolean)[0] ?? ''}`;

const links = t.nav.links.map((l) => ({
  ...l,
  icon: getNavIcon(l.href),
  url: l.href.startsWith('/') ? localizePath(l.href, lang) : l.href,
  active: route === l.href || (l.href !== '/' && route.startsWith(l.href)),
}));

const otherLangs = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => ({
    code: l,
    label: languages[l],
    url: localizePath(!availableLangs || availableLangs.includes(l) ? switchRoute : sectionRoute, l),
  }));
const themeToDark = t.nav.themeToDark ?? 'Switch to dark mode';
const themeToLight = t.nav.themeToLight ?? 'Switch to light mode';
/* Optional, English fallback: no locale bundle has to change for this to ship. */
const tourPlay = t.nav.tourPlay ?? 'Play the tour';
const tourStop = t.nav.tourStop ?? 'Stop the tour';
---

<header id="site-header" transition:animate="none" class="fixed inset-x-0 top-0 z-50" data-hidden="false">
  <div class="container-page" id="site-header-bar">
    <nav
      class="mt-3 flex h-16 items-center justify-between rounded-full border border-transparent px-3 pl-4 transition-all duration-300"
      id="site-nav"
      aria-label="Primary"
    >
      <Logo lang={lang} class="h-7" shortcut="0" />

      <!-- Desktop nav — `lg` not `md`: seven links plus the language picker and
           the CTA need ~870px, so at 768px they would run off the right edge.
           Between `lg` and `xl` the row runs compact so the longest locales
           (el, ru) still fit at 1024; `xl` restores the roomier spacing. -->
      <ul class="hidden items-center gap-0.5 lg:flex xl:gap-1">
        {
          links.map((l, i) => {
            const key = String(i + 1);
            const icon = l.active ? l.icon : undefined;
            return (
              <li>
                <a
                  href={l.url}
                  data-nav-key={key}
                  aria-keyshortcuts={key}
                  class:list={[
                    'inline-flex items-center gap-1.5 rounded-full px-2 py-2 text-[0.8125rem] font-medium transition-colors xl:px-3.5 xl:text-sm',
                    l.active
                      ? 'text-brand-600 dark:text-brand-300'
                      : 'text-ink-600 hover:text-ink-950 dark:text-ink-300 dark:hover:text-white',
                  ]}
                  aria-current={l.active ? 'page' : undefined}
                >
                  {icon ? (
                    <Icon name={icon} class="size-4 shrink-0" />
                  ) : (
                    <kbd class="nav-kbd" aria-hidden="true">
                      {key}
                    </kbd>
                  )}
                  {l.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="flex items-center gap-1.5 sm:gap-2">
        {/* Hands-free scroll. Only rendered as visible on pages that carry a
            world (`html[data-world]`) — a play button on the blog would scroll
            a page that has no story to tell. CSS does the hiding, so the
            header stays one component for every route. */}
        <button
          type="button"
          id="tour-toggle"
          class="tour-toggle size-10 items-center justify-center rounded-full text-ink-800 hover:bg-ink-900/5 dark:text-ink-200 dark:hover:bg-white/10"
          aria-pressed="false"
          aria-label={tourPlay}
          data-play-label={tourPlay}
          data-stop-label={tourStop}
        >
          <Icon name="play" class="tour-toggle__play size-4" />
          <Icon name="pause" class="tour-toggle__stop size-4" />
        </button>

        <ThemeToggle toDarkLabel={themeToDark} toLightLabel={themeToLight} />

        <details class="group relative hidden sm:block">
          <summary
            class="flex cursor-pointer list-none items-center gap-1.5 rounded-full px-3 py-2 font-mono text-xs font-medium uppercase tracking-wider text-ink-600 transition-colors hover:text-ink-950 dark:text-ink-300 dark:hover:text-white [&::-webkit-details-marker]:hidden"
            aria-label="Switch language"
          >
            <Icon name="globe" class="size-4" />
            {lang}
          </summary>
          <ul
            class="absolute right-0 top-full z-50 mt-2 min-w-[8rem] overflow-hidden rounded-xl border border-ink-900/10 bg-white py-1 shadow-lg dark:border-white/10 dark:bg-ink-900"
          >
            {
              otherLangs.map((l) => (
                <li>
                  <a
                    href={l.url}
                    class="block px-4 py-2 font-mono text-xs uppercase tracking-wider text-ink-600 transition-colors hover:bg-ink-900/5 hover:text-ink-950 dark:text-ink-300 dark:hover:bg-white/10 dark:hover:text-white"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        {/* The wrapper — not a `hidden` class on the Button — owns the hiding:
            Button's base sets `inline-flex`, and between two display utilities
            the stylesheet order wins, so `hidden` on the Button never applied
            and the CTA stayed on screen at phone widths. */}
        <span class="hidden sm:inline-flex">
          <Button href={SITE.appUrl} size="sm" external iconRight="rocket">
            {t.nav.launch}
          </Button>
        </span>

        <!-- Mobile toggle -->
        <button
          type="button"
          id="menu-toggle"
          class="inline-flex size-10 items-center justify-center rounded-full text-ink-800 hover:bg-ink-900/5 lg:hidden dark:text-ink-200 dark:hover:bg-white/10"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.nav.menu}
        >
          <Icon name="menu" class="size-6" />
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-40 hidden bg-white/98 backdrop-blur-md lg:hidden dark:bg-ink-950/98"
    hidden
  >
    <div class="container-page flex h-16 items-center justify-between pt-3">
      <Logo lang={lang} class="h-7" shortcut="0" />
      <button
        type="button"
        id="menu-close"
        class="inline-flex size-10 items-center justify-center rounded-full text-ink-800 hover:bg-ink-900/5 dark:text-ink-200 dark:hover:bg-white/10"
        aria-label={t.nav.close}
      >
        <Icon name="x" class="size-6" />
      </button>
    </div>
    <nav class="container-page mt-8 flex flex-col gap-1" aria-label="Mobile">
      {
        links.map((l, i) => {
          const key = String(i + 1);
          const icon = l.active ? l.icon : undefined;
          return (
            <a
              href={l.url}
              data-nav-key={key}
              aria-keyshortcuts={key}
              class:list={[
                'flex items-center gap-3 border-b border-ink-900/5 py-4 font-display text-2xl font-semibold text-ink-900 dark:border-white/10 dark:text-white',
                l.active && 'text-brand-600 dark:text-brand-300',
              ]}
              aria-current={l.active ? 'page' : undefined}
            >
              {icon ? (
                <Icon name={icon} class="size-6 shrink-0" />
              ) : (
                <kbd class="nav-kbd nav-kbd--lg" aria-hidden="true">
                  {key}
                </kbd>
              )}
              {l.label}
            </a>
          );
        })
      }
      <div class="mt-6 flex flex-col gap-3">
        <Button href={SITE.appUrl} size="lg" external iconRight="rocket">
          {t.nav.launch}
        </Button>
        <div class="flex flex-wrap items-center gap-3 py-2">
          {
            otherLangs.map((l) => (
              <a
                href={l.url}
                class="inline-flex items-center gap-2 font-mono text-sm uppercase tracking-wider text-ink-600 dark:text-ink-300"
              >
                <Icon name="globe" class="size-4" />
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Only the bar translates — the mobile menu stays a viewport-anchored overlay. */
  #site-header-bar {
    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 250ms ease;
    will-change: transform;
  }

  #site-header[data-hidden='true'] #site-header-bar {
    transform: translateY(-130%);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header-bar {
      transition: none;
    }
  }

  /* Shortcut chip — same 16px box as the active-page icon, so swapping
     kbd → icon on the current route does not shift the label. */
  .nav-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    border-radius: 0.28rem;
    border: 1px solid color-mix(in oklab, var(--color-ink-900) 14%, transparent);
    background: color-mix(in oklab, var(--color-ink-900) 4%, transparent);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-ink-900) 8%, transparent);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-ink-500);
  }

  .nav-kbd--lg {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.35rem;
    font-size: 0.75rem;
  }

  :global(.dark) .nav-kbd {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.1);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.1);
    color: var(--color-ink-200);
  }

  a:hover .nav-kbd,
  a:focus-visible .nav-kbd {
    border-color: color-mix(in oklab, var(--color-ink-900) 28%, transparent);
    color: var(--color-ink-800);
  }

  :global(.dark) a:hover .nav-kbd,
  :global(.dark) a:focus-visible .nav-kbd {
    border-color: rgb(255 255 255 / 0.32);
    color: white;
  }

  /* Home world: the bar is transparent over ink until the first scroll, so
     the light-theme chip would sit too dark on the sky. */
  :global(html[data-world]:not(.dark)) #site-header:not(.is-scrolled) .nav-kbd {
    border-color: rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.08);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.1);
    color: var(--color-ink-300);
  }

  :global(html[data-world]:not(.dark)) #site-header:not(.is-scrolled) a:hover .nav-kbd,
  :global(html[data-world]:not(.dark)) #site-header:not(.is-scrolled) a:focus-visible .nav-kbd {
    border-color: rgb(255 255 255 / 0.4);
    color: white;
  }
</style>

<script>
  /**
   * Hands-free scroll tour.
   *
   * The home page is a scroll-driven story with holds built into it, so it is
   * worth being able to watch rather than drive. This advances the scroll at a
   * real-world speed and gets out of the way the moment the visitor touches
   * anything.
   *
   * Speed is in CSS pixels per second, not per frame, so a 120Hz laptop and a
   * 60Hz monitor travel the page at the same rate. It is not one number: the
   * right-hand scene is the part that was crawling, so that half of a pinned
   * act runs fast; the left-hand copy then gets a few seconds to be read.
   */
  const TOUR_SCENE = 380;
  const TOUR_CRUISE = 260;
  const TOUR_READ = 64;
  /** How long the copy hold at the end of a pinned act should last. */
  const TOUR_READ_HOLD = 4.2;
  /** Time constant for easing from one pace into the next. */
  const TOUR_EASE = 0.18;

  let tourAbort: AbortController | undefined;
  let tourRaf = 0;

  function inReadingBand(el: Element, top = 0.22, bot = 0.72): boolean {
    const r = el.getBoundingClientRect();
    const t = window.innerHeight * top;
    const b = window.innerHeight * bot;
    return r.bottom > t && r.top < b;
  }

  function tourTargetSpeed(acts: HTMLElement[]): number {
    const vh = window.innerHeight;
    let best: HTMLElement | null = null;
    let bestCover = 0;
    for (const act of acts) {
      const r = act.getBoundingClientRect();
      const cover = Math.max(0, Math.min(r.bottom, vh) - Math.max(r.top, 0));
      if (cover > bestCover) {
        bestCover = cover;
        best = act;
      }
    }

    if (best && bestCover > vh * 0.15) {
      const r = best.getBoundingClientRect();
      const travel = r.height - vh;
      if (travel > 80) {
        /* Pinned: zip the right-hand scene together, then linger on the copy
         * once every beat is lit. */
        const scrolled = Math.max(0, -r.top);
        const holdPx = Math.min(travel * 0.42, TOUR_READ * TOUR_READ_HOLD);
        return scrolled >= travel - holdPx ? TOUR_READ : TOUR_SCENE;
      }

      /* Stacked (phone): pace off whichever half is in the reading band. */
      const copy = best.querySelector('.act-copy');
      const scene = best.querySelector('.act-scene');
      if (scene && inReadingBand(scene) && !(copy && inReadingBand(copy))) return TOUR_SCENE;
      if (copy && inReadingBand(copy)) return TOUR_READ;
    }

    for (const el of document.querySelectorAll('.act-copy')) {
      if (inReadingBand(el)) return TOUR_READ;
    }
    return TOUR_CRUISE;
  }

  function initTour() {
    tourAbort?.abort();
    tourAbort = new AbortController();
    const { signal } = tourAbort;

    const btn = document.getElementById('tour-toggle');
    if (!btn) return;

    const acts = Array.from(document.querySelectorAll<HTMLElement>('.act'));
    let playing = false;
    let last = 0;
    let speed = TOUR_CRUISE;

    const setPlaying = (on: boolean) => {
      playing = on;
      btn.setAttribute('aria-pressed', String(on));
      const label = on ? btn.dataset.stopLabel : btn.dataset.playLabel;
      if (label) btn.setAttribute('aria-label', label);
      /* `scroll-behavior: smooth` is on the document for anchor jumps; left on,
       * it would fight a per-frame scrollBy into a stutter. */
      document.documentElement.style.scrollBehavior = on ? 'auto' : '';
    };

    const stop = () => {
      if (!playing) return;
      if (tourRaf) cancelAnimationFrame(tourRaf);
      tourRaf = 0;
      last = 0;
      setPlaying(false);
    };

    const fromTourButton = (e: Event) =>
      e.target === btn || (e.target instanceof Node && btn.contains(e.target));

    const step = (now: number) => {
      tourRaf = 0;
      if (!playing) return;
      // Clamped: a background tab or a long task must not teleport the page.
      const dt = Math.min(0.05, last ? (now - last) / 1000 : 0.016);
      last = now;

      const target = tourTargetSpeed(acts);
      const ease = 1 - Math.exp(-dt / TOUR_EASE);
      speed += (target - speed) * ease;

      const max = document.documentElement.scrollHeight - window.innerHeight;
      const next = window.scrollY + speed * dt;
      if (next >= max) {
        window.scrollTo(0, max);
        stop();
        return;
      }
      window.scrollTo(0, next);
      tourRaf = requestAnimationFrame(step);
    };

    btn.addEventListener(
      'click',
      () => {
        if (playing) {
          stop();
          return;
        }
        // Reached the end already? Start the tour over rather than do nothing.
        const max = document.documentElement.scrollHeight - window.innerHeight;
        if (window.scrollY >= max - 2) window.scrollTo(0, 0);
        setPlaying(true);
        last = 0;
        speed = tourTargetSpeed(acts);
        tourRaf = requestAnimationFrame(step);
      },
      { signal },
    );

    /* Any intent to move the page yourself ends the tour. The button is
     * excluded so its own pointerdown does not cancel the click that toggles
     * it. `wheel` and `touchstart` stay passive, so this never delays a scroll. */
    for (const evt of ['wheel', 'touchstart', 'pointerdown'] as const) {
      window.addEventListener(
        evt,
        (e) => {
          if (fromTourButton(e)) return;
          stop();
        },
        { passive: true, signal },
      );
    }
    window.addEventListener(
      'keydown',
      (e) => {
        // The button's own Enter/Space is a toggle, not an escape.
        if (e.target === btn) return;
        stop();
      },
      { signal },
    );
    // Nothing to watch in a hidden tab.
    document.addEventListener('visibilitychange', () => document.hidden && stop(), { signal });
  }

  document.addEventListener('astro:page-load', initTour);
  document.addEventListener('astro:before-swap', () => {
    if (tourRaf) cancelAnimationFrame(tourRaf);
    tourRaf = 0;
    tourAbort?.abort();
    document.documentElement.style.scrollBehavior = '';
  });
</script>

<script>
  // Header: solidify on scroll, hide on scroll down / reveal on scroll up,
  // plus mobile menu toggle. Re-inits on view transitions.
  let headerAbort: AbortController | undefined;

  const lightSolid = ['bg-white/95', 'backdrop-blur-md', '!border-ink-900/10', 'shadow-sm'] as const;
  const darkSolid = [
    'bg-ink-900/92',
    'backdrop-blur-md',
    '!border-white/10',
    'shadow-lg',
    'shadow-black/20',
  ] as const;
  const allSolid = [...lightSolid, ...darkSolid];

  // Distance from top below which the header always stays visible.
  const REVEAL_ZONE = 96;
  // Minimum scroll delta before we react, so tiny jitters don't flip the header.
  const DELTA = 6;

  function initHeader() {
    headerAbort?.abort();
    headerAbort = new AbortController();
    const { signal } = headerAbort;

    const header = document.getElementById('site-header');
    const nav = document.getElementById('site-nav');
    if (!header || !nav) return;

    const menu = document.getElementById('mobile-menu');
    const toggle = document.getElementById('menu-toggle');
    const close = document.getElementById('menu-close');

    let lastY = Math.max(0, window.scrollY);
    let ticking = false;

    const setHidden = (hidden: boolean) => {
      header.dataset.hidden = String(hidden);
    };

    const paintSolid = () => {
      const solid = window.scrollY > 8;
      allSolid.forEach((c) => nav.classList.remove(c));
      if (solid) {
        const classes = document.documentElement.classList.contains('dark') ? darkSolid : lightSolid;
        classes.forEach((c) => nav.classList.add(c));
      }
      header.classList.toggle('is-scrolled', solid);
    };

    const update = () => {
      ticking = false;
      paintSolid();

      const y = Math.max(0, window.scrollY);
      const menuOpen = !!menu && !menu.hidden;

      if (y <= REVEAL_ZONE || menuOpen) {
        setHidden(false);
        lastY = y;
        return;
      }

      const diff = y - lastY;
      if (Math.abs(diff) < DELTA) return;
      setHidden(diff > 0);
      lastY = y;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true, signal });
    document.addEventListener('nexow:themechange', paintSolid, { signal });
    // Keyboard users tabbing back into the header should never chase a hidden bar.
    header.addEventListener('focusin', () => setHidden(false), { signal });

    const setMenu = (open: boolean) => {
      if (!menu) return;
      menu.hidden = !open;
      menu.classList.toggle('hidden', !open);
      toggle?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) setHidden(false);
    };
    toggle?.addEventListener('click', () => setMenu(true), { signal });
    close?.addEventListener('click', () => setMenu(false), { signal });
    menu?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setMenu(false), { signal }),
    );
    const typingIn = (el) => {
      if (!(el instanceof HTMLElement)) return false;
      if (el.isContentEditable) return true;
      const tag = el.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    };

    const samePath = (href) => {
      const there = new URL(href, location.href).pathname.replace(/\/+$/, '') || '/';
      const here = location.pathname.replace(/\/+$/, '') || '/';
      return there === here;
    };

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setMenu(false);
      if (e.defaultPrevented || e.repeat) return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      if (!/^[0-6]$/.test(e.key)) return;
      if (typingIn(e.target)) return;

      const link = header.querySelector(`[data-nav-key="${e.key}"]`);
      if (!(link instanceof HTMLAnchorElement) || samePath(link.href)) return;

      e.preventDefault();
      setMenu(false);
      link.click();
    }, { signal });
  }

  document.addEventListener('astro:before-preparation', () => {
    document.body.style.overflow = '';
    const menu = document.getElementById('mobile-menu');
    if (menu) {
      menu.hidden = true;
      menu.classList.add('hidden');
      document.getElementById('menu-toggle')?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('astro:page-load', initHeader);
</script>
