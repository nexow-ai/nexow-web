<style>
  .fma {
    --fma-panel-solid: #ffffff;
    --fma-panel-fill: #ffffff;
    --fma-line: color-mix(in oklab, var(--color-ink-950) 13%, transparent);
    --fma-mute: color-mix(in oklab, var(--color-ink-950) 17%, transparent);
    --fma-ink: color-mix(in oklab, var(--color-ink-950) 38%, transparent);
    --fma-brand: var(--color-brand-500);
    --fma-accent: var(--color-accent-500);
    --fma-sky: var(--color-sky-500);
    --fma-soft: color-mix(in oklab, var(--color-brand-500) 14%, transparent);
    --fma-e: cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.dark) .fma {
    --fma-panel-solid: #12151d;
    --fma-panel-fill: rgb(255 255 255 / 0.05);
    --fma-line: rgb(255 255 255 / 0.16);
    --fma-mute: rgb(255 255 255 / 0.24);
    --fma-ink: rgb(255 255 255 / 0.42);
    --fma-brand: var(--color-brand-400);
    --fma-accent: var(--color-accent-400);
    --fma-sky: var(--color-sky-400);
    --fma-soft: color-mix(in oklab, var(--color-brand-400) 20%, transparent);
  }

  .fma-scene {
    display: none;
    width: 100%;
    height: auto;
  }
  .fma-scene.is-active {
    display: block;
  }

  /* Shared fills */
  .fma-panel {
    fill: var(--fma-panel-fill);
    stroke: var(--fma-line);
    stroke-width: 1;
  }
  .fma-bar {
    fill: var(--fma-mute);
  }
  .fma-brandbar {
    fill: var(--fma-brand);
  }
  .fma-accentbar {
    fill: var(--fma-accent);
  }
  .fma-soft-fill {
    fill: var(--fma-soft);
  }

  /* Intro + idle motion */
  .fma-rise,
  .fma-rise-up,
  .fma-pop,
  .fma-grow,
  .fma-slide-left,
  .fma-slide-right {
    transform-box: fill-box;
    transform-origin: center;
  }

  .fma-rise {
    animation: fma-rise 0.6s var(--fma-e) var(--d, 0s) both;
  }
  .fma-rise-up {
    animation: fma-rise-up 0.7s var(--fma-e) var(--d, 0s) both;
  }
  .fma-pop {
    animation: fma-pop 0.5s var(--fma-e) var(--d, 0s) both;
  }
  .fma-grow {
    transform-origin: bottom;
    animation: fma-grow 0.6s var(--fma-e) var(--d, 0s) both;
  }
  .fma-slide-left {
    animation: fma-slide-left 0.6s var(--fma-e) var(--d, 0s) both;
  }
  .fma-slide-right {
    animation: fma-slide-right 0.6s var(--fma-e) var(--d, 0s) both;
  }
  .fma-float {
    transform-box: fill-box;
    transform-origin: center;
    animation: fma-float 5.5s ease-in-out var(--d, 0s) infinite;
  }
  .fma-blink {
    animation: fma-blink 1.5s ease-in-out var(--d, 0s) infinite;
  }
  .fma-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: fma-draw 1s var(--fma-e) var(--d, 0s) forwards;
  }
  .fma-flow {
    stroke-dasharray: 5 6;
