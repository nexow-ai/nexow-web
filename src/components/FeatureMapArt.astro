---
/**
 * Animated artwork for the home FeatureMap detail panel — one inline SVG scene
 * per surface id. Every scene is decorative; the explorer script toggles
 * `.is-active` so only the selected one is displayed (and re-runs its intro).
 */
import { ICON_PATHS } from './icon-paths';
import type { FeatureMapSurfaceId } from '../lib/featureMap';

interface Props {
  /** Surface rendered before hydration/selection. */
  initial?: FeatureMapSurfaceId;
}

const { initial } = Astro.props;
const active = (id: FeatureMapSurfaceId) => initial === id;

/** Connector hub spokes — even ring around the centre plug. */
const spokes = [0, 60, 120, 180, 240, 300].map((deg, i) => {
  const rad = (deg * Math.PI) / 180;
  return {
    i,
    x: +(160 + Math.cos(rad) * 106).toFixed(1),
    y: +(100 + Math.sin(rad) * 62).toFixed(1),
  };
});

/** Community graph — fixed layout so the drawing order stays deterministic. */
const people = [
  { x: 62, y: 52 },
  { x: 150, y: 34 },
  { x: 246, y: 62 },
  { x: 38, y: 132 },
  { x: 122, y: 108 },
  { x: 214, y: 142 },
  { x: 282, y: 118 },
];
const links: [number, number][] = [
  [0, 1],
  [1, 2],
  [0, 4],
  [1, 4],
  [2, 4],
  [3, 4],
  [4, 5],
  [5, 6],
  [2, 6],
];

const shelf = [0, 1, 2, 3, 4, 5];
const dockIcons = ['chat', 'users', 'bell', 'mail', 'grid'];
const tools = ['sparkles', 'grid', 'history', 'lock', 'sync', 'search'];
const swatches = [
  ['var(--fma-brand)', 'var(--fma-accent)'],
  ['var(--fma-accent)', 'var(--fma-sky)'],
  ['var(--fma-sky)', 'var(--fma-brand)'],
  ['var(--fma-brand)', 'var(--fma-sky)'],
];
---

<div
  class="fma relative w-full overflow-hidden rounded-xl border border-ink-900/8 dark:border-white/8 bg-white dark:bg-white/[0.03]"
  aria-hidden="true"
  data-fm-art-stage
>
  <!-- Canvas & workspaces -->
  <svg
    class:list={['fma-scene', active('canvas') && 'is-active']}
    data-fm-art="canvas"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <defs>
      <pattern id="fma-grid" width="26" height="26" patternUnits="userSpaceOnUse">
        <path d="M26 0H0v26" stroke="var(--fma-line)" stroke-width="1" fill="none"></path>
      </pattern>
      <linearGradient id="fma-link" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--fma-brand)" stop-opacity="0.2"></stop>
        <stop offset="55%" stop-color="var(--fma-brand)" stop-opacity="0.95"></stop>
        <stop offset="100%" stop-color="var(--fma-accent)" stop-opacity="0.85"></stop>
      </linearGradient>
    </defs>

    <rect x="10" y="10" width="300" height="180" rx="12" fill="url(#fma-grid)" opacity="0.55"></rect>

    <path class="fma-draw" d="M150 62 C176 62 172 44 196 44" stroke="url(#fma-link)" stroke-width="1.6" pathLength="1"></path>
    <path class="fma-draw" style="--d:.3s" d="M246 106 C246 134 208 130 184 140" stroke="url(#fma-link)" stroke-width="1.6" pathLength="1"></path>
    <circle class="fma-packet" r="2.6" fill="var(--fma-brand)">
      <animateMotion dur="3s" repeatCount="indefinite" path="M150 62 C176 62 172 44 196 44"></animateMotion>
    </circle>
    <circle class="fma-packet" r="2.4" fill="var(--fma-accent)">
      <animateMotion dur="3.8s" begin="0.9s" repeatCount="indefinite" path="M246 106 C246 134 208 130 184 140"></animateMotion>
    </circle>

    <g class="fma-rise fma-float">
      <rect class="fma-panel" x="26" y="30" width="124" height="64" rx="10"></rect>
      <rect class="fma-accentbar" x="38" y="42" width="38" height="7" rx="3.5"></rect>
      <rect class="fma-bar" x="38" y="57" width="98" height="6" rx="3"></rect>
      <rect class="fma-bar" x="38" y="70" width="70" height="6" rx="3" opacity="0.65"></rect>
      <rect x="146" y="90" width="8" height="8" rx="2" fill="var(--fma-panel-solid)" stroke="var(--fma-brand)" stroke-width="1.4"></rect>
    </g>

    <g class="fma-rise" style="--d:.12s">
      <rect class="fma-panel" x="196" y="22" width="98" height="84" rx="10"></rect>
      <rect class="fma-bar" x="208" y="34" width="46" height="6" rx="3"></rect>
      {[0, 1, 2, 3].map((n) => (
        <rect
          class="fma-grow"
          style={`--d:${0.3 + n * 0.12}s`}
          x={208 + n * 20}
          y={94 - (14 + n * 12)}
          width="12"
          height={14 + n * 12}
          rx="3"
          fill={n === 3 ? 'var(--fma-brand)' : 'var(--fma-soft)'}
        />
      ))}
    </g>

    <g class="fma-rise" style="--d:.24s">
      <rect class="fma-panel" x="112" y="118" width="140" height="56" rx="10"></rect>
      <circle cx="132" cy="140" r="10" fill="var(--fma-soft)"></circle>
      <rect class="fma-bar" x="150" y="133" width="82" height="6" rx="3"></rect>
      <rect class="fma-bar" x="150" y="146" width="56" height="6" rx="3" opacity="0.65"></rect>
      <rect class="fma-brandbar" x="124" y="158" width="34" height="7" rx="3.5"></rect>
    </g>

    <path class="fma-cursor" d="M0 0l11 4-4.4 1.6L4.6 10 0 0z" fill="var(--fma-ink)" transform="translate(84 96)"></path>
  </svg>

  <!-- Widgets -->
  <svg
    class:list={['fma-scene', active('widgets') && 'is-active']}
    data-fm-art="widgets"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <g class="fma-rise">
      <rect class="fma-panel" x="24" y="20" width="272" height="36" rx="12"></rect>
      <g transform="translate(38 30) scale(0.66)" stroke="var(--fma-brand)" stroke-width="2" fill="none">
        <path d={ICON_PATHS.sparkles}></path>
      </g>
      <rect class="fma-bar fma-typebar" x="60" y="34" width="180" height="8" rx="4"></rect>
      <rect class="fma-caret" x="60" y="30" width="2" height="16" rx="1" fill="var(--fma-brand)"></rect>
    </g>

    <g class="fma-pop" style="--d:1.05s">
      <rect class="fma-panel" x="60" y="74" width="200" height="106" rx="12"></rect>
      <rect class="fma-brandbar" x="74" y="88" width="44" height="7" rx="3.5"></rect>
      <circle cx="246" cy="91" r="4" fill="var(--fma-brand)" class="fma-blink"></circle>
      <line x1="60" y1="106" x2="260" y2="106" stroke="var(--fma-line)" stroke-width="1"></line>
      {[0, 1, 2, 3, 4].map((n) => (
        <rect
          class="fma-grow"
          style={`--d:${1.25 + n * 0.09}s`}
          x={78 + n * 33}
          y={166 - (16 + ((n * 37) % 44))}
          width="20"
          height={16 + ((n * 37) % 44)}
          rx="4"
          fill={n === 2 ? 'var(--fma-brand)' : 'var(--fma-soft)'}
        />
      ))}
      <rect class="fma-bar" x="78" y="170" width="122" height="5" rx="2.5" opacity="0.6"></rect>
    </g>
  </svg>

  <!-- Widget library -->
  <svg
    class:list={['fma-scene', active('library') && 'is-active']}
    data-fm-art="library"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <defs>
      <clipPath id="fma-shelf-clip">
        <rect x="0" y="0" width="320" height="200" rx="12"></rect>
      </clipPath>
    </defs>

    <g clip-path="url(#fma-shelf-clip)" opacity="0.9">
      <g class="fma-marquee">
        {[...shelf, ...shelf].map((n, i) => (
          <g transform={`translate(${i * 78} 0)`}>
            <rect class="fma-panel" x="14" y="22" width="64" height="50" rx="9"></rect>
            <rect class="fma-bar" x="24" y="34" width={22 + ((n * 11) % 26)} height="5" rx="2.5"></rect>
            <rect class="fma-soft-fill" x="24" y="46" width="44" height="16" rx="5"></rect>
          </g>
        ))}
      </g>
      <g class="fma-marquee-rev">
        {[...shelf, ...shelf].map((n, i) => (
          <g transform={`translate(${i * 78} 0)`}>
            <rect class="fma-panel" x="14" y="140" width="64" height="46" rx="9"></rect>
            <rect class="fma-bar" x="24" y="150" width={18 + ((n * 17) % 30)} height="5" rx="2.5"></rect>
            <rect class="fma-soft-fill" x="24" y="162" width="34" height="14" rx="5"></rect>
          </g>
        ))}
      </g>
    </g>

    <g class="fma-pop" style="--d:.15s">
      <rect
        x="96"
        y="66"
        width="128"
        height="70"
        rx="12"
        fill="var(--fma-panel-solid)"
        stroke="var(--fma-brand)"
        stroke-width="1.5"
      ></rect>
      <g transform="translate(108 78) scale(0.6)" stroke="var(--fma-brand)" stroke-width="2.4" fill="none">
        <path d={ICON_PATHS.library}></path>
      </g>
      <rect class="fma-bar" x="132" y="82" width="62" height="6" rx="3"></rect>
      <rect class="fma-bar" x="132" y="94" width="40" height="5" rx="2.5" opacity="0.6"></rect>
      <rect x="108" y="112" width="104" height="10" rx="5" fill="var(--fma-soft)"></rect>
      <rect class="fma-progress" x="108" y="112" width="104" height="10" rx="5" fill="var(--fma-brand)"></rect>
    </g>
  </svg>

  <!-- Bots -->
  <svg
    class:list={['fma-scene', active('bots') && 'is-active']}
    data-fm-art="bots"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <g class="fma-rise">
      <rect class="fma-panel" x="20" y="14" width="128" height="28" rx="10"></rect>
      <g transform="translate(31 21) scale(0.6)" stroke="var(--fma-brand)" stroke-width="2.4" fill="none">
        <path d={ICON_PATHS.bolt}></path>
      </g>
      <rect class="fma-bar" x="50" y="25" width="84" height="6" rx="3"></rect>
    </g>

    <path class="fma-flow" d="M84 42 84 62" stroke="var(--fma-brand)" stroke-width="1.5" opacity="0.8"></path>

    {[0, 1, 2].map((n) => (
      <g class="fma-rise" style={`--d:${0.15 + n * 0.12}s`}>
        <rect class="fma-panel" x={20 + n * 100} y="62" width="84" height="56" rx="11" />
        <circle cx={38 + n * 100} cy="80" r="9" fill="var(--fma-soft)" />
        <circle class="fma-blink" style={`--d:${n * 0.4}s`} cx={38 + n * 100} cy="80" r="3.4" fill="var(--fma-brand)" />
        <rect class="fma-bar" x={54 + n * 100} y="76" width="34" height="5" rx="2.5" />
        <rect class="fma-bar" x="0" y="98" width="60" height="5" rx="2.5" opacity="0.6" transform={`translate(${32 + n * 100} 0)`} />
      </g>
    ))}

    {[0, 1].map((n) => (
      <g>
        <path
          class="fma-flow"
          style={`--d:${n * 0.3}s`}
          d={`M${104 + n * 100} 90 H${120 + n * 100}`}
          stroke="var(--fma-brand)"
          stroke-width="1.5"
        />
        <circle class="fma-packet" r="2.4" fill="var(--fma-brand)">
          <animateMotion dur="1.8s" begin={`${n * 0.45}s`} repeatCount="indefinite" path={`M${104 + n * 100} 90 H${120 + n * 100}`} />
        </circle>
      </g>
    ))}

    <path class="fma-flow" d="M262 118 262 146" stroke="var(--fma-accent)" stroke-width="1.5" opacity="0.8"></path>

    <g class="fma-rise" style="--d:.5s">
      <rect x="20" y="146" width="280" height="38" rx="12" fill="var(--fma-soft)" stroke="var(--fma-brand)" stroke-width="1.2"></rect>
      <circle class="fma-ripple" cx="44" cy="165" r="12" fill="none" stroke="var(--fma-brand)" stroke-width="1.4"></circle>
      <g transform="translate(36 157) scale(0.66)" stroke="var(--fma-brand)" stroke-width="2.2" fill="none">
        <path d={ICON_PATHS.bell}></path>
      </g>
      <rect class="fma-bar" x="66" y="158" width="140" height="6" rx="3"></rect>
      <rect class="fma-bar" x="66" y="170" width="88" height="5" rx="2.5" opacity="0.6"></rect>
      <rect class="fma-brandbar" x="252" y="160" width="34" height="9" rx="4.5"></rect>
    </g>
  </svg>

  <!-- Agents -->
  <svg
    class:list={['fma-scene', active('agents') && 'is-active']}
    data-fm-art="agents"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <g class="fma-spin" style="transform-origin:100px 100px;--dur:26s">
      <circle cx="100" cy="100" r="66" stroke="var(--fma-line)" stroke-width="1.2" stroke-dasharray="4 8"></circle>
    </g>
    <g class="fma-spin-rev" style="transform-origin:100px 100px;--dur:18s">
      <circle cx="100" cy="100" r="44" stroke="var(--fma-line)" stroke-width="1.2" stroke-dasharray="3 7"></circle>
    </g>

    {[
      { r: 66, dur: '14s', d: '0s', fill: 'var(--fma-brand)', size: 5 },
      { r: 66, dur: '14s', d: '-4.6s', fill: 'var(--fma-accent)', size: 4 },
      { r: 44, dur: '9s', d: '-2s', fill: 'var(--fma-sky)', size: 4 },
    ].map((s) => (
      <g class="fma-spin" style={`transform-origin:100px 100px;--dur:${s.dur};--d:${s.d}`}>
        <circle cx={100 + s.r} cy="100" r={s.size} fill={s.fill} />
      </g>
    ))}

    <circle class="fma-ripple" cx="100" cy="100" r="26" fill="none" stroke="var(--fma-brand)" stroke-width="1.4"></circle>
    <circle cx="100" cy="100" r="26" fill="var(--fma-soft)" stroke="var(--fma-brand)" stroke-width="1.4"></circle>
    <g transform="translate(88 88) scale(1)" stroke="var(--fma-brand)" stroke-width="1.6" fill="none">
      <path d={ICON_PATHS.cpu}></path>
    </g>

    {[0, 1, 2].map((n) => (
      <g class="fma-rise" style={`--d:${0.25 + n * 0.18}s`}>
        <rect class="fma-panel" x="192" y={46 + n * 38} width="106" height="30" rx="9" />
        <circle
          class="fma-check-dot"
          style={`--d:${0.9 + n * 0.5}s`}
          cx="208"
          cy={61 + n * 38}
          r="7"
          fill="var(--fma-soft)"
          stroke="var(--fma-brand)"
          stroke-width="1.2"
        />
        <path
          class="fma-check"
          style={`--d:${1 + n * 0.5}s`}
          d={`M204.5 ${61 + n * 38}l2.6 2.6 4.6-4.8`}
          stroke="var(--fma-brand)"
          stroke-width="1.8"
          pathLength="1"
        />
        <rect class="fma-bar" x="224" y={57 + n * 38} width={58 - n * 12} height="6" rx="3" />
      </g>
    ))}
  </svg>

  <!-- Copilot -->
  <svg
    class:list={['fma-scene', active('copilot') && 'is-active']}
    data-fm-art="copilot"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <g class="fma-slide-left">
      <rect x="140" y="16" width="164" height="38" rx="12" fill="var(--fma-soft)" stroke="var(--fma-brand)" stroke-width="1.1"></rect>
      <rect class="fma-bar" x="154" y="27" width="120" height="6" rx="3"></rect>
      <rect class="fma-bar" x="154" y="39" width="76" height="5" rx="2.5" opacity="0.6"></rect>
    </g>

    <g class="fma-slide-right" style="--d:.4s">
      <rect class="fma-panel" x="16" y="66" width="180" height="46" rx="12"></rect>
      <g transform="translate(26 78) scale(0.55)" stroke="var(--fma-brand)" stroke-width="2.6" fill="none">
        <path d={ICON_PATHS.chat}></path>
      </g>
      {[0, 1, 2].map((n) => (
        <circle class="fma-blink" style={`--d:${n * 0.22}s`} cx={56 + n * 14} cy="89" r="4" fill="var(--fma-brand)" />
      ))}
      <rect class="fma-bar" x="106" y="85" width="76" height="6" rx="3" opacity="0.5"></rect>
    </g>

    <g class="fma-pop" style="--d:1.05s">
      <rect class="fma-panel" x="16" y="124" width="196" height="60" rx="12"></rect>
      <rect class="fma-brandbar" x="30" y="136" width="40" height="6" rx="3"></rect>
      {[0, 1, 2, 3, 4].map((n) => (
        <rect
          class="fma-grow"
          style={`--d:${1.3 + n * 0.08}s`}
          x={30 + n * 22}
          y={172 - (10 + ((n * 23) % 28))}
          width="14"
          height={10 + ((n * 23) % 28)}
          rx="3"
          fill={n === 4 ? 'var(--fma-brand)' : 'var(--fma-soft)'}
        />
      ))}
    </g>

    <g class="fma-float" style="--d:.2s">
      <rect x="226" y="124" width="78" height="60" rx="12" fill="var(--fma-soft)"></rect>
      <g transform="translate(252 140) scale(1.1)" stroke="var(--fma-brand)" stroke-width="1.6" fill="none">
        <path d={ICON_PATHS.wand}></path>
      </g>
      <rect class="fma-brandbar" x="244" y="168" width="42" height="6" rx="3"></rect>
    </g>
  </svg>

  <!-- Connectors -->
  <svg
    class:list={['fma-scene', active('connectors') && 'is-active']}
    data-fm-art="connectors"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {spokes.map((s) => (
      <path
        class="fma-flow"
        style={`--d:${s.i * 0.18}s`}
        d={`M160 100 L${s.x} ${s.y}`}
        stroke="var(--fma-brand)"
        stroke-width="1.4"
        opacity="0.75"
      />
    ))}
    {spokes.slice(0, 3).map((s) => (
      <circle class="fma-packet" r="2.6" fill="var(--fma-accent)">
        <animateMotion dur="2.6s" begin={`${s.i * 0.6}s`} repeatCount="indefinite" path={`M${s.x} ${s.y} L160 100`} />
      </circle>
    ))}

    {spokes.map((s) => (
      <g class="fma-pop" style={`--d:${0.1 + s.i * 0.09}s`}>
        <rect class="fma-panel" x={s.x - 22} y={s.y - 13} width="44" height="26" rx="9" />
        <circle cx={s.x - 10} cy={s.y} r="4" fill={s.i % 2 ? 'var(--fma-accent)' : 'var(--fma-brand)'} />
        <rect class="fma-bar" x={s.x - 2} y={s.y - 3} width="16" height="5" rx="2.5" />
      </g>
    ))}

    <circle class="fma-ripple" cx="160" cy="100" r="28" fill="none" stroke="var(--fma-brand)" stroke-width="1.4"></circle>
    <circle class="fma-ripple" style="--d:1s" cx="160" cy="100" r="28" fill="none" stroke="var(--fma-brand)" stroke-width="1.4"></circle>
    <circle cx="160" cy="100" r="28" fill="var(--fma-panel-solid)" stroke="var(--fma-brand)" stroke-width="1.5"></circle>
    <g transform="translate(148 88)" stroke="var(--fma-brand)" stroke-width="1.7" fill="none">
      <path d={ICON_PATHS.plug}></path>
    </g>
  </svg>

  <!-- Social media apps -->
  <svg
    class:list={['fma-scene', active('social') && 'is-active']}
    data-fm-art="social"
    viewBox="0 0 320 200"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="92" cy="100" r="60" fill="var(--fma-soft)" opacity="0.5"></circle>
    <g class="fma-spin" style="transform-origin:92px 100px;--dur:24s">
      <circle cx="92" cy="100" r="60" stroke="var(--fma-brand)" stroke-width="1.3"></circle>
      <ellipse cx="92" cy="100" rx="24" ry="60" stroke="var(--fma-line)" stroke-width="1.1"></ellipse>
      <ellipse cx="92" cy="100" rx="46" ry="60" stroke="var(--fma-line)" stroke-width="1.1"></ellipse>
      <path d="M32 100h120M44 66h96M44 134h96" stroke="var(--fma-line)" stroke-width="1.1"></path>
      <circle class="fma-blink" cx="70" cy="72" r="4" fill="var(--fma-brand)"></circle>
      <circle class="fma-blink" style="--d:.5s" cx="116" cy="118" r="4" fill="var(--fma-accent)"></circle>
      <circle class="fma-blink" style="--d:.9s" cx="82" cy="132" r="3.4" fill="var(--fma-sky)"></circle>
    </g>

    <path class="fma-draw" d="M150 84 C186 62 208 60 236 58" stroke="var(--fma-brand)" stroke-width="1.4" pathLength="1" opacity="0.8"></path>
    <path class="fma-draw" style="--d:.25s" d="M152 108 C188 108 206 106 236 104" stroke="var(--fma-brand)" stroke-width="1.4" pathLength="1" opacity="0.8"></path>
    <path class="fma-draw" style="--d:.5s" d="M148 128 C184 148 208 150 236 152" stroke="var(--fma-brand)" stroke-width="1.4" pathLength="1" opacity="0.8"></path>

    {[0, 1, 2].map((n) => (
      <g class="fma-slide-left" style={`--d:${0.3 + n * 0.18}s`}>
        <rect class="fma-panel" x="236" y={40 + n * 46} width="68" height="36" rx="10" />
        <circle cx="252" cy={58 + n * 46} r="7" fill={n === 1 ? 'var(--fma-brand)' : 'var(--fma-soft)'} />
        <rect class="fma-bar" x="264" y={51 + n * 46} width="30" height="5" rx="2.5" />
