---
import { SITE, SOCIALS, languages, type Lang } from '../i18n/config';
import { localizePath, getAlternates, withTrailingSlash, ogLocale } from '../i18n/utils';
import {
  THEME_CHANGE_EVENT,
  THEME_COLORS,
  THEME_FAVICONS,
  THEME_STORAGE_KEY,
} from '../lib/theme';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Canonical, English-shaped route this page maps to, e.g. `/features`. */
  route: string;
  /** OG image path relative to site root. */
  image?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD objects to embed. */
  schema?: Record<string, unknown>[];
  /** Prevent indexing (e.g. 404). */
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  route,
  image = '/og.png',
  type = 'website',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = withTrailingSlash(new URL(localizePath(route, lang), SITE.url).href);
const alternates = getAlternates(route, SITE.url);
const ogImage = new URL(image, SITE.url).href;
const primaryOgLocale = ogLocale(lang);
const altOgLocales = (Object.keys(languages) as Lang[])
  .filter((l) => l !== lang)
  .map((l) => ogLocale(l));

// Baseline Organization schema on every page for GEO / knowledge-graph.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/logo-black.png', SITE.url).href,
  sameAs: SOCIALS.map((s) => s.href),
};
const allSchema = [orgSchema, ...schema];
---

<!-- Global metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical + language alternates -->
<link rel="canonical" href={canonical} />
{
  (Object.keys(languages) as Lang[]).map((l) => (
    <link rel="alternate" hreflang={l} href={alternates[l]} />
  ))
}
<link rel="alternate" hreflang="x-default" href={alternates['x-default']} />

<!-- Feed for this locale, so readers and crawlers can discover /rss.xml -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} — ${languages[lang]}`}
  href={localizePath('/rss.xml', lang)}
/>

<!-- Icons — system color scheme: black mark (light), white mark (dark) -->
<link id="site-favicon" rel="icon" href="/favicon-black.png" type="image/png" />
<link rel="icon" href="/favicon-black.png" type="image/png" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon.png" type="image/png" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-black.png" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-black.png" media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" media="(prefers-color-scheme: dark)" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{/* Runs before paint, so it cannot import — the values come from src/lib/theme
    via define:vars, keeping one source of truth with ThemeToggle. */}
<script
  is:inline
  define:vars={{
    storageKey: THEME_STORAGE_KEY,
    colors: THEME_COLORS,
    favicons: THEME_FAVICONS,
    changeEvent: THEME_CHANGE_EVENT,
  }}
>
  (function () {
    function isDark() {
      if (document.documentElement.dataset.themeLocked !== undefined) {
        return document.documentElement.classList.contains('dark');
      }
      try {
        var stored = localStorage.getItem(storageKey);
        if (stored === 'dark' || stored === 'light') return stored === 'dark';
      } catch (e) {}
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }
    function apply() {
      var theme = isDark() ? 'dark' : 'light';
      var link = document.getElementById('site-favicon');
      if (!link) return;
      link.href = favicons[theme];
      var meta = document.querySelector('meta[name="theme-color"]:not([media])');
      if (meta) meta.setAttribute('content', colors[theme]);
    }
    apply();
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply);
    document.addEventListener(changeEvent, apply);
  })();
</script>
<meta name="theme-color" content={THEME_COLORS.light} />
<meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={primaryOgLocale} />
{altOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.x} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Structured data (SEO + GEO) -->
{
  allSchema.map((s) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
  ))
}

<slot />
