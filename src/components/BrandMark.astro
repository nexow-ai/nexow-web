---
/**
 * Nexow spike mark — uses the brand favicon PNGs (public/favicon.png /
 * favicon-black.png). Same asset as the browser tab icon.
 */
interface Props {
  class?: string;
  title?: string;
  /** light = white mark (dark bg), dark = black mark (light bg), auto = follows theme */
  tone?: 'dark' | 'light' | 'auto';
}
const { class: className, title, tone = 'light' } = Astro.props;
const imgClass = ['w-auto select-none object-contain', className];
---

{
  tone === 'auto' ? (
    <>
      <img
        src="/favicon-black.png"
        alt={title ?? ''}
        width="593"
        height="750"
        class:list={[...imgClass, 'dark:hidden']}
        loading="lazy"
        decoding="async"
        role={title ? 'img' : 'presentation'}
        aria-hidden={title ? undefined : 'true'}
        aria-label={title}
      />
      <img
        src="/favicon.png"
        alt=""
        width="593"
        height="750"
        class:list={[...imgClass, 'hidden dark:block']}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
      />
    </>
  ) : (
    <img
      src={tone === 'light' ? '/favicon.png' : '/favicon-black.png'}
      alt={title ?? ''}
      width="593"
      height="750"
      class:list={imgClass}
      loading="lazy"
      decoding="async"
      role={title ? 'img' : 'presentation'}
      aria-hidden={title ? undefined : 'true'}
      aria-label={title}
    />
  )
}
