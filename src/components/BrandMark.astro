---
/**
 * Nexow spike mark — uses the brand favicon PNGs (public/favicon.png /
 * favicon-black.png). Same asset as the browser tab icon.
 */
interface Props {
  class?: string;
  title?: string;
  /** light = white mark (dark backgrounds), dark = black mark (light backgrounds) */
  tone?: 'dark' | 'light';
}
const { class: className, title, tone = 'light' } = Astro.props;
const src = tone === 'light' ? '/favicon.png' : '/favicon-black.png';
---

<img
  src={src}
  alt={title ?? ''}
  width="593"
  height="750"
  class:list={['w-auto select-none object-contain', className]}
  loading="lazy"
  decoding="async"
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
/>
