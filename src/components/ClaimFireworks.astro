---
/**
 * Soft brand fireworks for the "claim your @handle" CTA band.
 * Pure CSS/SVG bursts — pauses under prefers-reduced-motion.
 */
---

<div class="claim-fw pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true" data-claim-fw>
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 1200 420" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="cfw-core-a" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-brand-300)" stop-opacity="0.95"></stop>
        <stop offset="55%" stop-color="var(--color-brand-500)" stop-opacity="0.35"></stop>
        <stop offset="100%" stop-color="var(--color-brand-500)" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="cfw-core-b" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--color-sky-300)" stop-opacity="0.9"></stop>
        <stop offset="55%" stop-color="var(--color-accent-400)" stop-opacity="0.3"></stop>
        <stop offset="100%" stop-color="var(--color-accent-500)" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id="cfw-spark" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.85"></stop>
        <stop offset="100%" stop-color="var(--color-sky-400)" stop-opacity="0.15"></stop>
      </linearGradient>
    </defs>

    <!-- Burst A (upper left) -->
    <g class="cfw-burst cfw-burst--a" transform="translate(220 150)">
      <circle r="28" fill="url(#cfw-core-a)" class="cfw-bloom"></circle>
      {
        [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330].map((deg, i) => (
          <g transform={`rotate(${deg})`}>
            <line
              class="cfw-ray"
              style={`--i:${i}`}
              x1="8"
              y1="0"
              x2="52"
              y2="0"
              stroke="url(#cfw-spark)"
              stroke-width="1.6"
              stroke-linecap="round"
            ></line>
            <circle class="cfw-dot" style={`--i:${i}`} cx="58" cy="0" r="2.2" fill="var(--color-brand-400)"></circle>
          </g>
        ))
      }
    </g>

    <!-- Burst B (upper right) -->
    <g class="cfw-burst cfw-burst--b" transform="translate(980 130)">
      <circle r="22" fill="url(#cfw-core-b)" class="cfw-bloom"></circle>
      {
        [15, 55, 95, 135, 175, 215, 255, 295, 335].map((deg, i) => (
          <g transform={`rotate(${deg})`}>
            <line
              class="cfw-ray"
              style={`--i:${i}`}
              x1="6"
              y1="0"
              x2="44"
              y2="0"
              stroke="var(--color-sky-400)"
              stroke-opacity="0.7"
              stroke-width="1.4"
              stroke-linecap="round"
            ></line>
            <circle class="cfw-dot" style={`--i:${i}`} cx="50" cy="0" r="1.8" fill="var(--color-accent-400)"></circle>
          </g>
        ))
      }
    </g>

    <!-- Burst C (lower center-left) -->
    <g class="cfw-burst cfw-burst--c" transform="translate(420 300)">
      <circle r="18" fill="url(#cfw-core-a)" class="cfw-bloom" opacity="0.8"></circle>
      {
        [0, 45, 90, 135, 180, 225, 270, 315].map((deg, i) => (
          <g transform={`rotate(${deg})`}>
            <line
              class="cfw-ray"
              style={`--i:${i}`}
              x1="5"
              y1="0"
              x2="36"
              y2="0"
              stroke="var(--color-brand-500)"
              stroke-opacity="0.55"
              stroke-width="1.3"
              stroke-linecap="round"
            ></line>
            <circle class="cfw-dot" style={`--i:${i}`} cx="40" cy="0" r="1.6" fill="var(--color-brand-300)"></circle>
          </g>
        ))
      }
    </g>

    <!-- Burst D (lower right) -->
    <g class="cfw-burst cfw-burst--d" transform="translate(780 290)">
      <circle r="16" fill="url(#cfw-core-b)" class="cfw-bloom" opacity="0.75"></circle>
      {
        [20, 80, 140, 200, 260, 320].map((deg, i) => (
          <g transform={`rotate(${deg})`}>
            <line
              class="cfw-ray"
              style={`--i:${i}`}
              x1="4"
              y1="0"
              x2="30"
              y2="0"
              stroke="var(--color-accent-400)"
              stroke-opacity="0.55"
              stroke-width="1.2"
              stroke-linecap="round"
            ></line>
            <circle class="cfw-dot" style={`--i:${i}`} cx="34" cy="0" r="1.5" fill="var(--color-sky-300)"></circle>
          </g>
        ))
      }
    </g>

    <!-- Drift sparks -->
    <circle class="cfw-drift" cx="160" cy="240" r="2" fill="var(--color-brand-400)" opacity="0.5"></circle>
    <circle class="cfw-drift cfw-drift--2" cx="640" cy="90" r="1.6" fill="var(--color-sky-400)" opacity="0.45"></circle>
    <circle class="cfw-drift cfw-drift--3" cx="1050" cy="250" r="1.8" fill="var(--color-accent-400)" opacity="0.4"></circle>
  </svg>
</div>

<style>
  .cfw-burst {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: cfw-pop 4.8s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) infinite;
  }
  .cfw-burst--a { animation-delay: 0s; }
  .cfw-burst--b { animation-delay: 1.2s; }
  .cfw-burst--c { animation-delay: 2.4s; }
  .cfw-burst--d { animation-delay: 3.4s; }

  .cfw-bloom {
    animation: cfw-bloom 4.8s ease-out infinite;
  }
  .cfw-burst--b .cfw-bloom { animation-delay: 1.2s; }
  .cfw-burst--c .cfw-bloom { animation-delay: 2.4s; }
  .cfw-burst--d .cfw-bloom { animation-delay: 3.4s; }

  .cfw-ray,
  .cfw-dot {
    opacity: 0;
    animation: cfw-spark 4.8s ease-out infinite;
    animation-delay: calc(var(--burst-delay, 0s) + var(--i, 0) * 0.03s);
  }
  .cfw-burst--a { --burst-delay: 0s; }
  .cfw-burst--b { --burst-delay: 1.2s; }
  .cfw-burst--c { --burst-delay: 2.4s; }
  .cfw-burst--d { --burst-delay: 3.4s; }

  .cfw-drift {
    animation: cfw-float 7s ease-in-out infinite;
  }
  .cfw-drift--2 { animation-delay: 1.5s; animation-duration: 8.5s; }
  .cfw-drift--3 { animation-delay: 3s; animation-duration: 6.5s; }

  @keyframes cfw-pop {
    0%, 8% { opacity: 0; }
    14% { opacity: 1; }
    42% { opacity: 0.85; }
    70%, 100% { opacity: 0; }
  }
  @keyframes cfw-bloom {
    0%, 10% { opacity: 0; transform: scale(0.35); }
    18% { opacity: 0.9; transform: scale(1); }
    55% { opacity: 0.25; transform: scale(1.55); }
    80%, 100% { opacity: 0; transform: scale(1.8); }
  }
  @keyframes cfw-spark {
    0%, 10% { opacity: 0; }
    16% { opacity: 0.95; }
    50% { opacity: 0.35; }
    75%, 100% { opacity: 0; }
  }
  @keyframes cfw-float {
    0%, 100% { transform: translateY(0); opacity: 0.25; }
    50% { transform: translateY(-14px); opacity: 0.65; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cfw-burst,
    .cfw-bloom,
    .cfw-ray,
    .cfw-dot,
    .cfw-drift {
      animation: none !important;
    }
    .cfw-burst {
      opacity: 0.35;
    }
    .cfw-ray,
    .cfw-dot {
      opacity: 0.4;
    }
    .cfw-bloom {
      opacity: 0.45;
      transform: none;
    }
  }
</style>
