---
/**
 * Interactive USDC→Solana purchase rail: path-drawn rail, traveling packets,
 * hoverable step nodes. Illustrative (aria-hidden).
 */
import Icon from './Icon.astro';

interface Props {
  steps: { n: string; title: string }[];
}
const { steps } = Astro.props;
---

<div class="mkt-flow relative mx-auto w-full max-w-2xl" aria-hidden="true" data-motion="rise">
  <!-- Full decorative rail SVG -->
  <div class="relative mb-2 hidden sm:block">
    <svg class="mx-auto h-28 w-full max-w-xl" viewBox="0 0 520 110" fill="none">
      <defs>
        <linearGradient id="mkt-rail" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--color-brand-400)"></stop>
          <stop offset="50%" stop-color="var(--color-accent-400)"></stop>
          <stop offset="100%" stop-color="var(--color-plasma-400)"></stop>
        </linearGradient>
        <filter id="mkt-glow" x="-40%" y="-40%" width="180%" height="180%">
          <feGaussianBlur stdDeviation="4" result="b"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="b"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <!-- Soft track -->
      <path d="M40 55 C 140 55 160 55 200 55 S 300 55 360 55 S 440 55 480 55" stroke="var(--color-brand-200)" stroke-width="6" stroke-linecap="round" opacity="0.35"></path>

      <!-- Animated draw rail -->
      <path
        class="mkt-draw"
        pathLength="1"
        d="M40 55 C 140 55 160 55 200 55 S 300 55 360 55 S 440 55 480 55"
        stroke="url(#mkt-rail)"
        stroke-width="2.5"
        stroke-linecap="round"
      ></path>

      <!-- Dashed flow -->
      <path
        class="mkt-dash"
        d="M40 55 C 140 55 160 55 200 55 S 300 55 360 55 S 440 55 480 55"
        stroke="url(#mkt-rail)"
        stroke-width="1.5"
        stroke-dasharray="5 9"
        stroke-linecap="round"
        opacity="0.55"
      ></path>

      <!-- Station nodes -->
      {[40, 200, 360, 480].map((x, i) => (
        <g class="mkt-station" style={`--d:${0.2 + i * 0.12}s`}>
          <circle cx={x} cy="55" r="16" fill="white" stroke="var(--color-brand-200)" stroke-width="1.5"></circle>
          <circle cx={x} cy="55" r="6" fill="url(#mkt-rail)" filter="url(#mkt-glow)" class="mkt-station-core"></circle>
          <text x={x} y="88" text-anchor="middle" class="fill-brand-600 font-mono text-[10px]" style="font-family:var(--font-mono)">{String(i + 1).padStart(2, '0')}</text>
        </g>
      ))}

      <!-- Packets -->
      <circle r="4.5" fill="var(--color-brand-400)" filter="url(#mkt-glow)">
        <animateMotion dur="4s" repeatCount="indefinite" path="M40 55 C 140 55 160 55 200 55 S 300 55 360 55 S 440 55 480 55"></animateMotion>
      </circle>
      <circle r="3.2" fill="var(--color-accent-400)" opacity="0.85">
        <animateMotion dur="4.8s" begin="1.2s" repeatCount="indefinite" path="M40 55 C 140 55 160 55 200 55 S 300 55 360 55 S 440 55 480 55"></animateMotion>
      </circle>

      <!-- Solana spark marks -->
      <path d="M60 28l1.6 4 4 1.6-4 1.6-1.6 4-1.6-4-4-1.6 4-1.6z" fill="var(--color-brand-400)" class="mkt-spark" style="--d:0s"></path>
      <path d="M460 28l1.4 3.4 3.4 1.4-3.4 1.4-1.4 3.4-1.4-3.4-3.4-1.4 3.4-1.4z" fill="var(--color-plasma-400)" class="mkt-spark" style="--d:0.8s"></path>
    </svg>
  </div>

  <ol class="relative grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-3">
    {
      steps.map((s, i) => (
        <li class="mkt-step group flex flex-col items-center text-center" style={`--d:${i * 0.1}s`}>
          <span class="relative z-10 inline-flex size-14 items-center justify-center rounded-2xl bg-white text-brand-700 shadow-lg shadow-brand-500/15 ring-1 ring-brand-200/80 transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-brand-500/25 group-hover:ring-brand-400/50 group-focus-within:-translate-y-1">
            <span class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-br from-brand-400/0 via-accent-400/0 to-plasma-400/0 opacity-0 transition-opacity duration-300 group-hover:opacity-20"></span>
            {i === 0 && <Icon name="store" class="relative size-5 transition-transform duration-300 group-hover:scale-110" />}
            {i === 1 && <Icon name="coins" class="relative size-5 transition-transform duration-300 group-hover:scale-110" />}
            {i === 2 && <Icon name="shield" class="relative size-5 transition-transform duration-300 group-hover:scale-110" />}
            {i === 3 && <Icon name="check" class="relative size-5 transition-transform duration-300 group-hover:scale-110" />}
          </span>
          <span class="mt-3 font-mono text-[0.65rem] text-brand-600">{s.n}</span>
          <span class="mt-1 max-w-[9.5rem] font-display text-sm font-semibold leading-snug text-ink-950 transition-colors group-hover:text-brand-800">{s.title}</span>
        </li>
      ))
    }
  </ol>

  <div class="mkt-badge mt-8 flex items-center justify-center gap-2 rounded-full border border-brand-200/70 bg-gradient-to-r from-brand-50 via-white to-accent-50/60 px-4 py-2.5 font-mono text-xs text-brand-800 shadow-sm">
    <Icon name="bolt" class="size-3.5 text-brand-600 mkt-bolt" />
    USDC · Solana · direct wallet transfer
  </div>
</div>

<style>
  .mkt-draw {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: mkt-draw 1.8s var(--ease-out-expo) 0.2s forwards;
  }
  .mkt-dash {
    animation: mkt-flow 7s linear infinite;
  }
  .mkt-station {
    animation: mkt-pop 0.75s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }
  .mkt-station-core {
    animation: mkt-core 2.8s ease-in-out infinite;
  }
  .mkt-step {
    animation: mkt-in 0.85s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }
  .mkt-spark {
    animation: mkt-twinkle 2.2s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .mkt-bolt {
    animation: mkt-twinkle 1.8s ease-in-out infinite;
  }
  .mkt-badge {
    animation: mkt-in 0.9s var(--ease-out-expo) 0.45s both;
  }

  @keyframes mkt-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes mkt-flow {
    to { stroke-dashoffset: -80; }
  }
  @keyframes mkt-pop {
    from { opacity: 0; transform: scale(0.6); }
    to { opacity: 1; transform: none; }
  }
  @keyframes mkt-core {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 1; }
  }
  @keyframes mkt-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes mkt-twinkle {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }

  .is-offscreen .mkt-draw,
  .is-offscreen .mkt-dash,
  .is-offscreen .mkt-station,
  .is-offscreen .mkt-station-core,
  .is-offscreen .mkt-step,
  .is-offscreen .mkt-spark,
  .is-offscreen .mkt-bolt,
  .is-offscreen .mkt-badge {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .mkt-draw { animation: none; stroke-dashoffset: 0; }
    .mkt-dash,
    .mkt-station,
    .mkt-station-core,
    .mkt-step,
    .mkt-spark,
    .mkt-bolt,
    .mkt-badge {
      animation: none;
    }
  }
</style>
