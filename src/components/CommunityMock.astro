---
/**
 * Decorative community/marketplace mock: a maker's shared widget post with a
 * mini template thumbnail, a live DM row, and a marketplace install cue.
 * Purely illustrative (aria-hidden), deterministic markup.
 */
import Icon from './Icon.astro';
---

<div
  class="relative mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-ink-900/10 bg-white shadow-xl shadow-ink-950/10"
  aria-hidden="true"
>
  <div class="flex items-center gap-2 border-b border-ink-900/8 px-4 py-3">
    <Icon name="users" class="size-4 text-sky-600" />
    <span class="font-mono text-xs text-ink-500">community · discover</span>
    <span class="ml-auto rounded-full bg-sky-50 px-2 py-0.5 font-mono text-[0.65rem] text-sky-700">feed</span>
  </div>

  <div class="space-y-3 p-5">
    <!-- Shared widget post -->
    <div class="rounded-xl border border-ink-900/10 bg-[#f7fbfb] p-3">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex size-8 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-accent-500 font-display text-xs font-bold text-white">Q</span>
        <div class="min-w-0 leading-tight">
          <p class="font-mono text-xs text-ink-900">@quanta</p>
          <p class="font-mono text-[0.6rem] text-ink-500">shared a widget</p>
        </div>
        <span class="ml-auto inline-flex shrink-0 items-center gap-1 rounded-full bg-white px-2 py-0.5 font-mono text-[0.6rem] text-ink-600 ring-1 ring-ink-900/10">
          <Icon name="store" class="size-3 text-brand-700" /> $12
        </span>
      </div>

      <!-- mini template thumbnail -->
      <div class="mt-3 grid h-16 grid-cols-5 gap-1 rounded-lg border border-ink-900/10 bg-white p-2">
        {Array.from({ length: 10 }).map((_, i) => (
          <span class:list={[
            'rounded-sm',
            [0, 5].includes(i) ? 'bg-brand-400/65' : [3, 8].includes(i) ? 'bg-accent-400/65' : 'bg-ink-900/[0.06]',
          ]}></span>
        ))}
      </div>

      <div class="mt-3 flex items-center gap-4 font-mono text-[0.65rem] text-ink-400">
        <span class="inline-flex items-center gap-1.5 text-rose-500"><Icon name="check" class="size-3.5" /> 128</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="chat" class="size-3.5" /> 24</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="arrow" class="size-3.5" /> fork</span>
      </div>
    </div>

    <!-- Realtime DM row -->
    <div class="flex items-center gap-2.5 rounded-xl border border-ink-900/10 bg-white px-3 py-2.5">
      <span class="relative inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-display text-xs font-bold text-brand-800">
        A
        <span class="absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full bg-brand-500 ring-2 ring-white"></span>
      </span>
      <div class="min-w-0 leading-tight">
        <p class="font-mono text-xs text-ink-900">@ada</p>
        <p class="truncate font-mono text-[0.6rem] text-ink-500">typing a reply…</p>
      </div>
      <span class="ml-auto inline-flex shrink-0 items-center gap-1 rounded-full bg-brand-50 px-2 py-0.5 font-mono text-[0.6rem] text-brand-700 ring-1 ring-brand-200/80">
        <Icon name="mail" class="size-3" /> live
      </span>
    </div>

    <!-- Marketplace row -->
    <div class="flex items-center gap-2.5 rounded-xl border border-sky-200 bg-sky-50 px-3 py-2.5">
      <Icon name="store" class="size-4 shrink-0 text-sky-700" />
      <span class="min-w-0 truncate font-mono text-xs text-ink-700">new theme in marketplace</span>
      <span class="ml-auto shrink-0 font-mono text-[0.65rem] text-brand-700">install</span>
    </div>
  </div>
</div>
