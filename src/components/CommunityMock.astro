---
/**
 * Decorative community feed mock with soft idle motion and hover accents.
 */
import Icon from './Icon.astro';
---

<div
  class="community-mock relative mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] shadow-xl shadow-ink-950/10 transition-shadow duration-500 hover:shadow-2xl hover:shadow-sky-500/10"
  aria-hidden="true"
>
  <div class="pointer-events-none absolute -right-16 -top-16 size-40 rounded-full opacity-40 blur-3xl community-mock-glow" style="background:radial-gradient(circle, var(--color-sky-300), transparent 70%)"></div>

  <!-- Subtle network SVG behind the feed cards -->
  <svg class="pointer-events-none absolute inset-x-0 bottom-0 h-28 w-full opacity-50" viewBox="0 0 360 110" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="cm-net" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0"></stop>
        <stop offset="40%" stop-color="var(--color-sky-400)" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="var(--color-accent-400)" stop-opacity="0.35"></stop>
      </linearGradient>
    </defs>
    <path class="community-mock-arc" pathLength="1" d="M20 80 C 90 30 140 95 200 55 C 250 25 300 70 340 40" stroke="url(#cm-net)" stroke-width="1.3" stroke-linecap="round"></path>
    <circle class="community-mock-packet" r="2.4" fill="var(--color-sky-500)">
      <animateMotion dur="4.5s" repeatCount="indefinite" path="M20 80 C 90 30 140 95 200 55 C 250 25 300 70 340 40"></animateMotion>
    </circle>
    <circle class="community-mock-node" cx="90" cy="48" r="2" fill="var(--color-brand-400)"></circle>
    <circle class="community-mock-node" cx="200" cy="55" r="2" fill="var(--color-sky-400)" style="--d:0.4s"></circle>
    <circle class="community-mock-node" cx="300" cy="58" r="2" fill="var(--color-accent-400)" style="--d:0.8s"></circle>
  </svg>

  <div class="relative flex items-center gap-2 border-b border-ink-900/8 dark:border-white/8 px-4 py-3">
    <Icon name="users" class="size-4 text-sky-600" />
    <span class="font-mono text-xs text-ink-500 dark:text-ink-400">community · discover</span>
    <span class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-2 py-0.5 font-mono text-[0.65rem] text-sky-700">
      <span class="size-1.5 rounded-full bg-sky-500 community-mock-pulse"></span>
      feed
    </span>
  </div>

  <div class="relative space-y-3 p-5">
    <div class="community-mock-card rounded-xl border border-ink-900/10 dark:border-white/10 bg-[#f7fbfb] dark:bg-white/[0.015] p-3 transition-transform duration-300 hover:-translate-y-0.5">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex size-8 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-accent-500 font-display text-xs font-bold text-white shadow-md shadow-brand-500/30">Q</span>
        <div class="min-w-0 leading-tight">
          <p class="font-mono text-xs text-ink-900 dark:text-white">@quanta</p>
          <p class="font-mono text-[0.6rem] text-ink-500 dark:text-ink-400">shared a widget</p>
        </div>
        <span class="ml-auto inline-flex shrink-0 items-center gap-1 rounded-full bg-white dark:bg-white/[0.04] px-2 py-0.5 font-mono text-[0.6rem] text-ink-600 dark:text-ink-300 ring-1 ring-ink-900/10 dark:ring-white/10">
          <Icon name="store" class="size-3 text-brand-700" /> $12
        </span>
      </div>

      <div class="mt-3 grid h-16 grid-cols-5 gap-1 rounded-lg border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] p-2">
        {
          Array.from({ length: 10 }).map((_, i) => (
            <span
              class:list={[
                'community-mock-cell rounded-sm',
                [0, 5].includes(i) ? 'bg-brand-400/65' : [3, 8].includes(i) ? 'bg-accent-400/65' : 'bg-ink-900/[0.06]',
              ]}
              style={`--d:${i * 0.05}s`}
            />
          ))
        }
      </div>

      <div class="mt-3 flex items-center gap-4 font-mono text-[0.65rem] text-ink-400">
        <span class="inline-flex items-center gap-1.5 text-rose-500"><Icon name="check" class="size-3.5" /> 128</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="chat" class="size-3.5" /> 24</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="arrow" class="size-3.5 community-mock-fork" /> fork</span>
      </div>
    </div>

    <div class="community-mock-card flex items-center gap-2.5 rounded-xl border border-ink-900/10 dark:border-white/10 bg-white dark:bg-white/[0.04] px-3 py-2.5 transition-transform duration-300 hover:-translate-y-0.5" style="--d:0.12s">
      <span class="relative inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-100 font-display text-xs font-bold text-brand-800">
        A
        <span class="absolute -right-0.5 -bottom-0.5 size-2.5 rounded-full bg-brand-500 ring-2 ring-white community-mock-pulse"></span>
      </span>
      <div class="min-w-0 leading-tight">
        <p class="font-mono text-xs text-ink-900 dark:text-white">@ada</p>
        <p class="truncate font-mono text-[0.6rem] text-ink-500 dark:text-ink-400">
          typing a reply<span class="community-mock-dots">…</span>
        </p>
      </div>
      <span class="ml-auto inline-flex shrink-0 items-center gap-1 rounded-full bg-brand-50 dark:bg-brand-400/12 px-2 py-0.5 font-mono text-[0.6rem] text-brand-700 dark:text-brand-300 ring-1 ring-brand-200/80 dark:ring-brand-400/25">
        <Icon name="mail" class="size-3" /> live
      </span>
    </div>

    <div class="community-mock-card flex items-center gap-2.5 rounded-xl border border-sky-200 bg-gradient-to-r from-sky-50 to-brand-50/40 px-3 py-2.5 transition-transform duration-300 hover:-translate-y-0.5" style="--d:0.22s">
      <Icon name="store" class="size-4 shrink-0 text-sky-700" />
      <span class="min-w-0 truncate font-mono text-xs text-ink-700 dark:text-ink-200">new theme in marketplace</span>
      <span class="ml-auto shrink-0 font-mono text-[0.65rem] font-medium text-brand-700">install</span>
    </div>
  </div>
</div>

<style>
  .community-mock-glow {
    animation: cm-bloom 6s ease-in-out infinite;
  }
  .community-mock-pulse {
    animation: cm-blink 1.5s ease-in-out infinite;
  }
  .community-mock-card {
    animation: cm-in 0.8s var(--ease-out-expo) both;
    animation-delay: var(--d, 0s);
  }
  .community-mock-cell {
    animation: cm-cell 2.8s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .community-mock-fork {
    animation: cm-nudge 2.4s ease-in-out infinite;
  }
  .community-mock-dots {
    display: inline-block;
    animation: cm-dots 1.2s steps(4, end) infinite;
  }
  .community-mock-arc {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: cm-draw 1.8s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) 0.2s forwards;
  }
  .community-mock-node {
    animation: cm-blink 2.4s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  @keyframes cm-bloom {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(1.1); }
  }
  @keyframes cm-blink {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  @keyframes cm-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes cm-cell {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }
  @keyframes cm-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(2px); }
  }
  @keyframes cm-dots {
    0% { width: 0; opacity: 0.3; }
    100% { width: 1em; opacity: 1; }
  }
  @keyframes cm-draw {
    to { stroke-dashoffset: 0; }
  }

  .is-offscreen .community-mock-glow,
  .is-offscreen .community-mock-pulse,
  .is-offscreen .community-mock-card,
  .is-offscreen .community-mock-cell,
  .is-offscreen .community-mock-fork,
  .is-offscreen .community-mock-dots,
  .is-offscreen .community-mock-arc,
  .is-offscreen .community-mock-node {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .community-mock-glow,
    .community-mock-pulse,
    .community-mock-card,
    .community-mock-cell,
    .community-mock-fork,
    .community-mock-dots,
    .community-mock-arc,
    .community-mock-node {
      animation: none;
    }
    .community-mock-arc { stroke-dashoffset: 0; }
    .community-mock-packet { display: none; }
  }
</style>
