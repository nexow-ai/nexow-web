---
import Icon from './Icon.astro';

interface Props {
  badge: string;
  /** Stroke icon name from `icon-paths` — rendered before the badge label. */
  icon?: string;
  title: string;
  subtitle?: string;
  /** Anchor for the in-page section rail. */
  id?: string;
}
const { badge, icon, title, subtitle, id = 'hero' } = Astro.props;
---

<section id={id} class="relative scroll-mt-20 overflow-hidden pt-32 pb-14 text-ink-950 sm:pt-40 sm:pb-20 dark:text-white">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="aurora-mesh absolute inset-[-10%]"></div>
    <div
      class="aurora-a absolute -top-28 left-[6%] size-[min(70vw,520px)] rounded-full opacity-55 blur-3xl dark:opacity-45"
      style="background:radial-gradient(circle, var(--color-brand-200), transparent 65%)"
    >
    </div>
    <div
      class="aurora-b absolute -top-20 right-[4%] size-[min(65vw,480px)] rounded-full opacity-45 blur-3xl dark:opacity-35"
      style="background:radial-gradient(circle, var(--color-accent-200), transparent 65%)"
    >
    </div>
    <div
      class="aurora-c absolute left-[38%] top-[28%] size-[min(50vw,400px)] rounded-full opacity-40 blur-3xl dark:opacity-30"
      style="background:radial-gradient(circle, var(--color-sky-200), transparent 65%)"
    >
    </div>
  </div>
  <div class="container-page">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-500/20 bg-brand-50 px-3 py-1 font-mono text-xs font-medium uppercase tracking-wider text-brand-700 dark:border-brand-400/25 dark:bg-brand-400/12 dark:text-brand-300">
        {icon && <Icon name={icon} class="size-3.5 shrink-0" />}
        {badge}
      </span>
      <h1
        data-text-appear
        data-text-appear-delay="0.12"
        class="mt-6 text-center font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink-950 sm:text-5xl md:text-6xl dark:text-white"
      >
        {title}
      </h1>
      {subtitle && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-600 dark:text-ink-300">{subtitle}</p>}
    </div>
  </div>
</section>
