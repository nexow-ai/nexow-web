---
/**
 * The theatre the home story plays inside — hero, acts, and the rest of the
 * page through the footer. One room: the hero is scene 0, and the later
 * sections (surfaces, privacy, plans, rewards, FAQ, CTA, footer) are later
 * beats of the same space.
 *
 * Theme tokens still flip; only the ink behind the room changes. `global.css`
 * repaints the header for the one case this creates: light-theme chrome
 * floating over the world before the first scroll.
 *
 * There is no WebGL layer here any more. The fixed, full-page field — screens,
 * hairlines and a crystal that changed shape every section — is gone; the
 * only canvas left is the hero's own object (`sections/HeroCrystal.astro`),
 * which lives in the hero's box and stops when the hero leaves the screen.
 *
 * Four layers, and the order matters:
 *   1. .world ink      the element's own black/white plate (back of the stack).
 *   2. .world__bands   solid page-tone / invert boxes (still ink, still back).
 *   3. .world__wash    the colour wash — above ink, below the content.
 *   4. .world__crown   header fade, then .world__content (the story).
 *
 * `z-index: 0` here is load-bearing: it makes this a stacking context, so the
 * wash paints under the content and over the ink instead of over the header.
 * Nothing here may set `overflow`, which would break the `position: sticky`
 * every act depends on.
 *
 * Every direct child that is a beat of the story carries `data-world-scene`;
 * the script below reads them in document order and maps scene *i* to colour
 * family *i* (`src/lib/worldTone.ts`).
 */
---

<div class="world">
  <div class="world__bands" aria-hidden="true"></div>
  <div class="world__wash" aria-hidden="true"></div>
  {/* Header band. The header is transparent until 8px of scroll and the world
      runs to the top of the document, so without this the content crosses the
      nav labels. */}
  <div class="world__crown" aria-hidden="true"></div>
  <div class="world__content">
    <slot />
  </div>
</div>

<script>
  import {
    HUE_STEP_NAMES,
    familyOf,
    handover,
    hueSteps,
    sceneAt,
    washStops,
    wrapWay,
  } from '../../lib/worldTone';

  /**
   * Pointer parallax for the DOM scenes.
   *
   * The act scenes are CSS 3D constructions; without this they sit locked
   * flat to the screen. This writes `--mx` and `--my` (-1…1, damped) onto each
   * act scene, which turns them into a shift of its own `perspective-origin`,
   * the one way to look around a CSS 3D scene without touching the transforms
   * the scroll ramps already compose.
   *
   * The loop is self-terminating: it runs only while the damped value is still
   * catching up to the cursor, so a still mouse costs nothing.
   *
   * Never on coarse pointers (there is no cursor to follow) and never under
   * reduced motion.
   */
  /* The act scenes, written to directly. These used to be written to `.world`
   * and inherited — one write, but a style invalidation of every element in
   * the world on every mouse move. Five scene subtrees are a fraction of it. */
  let targets: HTMLElement[] = [];
  let raf = 0;
  let aimX = 0;
  let aimY = 0;
  let curX = 0;
  let curY = 0;

  function tick() {
    raf = 0;
    if (!targets.length) return;
    curX += (aimX - curX) * 0.08;
    curY += (aimY - curY) * 0.08;
    const mx = curX.toFixed(4);
    const my = curY.toFixed(4);
    for (const el of targets) {
      el.style.setProperty('--mx', mx);
      el.style.setProperty('--my', my);
    }
    if (Math.abs(aimX - curX) > 0.002 || Math.abs(aimY - curY) > 0.002) {
      raf = requestAnimationFrame(tick);
    }
  }

  function onPointer(e: PointerEvent) {
    aimX = (e.clientX / window.innerWidth) * 2 - 1;
    aimY = 1 - (e.clientY / window.innerHeight) * 2;
    if (!raf) raf = requestAnimationFrame(tick);
  }

  /* ---- scenes, measured in document space ----
   * A scene's place in the document only changes when the layout does, so it
   * is measured on resize and read back on scroll for free. */
  let world: HTMLElement | null = null;
  let scenes: HTMLElement[] = [];
  let sceneTop = new Float64Array(0);
  let sceneBottom = new Float64Array(0);
  let sceneInvert: boolean[] = [];
  let features: HTMLElement | null = null;
  let pgPin: Element | null = null;

  let bandRo: ResizeObserver | null = null;
  let stageMo: MutationObserver | null = null;

  /**
   * One solid box per section, painted under the wash so it keeps showing on
   * both tones. Page-tone boxes and invert boxes abut — no fade. Measures the
   * scenes for the tone on the way.
   */
  function syncBands() {
    world = document.querySelector<HTMLElement>('.world');
    const content = world?.querySelector('.world__content');
    const bands = world?.querySelector('.world__bands');
    if (!world || !(content instanceof HTMLElement) || !(bands instanceof HTMLElement)) return;
    /* One box per world scene, not per content wrapper: acts 01 and 02 live
     * in the same span so the mock can pin across both, but they are still
     * opposite tones. */
    const kids = Array.from(world.querySelectorAll<HTMLElement>('[data-world-scene]')).filter(
      (el) => el.offsetHeight > 0,
    );
    while (bands.children.length < kids.length) {
      bands.appendChild(document.createElement('div'));
    }
    while (bands.children.length > kids.length) bands.lastElementChild?.remove();
    const sy = window.scrollY;
    const worldTop = world.getBoundingClientRect().top + sy;
    scenes = kids;
    sceneTop = new Float64Array(kids.length);
    sceneBottom = new Float64Array(kids.length);
    sceneInvert = [];
    kids.forEach((kid, i) => {
      const rect = kid.getBoundingClientRect();
      const band = bands.children[i] as HTMLElement;
      const invert = kid.classList.contains('tone-invert') || !!kid.closest('.tone-invert');
      band.className = invert ? 'world__band world__band--invert' : 'world__band';
      band.style.top = `${Math.round(rect.top + sy - worldTop)}px`;
      band.style.height = `${Math.round(rect.height)}px`;
      sceneTop[i] = rect.top + sy;
      sceneBottom[i] = rect.bottom + sy;
      sceneInvert.push(invert);
    });
    features = kids.find((el) => el.id === 'features') ?? null;
    pgPin = world.querySelector('.pg-pin');
    scheduleTone();
  }

  /* ---- the section's colour, on scroll ---- */
  let toneRaf = 0;
  let hueKey = '';
  let washKey = '';
  let dayOn: boolean | null = null;
  let lastInvert: boolean | null = null;
  const docStyle = document.documentElement.style;

  /** The features act lets a clicked surface pick the room's colour. */
  function featuresWay() {
    if (!features) return 0;
    const raw = Number(features.dataset.fmWay);
    if (Number.isFinite(raw)) return wrapWay(raw);
    return Number(features.querySelector<HTMLElement>('[data-stage]')?.dataset.stage) || 0;
  }

  function paintTone() {
    toneRaf = 0;
    if (!world || !scenes.length) return;
    const vv = window.visualViewport;
    const vh = vv?.height ?? window.innerHeight;
    const mid = window.scrollY + (vv?.offsetTop ?? 0) + vh * 0.5;
    const { index: a, local } = sceneAt(sceneTop, sceneBottom, mid);
    const way = featuresWay();
    const A = familyOf(a, scenes[a] === features ? way : null);
    const B = familyOf(a + 1, scenes[a + 1] && scenes[a + 1] === features ? way : null);
    const k = handover(sceneBottom[a], mid, vh);

    /* Quantised, and written only when it moves: a hold is no writes at all,
       a handover is a few dozen. */
    const hk = `${A.fam}|${B.fam}|${k}`;
    if (hk !== hueKey) {
      hueKey = hk;
      hueSteps(A.fam, B.fam, k).forEach((c, s) =>
        docStyle.setProperty(`--w-hue-${HUE_STEP_NAMES[s]}`, c),
      );
    }
    const wk = `${a}|${A.fam}|${A.pair}|${B.fam}|${B.pair}|${k}`;
    if (wk !== washKey) {
      washKey = wk;
      washStops(a, A, B, k).forEach((c, s) => world!.style.setProperty(`--w-wash-${'abc'[s]}`, c));
    }

    /* Studio beats (features onward) lift the room; the use-cases act hands
       over to them on its way out. */
    const morph = Math.min(1, Math.max(0, (local - 0.12) / 0.88));
    const studio = a >= 8 ? 1 : a === 7 ? morph : 0;
    const day = studio > 0.45;
    if (day !== dayOn) {
      dayOn = day;
      world.classList.toggle('world--day', day);
    }

    /* The playground mock pins across two opposite-tone acts and follows
       the box under it. */
    const invert = !!sceneInvert[a];
    if (invert !== lastInvert) {
      lastInvert = invert;
      pgPin?.classList.toggle('tone-invert', invert);
    }
  }

  function scheduleTone() {
    if (!toneRaf) toneRaf = requestAnimationFrame(paintTone);
  }

  function teardownWorld() {
    window.removeEventListener('pointermove', onPointer);
    window.removeEventListener('resize', syncBands);
    window.removeEventListener('scroll', scheduleTone);
    if (raf) cancelAnimationFrame(raf);
    if (toneRaf) cancelAnimationFrame(toneRaf);
    raf = 0;
    toneRaf = 0;
    targets = [];
    bandRo?.disconnect();
    bandRo = null;
    stageMo?.disconnect();
    stageMo = null;
    world?.style.removeProperty('--w-wash-a');
    world?.style.removeProperty('--w-wash-b');
    world?.style.removeProperty('--w-wash-c');
    world = null;
    scenes = [];
    features = null;
    pgPin = null;
    hueKey = '';
    washKey = '';
    dayOn = null;
    lastInvert = null;
  }

  function initWorld() {
    teardownWorld();
    syncBands();
    if (!world) return;
    /* Synchronous on load, so the first paint already wears the hero's hue. */
    paintTone();
    const content = world.querySelector('.world__content');
    if (content) {
      bandRo = new ResizeObserver(syncBands);
      bandRo.observe(content);
      for (const kid of content.querySelectorAll('[data-world-scene]')) bandRo.observe(kid);
    }
    if (features) {
      stageMo = new MutationObserver(scheduleTone);
      stageMo.observe(features, {
        attributes: true,
        subtree: true,
        attributeFilter: ['data-fm-way', 'data-stage'],
      });
    }
    window.addEventListener('resize', syncBands, { passive: true });
    window.addEventListener('scroll', scheduleTone, { passive: true });
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;
    targets = Array.from(document.querySelectorAll<HTMLElement>('.world .act-scene'));
    if (!targets.length) return;
    window.addEventListener('pointermove', onPointer, { passive: true });
  }

  document.addEventListener('astro:page-load', initWorld);
  document.addEventListener('astro:before-swap', teardownWorld);
  if (document.readyState !== 'loading') initWorld();
</script>

<style>
  /* The world's own palette, flipping with the page theme. Every act and the
   * hero paint from these rather than from literal whites and inks, which is
   * what lets one dark-native design read as a light stage without a second
   * copy of every rule. Light values are picked for AA on the light surface;
   * dark values are the ones the stage was built with. */
  .world {
    position: relative;
    z-index: 0;
    /* The section's colour is the brand inside the world. The script above
     * writes each section's hue as five shade steps on the document
     * (--w-hue-300 … --w-hue-700) and they are mapped onto the brand tokens
     * here, so every brand-coloured accent in a section — eyebrows, beat
     * labels, chips, icons, rules — is that section's colour, in the shade
     * its ground wants, and crosses to the next colour at the seam. The
     * ember fallbacks hold before the script runs and without JavaScript.
     * The gradient buttons keep the brand: their stops resolve on the root. */
    --color-brand-50: color-mix(in oklab, var(--w-hue-400, #ff7038) 12%, white);
    --color-brand-100: color-mix(in oklab, var(--w-hue-400, #ff7038) 22%, white);
    --color-brand-200: color-mix(in oklab, var(--w-hue-400, #ff7038) 45%, white);
    --color-brand-300: var(--w-hue-300, #ff9b70);
    --color-brand-400: var(--w-hue-400, #ff7038);
    --color-brand-500: var(--w-hue-500, #ff4d14);
    --color-brand-600: var(--w-hue-600, #d63200);
    --color-brand-700: var(--w-hue-700, #b02a00);
    --color-brand-800: color-mix(in oklab, var(--w-hue-700, #b02a00) 78%, black);
    --color-brand-900: color-mix(in oklab, var(--w-hue-700, #b02a00) 60%, black);
    --color-brand-950: color-mix(in oklab, var(--w-hue-700, #b02a00) 42%, black);
    --w-hue: var(--color-brand-500);
    --w-surface: #ffffff;
    --w-text: var(--color-ink-950);
    --w-text-2: var(--color-ink-600);
    --w-text-3: var(--color-ink-800);
    --w-text-4: var(--color-ink-500);
    /* 700, not 600: the amber and yellow sections' 600s fall short of AA
     * for eyebrow-sized type on paper. */
    --w-accent: var(--color-brand-700);
    --w-accent-2: var(--color-brand-700);
    --w-line: color-mix(in oklab, var(--color-ink-900) 12%, transparent);
    --w-line-soft: color-mix(in oklab, var(--color-ink-900) 7%, transparent);
    --w-panel: rgba(255, 255, 255, 0.84);
    --w-panel-2: color-mix(in oklab, var(--color-ink-900) 4%, transparent);
    --w-shadow: rgba(15, 23, 42, 0.22);
    --w-rail: color-mix(in oklab, var(--color-ink-900) 28%, transparent);
    /* Wash strength: the colour behind the content. Quieter on a light page.
     * Stops start as the first-paint cloth (ember → indigo → plasma). The
     * script walks them onto each later section's hue at the seam — it must
     * not use --color-brand-*, or the hero flashes cyan the moment the first
     * paint writes --w-hue-*. */
    --w-wash: 0.45;
    --w-wash-a: #ff4d14;
    --w-wash-b: var(--color-accent-600, var(--color-accent-500));
    --w-wash-c: var(--color-plasma-500);
    --w-band: #000000;
    background: var(--w-surface);
    color: var(--w-text);
  }

  :global(.dark) .world {
    --w-hue: var(--color-brand-400);
    --w-surface: #000000;
    --w-band: #ffffff;
    --w-text: #fff;
    --w-text-2: var(--color-ink-200);
    --w-text-3: var(--color-ink-100);
    --w-text-4: var(--color-ink-300);
    --w-accent: var(--color-brand-300);
    --w-accent-2: var(--color-brand-400);
    --w-line: rgba(255, 255, 255, 0.12);
    --w-line-soft: rgba(255, 255, 255, 0.08);
    --w-panel: rgba(9, 12, 20, 0.9);
    --w-panel-2: rgba(255, 255, 255, 0.04);
    --w-shadow: rgba(0, 0, 0, 0.85);
    --w-rail: rgba(255, 255, 255, 0.22);
    --w-wash: 1;
  }

  /* Studio beats (features onward). A lifted dusk, not a white slab: the
   * same room, more light in it, so the later copy still reads and the
   * screens read as product surfaces rather than theatre glass. */
  :global(.dark) .world.world--day {
    --w-wash: 0.72;
    --w-panel: rgba(16, 20, 30, 0.78);
  }

  :global(html:not(.dark)) .world.world--day {
    --w-wash: 0.38;
  }

  /* Opposite of the page theme. Ground is painted on `.world__bands` (under
   * the wash) so the wash stays visible; this wrapper only flips type.
   * Transparent here beats the opaque `html.dark .tone-invert` in global.css. */
  :global(html.dark) .world :global(.tone-invert) {
    --w-hue: var(--color-brand-500);
    --w-surface: #ffffff;
    --w-text: var(--color-ink-950);
    --w-text-2: var(--color-ink-600);
    --w-text-3: var(--color-ink-800);
    --w-text-4: var(--color-ink-500);
    --w-accent: var(--color-brand-700);
    --w-accent-2: var(--color-brand-700);
    --w-line: color-mix(in oklab, var(--color-ink-900) 12%, transparent);
    --w-line-soft: color-mix(in oklab, var(--color-ink-900) 7%, transparent);
    --w-panel: rgba(255, 255, 255, 0.84);
    --w-panel-2: color-mix(in oklab, var(--color-ink-900) 4%, transparent);
    --w-shadow: rgba(15, 23, 42, 0.22);
    --w-rail: color-mix(in oklab, var(--color-ink-900) 28%, transparent);
    --w-wash: 0.45;
    background-color: #ffffff;
  }

  :global(html.js.dark) .world :global(.tone-invert) {
    background-color: transparent;
  }

  :global(html:not(.dark)) .world :global(.tone-invert) {
    --w-hue: var(--color-brand-400);
    --w-surface: #000000;
    --w-text: #fff;
    --w-text-2: var(--color-ink-200);
    --w-text-3: var(--color-ink-100);
    --w-text-4: var(--color-ink-300);
    --w-accent: var(--color-brand-300);
    --w-accent-2: var(--color-brand-400);
    --w-line: rgba(255, 255, 255, 0.12);
    --w-line-soft: rgba(255, 255, 255, 0.08);
    --w-panel: rgba(9, 12, 20, 0.9);
    --w-panel-2: rgba(255, 255, 255, 0.04);
    --w-shadow: rgba(0, 0, 0, 0.85);
    --w-rail: rgba(255, 255, 255, 0.22);
    --w-wash: 1;
    background-color: #000000;
  }

  :global(html.js:not(.dark)) .world :global(.tone-invert) {
    background-color: transparent;
  }

  .world__bands {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* Bands are created in JS, so they never get this file's scope hash.
   * Solid boxes: page tone, then invert, then page tone. */
  .world :global(.world__band) {
    position: absolute;
    inset-inline: 0;
    background: #ffffff;
  }

  :global(.dark) .world :global(.world__band) {
    background: #000000;
  }

  .world :global(.world__band--invert) {
    background: #000000;
  }

  :global(.dark) .world :global(.world__band--invert) {
    background: #ffffff;
  }

  /* A wash that sits between the ink and the content: enough colour that the
   * world is not a flat black rectangle, with or without JavaScript. Must
   * paint *above* `.world` and `.world__bands` — those solid plates used to
   * share this z-index and cover the wash the moment JS built the boxes. */
  .world__wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        58% 40% at 18% 6%,
        color-mix(in oklab, var(--w-wash-a) calc(22% * var(--w-wash)), transparent),
        transparent 70%
      ),
      radial-gradient(
        50% 34% at 86% 2%,
        color-mix(in oklab, var(--w-wash-b) calc(24% * var(--w-wash)), transparent),
        transparent 72%
      ),
      radial-gradient(
        70% 44% at 60% 98%,
        color-mix(in oklab, var(--w-wash-c) calc(12% * var(--w-wash)), transparent),
        transparent 76%
      );
  }

  /* Softens the content under the nav. Colour must match the band behind the
   * header — page surface on page bands, invert surface on invert bands —
   * otherwise the crown reads as a white/black gradient across a solid stripe.
   * `.chrome-invert` is stamped by `ChromeTone` while the band under the bar
   * is the opposite tone. */
  .world__crown {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 2;
    height: 8rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      var(--w-surface) 14%,
      color-mix(in oklab, var(--w-surface) 62%, transparent) 52%,
      transparent
    );
  }

  :global(html.dark) .world__crown.chrome-invert {
    background: linear-gradient(
      to bottom,
      #ffffff 14%,
      color-mix(in oklab, #ffffff 62%, transparent) 52%,
      transparent
    );
  }

  :global(html:not(.dark)) .world__crown.chrome-invert {
    background: linear-gradient(
      to bottom,
      #000000 14%,
      color-mix(in oklab, #000000 62%, transparent) 52%,
      transparent
    );
  }

  .world__content {
    position: relative;
    z-index: 3;
  }

  /* Later beats used to be marketing slabs (mint wash, white FAQ plate,
   * opaque rewards ink, footer night). Inside the world they are glass
   * holds — the wash shows through, type uses the world's tokens. */
  .world :global(#features),
  .world :global(#privacy),
  .world :global(#plans),
  .world :global(#rewards),
  .world :global(#faq),
  .world :global(#cta) {
    background-color: transparent;
    border-color: transparent;
    color: var(--w-text);
  }

  .world :global(#privacy) > .pointer-events-none,
  .world :global(#plans) > .pointer-events-none,
  .world :global(#rewards) > .pointer-events-none,
  .world :global(#cta) > .pointer-events-none,
  .world :global(#rewards) > .bg-grid,
  .world :global(#rewards) > .bg-noise,
  .world :global(#rewards) > .glow-accent {
    opacity: 0.28;
  }

  .world :global(footer) {
    background-color: transparent;
    border-top-color: var(--w-line-soft);
    color: var(--w-text-2);
  }

  .world :global(footer) > .absolute {
    display: none;
  }

  .world :global(footer a),
  .world :global(footer p),
  .world :global(footer h3) {
    color: inherit;
  }

  .world :global(footer a:hover),
  .world :global(footer .font-display) {
    color: var(--w-text);
  }

  .world :global(.tone-invert) :global(footer),
  .world :global(.tone-invert) :global(footer a),
  .world :global(.tone-invert) :global(footer p),
  .world :global(.tone-invert) :global(footer h3) {
    color: var(--w-text-2);
  }

  .world :global(.tone-invert) :global(footer) :global(.font-display) {
    color: var(--w-text);
  }

  .world :global(#faq .reveal) {
    background: var(--w-panel);
    border-color: var(--w-line);
  }
</style>
