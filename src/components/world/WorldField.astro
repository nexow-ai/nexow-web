---
/**
 * The world the home page is staged inside.
 *
 * ONE IDEA: a single body of matter travels the whole page under one camera
 * that never cuts. In the hero it is unformed dust that the words you type
 * charge and tighten; at each act it condenses into the thing that act
 * explains — a widget, a canvas of widgets, a ring of connectors, a signal
 * fanning out, an agent's harness — and at the end it opens back out.
 *
 * Sacrificed for it: every other effect. No bloom, no depth of field, no
 * chromatic aberration, no second particle system. The morph is the whole show,
 * and the budget goes to holding 60fps while it happens.
 *
 * BUDGET (set before building, enforced by tests/build/payload.test.ts)
 *   · total shipped JS  < 150 KB   · any single script < 60 KB
 *   · zero external origins        — which is why this is hand-rolled WebGL and
 *                                    not three.js: the CDN is not reachable and
 *                                    a bundled copy blows the budget on its own
 *   · DPR clamped to 2 (1.5 on coarse pointers)
 *   · 2600 instances wide / 900 narrow, one draw call, zero per-frame uploads
 *
 * Every formation is a closed-form function of the instance index, so morphing
 * is a `mix()` in the vertex shader and no buffer is ever re-uploaded. The
 * projection and view matrices are ~40 lines at the bottom of this file.
 *
 * Stacking inside `World.astro` — load-bearing:
 *
 *     .world          z-index: 0, opaque ink   ← what axe measures against
 *       .world-field  z-index: 1, this canvas  ← the matter, additive
 *       .world__content z-index: 2             ← hero + acts, always on top
 *
 * The canvas is `position: fixed`: one viewport-sized surface for the whole
 * world rather than one per section, faded out at the world's two edges.
 */
---

<div class="world-field" aria-hidden="true">
  <canvas class="world-field__canvas"></canvas>
</div>

<script>
  /** Panels. Each is one lit rectangle; the formations below place them. */
  /* Shader sources are tagged so `src/lib/vite-glsl-strip.mjs` can drop their
   * comments and indentation at build time — the minifier never looks inside a
   * template literal, and the commentary in these four is a third of the
   * script. At runtime the tag is `String.raw`, an identity for a literal
   * with no escapes, so an unstripped dev build is the same program. */
  const glsl = String.raw;
  /* Backing-store scale. The canvas is stretched to full size by CSS.
   *
   * Back to full resolution. It was 0.58 because 1900 soft round sprites could
   * lose half their pixels without anyone noticing — a blurred glow is still a
   * glow. Panels have hard lit borders, and a border drawn at 58% and upscaled
   * is just a fuzzy border. The instance count dropped by a factor of six to
   * pay for it, and fill rate went down with it: a panel covers more pixels
   * than a mote, but six times fewer of them at ~1x overdraw is cheaper than
   * what this replaced. */
  const RENDER_SCALE = 1;
  /* Fewer screens than the field can afford, because the point is no longer
   * density. The panels come in four sizes now (see `sz` in the vertex
   * shader), and a crowd this varied only reads as a mosaic if there is space
   * between the pieces — at 260 the big ones had nowhere to sit and the whole
   * thing went back to being a texture. The size spread costs less fill than
   * the instances it replaces, so this is also the cheaper field. */
  const COUNT_WIDE = 160;
  const COUNT_NARROW = 80;

  /* How present the screens are against the backdrop. Blending stays off —
   * screens occlude one another, and a see-through field of them reads as
   * smear — so this dissolves each panel into the world's own surface instead,
   * which is what the same opacity over that backdrop looks like. At 0.8 the
   * panels hold as objects while still sitting a fifth of the way back into the
   * stage; the same value on both themes, since either surface is what the
   * fifth is made of. */
  const SCREEN_ALPHA = 0.8;

  /** Damping for the camera's follow, per second. Lower = heavier lens. */
  const CAM_DAMP = 3.2;
  /** Damping for the pointer parallax. Slower than the camera, so it trails. */
  const PTR_DAMP = 2.1;

  const VERT = glsl`
    precision highp float;
    attribute vec2 aCorner;
    attribute float aId;
    attribute float aSeed;

    uniform mat4 uProj;
    uniform mat4 uView;
    uniform float uN;
    uniform float uFormA;
    uniform float uFormB;
    uniform float uMorph;
    uniform float uTime;
    uniform float uShift;
    /* View-space lift, the vertical twin of uShift. In the hero it carries the
       world up until its origin sits on the headline instead of the viewport
       centre; it is zero everywhere else. */
    uniform float uLift;
    uniform float uCharge;
    uniform float uBurst;
    /* 1 while the loop is running, 0 for the one composed reduced-motion
       frame. Only the channel cut reads it — everything else is already still
       in that frame because the clock is. */
    uniform float uLive;
    uniform vec3 uCam;
    /** Half the backing-store height, in device pixels. Feeds edge antialiasing. */
    uniform float uPix;

    varying float vTone;
    varying float vGlow;
    varying float vLight;
    varying float vFres;
    varying float vSpec;
    varying float vKind;
    varying float vSeed;
    varying float vAA;
    varying float vT;
    varying float vSwitch;
    varying vec2 vUv;

    vec3 hash3(float i) {
      return fract(sin(vec3(i * 12.9898, i * 78.233, i * 37.719)) * 43758.5453);
    }

    /* Eight formations — one per scene, hero included. Every one is a
       closed-form function of the instance index, which is what makes the morph
       a mix() and keeps the buffers static for the life of the page. */
    vec3 form(float f, float i, float n, float seed, float t) {
      float a = i / n;
      vec3 h = hash3(i);

      if (f < 0.5) {
        /* 0 — THE CAROUSEL (hero): screens standing on concentric rings that
           turn slowly around the headline.

           A ring, not a scatter, because the headline sits dead centre and a
           ring is the one arrangement that leaves the middle empty while still
           filling the frame — the type reads through the hole, and the screens
           orbit it. Three bands at different radii, each turning at its own
           rate, so the wall has depth instead of moving as one cylinder.

           The camera sits ~22 out and the outer band reaches 17, so the near
           side of the ring passes between the lens and the title and fades out
           on the near plane: screens genuinely sweep past you. */
        /* Two shells, not three. Three spread 160 screens so thin that no one
           of them had a readable circumference — the eye had nothing to trace,
           which is why the ring read as a scatter. Two puts ~27 screens in
           every row of every shell, close enough to spaced to be a wall. */
        float bands = 2.0;
        float band = mod(i, bands);
        float idx = floor(i / bands);
        float per = ceil(n / bands);

        /* No radial jitter at all. Every loosening of this formation — ±1.2 on
           the radius, ±1 slot on the angle, two thirds of the pitch on the
           height, a breathing term on top — was added to stop a cloud looking
           sorted, and together they cost the one thing the hero is for. A
           carousel is a rigid object: the moment a screen can be anywhere, the
           circle stops being traceable and the frame is back to floating
           screens. What keeps it from looking stamped is the content, which
           now changes on every screen, and the size spread. */
        float R = 11.4 + band * 3.0;
        /* Both shells on one clock, so the cylinder turns as one thing. They
           used to differ by 20% for depth, which is a real cue and a poor
           trade: two concentric rings at different rates read as two
           unrelated fields, and the depth is already carried by the radius. */
        float spin = t * 0.12;
        /* The outer shell sits half a slot round from the inner, so it fills
           the inner's gaps instead of hiding behind it. */
        float th = (idx / per) * 6.2831 + spin + band * 3.1416 / per;

        /* Three true ranks. This is the wrapped video wall: 160 screens cannot
           make a single readable circle at this radius (the spacing would be a
           quarter of a screen), so the circle is three rows deep. */
        float rows = 3.0;
        float row = mod(idx, rows);
        float y = (row - (rows - 1.0) * 0.5) * 3.3;

        return vec3(cos(th) * R, y, sin(th) * R);
      }
      if (f < 1.5) {
        /* 1 — WIDGET: the matter condenses into one card.
           Columns are derived from the instance count rather than hardcoded.
           A fixed 44 was tuned for a swarm of 2600 motes; at 300 panels the
           same number draws a 7-row ribbon instead of a card. This holds the
           slab at a constant 14 units wide whatever the count is. */
        float cols = max(4.0, floor(sqrt(n * 1.6)));
        float gap = 14.0 / cols;
        float x = mod(i, cols);
        float y = floor(i / cols);
        float rows = ceil(n / cols);
        return vec3(
          (x - cols * 0.5) * gap,
          -(y - rows * 0.5) * gap * 0.56,
          sin(x * 0.28 + y * 0.17 + t * 0.35) * 0.32
        );
      }
      if (f < 2.5) {
        /* 2 — CANVAS: the slab splits into four widgets on one screen. */
        float g = floor(a * 4.0);
        float k = fract(a * 4.0);
        /* Same derivation as the single card, over a quarter of the panels —
           hardcoding it drew four tall ribbons rather than four widgets. */
        float quarter = n / 4.0;
        float cols = max(3.0, floor(sqrt(quarter * 1.6)));
        float gap = 5.8 / cols;
        float idx = k * quarter;
        float x = mod(idx, cols);
        float y = floor(idx / cols);
        float rows = ceil(quarter / cols);
        vec3 base = vec3(g < 2.0 ? -4.6 : 4.6, mod(g, 2.0) < 1.0 ? 3.0 : -3.0, (g - 1.5) * 1.3);
        return base + vec3((x - cols * 0.5) * gap, -(y - rows * 0.5) * gap, 0.0);
      }
      if (f < 3.5) {
        /* 3 — CONNECTORS: a ring docking around the workspace. A torus, not a
           circle — a one-dimensional wire of points is too thin to read as an
           object once it is spread across the viewport. */
        float u = a * 6.2831 * 2.0;
        float v = h.x * 6.2831;
        float R = 8.4;
        float rt = 1.8;
        float ring = R + rt * cos(v);
        return vec3(
          ring * cos(u),
          ring * sin(u) * 0.44,
          rt * sin(v) + sin(u * 3.0 + t * 0.4) * 0.55
        );
      }
      if (f < 4.5) {
        /* 4 — BOTS: the patrol. A hoop of screens going round and round the
           one solid on the page that beats. A bot watches a thing on a fixed
           circuit and fires the moment the rule trips, and a circuit is a
           circle; the branching column that used to stand here drew the
           plumbing instead — four wires leaving a trunk, which is a diagram of
           the delivery and says nothing about the watching.

           Two things keep it clear of the collar in scene 03: it is centred on
           the solid rather than on the origin, and it turns. 03 hangs still
           around its hub and reads as a fitting; this one sweeps, and a circle
           is only an orbit while something is going round it.

           Two shells three rows deep, the hero's cross-section wrapped into a
           hoop and for the same reason: 160 screens strung along a single
           circle this size land a fraction of a screen apart, and what the eye
           can actually trace is a band.

           The radius is the whole difficulty. Wide enough and the hoop runs off
           both edges of the frame, leaving screens crossing rather than a
           circle; tight enough to be comfortably inside it and the band is
           thicker than the hole it goes round, which is a blob. This is the
           size that closes inside the shot with the solid alone in the middle
           of it, and the band is kept to two shells so the hole stays open. */
        float shells = 2.0;
        float rows = 3.0;
        float slots = shells * rows;
        float slot = mod(i, slots);
        float idx = floor(i / slots);
        float per = ceil(n / slots);
        /* Every slot starts a fraction of a place on from the one before, so
           they interleave rather than line up as spokes. */
        float th = (idx / per) * 6.2831 + t * 0.34 + slot * 6.2831 / (per * slots);
        /* And it breathes on the same beat the solid does — the same sine
           drawCore's beat rides — so the two read as one mechanism rather than
           as a shape with something circling it. */
        float R = 6.2 + mod(slot, shells) * 1.45 + sin(t * 3.1) * 0.22;
        float off = (floor(slot / shells) - 1.0) * 1.3;
        /* The circle, then the plane it lies in rolled 35° about X, which is
           what tips the orbit's axis toward the lens: level, the camera is only
           19° above the plane here and the hoop closes to a flat band with the
           far arc lying across the hole. Rolled, it opens to about four fifths
           of a face-on circle — an ellipse with the solid alone inside it,
           still deep enough that the near arc is visibly nearer. Centred on the
           solid, which stands 1.5 up (see OBJECTS). */
        vec3 c = vec3(cos(th) * R, off, sin(th) * R);
        return vec3(c.x, 1.5 + c.y * 0.82 - c.z * 0.57, c.y * 0.57 + c.z * 0.82);
      }
      if (f < 5.5) {
        /* 5 — AGENTS: six harness clusters in slow orbit around a core. */
        float g = floor(h.z * 6.0);
        float th = g / 6.0 * 6.2831 + t * 0.13;
        vec3 c = vec3(cos(th) * 7.2, sin(th) * 7.2 * 0.44, sin(th * 2.0) * 1.7);
        /* One in six stays at the core, so the centre reads as the agent. */
        float core = step(h.x, 0.16);
        return mix(c + (h - 0.5) * 2.1, (h - 0.5) * 1.6, core);
      }
      if (f < 6.5) {
        /* 6 — OWN IT: the ledger. Two strands of screens climbing a helix
           around the token, and turning — a turning helix is a rising one, so
           the column reads as value on its way up and out to the holders,
           which is what a weekly distribution looks like from inside it. Two
           strands so the column has a front and a back and reads as a body
           rather than a wire, and it is the one formation whose long axis is
           vertical: nothing else on the page can be mistaken for it. */
        float strands = 2.0;
        float s = mod(i, strands);
        float idx = floor(i / strands);
        float per = ceil(n / strands);
        float u = idx / per;
        float th = u * 6.2831 * 2.6 + s * 3.1416 + t * 0.32;
        float R = 5.2 + (h.x - 0.5) * 0.8;
        return vec3(cos(th) * R, (u - 0.5) * 11.5, sin(th) * R);
      }
      /* 7 — RELEASE: the matter opens back out into a wide, slow horizon. This
         is the exhale after six pinned scenes; nothing is being explained any
         more, so nothing is being held. */
      float th = a * 6.2831 * 4.0 + t * 0.05;
      float r = 7.0 + 13.0 * h.x;
      return vec3(
        cos(th) * r,
        (h.y - 0.5) * 5.5 + sin(th * 0.5) * 1.3,
        sin(th) * r * 0.55 - 2.0
      );
    }

    void main() {
      vec3 pa = form(uFormA, aId, uN, aSeed, uTime);
      vec3 pb = form(uFormB, aId, uN, aSeed, uTime);

      /* How big this screen is, as one of four sizes.
         Continuous scaling from the seed gave a field where every panel was a
         slightly different size, which is not a mosaic — it is the same crowd
         with noise on it. Four discrete steps in a geometric run read as a
         wall of real screens: phones, panels, displays, boards. The roll is
         squared before it is quantised, so half the field takes the smallest
         size and the biggest is the rare one that anchors a corner.
         Its own hash, not aSeed, which already owns the fly-by and the tone. */
      float tier = floor(pow(hash3(aId + 57.3).x, 2.0) * 3.999);
      float grade = tier / 3.0;

      /* Stagger the morph per instance so the change reads as matter flowing
         rather than every point cutting on the same frame. */
      float lead = aSeed * 0.4;
      float m = clamp((uMorph - lead) / max(1.0 - lead, 0.35), 0.0, 1.0);
      m = m * m * (3.0 - 2.0 * m);
      vec3 p = mix(pa, pb, m);

      /* The fly-by. A straight mix() between two shapes only ever reads as a
         cross-fade watched from outside; nothing in it ever occupies the space
         the camera is in. So at the midpoint of every morph a minority of the
         instances take the long way round — they sweep toward the lens, pass
         it close enough to blow out into soft near-field flares, and settle
         back into the new formation.

         Aimed at the camera rather than radially outward from the origin: the
         world is built around the origin and the camera looks at it, so a
         radial push sends the cloud sideways *out of frame* — it empties the
         shot at exactly the moment the reader is watching it. Toward the lens
         it fills instead.

         The step() keeps it to about one panel in ten. A panel that sweeps
         the lens fills a lot more of the frame than a mote did, so the same
         one-in-six fraction that read as a few pieces breaking off now reads
         as the scene detonating. The rest cross directly and the formation
         stays legible the whole way through. */
      float bloom = sin(m * 3.14159265);
      /* Held back on the large sizes: the push is a fraction of the distance
         to the lens, and on a screen three times the size that fraction is a
         wall across the frame rather than an object going past it. */
      float flyby = step(0.90, aSeed) * (1.0 - 0.72 * grade);
      /* Travel a fraction of the actual distance to the lens rather than a
         fixed number of units: a fixed push overshoots *behind* the camera on
         the near side of the cloud, where the point clips out instead of
         sweeping past. At peak it closes ~82% of the gap, so it comes close
         enough to flare and always stays in front. */
      vec3 toCam = uCam - p;
      p += normalize(toCam) * bloom * flyby * length(toCam) * 0.70;

      /* The hero's one interaction: what you type charges the matter. It winds
         up and tightens as the composer fills, and the send throws a shockwave
         through it. Confined to the dust formation: heroness is 1 only while
         formation A is the dust and the morph out of it has not started. */
      float heroness = (1.0 - clamp(uFormA, 0.0, 1.0)) * (1.0 - uMorph);
      float k = uCharge * heroness;
      float burst = uBurst * heroness;
      float ang = k * (1.1 + aSeed * 1.4) + burst * 0.7;
      float ca = cos(ang);
      float sa = sin(ang);
      p.xz = mat2(ca, -sa, sa, ca) * p.xz;
      p *= mix(1.0, 0.58, k);
      p += normalize(p + 0.0001) * burst * (2.5 + aSeed * 5.0);

      /* The panel.
         Not a billboard. A billboard always faces the camera, so it never
         turns, never foreshortens and never catches light differently — which
         is exactly why a field of them reads as dust however it is coloured.
         Each instance here is a real rectangle standing in world space with a
         real normal, so turning it is what shades it.

         The orientation is a per-instance angle biased toward the eye. Fully
         free orientation leaves too many panels edge-on and the frame fills
         with slivers; pure eye-facing is the billboard again. The mix keeps
         them readable as panels while still letting them tumble. */
      vec3 toEye = normalize(uCam - p);
      vec3 ho = hash3(aId + 91.7);
      float yaw = ho.x * 6.2831 + uTime * (0.05 + aSeed * 0.10);
      float pitch = (ho.y - 0.5) * 1.15;
      vec3 nrm = vec3(cos(pitch) * sin(yaw), sin(pitch), cos(pitch) * cos(yaw));
      /* Heavily biased to the eye. At 0.55 the panels tumbled freely and the
         crowd read as confetti; near-facing, a field of them reads as ranks of
         screens receding, which is the thing this is meant to look like. The
         residual tilt is what still lets them catch the key light. */
      nrm = normalize(mix(nrm, toEye, 0.82));

      /* Except in the hero, where they stand on the ring facing out of it like
         the screens on a carousel. This is the whole reason the circle reads as
         a circle: a screen at the side of the ring is caught edge-on and opens
         up as it comes round, so the wall turns as one object. Eye-facing
         panels cannot do that — they present the same face at every angle,
         which is why the ring used to read as a scatter however cleanly it was
         placed. The radial is free to know: every ring here is centred on the
         Y axis, so it falls out of the position. The small pull back toward the
         eye stops the edge-on screens collapsing to a hairline. */
      vec3 radial = normalize(vec3(p.x, 0.0, p.z) + vec3(1e-4, 0.0, 0.0));
      nrm = normalize(mix(nrm, normalize(mix(radial, toEye, 0.28)), heroness));

      /* Basis built off world +Y, so every panel shares a horizon and the set
         reads as one system rather than as confetti. The epsilon keeps the
         cross product defined for a panel that happens to face straight up. */
      vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), nrm) + vec3(1e-4, 0.0, 0.0));
      vec3 up = cross(nrm, right);

      /* Widget proportions: wider than tall. The 0.62 is also baked into the
         fragment shader's distance metric, so it is not a per-instance dial:
         scale is what varies here, and every screen keeps the same shape. */
      /* The four sizes, a geometric run so each step is visibly a different
         class of screen and not a rounding error. The floor is where a chart
         drawn inside the panel is still a chart rather than noise. */
      float tiered = 0.68 * pow(1.50, tier);
      /* Pulled toward one size in the hero. Four size classes are what make the
         acts read as a mosaic, but around a ring they read as debris: a bank of
         screens is a set of like objects, and the circle only traces if the
         things on it are comparable. Still a little spread, so the ring is a
         wall of screens and not a stamped pattern. */
      /* One screen in five is a feature screen, twice the size of whatever
         tier it landed in. Picked by id, not seed, so they fall evenly through
         every formation — every fifth seat on the ring, every fifth cell of
         the slab — and floated a little toward the eye so each sits in front
         of its neighbours instead of slicing through them. */
      float big = 1.0 - step(0.5, mod(aId, 5.0));
      float sz = (mix(tiered, 1.02 + grade * 0.42, heroness) + k * 0.10 + burst * 0.16) * mix(1.0, 2.0, big);
      vec3 world = p + toEye * big * 0.7 + aCorner.x * sz * right + aCorner.y * sz * 0.62 * up;

      vec4 mv = uView * vec4(world, 1.0);
      /* Slide the world into the scene column so it frames the copy rather
       * than sitting on top of it. Zero where the layout stacks. */
      mv.x += uShift;
      mv.y += uLift;

      gl_Position = uProj * mv;

      /* Lighting. One key plus a grazing-angle rim — no PBR, because this is
         emissive glass on a dark stage and a Lambert term with a Fresnel edge
         is the whole model for about four instructions. It is also the entire
         reason the panels have to be oriented: the shading *is* the turn. */
      vec3 key = normalize(vec3(-0.35, 0.85, 0.42));
      vLight = 0.20 + 0.80 * max(dot(nrm, key), 0.0);
      vFres = pow(1.0 - abs(dot(nrm, toEye)), 2.0);
      /* A hard specular lobe. This is the term that actually reads as glass:
         a highlight that sweeps across a panel as it turns, rather than a face
         that merely gets brighter. Tight exponent so it stays a glint. */
      vSpec = pow(max(dot(reflect(-key, nrm), toEye), 0.0), 14.0);

      /* Antialiasing width, in panel-UV units, for every edge the fragment
         shader draws. WebGL 1 has no fwidth() without an extension, but the
         projected size of a panel is knowable here: its world size over its
         distance, through the vertical focal length, times half the viewport
         in pixels. Inverting that gives the UV distance one pixel covers, and
         a step() widened by it is a step() that no longer stairsteps. */
      float px = (sz / max(-mv.z, 0.001)) * uProj[1][1] * uPix;
      vAA = clamp(1.4 / max(px, 1.0), 0.0015, 0.45);
      /* ---- the channel ----
         Each screen holds one of the thirty-six for a few seconds and then cuts
         to another. A wall of screens that never change is a photograph of
         software; the hero is meant to be a bank of live TVs, and a TV that
         shows one frame forever is a poster of a TV.

         The dwell is per-screen, so the cuts arrive scattered: a handful of
         screens are always mid-change and the wall is never all still nor all
         flickering at once.

         Redrawn from the slot number rather than stepped to the next index —
         +1 would send a visible wave of the same picture around the ring, and
         two neighbours would stay neighbours for the life of the page. The
         slot wraps at 61 to keep the hash argument small: this is sin() hashing
         in a float, and it goes flat long before an hour of uptime does.

         Still offset by the formation, so each act keeps its own bias in the
         mix — connectors leaning to market and data screens, bots to alerts. */
      float dwell = 4.0 + ho.x * 5.0;
      float phase = (uTime + aSeed * 41.0) / dwell;
      float slot = mod(floor(phase), 61.0);
      vKind = fract(hash3(aId * 0.37 + slot * 2.71).z + uFormA * 0.17);
      /* 1 on the frame the picture changes, gone about 0.2s later. The fragment
         shader spends this on the collapse; here it only has to be a ramp.
         Zero for the reduced-motion still, which must not catch a screen
         halfway through a cut and render it as a broken one. */
      vSwitch = uLive * (1.0 - smoothstep(0.0, 0.26 / dwell, fract(phase)));
      vSeed = aSeed;
      /* Per-screen clock. Same offset that placed it, so a wall of screens
         animates out of phase instead of pulsing as one. */
      vT = uTime + aSeed * 37.0;

      /* Fog. Additive blending means fading alpha to 0 *is* fading to the
         ground colour, so distance falloff costs one smoothstep and buys the
         whole sense of depth. */
      float dist = -mv.z;
      vGlow = smoothstep(48.0, 2.0, dist);
      /* Near fade. A mote that drifted close was a bright speck; a *panel*
         that drifts close is a wall across the headline. Scaled by the panel's
         own size, because what has to stay under a threshold is the share of
         the frame it covers, not its distance: the smallest size keeps roughly
         the old ~5-unit soft near-plane, the largest is gone by 9. This is the
         only reason the hero stays readable. */
      vGlow *= smoothstep(sz * 1.3, 3.4 + sz * 2.6, dist);
      /* Then flare on the approach, before that fade takes over, so a panel
         sweeping the lens still reads as an object going past rather than one
         quietly winking out. */
      vGlow *= 1.0 + 0.55 * smoothstep(12.0, 5.5, dist);
      /* Nothing to see, nothing to draw. A screen fading out on the near
         plane is the size of the viewport, and until now every one of its
         pixels ran the fragment shader just to be discarded. Pushing the
         vertex outside clip space here means it is never rasterised at all —
         the single largest saving in the whole loop. */
      if (vGlow < 0.03) {
        gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
      }
      /* Which of the two accents this screen owns. Stable for its whole life:
         a screen that changed colour mid-morph read as a glitch. */
      vTone = fract(aSeed * 7.31);
      vUv = aCorner;
    }
  `;

  const FRAG = glsl`
    precision mediump float;
    uniform vec3 uC1;
    uniform vec3 uC2;
    uniform vec3 uC3;
    uniform vec3 uFog;
    uniform float uAlpha;
    /* 1 on the light theme, 0 on the dark. The glass, the type and the frame
       invert with it; the accents darken so they still hold on a pale surface. */
    uniform float uLight;
    /* Backing-store size, the copy column's hold-back, and 1 for RTL. This
       used to be a CSS mask on the canvas, which cost a full-screen offscreen
       layer on every frame and a re-rasterisation on every change; here it
       is one smoothstep. */
    uniform vec2 uRes;
    uniform float uDim;
    uniform float uDir;
    varying float vTone;
    varying float vGlow;
    varying float vLight;
    varying float vFres;
    varying float vSpec;
    varying float vKind;
    varying float vSeed;
    varying float vAA;
    varying float vT;
    varying float vSwitch;
    varying vec2 vUv;

    float rnd(float i) {
      return fract(sin(i * 78.233) * 43758.5453);
    }

    /* step(), widened to the width of a pixel. Every edge below goes through
       this; a hard step() on content this small stairsteps, and jagged chart
       lines are most of what makes procedural UI look cheap. */
    float aastep(float e, float x) {
      return smoothstep(e - vAA, e + vAA, x);
    }

    float aaband(float lo, float hi, float x) {
      return aastep(lo, x) * (1.0 - aastep(hi, x));
    }

    /* Anything that used to snap goes through this instead. */
    float ease(float x) {
      return smoothstep(0.0, 1.0, x);
    }

    /* Rounded rectangle, in panel space. The screen is 0.62 as tall as it is
       wide, so distances are corrected to physical units before the radius is
       applied; otherwise every pill is rounder on its sides than its ends.
       The radius is clamped so a thin bar can never invert. */
    float rect(vec2 p, vec2 c, vec2 hs, float r) {
      vec2 hp = hs * vec2(1.0, 0.62);
      r = min(r, min(hp.x, hp.y));
      vec2 d = abs((p - c) * vec2(1.0, 0.62)) - (hp - r);
      float sd = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
      return 1.0 - aastep(0.0, sd);
    }

    float disc(vec2 p, vec2 c, float r) {
      return 1.0 - aastep(r, length((p - c) * vec2(1.0, 0.62)));
    }

    /* Distance from p to the segment ab, in physical units. Routes, spokes
       and every other line that is not axis-aligned go through this. */
    float seg(vec2 p, vec2 a, vec2 b) {
      vec2 pa = (p - a) * vec2(1.0, 0.62);
      vec2 ba = (b - a) * vec2(1.0, 0.62);
      float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-5), 0.0, 1.0);
      return length(pa - ba * h);
    }

    /* Value noise: the hash above on a lattice, smoothed between the corners.
       Two octaves of it is a coastline, which is all the map screen wants. */
    float vnoise(vec2 p) {
      vec2 i = floor(p);
      vec2 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      float k = i.x * 1.7 + i.y * 9.1;
      return mix(mix(rnd(k), rnd(k + 1.7), f.x), mix(rnd(k + 9.1), rnd(k + 10.8), f.x), f.y);
    }

    void main() {
      float rr = 0.11;
      vec2 cd = abs(vUv) - (0.5 - rr);
      float sd = length(max(cd, 0.0)) + min(max(cd.x, cd.y), 0.0) - rr;
      if (sd > 0.0) discard;

      /* Hold the screens back where the copy sits: the inline-start column
         under the acts, near-even under the hero. Screens fog toward the page
         surface as they cross into it. */
      float sx = gl_FragCoord.x / uRes.x;
      sx = mix(sx, 1.0 - sx, uDir);
      /* Narrow: the copy column only, so a centred ring and its solid are at
         full strength from the middle of the screen out. */
      float glow = vGlow * mix(uDim, 1.0, smoothstep(0.30, 0.56, sx));
      /* A screen fogged to nothing must not be drawn at all: opaque, it would
         paint a surface-coloured rectangle over whatever is behind it. */
      if (glow < 0.04) discard;

      float bezel = aastep(-0.060, sd);
      float inner = 1.0 - bezel;
      /* The bezel throws a soft shadow onto the glass just inside it. */
      float inset = 1.0 - smoothstep(-0.060, -0.135, sd);

      /* ---- the cut ----
         A channel change, done the way a CRT does it: the picture collapses to
         a bright slit and springs back open with something else on it.

         Squeezing the *coordinate* is what compresses the picture. At 0.22 the
         panel's whole 0..1 range maps to a band a fifth as tall, so all
         thirty-six screens and the chrome above them collapse together and
         every content guard below clips itself to the slit without knowing
         anything about this. One divide, and the bezel — which is drawn off
         vUv and sd, not uv — stays a solid object while its screen misbehaves.

         Squared, so the collapse snaps and the reopen eases. */
      float cut = vSwitch * vSwitch;
      vec2 uv = vUv + 0.5;
      uv.y = 0.5 + (uv.y - 0.5) / mix(1.0, 0.22, cut);
      float t = vT;
      float s = vSeed;

      /* ---- palette ----
         One accent per screen and soft white for type; nothing else. The old
         shader tinted every screen somewhere along brand→sky→violet, so a
         wall of them was a rainbow. Now roughly three in four take the brand
         mint and the rest take sky, and the second series on a chart takes
         whichever one the screen did not. */
      float pick = step(0.72, vTone);
      vec3 accent = mix(uC1, uC2, pick);
      vec3 accent2 = mix(uC2, uC1, pick);
      /* On the light theme the brand mint is too pale to carry a line on
         near-white glass, so both accents are pulled down toward their 600s. */
      accent = mix(accent, accent * 0.62, uLight);
      accent2 = mix(accent2, accent2 * 0.62, uLight);
      /* paper is what type and rules are drawn in: soft white on the dark
         theme, ink on the light. lightest is the highlight colour, white on
         both, which is what the sheen and the glint are made of. */
      vec3 paper = mix(vec3(0.74, 0.79, 0.88), vec3(0.07, 0.10, 0.16), uLight);
      vec3 lightest = mix(paper, vec3(1.0), uLight);
      /* On the light theme the glass is white, not the pale grey it was: grey
         glass on a near-white page is the same value as the page, so the panel
         only existed because of the frame around it. White glass and darker
         ink means the *content* is what you see. */
      vec3 glassDark = mix(mix(uFog, vec3(0.040, 0.058, 0.090), 0.75),
                           mix(uFog, vec3(1.0), 0.94), uLight);
      vec3 glassLite = mix(mix(glassDark, accent * 0.16, 0.28),
                           mix(glassDark, vec3(1.0), 0.45), uLight);

      /* Display: lit from above, shadowed under the bezel. The shadow is much
         lighter on the light theme, where a dark ring inside the edge reads as
         a second border rather than as depth. */
      vec3 col = mix(glassDark, glassLite, uv.y * 0.9);
      col *= 1.0 - inset * (0.38 - 0.29 * uLight);

      /* ---- chrome: title, subtitle, live dot, hairline ---- */
      float pulse = 0.65 + 0.35 * sin(t * 2.2);
      col = mix(col, paper, rect(uv, vec2(0.20, 0.905), vec2(0.12, 0.024), 0.014) * 0.55);
      col = mix(col, paper, rect(uv, vec2(0.41, 0.905), vec2(0.055, 0.018), 0.011) * 0.26);
      col = mix(col, paper, (1.0 - aastep(0.005, abs(uv.y - 0.815))) * 0.10);
      float dEnd0 = length((uv - vec2(0.905, 0.905)) * vec2(1.0, 0.62));
      col = mix(col, accent, (1.0 - aastep(0.06, dEnd0)) * 0.32 * pulse);
      col = mix(col, mix(accent, paper, 0.4), disc(uv, vec2(0.905, 0.905), 0.019) * pulse);

      float kind = floor(vKind * 36.0);

      /* ---- chart frame: gridlines and axis ticks, on the chart kinds ---- */
      bool chart = kind < 1.5 || (kind > 3.5 && kind < 4.5) || (kind > 5.5 && kind < 6.5) || (kind > 10.5 && kind < 11.5);
      if (chart) {
        float gy = (1.0 - aastep(0.004, abs(uv.y - 0.28)))
                 + (1.0 - aastep(0.004, abs(uv.y - 0.44)))
                 + (1.0 - aastep(0.004, abs(uv.y - 0.60)));
        gy *= aaband(0.08, 0.94, uv.x);
        float tk = aaband(0.045, 0.070, uv.y)
                 * (1.0 - aastep(0.5, fract((uv.x - 0.08) / 0.86 * 5.0 + 0.25)))
                 * aaband(0.10, 0.92, uv.x);
        col = mix(col, paper, gy * 0.07);
        col = mix(col, paper, tk * 0.22);
      }

      /* ---- thirty-six screens ----
         Charts, dashboards, maps, apps and games, each animating off vT — the
         shared clock plus this screen's own offset, so a wall of them reads as
         many live things rather than one thing repeated. Every branch is
         instance-coherent (kind is constant across a panel), which is the case
         GPUs are fast at: a fragment pays for the one screen it draws, not for
         the thirty-five it does not. The first twelve are the original set;
         the rest were added to make the wall read as *any* software — charts
         of every shape, maps, boards, apps and games — not only analytics. */
      if (kind < 1.0) {
        /* Line chart with area fill, glow and a live endpoint. */
        float x = (uv.x - 0.08) / 0.86;
        float ph = s * 24.0;
        float y = 0.40 + 0.15 * sin(x * 6.5 - t * 0.9 + ph) + 0.06 * sin(x * 15.0 - t * 1.6 + ph * 0.5);
        float inX = aaband(0.08, 0.94, uv.x);
        float core = (1.0 - aastep(0.026, abs(uv.y - y))) * inX;
        float halo = (1.0 - aastep(0.085, abs(uv.y - y))) * inX * 0.30;
        float under = aaband(0.10, y, uv.y) * inX;
        float fade = clamp((uv.y - 0.10) / max(y - 0.10, 0.02), 0.0, 1.0);
        col = mix(col, accent, under * (0.05 + 0.22 * fade * fade));
        col = mix(col, accent, halo);
        col = mix(col, mix(accent, paper, 0.35), core);
        float ye = 0.40 + 0.15 * sin(6.5 - t * 0.9 + ph) + 0.06 * sin(15.0 - t * 1.6 + ph * 0.5);
        vec2 pe = vec2(0.94, ye);
        float ring = fract(t * 0.6);
        float dEnd = length((uv - pe) * vec2(1.0, 0.62));
        col = mix(col, accent, (1.0 - aastep(0.012, abs(dEnd - 0.02 - ring * 0.07))) * (1.0 - ring) * 0.6);
        col = mix(col, paper, disc(uv, pe, 0.021));
      } else if (kind < 2.0) {
        /* Bars with a hover that glides along them. */
        float nb = 8.0;
        float b = floor((uv.x - 0.08) / 0.86 * nb);
        float bx = 0.08 + (b + 0.5) * 0.86 / nb;
        float hv = 0.14 + 0.44 * rnd(b + s * 40.0) * (0.78 + 0.22 * sin(t * 1.1 + b * 0.9));
        float hq = (b - (3.5 + 3.5 * sin(t * 0.45 + s * 3.0))) * 1.1;
        float hover = exp(-hq * hq);
        float inX = aaband(0.07, 0.95, uv.x);
        float bar = rect(uv, vec2(bx, 0.12 + hv * 0.5), vec2(0.036, hv * 0.5), 0.014) * inX;
        float cap = bar * aaband(0.12 + hv - 0.035, 0.12 + hv, uv.y);
        col = mix(col, paper, (1.0 - aastep(0.005, abs(uv.y - 0.12))) * aaband(0.08, 0.94, uv.x) * 0.22);
        col = mix(col, accent * (0.55 + 0.45 * hover), bar * (0.70 + 0.30 * hover));
        col = mix(col, mix(accent, paper, 0.5), cap * (0.5 + 0.5 * hover));
        col = mix(col, paper, rect(uv, vec2(bx, 0.12 + hv + 0.07), vec2(0.04, 0.018), 0.011) * hover * 0.7);
      } else if (kind < 3.0) {
        /* Heatmap, cells warming and cooling. */
        vec2 g = vec2((uv.x - 0.08) / 0.86 * 8.0, (uv.y - 0.11) / 0.64 * 4.0);
        vec2 gi = floor(g);
        float v = rnd(gi.x * 3.7 + gi.y * 11.3 + s * 30.0);
        v = 0.5 + 0.5 * sin(v * 6.2831 + t * 0.7 + gi.x * 0.6 + gi.y * 1.1);
        vec2 cc = vec2(0.08 + (gi.x + 0.5) * 0.86 / 8.0, 0.11 + (gi.y + 0.5) * 0.64 / 4.0);
        float cell = rect(uv, cc, vec2(0.86 / 8.0 * 0.40, 0.64 / 4.0 * 0.38), 0.012)
                   * aaband(0.08, 0.94, uv.x) * aaband(0.11, 0.75, uv.y);
        col = mix(col, mix(mix(accent * 0.18, mix(accent, lightest, 0.72), uLight), accent, v), cell * (0.30 + 0.70 * v));
        col = mix(col, paper, cell * smoothstep(0.85, 1.0, v) * 0.5);
      } else if (kind < 4.0) {
        /* List: avatar, label, value, with a highlight drifting down the rows. */
        float nr = 5.0;
        float r = floor((uv.y - 0.10) / 0.68 * nr);
        float cy = 0.10 + (r + 0.5) * 0.68 / nr;
        float hq = (r - (2.0 + 2.0 * sin(t * 0.55 + s * 5.0))) * 1.6;
        float hi = exp(-hq * hq);
        float inR = step(-0.5, r) * step(r, nr - 0.5);
        float w = 0.22 + 0.30 * rnd(r * 7.7 + s * 15.0);
        float vw = 0.06 + 0.10 * rnd(r * 2.3 + s * 9.0);
        col = mix(col, paper, rect(uv, vec2(0.51, cy), vec2(0.45, 0.68 / nr * 0.42), 0.02) * inR * (0.04 + 0.08 * hi));
        col = mix(col, accent, disc(uv, vec2(0.12, cy), 0.024) * inR * (0.5 + 0.5 * hi));
        col = mix(col, paper, rect(uv, vec2(0.19 + w * 0.5, cy), vec2(w * 0.5, 0.012), 0.007) * inR * (0.45 + 0.4 * hi));
        col = mix(col, accent, rect(uv, vec2(0.92 - vw * 0.5, cy), vec2(vw * 0.5, 0.012), 0.007) * inR * 0.9);
      } else if (kind < 5.0) {
        /* Candlesticks with a moving average; the last candle forms live. */
        float nc = 10.0;
        float c = floor((uv.x - 0.08) / 0.86 * nc);
        float cx = 0.08 + (c + 0.5) * 0.86 / nc;
        float o = 0.40 + 0.14 * sin(c * 1.1 + s * 9.0);
        float cl = 0.40 + 0.14 * sin((c + 1.0) * 1.1 + s * 9.0);
        cl = mix(cl, o + (cl - o) * (0.5 + 0.5 * sin(t * 1.3)), step(nc - 1.5, c));
        float up = step(o, cl);
        float lo = min(o, cl);
        float hy = max(o, cl);
        float wl = 0.05 + 0.05 * rnd(c + s * 12.0);
        float inC = aaband(0.07, 0.95, uv.x) * step(-0.5, c);
        vec3 cc = mix(mix(paper * 0.55, mix(paper, lightest, 0.45), uLight), accent, up);
        col = mix(col, cc, (1.0 - aastep(0.006, abs(uv.x - cx))) * aaband(lo - wl, hy + wl, uv.y) * inC * 0.8);
        col = mix(col, cc, rect(uv, vec2(cx, (lo + hy) * 0.5), vec2(0.024, max((hy - lo) * 0.5, 0.008)), 0.005) * inC);
        float x = (uv.x - 0.08) / 0.86;
        float ma = 0.40 + 0.12 * sin(x * nc * 1.1 + s * 9.0);
        col = mix(col, accent2, (1.0 - aastep(0.013, abs(uv.y - ma))) * aaband(0.08, 0.94, uv.x) * 0.75);
      } else if (kind < 6.0) {
        /* Gauge: track, lit arc, ticks, needle, hub, readout. */
        vec2 gc = vec2(0.5, 0.30);
        vec2 d = (uv - gc) * vec2(1.0, 0.62);
        float rad = length(d);
        float ang = atan(d.y, d.x);
        float upper = step(0.0, ang);
        float pa = clamp((3.14159 - ang) / 3.14159, 0.0, 1.0);
        float sweep = 0.5 + 0.5 * sin(t * 0.55 + s * 6.0);
        float track = aaband(0.215, 0.27, rad) * upper;
        float lit = 1.0 - aastep(sweep, pa);
        float tt = abs(fract(pa * 8.0 + 0.5) - 0.5);
        float tick = (1.0 - aastep(0.006, tt * 0.3927 * rad)) * aaband(0.285, 0.305, rad) * upper;
        float na = 3.14159 * (1.0 - sweep);
        vec2 nd = vec2(cos(na), sin(na));
        float needle = (1.0 - aastep(0.008, abs(d.x * nd.y - d.y * nd.x))) * aaband(0.0, 0.20, dot(d, nd));
        col = mix(col, paper, track * 0.14);
        col = mix(col, accent, aaband(0.19, 0.30, rad) * upper * lit * 0.22);
        col = mix(col, accent, track * lit);
        col = mix(col, paper, tick * 0.5);
        col = mix(col, paper, needle * 0.95);
        col = mix(col, paper, disc(uv, gc, 0.026));
        col = mix(col, accent, disc(uv, gc, 0.014));
        col = mix(col, paper, rect(uv, vec2(0.5, 0.15), vec2(0.075, 0.02), 0.012) * 0.5);
      } else if (kind < 7.0) {
        /* Scatter with a trend line; points breathe. */
        vec2 g = vec2((uv.x - 0.08) / 0.86 * 8.0, (uv.y - 0.10) / 0.64 * 5.0);
        vec2 gi = floor(g);
        float rA = rnd(gi.x * 5.1 + gi.y * 17.3 + s * 21.0);
        float rB = rnd(gi.x * 2.7 + gi.y * 9.1 + s * 13.0);
        vec2 pc = vec2(0.08 + (gi.x + 0.5 + (rA - 0.5) * 0.7) * 0.86 / 8.0,
                       0.10 + (gi.y + 0.5 + (rB - 0.5) * 0.7) * 0.64 / 5.0);
        float on = step(0.45, rA);
        float pr = 0.010 + 0.012 * rB;
        float bright = 0.55 + 0.45 * sin(t * 1.3 + rA * 20.0);
        float dpt = length((uv - pc) * vec2(1.0, 0.62));
        float inA = aaband(0.08, 0.94, uv.x) * aaband(0.10, 0.74, uv.y);
        col = mix(col, accent, (1.0 - aastep(pr * 2.6, dpt)) * on * 0.22 * bright * inA);
        col = mix(col, mix(accent, paper, 0.3 * bright), (1.0 - aastep(pr, dpt)) * on * inA * (0.6 + 0.4 * bright));
        float x = (uv.x - 0.08) / 0.86;
        col = mix(col, accent2, (1.0 - aastep(0.010, abs(uv.y - (0.22 + 0.42 * x)))) * inA * 0.5);
      } else if (kind < 8.0) {
        /* Kanban: three columns of cards, floating in a slow wave. */
        float colx = floor((uv.x - 0.06) / 0.88 * 3.0);
        float cxk = 0.06 + (colx + 0.5) * 0.88 / 3.0;
        float inK = step(-0.5, colx) * step(colx, 2.5);
        float row = floor((0.70 - uv.y) / 0.155);
        float cyk = 0.70 - (row + 0.5) * 0.155;
        float has = step(0.30, rnd(colx * 9.3 + row * 4.1 + s * 8.0)) * step(-0.5, row) * step(row, 3.5) * inK;
        float lift = 0.012 * (0.5 + 0.5 * cos(t * 0.8 + colx * 2.094 + row * 0.9));
        col = mix(col, paper, rect(uv, vec2(cxk - 0.04, 0.745), vec2(0.07, 0.015), 0.009) * inK * 0.45);
        col = mix(col, paper, rect(uv, vec2(cxk, cyk + lift), vec2(0.125, 0.06), 0.018) * has * 0.10);
        col = mix(col, accent, rect(uv, vec2(cxk - 0.108, cyk + lift), vec2(0.008, 0.045), 0.005) * has);
        col = mix(col, paper, rect(uv, vec2(cxk - 0.02, cyk + lift + 0.02), vec2(0.06, 0.008), 0.004) * has * 0.5);
        col = mix(col, paper, rect(uv, vec2(cxk - 0.045, cyk + lift - 0.018), vec2(0.035, 0.008), 0.004) * has * 0.3);
      } else if (kind < 9.0) {
        /* Terminal: prompts, lines typing in, a soft-blinking cursor. */
        float nr = 6.0;
        float r = floor((0.76 - uv.y) / 0.11);
        float cy = 0.76 - (r + 0.5) * 0.11;
        float inR = step(-0.5, r) * step(r, nr - 0.5);
        float cycle = mod(t * 0.75, nr + 2.0);
        float prog = ease(clamp(cycle - r, 0.0, 1.0));
        float w = (0.20 + 0.50 * rnd(r * 3.3 + s * 6.0)) * prog;
        float active = 1.0 - aastep(0.5, abs(r - floor(cycle)));
        float blink = ease(0.5 + 0.5 * sin(t * 4.0));
        col = mix(col, accent, rect(uv, vec2(0.10, cy), vec2(0.012, 0.011), 0.004) * inR * step(0.001, prog) * 0.9);
        col = mix(col, paper, rect(uv, vec2(0.14 + w * 0.5, cy), vec2(w * 0.5, 0.010), 0.006) * inR * step(0.001, w) * 0.55);
        col = mix(col, accent, rect(uv, vec2(0.15 + w, cy), vec2(0.010, 0.013), 0.003) * inR * active * blink);
      } else if (kind < 10.0) {
        /* Donut with a legend; the split breathes. */
        vec2 dc = vec2(0.40, 0.42);
        vec2 d = (uv - dc) * vec2(1.0, 0.62);
        float rad = length(d);
        float p = fract((atan(d.y, d.x) - 1.5708) / -6.2831);
        float f1 = 0.36 + 0.22 * sin(t * 0.45 + s * 4.0);
        float f2 = f1 + 0.22;
        float ring = aaband(0.135, 0.20, rad);
        float in1 = 1.0 - aastep(f1, p);
        col = mix(col, paper, ring * 0.12);
