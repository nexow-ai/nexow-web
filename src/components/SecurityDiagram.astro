---
/**
 * Secure-by-design diagram — concentric trust boundary, shield core, and
 * orbiting control nodes with scroll-friendly idle animation.
 */
import { ICON_PATHS } from './icon-paths';

const NODES = [
  { label: 'vault', icon: 'lock', angle: -90, delay: '0s' },
  { label: 'runtime', icon: 'cpu', angle: -18, delay: '0.35s' },
  { label: 'scopes', icon: 'layers', angle: 54, delay: '0.7s' },
  { label: 'access', icon: 'plug', angle: 126, delay: '1.05s' },
  { label: 'sync', icon: 'sync', angle: 198, delay: '1.4s' },
] as const;

const CX = 260;
const CY = 220;
const RING = 118;

const glyph = (x: number, y: number, scale: number) =>
  `translate(${x} ${y}) scale(${scale}) translate(-12 -12)`;

const nodes = NODES.map((n) => {
  const a = (n.angle * Math.PI) / 180;
  return {
    ...n,
    x: CX + Math.cos(a) * RING,
    y: CY + Math.sin(a) * RING,
  };
});
---

<div class="sec-diagram relative mx-auto w-full max-w-xl" aria-hidden="true" data-motion="breathe">
  <svg class="sec-svg relative mx-auto block h-auto w-full" viewBox="0 0 520 400" fill="none">
    <defs>
      <linearGradient id="sec-ring" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.85"></stop>
        <stop offset="100%" stop-color="var(--color-sky-400)" stop-opacity="0.45"></stop>
      </linearGradient>
      <radialGradient id="sec-core" cx="50%" cy="45%" r="55%">
        <stop offset="0%" stop-color="var(--color-brand-300)" stop-opacity="0.95"></stop>
        <stop offset="55%" stop-color="var(--color-brand-500)" stop-opacity="0.9"></stop>
        <stop offset="100%" stop-color="var(--color-brand-700)" stop-opacity="0.75"></stop>
      </radialGradient>
      <filter id="sec-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="5" result="b"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="b"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    <!-- Ambient scan grid (tight, technical — not a soft light wash) -->
    <g class="sec-grid" opacity="0.35">
      {
        Array.from({ length: 9 }, (_, i) => (
          <line
            x1={40 + i * 55}
            y1="28"
            x2={40 + i * 55}
            y2="380"
            stroke="var(--color-brand-400)"
            stroke-width="0.6"
            stroke-opacity="0.22"
          />
        ))
      }
      {
        Array.from({ length: 7 }, (_, i) => (
          <line
            x1="36"
            y1={40 + i * 55}
            x2="484"
            y2={40 + i * 55}
            stroke="var(--color-brand-400)"
            stroke-width="0.6"
            stroke-opacity="0.18"
          />
        ))
      }
    </g>

    <!-- Outer trust boundary -->
    <circle class="sec-boundary" cx={CX} cy={CY} r="168" stroke="url(#sec-ring)" stroke-width="1.4" pathLength="1"></circle>
    <circle
      class="sec-boundary sec-boundary--spin"
      cx={CX}
      cy={CY}
      r="168"
      stroke="var(--color-brand-400)"
      stroke-width="1.2"
      stroke-dasharray="3 10"
      opacity="0.35"
    >
    </circle>
    <circle
      class="sec-boundary sec-boundary--spin-rev"
      cx={CX}
      cy={CY}
      r="138"
      stroke="var(--color-sky-400)"
      stroke-width="1"
      stroke-dasharray="2 8"
      opacity="0.28"
    >
    </circle>
    <circle class="sec-ring-draw" cx={CX} cy={CY} r={RING} stroke="url(#sec-ring)" stroke-width="1.6" pathLength="1"></circle>

    <!-- Spokes from core to nodes -->
    {
      nodes.map((n, i) => (
        <g>
          <path
            class="sec-spoke"
            d={`M ${CX} ${CY} L ${n.x} ${n.y}`}
            stroke="var(--color-brand-400)"
            stroke-width="1.4"
            stroke-opacity="0.35"
            pathLength="100"
            style={`--d:${(i * 0.12).toFixed(2)}s`}
          />
          <path
            class="sec-pulse"
            d={`M ${CX} ${CY} L ${n.x} ${n.y}`}
            stroke="var(--color-brand-300)"
            stroke-width="2.6"
            stroke-linecap="round"
            pathLength="100"
            style={`--d:${(i * 0.28).toFixed(2)}s`}
          />
        </g>
      ))
    }

    <!-- Orbiting control nodes -->
    {
      nodes.map((n) => (
        <g class="sec-node" style={`--d:${n.delay}`}>
          <circle class="sec-node-halo" cx={n.x} cy={n.y} r="22"></circle>
          <circle class="sec-node-disc" cx={n.x} cy={n.y} r="17"></circle>
          <path
            class="sec-node-glyph"
            d={ICON_PATHS[n.icon]}
            transform={glyph(n.x, n.y, 0.72)}
          />
          <text class="sec-node-label" x={n.x} y={n.y + 34}>
            {n.label}
          </text>
        </g>
      ))
    }

    <!-- Shield core -->
    <g filter="url(#sec-glow)" class="sec-core">
      <circle cx={CX} cy={CY} r="52" fill="url(#sec-core)" opacity="0.22" class="sec-core-halo"></circle>
      <circle class="sec-core-disc" cx={CX} cy={CY} r="38" fill="url(#sec-core)"></circle>
      <path
        class="sec-core-glyph"
        d={ICON_PATHS.shield}
        transform={glyph(CX, CY, 1.55)}
      />
    </g>
  </svg>
</div>

<style>
  .sec-svg {
    font-family: var(--font-mono);
    color: var(--color-ink-700);
  }
  :global(.dark) .sec-svg {
    color: var(--color-ink-200);
  }

  .sec-grid {
    mask-image: radial-gradient(55% 50% at 50% 48%, black, transparent 78%);
  }
  :global(.dark) .sec-grid {
    opacity: 0.55;
  }

  .sec-boundary {
    fill: none;
  }
  .sec-ring-draw {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: sec-draw 2.4s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) forwards;
  }
  .sec-boundary--spin {
    transform-box: fill-box;
    transform-origin: center;
    animation: sec-spin 42s linear infinite;
  }
  .sec-boundary--spin-rev {
    transform-box: fill-box;
    transform-origin: center;
    animation: sec-spin-rev 36s linear infinite;
  }
  @keyframes sec-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes sec-spin-rev {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes sec-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sec-spoke {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: sec-spoke-in 1.2s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes sec-spoke-in {
    to {
      stroke-dashoffset: 0;
    }
  }
  :global(.dark) .sec-spoke {
    stroke-opacity: 0.55;
    stroke-width: 1.7;
  }

  .sec-pulse {
    stroke-dasharray: 10 90;
    stroke-dashoffset: 100;
    opacity: 0.85;
    animation: sec-pulse-run 2.4s linear infinite;
    animation-delay: var(--d, 0s);
  }
  :global(.dark) .sec-pulse {
    stroke: var(--color-brand-300);
    stroke-width: 3;
    filter: drop-shadow(0 0 3px color-mix(in oklab, var(--color-brand-400) 50%, transparent));
  }
  @keyframes sec-pulse-run {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sec-node {
    animation: sec-node-pop 2.8s ease-in-out infinite;
    animation-delay: var(--d, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes sec-node-pop {
    0%,
    100% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.06);
    }
  }
  .sec-node-halo {
    fill: color-mix(in oklab, var(--color-brand-400) 16%, transparent);
  }
  :global(.dark) .sec-node-halo {
    fill: color-mix(in oklab, var(--color-brand-400) 28%, transparent);
  }
  .sec-node-disc {
    fill: white;
    stroke: color-mix(in oklab, var(--color-brand-500) 45%, transparent);
    stroke-width: 1.4;
  }
  :global(.dark) .sec-node-disc {
    fill: color-mix(in oklab, white 94%, transparent);
    stroke: color-mix(in oklab, var(--color-brand-300) 70%, transparent);
    stroke-width: 1.7;
  }
  .sec-node-glyph {
    stroke: var(--color-brand-700);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }
  :global(.dark) .sec-node-glyph {
    stroke: var(--color-brand-600);
  }
  .sec-node-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-anchor: middle;
    fill: var(--color-ink-500);
  }
  :global(.dark) .sec-node-label {
    fill: var(--color-brand-300);
    fill-opacity: 0.9;
  }

  .sec-core {
    transform-box: fill-box;
    transform-origin: center;
    animation: sec-core-breathe 4.5s ease-in-out infinite;
  }
  @keyframes sec-core-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }
  .sec-core-disc {
    stroke: color-mix(in oklab, white 35%, transparent);
    stroke-width: 1.2;
  }
  .sec-core-glyph {
    stroke: white;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sec-boundary--spin,
    .sec-boundary--spin-rev,
    .sec-pulse,
    .sec-node,
    .sec-core {
      animation: none;
    }
    .sec-ring-draw,
    .sec-spoke {
      animation: none;
      stroke-dashoffset: 0;
    }
  }

  :global(.is-offscreen) .sec-boundary--spin,
  :global(.is-offscreen) .sec-boundary--spin-rev,
  :global(.is-offscreen) .sec-pulse,
  :global(.is-offscreen) .sec-node,
  :global(.is-offscreen) .sec-core {
    animation-play-state: paused;
  }
</style>
