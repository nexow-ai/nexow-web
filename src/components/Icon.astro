---
/**
 * Lightweight inline icon set (stroke, 24×24, inherits currentColor).
 * Only the icons the site actually uses are included to keep markup small.
 * The stroke paths live in `icon-paths.ts` so inline SVG diagrams can draw the
 * same glyphs inside their own coordinate system.
 */
import { ICON_PATHS as paths } from './icon-paths';

interface Props {
  name: string;
  class?: string;
  /** Inline style — lets a caller tint the glyph from a CSS custom property. */
  style?: string;
}
const { name, class: className, style } = Astro.props;

/** Filled brand marks (Simple Icons paths, 24×24) — read better than stroke approximations. */
const filled: Record<string, { d: string; rule?: 'evenodd' }> = {
  youtube: {
    d: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z M9.545 15.568V8.432L15.818 12l-6.273 3.568z',
    rule: 'evenodd',
  },
  tiktok: {
    d: 'M19.59 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001.002.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 10.65 6.33 6.33 0 0 0 10.857-4.424V8.687a8.182 8.182 0 0 0 4.773 1.526V6.79a4.831 4.831 0 0 1-1.003-.104z',
  },
};

const fillIcon = filled[name];
const strokePath = paths[name];
---

{
  fillIcon ? (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} style={style} aria-hidden="true">
      <path d={fillIcon.d} fill-rule={fillIcon.rule} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      style={style}
      aria-hidden="true"
    >
      <path d={strokePath ?? ''} />
    </svg>
  )
}
