---
/**
 * Lightweight inline icon set (stroke, 24×24, inherits currentColor).
 * Only the icons the site actually uses are included to keep markup small.
 * The stroke paths live in `icon-paths.ts` so inline SVG diagrams can draw the
 * same glyphs inside their own coordinate system.
 */
import { ICON_PATHS as paths } from './icon-paths';

interface Props {
  name: string;
  class?: string;
  /** Inline style — lets a caller tint the glyph from a CSS custom property. */
  style?: string;
}
const { name, class: className, style } = Astro.props;

/** Filled brand marks (Simple Icons paths, 24×24) — read better than stroke approximations. */
const filled: Record<string, { d: string; rule?: 'evenodd' }> = {
