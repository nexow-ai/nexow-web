const fillIcon = filled[name];
const strokePath = paths[name];
---

{
  fillIcon ? (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} style={style} aria-hidden="true">
      <path d={fillIcon.d} fill-rule={fillIcon.rule} />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      style={style}
      aria-hidden="true"
    >
      <path d={strokePath ?? ''} />
    </svg>
  )
}
