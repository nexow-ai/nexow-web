---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconRight?: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconRight,
  external = false,
  class: className = '',
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-medium tracking-tight transition-all duration-200 ease-out-expo focus-visible:outline-2 focus-visible:outline-offset-2 whitespace-nowrap';

const variants: Record<string, string> = {
  // On a dark surface the flat teal fill goes flat: swap it for the brand →
  // secondary-accent gradient, which is where the page's colour story lives.
  primary:
    'bg-brand-600 text-white shadow-[0_1px_0_rgba(255,255,255,0.18)_inset,0_10px_20px_-14px_var(--color-brand-600)] hover:bg-brand-500 hover:shadow-[0_1px_0_rgba(255,255,255,0.22)_inset,0_14px_26px_-16px_var(--color-brand-500)] hover:-translate-y-0.5 dark:bg-none dark:bg-[linear-gradient(100deg,var(--color-brand-500),var(--color-accent-500)_62%,var(--color-plasma-500))] dark:text-white dark:shadow-[0_10px_34px_-14px_var(--color-accent-500)] dark:hover:shadow-[0_14px_40px_-14px_var(--color-plasma-500)]',
  secondary:
    'bg-white text-ink-900 ring-1 ring-ink-900/10 hover:ring-ink-900/20 hover:-translate-y-0.5 shadow-sm dark:bg-white/[0.06] dark:text-white dark:ring-white/12 dark:backdrop-blur dark:hover:bg-white/[0.1] dark:hover:ring-white/25',
  dark: 'bg-white text-ink-950 hover:bg-white/90 hover:-translate-y-0.5 shadow-lg shadow-black/20',
  outline:
    'text-white ring-1 ring-white/15 bg-white/[0.03] hover:ring-white/30 hover:bg-white/[0.07] hover:-translate-y-0.5',
  ghost: 'text-ink-700 hover:text-ink-950 hover:bg-ink-900/5',
};

const sizes: Record<string, string> = {
  sm: 'h-9 px-4 text-sm',
  md: 'h-11 px-5 text-[0.95rem]',
  lg: 'h-13 px-7 text-base',
};

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  rel={rel}
  target={target}
>
  {icon && <Icon name={icon} class="size-[1.15em] -ml-0.5 shrink-0" />}
  <slot />
  {
    iconRight && (
      <Icon
        name={iconRight}
        class="size-[1.15em] -mr-0.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    )
  }
</a>
