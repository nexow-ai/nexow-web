---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark' | 'outline' | 'gradient';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconRight?: string;
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconRight,
  external = false,
  class: className = '',
} = Astro.props;

// No `whitespace-nowrap`: CTA labels are translated, and the long ones
// (el "Διαβάστε την αρχιτεκτονική λειτουργίας τοπικού") cannot fit one line on a
// phone — they used to run straight out of the section and get clipped.
const base =
  'group inline-flex items-center justify-center gap-2 rounded-full text-center font-medium tracking-tight transition-all duration-200 ease-out-expo focus-visible:outline-2 focus-visible:outline-offset-2';

// Brand gradient (teal → sky → indigo). Same stops as `.text-gradient` /
// hero CTAs — identical in light and dark via shared --grad-* tokens.
const brandGradient =
  'bg-[linear-gradient(100deg,var(--grad-a),var(--grad-b)_52%,var(--grad-c))] text-white shadow-[0_1px_0_rgba(255,255,255,0.22)_inset,0_12px_28px_-14px_color-mix(in_oklab,var(--grad-b)_70%,transparent)] hover:brightness-[1.06] hover:shadow-[0_1px_0_rgba(255,255,255,0.28)_inset,0_16px_34px_-14px_color-mix(in_oklab,var(--grad-c)_55%,transparent)] hover:-translate-y-0.5';

const variants: Record<string, string> = {
  primary: brandGradient,
  // Explicit alias for feature CTAs; same paint as primary.
  gradient: brandGradient,
  secondary:
    'bg-white text-ink-900 ring-1 ring-ink-900/10 hover:ring-ink-900/20 hover:-translate-y-0.5 shadow-sm dark:bg-white/[0.06] dark:text-white dark:ring-white/12 dark:backdrop-blur dark:hover:bg-white/[0.1] dark:hover:ring-white/25',
  dark: 'bg-white text-ink-950 hover:bg-white/90 hover:-translate-y-0.5 shadow-lg shadow-black/20',
  outline:
    'text-white ring-1 ring-white/15 bg-white/[0.03] hover:ring-white/30 hover:bg-white/[0.07] hover:-translate-y-0.5',
  ghost: 'text-ink-700 hover:text-ink-950 hover:bg-ink-900/5',
};

// `min-h` rather than `h`, so a label that wraps grows the pill instead of
// spilling out of it. Single-line labels render at exactly the same height.
const sizes: Record<string, string> = {
  sm: 'min-h-9 px-4 py-2 text-sm',
  md: 'min-h-11 px-5 py-2.5 text-[0.95rem]',
  lg: 'min-h-13 px-7 py-3 text-base',
};

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  rel={rel}
  target={target}
>
  {icon && <Icon name={icon} class="size-[1.15em] -ml-0.5 shrink-0" />}
  <slot />
  {
    iconRight && (
      <Icon
        name={iconRight}
        class="size-[1.15em] -mr-0.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
      />
    )
  }
</a>
