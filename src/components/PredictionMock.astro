---
/**
 * Decorative prediction-market widget — event probability with a history
 * sparkline, Kalshi-style. Deterministic and purely presentational.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

// Hand-shaped probability history (percent), drifting up to 72.
const HIST = [58, 57, 59, 61, 60, 63, 62, 64, 66, 65, 68, 67, 69, 71, 70, 72];
const w = 560;
const h = 120;
const min = 50;
const max = 80;
const pts = HIST.map((v, i) => {
  const x = (i / (HIST.length - 1)) * w;
  const y = h - ((v - min) / (max - min)) * h;
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const line = `M ${pts.join(' L ')}`;
const area = `${line} L ${w} ${h} L 0 ${h} Z`;
---

<div class:list={['select-none', className]} aria-hidden="true">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-ink-200">Fed cuts rates at next FOMC?</p>
      <p class="mt-0.5 font-mono text-[0.65rem] text-ink-500">KXFEDCUT · Kalshi</p>
    </div>
    <div class="text-right">
      <p class="font-display text-3xl font-bold text-brand-300">72%</p>
      <p class="font-mono text-[0.65rem] text-emerald-400">▲ +3 / 24h</p>
    </div>
  </div>

  <svg viewBox={`0 0 ${w} ${h}`} class="mt-4 h-24 w-full" fill="none" preserveAspectRatio="none">
    <defs>
      <linearGradient id="pred-fill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#10c5a3" stop-opacity="0.35" />
        <stop offset="1" stop-color="#10c5a3" stop-opacity="0.02" />
      </linearGradient>
    </defs>
    {
      [0.33, 0.66].map((f) => (
        <line x1="0" x2={w} y1={h * f} y2={h * f} stroke="white" stroke-opacity="0.06" />
      ))
    }
    <path d={area} fill="url(#pred-fill)" />
    <path d={line} stroke="#2adfba" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx={w} cy={h - ((72 - min) / (max - min)) * h} r="4" fill="#2adfba" />
  </svg>

  <div class="mt-4 grid grid-cols-2 gap-2 font-mono text-xs">
    <div class="flex items-center justify-between rounded-lg bg-emerald-500/10 px-3 py-2 text-emerald-300 ring-1 ring-emerald-400/20">
      <span>YES</span><span>72¢</span>
    </div>
    <div class="flex items-center justify-between rounded-lg bg-rose-500/10 px-3 py-2 text-rose-300 ring-1 ring-rose-400/20">
      <span>NO</span><span>28¢</span>
    </div>
  </div>
</div>
