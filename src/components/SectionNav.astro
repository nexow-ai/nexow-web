---
/**
 * Right-side in-page section rail with click-to-scroll and scroll-spy.
 *
 * Pass an explicit `sections` list (id + label). Pages own discovery and i18n;
 * the rail only renders, spies, and navigates. Hidden below `lg` so mobile
 * keeps a clean full-bleed reading surface.
 *
 * Dots live in a fixed-width end column so variable label lengths never push
 * them off a straight vertical axis.
 */
export interface SectionNavItem {
  id: string;
  label: string;
}

interface Props {
  sections: SectionNavItem[];
  /** Accessible name for the nav landmark. */
  label?: string;
}

const { sections, label = 'On this page' } = Astro.props;
---

{
  sections.length > 0 && (
    <nav
      id="section-nav"
      class="section-nav pointer-events-none fixed inset-y-0 z-40 hidden items-center end-3 lg:flex xl:end-5"
      aria-label={label}
      data-section-nav
    >
      <ol class="section-nav__list pointer-events-auto relative flex w-max flex-col items-stretch gap-1 py-2 text-ink-500 dark:text-ink-300">
        {/* Vertical track centered on the fixed-width dot column */}
        <span
          class="section-nav__track pointer-events-none absolute top-3 bottom-3 end-[calc(0.4375rem-0.5px)] w-px bg-ink-900/15 dark:bg-white/20"
          aria-hidden="true"
        />

        {sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="section-nav__link group relative flex w-full items-center justify-end gap-3 py-1.5 text-ink-500 outline-none transition-colors duration-200 hover:text-ink-950 focus-visible:text-ink-950 dark:text-ink-400 dark:hover:text-white dark:focus-visible:text-white"
              data-section-link={s.id}
            >
              <span
                class="section-nav__label max-w-[9.5rem] truncate text-end font-mono text-[0.65rem] font-medium uppercase tracking-[0.14em] transition-all duration-200"
              >
                {s.label}
              </span>
              <span class="section-nav__dot-slot relative z-10 flex size-3.5 shrink-0 items-center justify-center" aria-hidden="true">
                <span class="section-nav__dot size-2.5 rounded-full border transition-all duration-200" />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  :global([dir='rtl']) .section-nav__link {
    flex-direction: row-reverse;
  }

  .section-nav__label {
    /* 42% measured below AA on the page background; 68% keeps it recessive. */
    color: color-mix(in oklab, var(--color-ink-900) 68%, transparent);
  }
  :global([dir='rtl']) .section-nav__label {
    text-align: start;
  }
  :global(.dark) .section-nav__label {
    color: color-mix(in oklab, white 68%, transparent);
  }

  .section-nav__link:hover .section-nav__label,
  .section-nav__link:focus-visible .section-nav__label {
    color: var(--color-ink-950);
  }
  :global(.dark) .section-nav__link:hover .section-nav__label,
  :global(.dark) .section-nav__link:focus-visible .section-nav__label {
    color: white;
  }

  .section-nav__dot {
    border-color: color-mix(in oklab, var(--color-ink-900) 28%, transparent);
    background: white;
  }
  :global(.dark) .section-nav__dot {
    border-color: color-mix(in oklab, white 40%, transparent);
    background: var(--color-ink-900);
  }

  .section-nav__link:hover .section-nav__dot,
  .section-nav__link:focus-visible .section-nav__dot {
    border-color: var(--color-brand-500);
    background: color-mix(in oklab, var(--color-brand-500) 80%, transparent);
  }

  .section-nav__link[aria-current='true'] .section-nav__dot {
    transform: scale(1.25);
    border-color: var(--color-brand-500);
    background: var(--color-brand-500);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-brand-500) 22%, transparent);
  }

  .section-nav__link[aria-current='true'] .section-nav__label {
    color: var(--color-brand-700);
  }
  :global(.dark) .section-nav__link[aria-current='true'] .section-nav__label {
    color: var(--color-brand-300);
  }
</style>

<script>
  type SectionNavController = {
    disconnect: () => void;
  };

  let controller: SectionNavController | null = null;

  function initSectionNav() {
    controller?.disconnect();
    controller = null;

    const nav = document.querySelector<HTMLElement>('[data-section-nav]');
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
    if (!links.length) return;

    const items = links
      .map((link) => {
        const id = link.dataset.sectionLink;
        if (!id) return null;
        const el = document.getElementById(id);
        if (!el) return null;
        return { id, link, el };
      })
      .filter((item): item is { id: string; link: HTMLAnchorElement; el: HTMLElement } => item !== null);

    if (!items.length) return;

    let activeId = '';
    let raf = 0;

    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      for (const item of items) {
        const on = item.id === id;
        if (on) item.link.setAttribute('aria-current', 'true');
        else item.link.removeAttribute('aria-current');
      }
    };

    /**
     * Pick the section whose top is nearest above a line ~28% down the viewport.
     * Falls back to the first / last section at the page edges.
     */
    const syncFromScroll = () => {
      raf = 0;
      const marker = window.innerHeight * 0.28;
      let current = items[0].id;

      for (const item of items) {
        const top = item.el.getBoundingClientRect().top;
        if (top <= marker) current = item.id;
        else break;
      }

      // Near document end: lock onto the last section that still intersects.
      const doc = document.documentElement;
      if (window.scrollY + window.innerHeight >= doc.scrollHeight - 8) {
        current = items[items.length - 1].id;
      }

      setActive(current);
    };

    const schedule = () => {
      if (raf) return;
      raf = requestAnimationFrame(syncFromScroll);
    };

    // Prefer IntersectionObserver to know when to recompute; scroll is the source of truth.
    let observer: IntersectionObserver | null = null;
    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(schedule, {
        rootMargin: '-20% 0px -55% 0px',
        threshold: [0, 0.25, 0.5, 0.75, 1],
      });
      for (const item of items) observer.observe(item.el);
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);

    const onClick = (event: MouseEvent) => {
      const link = (event.target as Element | null)?.closest?.('[data-section-link]') as
        | HTMLAnchorElement
        | null;
      if (!link || !nav.contains(link)) return;
      const id = link.dataset.sectionLink;
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;

      event.preventDefault();
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', `#${id}`);
      setActive(id);
    };

    nav.addEventListener('click', onClick);

    // Honour deep links / hash after view transitions.
    const hash = decodeURIComponent(window.location.hash.replace(/^#/, ''));
    if (hash && items.some((item) => item.id === hash)) setActive(hash);
    else syncFromScroll();

    controller = {
      disconnect() {
        observer?.disconnect();
        window.removeEventListener('scroll', schedule);
        window.removeEventListener('resize', schedule);
        nav.removeEventListener('click', onClick);
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
      },
    };
  }

  document.addEventListener('astro:page-load', initSectionNav);
  document.addEventListener('astro:before-swap', () => {
    controller?.disconnect();
    controller = null;
  });
</script>
