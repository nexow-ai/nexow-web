<script>
  function bind(root: HTMLElement) {
    const canvas = () => document.getElementById('app-showcase');
    let raf = 0;

    const tick = () => {
      raf = 0;
      const el = canvas();
      if (!el) return;
      const ps = parseFloat(getComputedStyle(el).getPropertyValue('--ps') || '0') || 0;
      const top = el.getBoundingClientRect().top;
      const vh = window.innerHeight || 1;
      const approach = top < vh * 0.78 ? Math.min(1, (vh * 0.78 - top) / (vh * 0.45)) : 0;
      const arr = Math.max(ps, approach);
      root.style.setProperty('--arr', arr.toFixed(3));
      root.classList.toggle('is-arrange', arr > 0.06);
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    tick();
  }

  document.querySelectorAll<HTMLElement>('[data-playground-art]').forEach(bind);
</script>
