    .w-source,
    .w-pointer,
    .w-mood-pick,
    .w-heat-today {
      opacity: 0;
    }

    .w-widget {
      opacity: 1;
      transform: none;
    }

    .w-board-alt {
      opacity: 0;
      visibility: hidden;
    }

    .w-board-home {
      opacity: 1;
      visibility: visible;
    }

    .w-mem-face {
      opacity: 0.85;
    }

    .w-mem-back {
      opacity: 0;
    }

    .w-heat {
      opacity: var(--heat, 0.6);
    }

    .w-streak-n {
      opacity: 0;
    }

    .w-streak-n:last-child {
      opacity: 1;
    }

    .w-tab-loop {
      width: calc(var(--w) + 2.3cqi);
      margin-inline-start: 0.45cqi;
      padding-inline: 1.15cqi;
    }

    .w-ws-loop {
      height: 3.5cqi;
      margin-block-start: 0.5cqi;
    }

    .w-tab-extra,
    .w-ws-extra {
      display: none;
    }

    .w-profile {
      opacity: 0;
    }

    .w-profile:first-child {
      opacity: 1;
    }
  }

  .w-mosaic-label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .w-mosaic {
    fill: color-mix(in oklab, var(--color-brand-400) 6%, transparent);
  }

  .w-link {
    stroke: var(--color-brand-400);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
  }

  .w-node {
    fill: var(--color-brand-300);
  }

  .w-mosaic,
  .w-mosaic-label {
    opacity: 0;
  }

  .w-links {
    opacity: 0;
  }

  /* 02 — same nodes, parked and wired. --arr is written by the script.
     Boards cycle through layouts (personal → trading → map → markets → news). */
  .w-scene.is-arrange {
    --arr: var(--arr, 1);
  }

  .w-scene.is-arrange .w-prompt-g,
  .w-scene.is-arrange .w-caret,
  .w-scene.is-arrange .w-glow,
  .w-scene.is-arrange .w-pointer,
  .w-scene.is-arrange .w-source {
    opacity: calc(1 - var(--arr, 1));
    animation: none !important;
  }

  .w-scene.is-arrange .w-type-mask {
    animation: none !important;
  }

  .w-scene.is-arrange .w-widget {
    animation: none !important;
    opacity: 1;
    transform: none;
  }

  /* Keep chart ink fully drawn while boards swap — the generate-loop
     stroke-dash hide would otherwise blank the spark mid-cycle. */
  .w-scene.is-arrange .w-sparkline,
  .w-scene.is-arrange .w-ema,
  .w-scene.is-arrange .w-mini-spark {
    animation: none !important;
    stroke-dashoffset: 0;
  }

  .w-scene.is-arrange .w-spark-dot {
    animation: none !important;
    opacity: 1;
    transform: none;
  }

  .w-scene.is-arrange .w-board-alt {
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .w-scene.is-arrange .w-board {
      animation: w-board-life var(--w-board-cycle, 8.25s) var(--w-e) infinite;
      /* Negative delay keeps the stagger after the first loop. */
      animation-delay: calc(var(--i) * var(--w-board-step, 1.65s) - var(--w-board-cycle, 8.25s));
    }
  }

  .w-scene.is-arrange .w-mosaic,
  .w-scene.is-arrange .w-mosaic-label {
    opacity: var(--arr, 1);
  }

  /* Links only on the personal board — fade with that board's opacity. */
  .w-scene.is-arrange .w-board-home .w-links {
    opacity: 1;
  }

  .w-scene.is-arrange .w-screen-tag {
    display: flex;
    opacity: var(--arr, 1);
  }

  .w-scene.is-arrange .w-link {
    stroke-dashoffset: calc(160 - var(--arr, 1) * 160);
  }

  .w-scene.is-arrange .w-node {
    opacity: var(--arr, 1);
  }
</style>

<script>
  function bind(root: HTMLElement) {
    const canvas = () => document.getElementById('app-showcase');
    let raf = 0;

    const tick = () => {
      raf = 0;
      const el = canvas();
      if (!el) return;
      const ps = parseFloat(getComputedStyle(el).getPropertyValue('--ps') || '0') || 0;
      const top = el.getBoundingClientRect().top;
      const vh = window.innerHeight || 1;
      const approach = top < vh * 0.78 ? Math.min(1, (vh * 0.78 - top) / (vh * 0.45)) : 0;
      const arr = Math.max(ps, approach);
      root.style.setProperty('--arr', arr.toFixed(3));
      root.classList.toggle('is-arrange', arr > 0.06);
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    tick();
  }

  document.querySelectorAll<HTMLElement>('[data-playground-art]').forEach(bind);
</script>
