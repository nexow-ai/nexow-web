---

<div class="act-scene w-scene" data-playground-art aria-hidden="true">
      <div class="w-slab"></div>
      <div class="w-frame">
      <svg
        class="w-art"
        viewBox="0 0 640 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="presentation"
        aria-hidden="true"
      >
        <defs>
          <pattern id="w-dots" width="10" height="10" patternUnits="userSpaceOnUse">
            <circle cx="0.6" cy="0.6" r="0.45" fill="var(--w-dot)"></circle>
          </pattern>
          <pattern id="w-grid" width="16" height="16" patternUnits="userSpaceOnUse">
            <path d="M16 0H0V16" fill="none" stroke="var(--w-line)" stroke-width="0.4"></path>
          </pattern>
          <clipPath id="w-frame-clip">
            <rect x="16" y="16" width="608" height="368" rx="8"></rect>
          </clipPath>
          <clipPath id="w-type-clip">
            <rect class="w-type-mask" x="180" y="80" width="400" height="36"></rect>
          </clipPath>
          <clipPath id="w-aq-clip">
            <rect x="136" y="310" width="184" height="46" rx="2"></rect>
          </clipPath>
          <clipPath id="w-chart-clip">
            <rect x="136" y="136" width="248" height="118" rx="2"></rect>
          </clipPath>
          <clipPath id="w-stage-clip">
            <rect x="120" y="64" width="492" height="312" rx="4"></rect>
          </clipPath>
          <linearGradient id="w-glow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.14"></stop>
            <stop offset="100%" stop-color="var(--color-sky-400)" stop-opacity="0.04"></stop>
          </linearGradient>
          <linearGradient id="w-spark-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.28"></stop>
            <stop offset="100%" stop-color="var(--color-brand-400)" stop-opacity="0"></stop>
          </linearGradient>
          <filter id="w-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="6"></feGaussianBlur>
          </filter>
        </defs>

        <g clip-path="url(#w-frame-clip)">
          <rect x="16" y="16" width="608" height="368" rx="8" fill="var(--w-panel)"></rect>
          <rect x="16" y="16" width="608" height="368" rx="8" fill="url(#w-dots)" opacity="0.4"></rect>
          <rect x="16" y="16" width="608" height="40" fill="var(--w-panel-2)"></rect>
          <rect x="16" y="56" width="96" height="16" fill="var(--w-panel-2)"></rect>
          <rect x="16" y="56" width="96" height="328" fill="var(--w-rail-bg)"></rect>
          <rect x="112" y="56" width="512" height="16" fill="var(--w-panel)"></rect>
          <line x1="112" y1="72" x2="624" y2="72" stroke="var(--w-line)" stroke-width="0.6"></line>
          {
            TOOLS.map((tool, i) => (
              <g transform={`translate(${120 + i * 42} 58)`} opacity="0.72">
                <rect width="38" height="12" rx="2" fill="var(--w-cell)"></rect>
                <g transform="translate(2.5 1.5) scale(0.38)" stroke="var(--w-text-2)" stroke-width="1.8" fill="none">
                  <path d={ICON_PATHS[tool.icon] ?? ''}></path>
                </g>
                <text x="14" y="9" class="w-micro" fill="var(--w-text-4)">{tool.label}</text>
              </g>
            ))
          }
          <text x="560" y="67" class="w-micro" fill="var(--w-text-4)">toolbar</text>

          <rect
            class="w-mosaic"
            x="120"
            y="74"
            width="492"
            height="302"
            rx="4"
            stroke="var(--color-brand-400)"
            stroke-dasharray="3 3"
          ></rect>
          <text class="w-mosaic-label" x="126" y="80" fill="var(--w-accent)">MOSAIC</text>

          <!-- Prompt — types on the shared loop, not on scroll. -->
          <g class="w-prompt-g">
            <ellipse class="w-glow" cx="360" cy="100" rx="180" ry="46" fill="url(#w-glow)" filter="url(#w-soft)"></ellipse>
            <rect x="128" y="76" width="476" height="48" rx="6" class="w-card"></rect>
            <rect x="140" y="86" width="28" height="28" rx="4" fill="var(--w-icon-bg)"></rect>
            <g class="w-spark" transform="translate(144 90) scale(0.83)" stroke="var(--color-brand-400)" stroke-width="1.7" fill="none">
              <path d={ICON_PATHS.sparkles}></path>
            </g>
            <g clip-path="url(#w-type-clip)">
              <foreignObject x="180" y="82" width="400" height="36">
                <div class="w-prompt">{prompt}</div>
              </foreignObject>
            </g>
            <g class="w-caret">
              <rect class="w-caret-bar" x="180" y="86" width="2" height="18" rx="1" fill="var(--color-brand-400)"></rect>
            </g>
          </g>

          <g class="w-source">
            <text x="136" y="148" class="w-tiny" fill="var(--w-accent)">GENERATING</text>
            {[0, 1, 2, 3].map((i) => (
              <rect
                class="w-src-bar"
                style={`--i:${i}`}
                x="128"
                y={156 + i * 10}
                width={80 + i * 52}
                height="5"
                rx="2.5"
                fill="var(--w-src)"
              />
            ))}
          </g>

          <g class="w-boards" clip-path="url(#w-stage-clip)">
          <!-- 0 · Personal — generate loop lands here. Top KPIs sit under
               the prompt during type/generate, then fill the mosaic in act 02. -->
          <g class="w-board w-board-home" style={`--i:0`}>
          <g class="w-under-prompt">
            <g class="w-widget-static">
              <rect x="128" y="76" width="148" height="48" rx="5" class="w-card"></rect>
              <text x="136" y="90" class="w-micro" fill="var(--w-text-4)">LOCAL · MON</text>
              <text class="w-kpi" x="136" y="106" fill="var(--w-text)">09:24:18</text>
              <text x="200" y="106" class="w-note" fill="var(--w-text-4)">UTC+2</text>
              <circle class="w-live" cx="264" cy="88" r="1.6" fill="var(--color-brand-400)"></circle>
            </g>
            <g class="w-widget-static">
              <rect x="284" y="76" width="148" height="48" rx="5" class="w-card"></rect>
              <text x="292" y="90" class="w-micro" fill="var(--w-text-4)">OUTSIDE</text>
              <text class="w-kpi" x="292" y="106" fill="var(--w-text)">18.4°</text>
              <text x="336" y="106" class="w-note" fill="var(--w-text-4)">clear · 41%</text>
              <rect x="400" y="96" width="22" height="16" rx="2" fill="var(--color-sky-400)" opacity="0.35"></rect>
              <rect x="404" y="99" width="14" height="10" rx="1" fill="var(--color-sky-400)" opacity="0.7"></rect>
            </g>
            <g class="w-widget-static">
              <rect x="440" y="76" width="164" height="48" rx="5" class="w-card"></rect>
              <text x="448" y="90" class="w-micro" fill="var(--w-text-4)">STREAK</text>
              <text class="w-kpi" x="448" y="106" fill="var(--w-text)">12 days</text>
              <rect class="w-mover" style="--i:0" x="508" y="96" width="84" height="6" rx="1" fill="var(--color-brand-400)" opacity="0.7"></rect>
              <text x="508" y="114" class="w-micro" fill="var(--w-text-4)">goal 21</text>
            </g>
          </g>

          <g class="w-widget" style="--i:0">
            <rect x="128" y="132" width="288" height="144" rx="5" class="w-card"></rect>
            <text x="136" y="146" class="w-card-title" fill="var(--w-text)">Moodboard</text>
            <text x="196" y="146" class="w-micro" fill="var(--w-text-4)">4 layers · v3</text>
            <rect x="352" y="138" width="52" height="10" rx="2" fill="var(--color-brand-400)" opacity="0.16"></rect>
            <text x="360" y="146" class="w-micro" fill="var(--w-accent)">saved</text>
            <line x1="136" y1="152" x2="404" y2="152" stroke="var(--w-line)" stroke-width="0.6"></line>
            {
              MOOD.map((tile, i) => (
                <g class="w-mood-tile" style={`--i:${i}`}>
                  <rect x={tile.x} y={tile.y} width={tile.w} height={tile.h} rx="3" fill={tile.fill}></rect>
                  <rect
                    x={tile.x + 4}
                    y={tile.y + 4}
                    width={tile.w - 8}
                    height={Math.max(8, tile.h * 0.38)}
                    rx="1.5"
                    fill="var(--w-panel)"
                    opacity="0.28"
                  ></rect>
                  <text x={tile.x + 6} y={tile.y + tile.h - 6} class="w-micro" fill="var(--w-text)">
                    {tile.label}
