    padding: 1.5cqi 0 1.5cqi 1.2cqi;
    background: var(--w-rail-bg);
    border-right: 1px solid var(--w-line);
  }

  .w-rail-label {
    margin: 0 0 0.6cqi 0.4cqi;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.05cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-text-4);
  }

  .w-ws {
    display: flex;
    height: 3.5cqi;
    flex-shrink: 0;
    align-items: center;
    gap: 0.7cqi;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 0.35cqi 0 0 0.35cqi;
    padding-inline: 0.85cqi;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.35cqi;
    color: var(--w-text-4);
  }

  .w-ws-active {
    background: var(--w-tab-on);
    color: var(--w-accent);
  }

  .w-ws-loop {
    height: 0;
    margin-block-start: 0;
    background: var(--w-tab);
  }

  .w-ws-dot {
    width: 0.85cqi;
    height: 0.85cqi;
    flex-shrink: 0;
    border-radius: 999px;
  }

  .w-ws-add {
    height: 3.5cqi;
    margin-block-start: 0.5cqi;
    border-radius: 0.35cqi 0 0 0.35cqi;
    border: 1px dashed var(--w-line);
    border-inline-end: 0;
    padding-inline: 0.85cqi;
    justify-content: flex-start;
  }

  .w-card-title,
  .w-tiny,
  .w-note,
  .w-micro,
  .w-streak-n,
  .w-pairs,
  .w-kpi,
  .w-mem-mark {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .w-card-title {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .w-tiny,
  .w-streak-n,
  .w-pairs,
  .w-kpi {
    font-size: 8px;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .w-note {
    font-size: 7.5px;
  }

  .w-micro,
  .w-mem-mark {
    font-size: 6.5px;
    letter-spacing: 0.02em;
  }

  .w-prompt {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    line-height: 32px;
    white-space: nowrap;
    color: var(--w-text-3);
  }

  .w-type-mask,
  .w-caret,
  .w-widget,
  .w-source,
  .w-glow,
  .w-spark,
  .w-mood-tile,
  .w-mood-pick,
  .w-swatch,
  .w-heat,
  .w-heat-today,
  .w-mem,
  .w-mem-back,
  .w-mem-face,
  .w-sparkline,
  .w-spark-dot,
  .w-pointer,
  .w-live,
  .w-streak-n,
  .w-board,
  .w-candle,
  .w-book-row,
  .w-quake,
  .w-quake-ring,
  .w-mag,
  .w-watch,
  .w-mover,
  .w-story,
  .w-chip,
  .w-donut-fill,
  .w-kpi-pulse {
    transform-box: fill-box;
    transform-origin: center;
  }

  .w-type-mask {
    transform-origin: left center;
  }

  .w-caret {
    transform-origin: left center;
  }

  .w-sparkline {
    transform-origin: left center;
    fill: none;
  }

  .w-boards {
    transform-box: fill-box;
  }

  .w-board-alt {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .w-board-home {
    opacity: 1;
  }

  /* Finished desk is the rest frame — the generate loop may settle widgets,
     it must not blank the stage under the chrome tabs. */
  .w-widget {
    opacity: 1;
  }

  /* Top KPI strip sits under the generate prompt; only reads as a row in act 02. */
  .w-under-prompt {
    opacity: 0;
  }

  .w-scene.is-arrange .w-under-prompt {
    opacity: 1;
  }

  .w-mini-spark {
    fill: none;
  }

  .w-donut {
    transform-origin: center;
  }

  .w-quake-ring {
    opacity: 0.55;
  }

  .w-mood-pick {
    fill: none;
    stroke: var(--color-brand-300);
    stroke-width: 1;
    opacity: 0;
  }

  .w-heat-today {
    fill: none;
    stroke: var(--color-brand-200, var(--color-brand-300));
    stroke-width: 1.3;
  }

  .w-mem-face {
    opacity: 0;
  }

  .w-pointer {
    offset-path: none;
    pointer-events: none;
  }

  .w-click {
    fill: none;
    stroke: var(--color-brand-300);
    stroke-width: 1.2;
    opacity: 0;
  }

  /* At rest — finished playground. The loop below only runs when motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .w-type-mask {
      animation: w-type var(--w-cycle) steps(26, end) infinite;
    }

    .w-caret {
      animation: w-caret-move var(--w-cycle) steps(26, end) infinite;
    }

    .w-caret-bar {
      animation: w-blink 0.9s steps(2, start) infinite;
    }

    .w-source {
      animation: w-source var(--w-cycle) var(--w-e) infinite;
    }

    .w-src-bar {
      transform-box: fill-box;
      transform-origin: left center;
      animation: w-src-bar var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }

    .w-widget {
      animation: w-widget var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.14s);
    }

    .w-tab-loop {
      animation: w-tab-life var(--w-tab-cycle, calc(var(--w-step) * 12)) var(--w-e) infinite both;
      animation-delay: calc(var(--i) * var(--w-step));
    }

    .w-ws-loop {
      animation: w-ws-life var(--w-ws-cycle, calc(var(--w-step) * 24)) var(--w-e) infinite both;
      animation-delay: calc(var(--i) * var(--w-step) + var(--w-step) / 2);
    }

    .w-tab-add,
    .w-ws-add {
      animation: w-add-flash var(--w-step) ease-out infinite;
    }

    .w-profile {
      animation: w-profile-roll calc(6 * 3s) var(--w-e) infinite backwards;
      animation-delay: calc(var(--i) * 3s);
    }

    .w-glow {
      animation: w-glow var(--w-cycle) ease-in-out infinite;
    }

    .w-spark {
      animation: w-spark 2.4s ease-in-out infinite;
    }

    .w-live {
      animation: w-live 1.6s ease-in-out infinite;
    }

    .w-mood-tile {
      animation: w-mood-breathe 3.2s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.35s);
    }

    .w-mood-pick {
      animation: w-mood-pick var(--w-cycle) var(--w-e) infinite;
    }

    .w-swatch {
      animation: w-swatch var(--w-cycle) ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.7s);
    }

    .w-heat {
      animation: w-heat var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.035s);
    }

    .w-heat-today {
      animation: w-today var(--w-cycle) ease-in-out infinite;
    }

    .w-streak-n {
      animation: w-streak var(--w-cycle) steps(1, end) infinite;
      animation-delay: calc(var(--i) * 1.8s);
    }

    .w-mem-back {
      animation: w-mem-back var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--p) * 0.7s);
    }

    .w-mem-face {
      animation: w-mem-face var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--p) * 0.7s);
    }

    .w-sparkline {
      stroke-dasharray: 280;
      animation: w-draw var(--w-cycle) var(--w-e) infinite;
    }

    .w-spark-dot {
      animation: w-spark-dot var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.05s);
    }

    .w-kpi {
      animation: w-kpi var(--w-cycle) steps(1, end) infinite;
    }

    .w-pointer {
      animation: w-pointer var(--w-cycle) var(--w-e) infinite;
    }

    .w-click {
      animation: w-click var(--w-cycle) ease-out infinite;
    }

    .w-candle {
      transform-origin: center bottom;
      animation: w-candle-pop 2.4s var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.06s);
    }

    .w-book-row {
      animation: w-book 2s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }

    .w-quake-ring {
      animation: w-quake-ring 2.2s ease-out infinite;
      animation-delay: calc(var(--i) * 0.45s);
    }

    .w-mag {
      transform-origin: center bottom;
      animation: w-mag 2.6s var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.05s);
    }

    .w-watch {
      animation: w-watch-in 2.8s var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }

    .w-mini-spark {
      stroke-dasharray: 320;
      animation: w-draw-fast 2.8s var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }

    .w-mover {
      transform-origin: left center;
      animation: w-mover 2.4s var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.1s);
    }

    .w-story {
      animation: w-story 3s var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.14s);
    }

    .w-chip {
      animation: w-chip 2.6s ease-in-out infinite;
    }

    .w-donut-fill {
      animation: w-donut 3s var(--w-e) infinite;
    }

    .w-kpi-pulse {
      animation: w-kpi-pulse 1.8s ease-in-out infinite;
    }

    .w-ema {
      stroke-dasharray: 320;
      animation: w-draw-fast 3s var(--w-e) infinite;
    }
  }

  /* Type 0–18%, generate 20–30%, land 32–40%, live through 88%, wipe 92–100%. */
  @keyframes w-type {
    0% {
      transform: scaleX(0.02);
