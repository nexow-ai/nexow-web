/** Air-quality spark — card 128,284,200×80. */
const SPARK = [28, 36, 32, 44, 50, 41, 56, 62, 54, 68, 74, 70, 66, 72];
const sparkLo = Math.min(...SPARK);
const sparkHi = Math.max(...SPARK);
const sparkX = (i: number) => 138 + i * 12.4;
const sparkY = (v: number) => 354 - ((v - sparkLo) / (sparkHi - sparkLo || 1)) * 36;
const sparkPath = SPARK.map((v, i) => `${i ? 'L' : 'M'}${sparkX(i)} ${sparkY(v)}`).join(' ');
const sparkArea = `${sparkPath} L${sparkX(SPARK.length - 1)} 356 L${sparkX(0)} 356 Z`;

/** Candle closes for the trading board. Chart 128,114,304×182. */
const CLOSES = [42, 45, 43, 48, 52, 49, 55, 58, 54, 61, 64, 60, 66, 70, 67, 73, 76, 72, 80, 84];
const VOLUME = [16, 22, 12, 28, 20, 14, 32, 18, 10, 26, 22, 16, 30, 20, 14, 24, 28, 16, 20, 34];
const candleY = (v: number) => 246 - (v - 38) * 1.72;
const CANDLES = CLOSES.map((c, i) => {
  const prev = i === 0 ? c - 5 : CLOSES[i - 1];
  const top = candleY(Math.max(c, prev));
  const bottom = candleY(Math.min(c, prev));
  return { x: 146 + i * 13.6, top, h: Math.max(5, bottom - top + 4), up: c >= prev, vol: VOLUME[i] };
});
const emaPath = CLOSES.map((c, i) => `${i ? 'L' : 'M'}${146 + i * 13.6} ${candleY(c)}`).join(' ');
const emaSlow = CLOSES.map((c, i) => {
  const v = i < 2 ? c : (CLOSES[i] + CLOSES[i - 1] + CLOSES[i - 2]) / 3;
  return `${i ? 'L' : 'M'}${146 + i * 13.6} ${candleY(v)}`;
}).join(' ');
