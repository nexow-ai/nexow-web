---
/**
 * The one playground for acts 01 and 02.
 *
 * Chrome is HTML — screens and workspaces open and close on a real width /
 * height the way the Features playground does. The stage stays SVG: type,
 * generate, live widgets. As #app-showcase takes the pin the generate loop
 * parks, a mosaic bound draws, and Links wire the same widgets. Chrome
 * keeps cycling through both acts.
 */
import { ICON_PATHS } from '../icon-paths';

interface Props {
  prompt: string;
}
const { prompt } = Astro.props;

/** Four weeks of streak intensities — a monthly heatmap, not a fortnight. */
const CELLS = [
  2, 3, 1, 0, 3, 2, 1, 0, 2, 3, 3, 1, 2, 0, 3, 2, 0, 1, 3, 2, 3, 1, 2, 2, 0, 3,
  1, 3, 2, 1,
];

/** Active screen stays put; the rest open and close on `--w-step`. `--w` is
 *  the label width in `ch` so the keyframes animate a real width. */
const activeTab = 'Playground';
const loopTabs = ['Markets', 'Habits', 'Research'];

const activeWorkspace = { label: 'Personal', tint: 'var(--color-brand-400)' };
const loopWorkspaces = [
  { label: 'Trading', tint: 'var(--color-accent-400)' },
  { label: 'Markets', tint: 'var(--color-sky-400)' },
  { label: 'Games', tint: 'var(--color-plasma-400, var(--color-accent-400))' },
  { label: 'Studio', tint: 'var(--color-brand-400)' },
  { label: 'Health', tint: 'var(--color-brand-300)' },
  { label: 'Travel', tint: 'var(--color-sky-400)' },
  { label: 'Music', tint: 'var(--color-accent-400)' },
  { label: 'Home', tint: 'var(--color-sky-300, var(--color-sky-400))' },
  { label: 'Team', tint: 'var(--color-accent-300, var(--color-accent-400))' },
  { label: 'Labs', tint: 'var(--color-brand-400)' },
  { label: 'Clients', tint: 'var(--color-sky-400)' },
];
const PARKED_WORKSPACES = 3;

const profiles = [
  { handle: '@quanta', initial: 'Q', tint: 'var(--color-brand-500)' },
  { handle: '@nova.eth', initial: 'N', tint: 'var(--color-accent-500)' },
  { handle: '@mira_dev', initial: 'M', tint: 'var(--color-sky-500)' },
  { handle: '@0xkaito', initial: 'K', tint: 'var(--color-plasma-500, var(--color-accent-500))' },
  { handle: '@lunaris', initial: 'L', tint: 'var(--color-brand-400)' },
  { handle: '@vega-01', initial: 'V', tint: 'var(--color-accent-400)' },
];

const MOOD = [
  { x: 144, y: 176, w: 148, h: 72, fill: 'var(--w-mood-1)' },
  { x: 300, y: 176, w: 68, h: 40, fill: 'var(--w-mood-2)' },
  { x: 376, y: 176, w: 56, h: 40, fill: 'var(--w-mood-3)' },
  { x: 300, y: 224, w: 132, h: 24, fill: 'var(--w-mood-4)' },
];

const SWATCHES = [
  { x: 144, fill: 'var(--color-brand-400)' },
  { x: 166, fill: 'var(--color-accent-400)' },
  { x: 188, fill: 'var(--color-sky-400)' },
  { x: 210, fill: 'var(--color-brand-300)' },
];

/** Eight memory cards in 4×2. `pair` is which two flip together. */
const MEMORY = [
  { col: 0, row: 0, pair: 0 },
  { col: 1, row: 0, pair: 1 },
  { col: 2, row: 0, pair: 0 },
  { col: 3, row: 0, pair: 2 },
  { col: 0, row: 1, pair: 1 },
  { col: 1, row: 1, pair: 3 },
  { col: 2, row: 1, pair: 2 },
  { col: 3, row: 1, pair: 3 },
];

const PAIR_FILL = [
  'var(--color-brand-400)',
  'var(--color-accent-400)',
  'var(--color-sky-400)',
  'var(--color-brand-300)',
];

const SPARK = [28, 36, 32, 44, 50, 41, 56, 62, 54, 68, 74, 70];
const sparkPath = SPARK.map((v, i) => `${i ? 'L' : 'M'}${152 + i * 22} ${318 - v * 0.7}`).join(' ');
---

<div class="act-scene w-scene" data-playground-art aria-hidden="true">
      <div class="w-slab"></div>
      <div class="w-frame">
      <svg
        class="w-art"
        viewBox="0 0 640 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="presentation"
      >
        <defs>
          <pattern id="w-dots" width="14" height="14" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.7" fill="var(--w-dot)"></circle>
          </pattern>
          <clipPath id="w-frame-clip">
            <rect x="16" y="16" width="608" height="368" rx="18"></rect>
          </clipPath>
          <clipPath id="w-type-clip">
            <rect class="w-type-mask" x="180" y="80" width="400" height="36"></rect>
          </clipPath>
          <linearGradient id="w-glow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.22"></stop>
            <stop offset="100%" stop-color="var(--color-sky-400)" stop-opacity="0.08"></stop>
          </linearGradient>
          <filter id="w-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="10"></feGaussianBlur>
          </filter>
        </defs>

        <g clip-path="url(#w-frame-clip)">
          <rect x="16" y="16" width="608" height="368" rx="18" fill="var(--w-panel)"></rect>
          <rect x="16" y="16" width="608" height="368" rx="18" fill="url(#w-dots)" opacity="0.55"></rect>
          <rect x="16" y="16" width="608" height="40" fill="var(--w-panel-2)"></rect>
          <rect x="16" y="56" width="96" height="328" fill="var(--w-rail-bg)"></rect>

          <rect
            class="w-mosaic"
            x="120"
            y="140"
            width="492"
            height="140"
            rx="16"
            stroke="var(--color-brand-400)"
            stroke-dasharray="5 4"
          ></rect>
          <text class="w-mosaic-label" x="132" y="156" fill="var(--w-accent)">MOSAIC</text>

          <!-- Prompt — types on the shared loop, not on scroll. -->
          <g class="w-prompt-g">
            <ellipse class="w-glow" cx="360" cy="100" rx="180" ry="46" fill="url(#w-glow)" filter="url(#w-soft)"></ellipse>
            <rect x="128" y="70" width="476" height="56" rx="14" class="w-card"></rect>
            <rect x="140" y="82" width="32" height="32" rx="8" fill="var(--w-icon-bg)"></rect>
            <g class="w-spark" transform="translate(146 88) scale(0.85)" stroke="var(--color-brand-400)" stroke-width="1.7" fill="none">
              <path d={ICON_PATHS.sparkles}></path>
            </g>
            <g clip-path="url(#w-type-clip)">
              <foreignObject x="180" y="82" width="400" height="36">
                <p xmlns="http://www.w3.org/1999/xhtml" class="w-prompt">{prompt}</p>
              </foreignObject>
            </g>
            <g class="w-caret">
              <rect class="w-caret-bar" x="180" y="86" width="2" height="18" rx="1" fill="var(--color-brand-400)"></rect>
            </g>
          </g>

          <g class="w-source">
            <text x="136" y="148" class="w-tiny" fill="var(--w-accent)">GENERATING</text>
            {[0, 1, 2, 3].map((i) => (
              <rect
                class="w-src-bar"
                style={`--i:${i}`}
                x="128"
                y={156 + i * 10}
                width={80 + i * 52}
                height="5"
                rx="2.5"
                fill="var(--w-src)"
              />
            ))}
          </g>

          <g class="w-widget" style="--i:0">
            <rect x="128" y="148" width="320" height="124" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="144" cy="166" r="3" fill="var(--color-brand-400)"></circle>
            <text x="154" y="170" class="w-card-title" fill="var(--w-text)">Moodboard</text>
            <rect x="392" y="158" width="40" height="8" rx="4" fill="var(--color-brand-400)" opacity="0.85"></rect>
            {
              MOOD.map((tile, i) => (
                <rect
                  class="w-mood-tile"
                  style={`--i:${i}`}
                  x={tile.x}
                  y={tile.y}
                  width={tile.w}
                  height={tile.h}
                  rx="8"
                  fill={tile.fill}
                />
              ))
            }
            <rect class="w-mood-pick" x="144" y="176" width="148" height="72" rx="10"></rect>
            {
              SWATCHES.map((s, i) => (
                <rect
                  class="w-swatch"
                  style={`--i:${i}`}
                  x={s.x}
                  y="254"
                  width="16"
                  height="8"
                  rx="2"
                  fill={s.fill}
                />
              ))
            }
            <text x="240" y="261" class="w-note" fill="var(--w-text-4)">calm · clear</text>
          </g>

          <g class="w-widget" style="--i:1">
            <rect x="460" y="148" width="144" height="124" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="476" cy="166" r="3" fill="var(--color-brand-400)"></circle>
            <text x="486" y="170" class="w-card-title" fill="var(--w-text)">Habits</text>
            <g class="w-streak">
              <text class="w-streak-n" style="--i:0" x="572" y="170" fill="var(--w-accent)">3/8</text>
              <text class="w-streak-n" style="--i:1" x="572" y="170" fill="var(--w-accent)">5/8</text>
              <text class="w-streak-n" style="--i:2" x="572" y="170" fill="var(--w-accent)">6/8</text>
            </g>
            {
              CELLS.slice(0, 28).map((v, i) => (
                <rect
                  class="w-heat"
                  style={`--i:${i};--heat:${0.12 + v * 0.26}`}
                  x={472 + (i % 7) * 16}
                  y={180 + Math.floor(i / 7) * 16}
                  width="13"
                  height="13"
                  rx="2.5"
                  fill="var(--color-brand-400)"
                />
              ))
            }
            <rect class="w-heat-today" x={472 + 6 * 16} y={180 + 3 * 16} width="13" height="13" rx="2.5"></rect>
          </g>

          <g class="w-widget" style="--i:2">
            <rect x="460" y="280" width="144" height="84" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="476" cy="296" r="3" fill="var(--color-sky-400)"></circle>
            <text x="486" y="300" class="w-card-title" fill="var(--w-text)">Memory</text>
            <text class="w-pairs" x="568" y="300" fill="var(--w-accent)">2 pairs</text>
            {
              MEMORY.map((card, i) => {
                const x = 472 + card.col * 30;
                const y = 310 + card.row * 22;
                return (
                  <g class="w-mem" style={`--i:${i};--p:${card.pair}`} transform={`translate(${x} ${y})`}>
                    <rect class="w-mem-back" x="0" y="0" width="26" height="18" rx="4" fill="var(--w-cell)"></rect>
                    <rect
                      class="w-mem-face"
                      x="0"
                      y="0"
                      width="26"
                      height="18"
                      rx="4"
                      fill={PAIR_FILL[card.pair]}
                    ></rect>
                  </g>
                );
              })
            }
          </g>

          <g class="w-widget" style="--i:3">
            <rect x="128" y="280" width="320" height="84" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="144" cy="296" r="3" fill="var(--color-accent-400)"></circle>
            <text x="154" y="300" class="w-card-title" fill="var(--w-text)">Air quality</text>
            <text class="w-kpi" x="400" y="300" fill="var(--w-accent)">AQI 42</text>
            <path class="w-sparkline" d={sparkPath} stroke="var(--color-brand-400)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            {
              SPARK.map((v, i) => (
                <circle
                  class="w-spark-dot"
                  style={`--i:${i}`}
                  cx={152 + i * 22}
                  cy={318 - v * 0.7}
                  r="2.2"
                  fill="var(--color-brand-300)"
                />
              ))
            }
          </g>

          <g class="w-links">
            <path class="w-link" d="M448 210 C 460 210, 460 188, 460 188"></path>
            <path class="w-link" d="M288 272 C 288 286, 318 296, 318 296"></path>
            <circle class="w-node" cx="448" cy="210" r="3.5"></circle>
            <circle class="w-node" cx="460" cy="188" r="3.5"></circle>
            <circle class="w-node" cx="318" cy="296" r="3.5"></circle>
          </g>

          <g class="w-pointer">
            <path d="M0 0l11 9-4.4 1.2 2.2 6.4-3.2 1.2-2.2-6.4L0 14Z" fill="var(--w-text)" stroke="var(--w-panel)" stroke-width="1"></path>
            <circle class="w-click" cx="2" cy="2" r="10"></circle>
          </g>
        </g>

        <rect
          x="16"
          y="16"
          width="608"
          height="368"
          rx="18"
          fill="none"
          stroke="var(--w-chrome)"
          stroke-width="1.4"
        ></rect>
      </svg>

      <div class="w-chrome">
        <div class="w-head">
          <img class="w-mark" src="/favicon.png" alt="" width="16" height="16" />
          <div class="w-tabs">
            <span class="w-tab w-tab-active">{activeTab}</span>
            {loopTabs.map((label, i) => (
              <span class="w-tab w-tab-loop" style={`--i:${i};--w:${label.length}ch`}>{label}</span>
            ))}
            <span class="w-tab-add">
              <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="M6 2.5v7M2.5 6h7"></path>
              </svg>
            </span>
          </div>
          <span class="w-screen-tag">SCREEN · 01</span>
          <span class="w-switcher">
            <span class="w-switcher-stack">
              {profiles.map((profile, i) => (
                <span class="w-profile" style={`--i:${i}`}>
                  <span class="w-avatar" style={`background:${profile.tint}`}>{profile.initial}</span>
                  <span class="w-handle">{profile.handle}</span>
                </span>
              ))}
            </span>
            <svg class="w-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 4.5 6 7.5 9 4.5"></path>
            </svg>
          </span>
        </div>
        <aside class="w-rail" style={`--w-ws-cycle:calc(var(--w-step) * ${loopWorkspaces.length})`}>
          <p class="w-rail-label">Workspaces</p>
          <span class="w-ws w-ws-active">
            <span class="w-ws-dot" style={`background:${activeWorkspace.tint}`}></span>
            {activeWorkspace.label}
          </span>
          {loopWorkspaces.map((workspace, i) => (
            <span
              class:list={['w-ws', 'w-ws-loop', i >= PARKED_WORKSPACES && 'w-ws-extra']}
              style={`--i:${i}`}
            >
              <span class="w-ws-dot" style={`background:${workspace.tint}`}></span>
              {workspace.label}
            </span>
          ))}
          <span class="w-ws-add">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
              <path d="M6 2.5v7M2.5 6h7"></path>
            </svg>
          </span>
        </aside>
      </div>
      </div>
    </div>

<style>
  .w-scene {
    position: relative;
    perspective: 880px;
    perspective-origin: 50% 42%;
  }

  .w-slab {
    position: absolute;
    inset: auto 8% -8% 8%;
    height: 42%;
    border-radius: 1.25rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 28%, transparent),
      transparent 70%
    );
    filter: blur(18px);
    pointer-events: none;
  }

  .w-frame {
    position: relative;
    width: 100%;
    container-type: inline-size;
    --w-cycle: 16s;
    --w-step: 1.6s;
    --w-e: var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    --w-add-flash: var(--color-brand-100);
    --w-add-flash-text: var(--color-brand-600);
    /* Daylight playground: ink on mist, solid pigment — not a 38% wash
       of the 400s (pastel) and not a dark island on a light page. */
    --w-text: var(--color-ink-950);
    --w-text-2: var(--color-ink-600);
    --w-text-3: var(--color-ink-800);
    --w-text-4: var(--color-ink-500);
    --w-accent: var(--color-brand-600);
    --w-line: color-mix(in oklab, var(--color-ink-900) 14%, transparent);
    --w-panel: #fff;
    --w-panel-2: color-mix(in oklab, var(--color-brand-100) 50%, #fff);
    --w-dot: color-mix(in oklab, var(--color-ink-900) 12%, transparent);
    --w-tab: color-mix(in oklab, var(--color-ink-900) 5%, transparent);
    --w-tab-on: color-mix(in oklab, var(--color-brand-200) 72%, #fff);
    --w-rail-bg: color-mix(in oklab, var(--color-brand-50) 70%, transparent);
    --w-icon-bg: var(--color-brand-100);
    --w-src: var(--color-brand-400);
    --w-cell: color-mix(in oklab, var(--color-ink-900) 8%, transparent);
    --w-chrome: var(--color-brand-400);
    --w-mood-1: var(--color-brand-200);
    --w-mood-2: var(--color-accent-200);
    --w-mood-3: var(--color-sky-200);
    --w-mood-4: var(--color-brand-100);
    --w-shadow: rgba(15, 23, 42, 0.16);
  }

  .w-art {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    filter: drop-shadow(0 28px 60px var(--w-shadow));
  }

  /* Night chrome: page is dark *or* this band is inverted on a light page.
   * `:global(.dark) .w-frame` alone would keep a dark mock on the white invert. */
  :global(.dark) .w-frame,
  :global(html:not(.dark) .tone-invert) .w-frame {
    --w-text: #fff;
    --w-text-2: var(--color-ink-200);
    --w-text-3: var(--color-ink-100);
    --w-text-4: var(--color-ink-300);
    --w-accent: var(--color-brand-300);
    --w-line: rgba(255, 255, 255, 0.12);
    --w-panel: rgba(9, 12, 20, 0.94);
    --w-panel-2: rgba(255, 255, 255, 0.05);
    --w-dot: rgba(255, 255, 255, 0.14);
    --w-tab: rgba(255, 255, 255, 0.06);
    --w-tab-on: color-mix(in oklab, var(--color-brand-400) 32%, transparent);
    --w-rail-bg: rgba(255, 255, 255, 0.035);
    --w-icon-bg: color-mix(in oklab, var(--color-brand-400) 22%, transparent);
    --w-src: color-mix(in oklab, var(--color-brand-400) 45%, var(--color-accent-500));
    --w-cell: rgba(255, 255, 255, 0.08);
    --w-chrome: color-mix(in oklab, var(--color-brand-400) 70%, rgba(255, 255, 255, 0.16));
    --w-mood-1: color-mix(in oklab, var(--color-brand-400) 48%, transparent);
    --w-mood-2: color-mix(in oklab, var(--color-accent-400) 52%, transparent);
    --w-mood-3: color-mix(in oklab, var(--color-sky-400) 46%, transparent);
    --w-mood-4: color-mix(in oklab, var(--color-brand-300) 28%, transparent);
    --w-add-flash: color-mix(in oklab, var(--color-brand-400) 20%, transparent);
    --w-add-flash-text: var(--color-brand-200);
  }

  :global(.dark .tone-invert) .w-frame {
    --w-text: var(--color-ink-950);
    --w-text-2: var(--color-ink-600);
    --w-text-3: var(--color-ink-800);
    --w-text-4: var(--color-ink-500);
    --w-accent: var(--color-brand-600);
    --w-line: color-mix(in oklab, var(--color-ink-900) 14%, transparent);
    --w-panel: #fff;
    --w-panel-2: color-mix(in oklab, var(--color-brand-100) 50%, #fff);
    --w-dot: color-mix(in oklab, var(--color-ink-900) 12%, transparent);
    --w-tab: color-mix(in oklab, var(--color-ink-900) 5%, transparent);
    --w-tab-on: color-mix(in oklab, var(--color-brand-200) 72%, #fff);
    --w-rail-bg: color-mix(in oklab, var(--color-brand-50) 70%, transparent);
    --w-icon-bg: var(--color-brand-100);
    --w-src: var(--color-brand-400);
    --w-cell: color-mix(in oklab, var(--color-ink-900) 8%, transparent);
    --w-chrome: var(--color-brand-400);
    --w-mood-1: var(--color-brand-200);
    --w-mood-2: var(--color-accent-200);
    --w-mood-3: var(--color-sky-200);
    --w-mood-4: var(--color-brand-100);
    --w-shadow: rgba(15, 23, 42, 0.16);
  }

  .w-card {
    fill: var(--w-panel-2);
    stroke: var(--w-line);
    stroke-width: 1;
  }

  /* HTML chrome — same open/close life as Features PlaygroundMock. Sized in
     cqi so tabs and the rail stay locked to the SVG as the pin scales. */
  .w-chrome {
    position: absolute;
    inset: 4% 2.5%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 2.8cqi;
    pointer-events: none;
  }

  .w-head {
    display: flex;
    align-items: flex-end;
    gap: 0.8cqi;
    height: 10.87%;
    padding: 0 1.8cqi;
    background: var(--w-panel-2);
    border-bottom: 1px solid var(--w-line);
  }

  .w-mark {
    width: 2.5cqi;
    height: 2.5cqi;
    margin-bottom: 1.2cqi;
    object-fit: contain;
    flex-shrink: 0;
  }

  .w-tabs {
    display: flex;
    align-items: flex-end;
    min-width: 0;
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(to right, black calc(100% - 2cqi), transparent);
  }

  .w-tab {
    display: flex;
    height: 3.75cqi;
    flex-shrink: 0;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
    border-radius: 0.7cqi 0.7cqi 0 0;
    padding-inline: 1.15cqi;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.4cqi;
    color: var(--w-text-4);
  }

  .w-tab-active {
    background: var(--w-tab-on);
