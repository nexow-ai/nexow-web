    .w-glow,
    .w-spark,
    .w-live,
    .w-mood-tile,
    .w-mood-pick,
    .w-swatch,
    .w-heat,
    .w-heat-today,
    .w-streak-n,
    .w-mem-back,
    .w-mem-face,
    .w-sparkline,
    .w-spark-dot,
    .w-kpi,
    .w-pointer,
    .w-click,
    .w-board,
    .w-candle,
    .w-book-row,
    .w-quake-ring,
    .w-mag,
    .w-watch,
    .w-mini-spark,
    .w-mover,
    .w-story,
