---
/**
 * The 3D world the acts are staged inside.
 *
 * One hand-rolled WebGL scene — instanced billboards under a real perspective
 * camera that orbits and dollies as you scroll. The point cloud is not
 * decoration: it *is* the story, morphing between six formations, one per act,
 * so the same body of matter becomes a widget, then a canvas of widgets, then a
 * ring of connectors, then a signal fanning out, then an agent's harness.
 *
 * It lives inside `ActsStage` rather than behind the whole page because the
 * stage paints an opaque surface — a canvas underneath it would simply never be
 * seen. Stacking here is deliberate and load-bearing:
 *
 *     .acts-stage        z-index: 0, opaque ink   ← what axe measures contrast against
 *       .acts-field      z-index: 1, this canvas  ← the world, additive
 *       .acts-stage > *  z-index: 2, the acts     ← text, always on top
 *
 * The canvas is `position: fixed`, so it is one viewport-sized surface for the
 * whole stage instead of one per act, and it fades out at the stage's edges.
 *
 * No 3D library: `tests/build/payload.test.ts` caps total JS at 150 KB, caps any
 * one file at 60 KB, and forbids every external origin, so three.js is not an
 * option. The projection and view matrices are ~40 lines at the bottom of this
 * file.
 */
---

<div class="acts-field" aria-hidden="true">
  <canvas class="acts-field__canvas"></canvas>
</div>

<script>
  /** Billboards. Each is two triangles; the formations below place them. */
  const COUNT_WIDE = 2600;
  const COUNT_NARROW = 900;

  const VERT = `
    precision highp float;
    attribute vec2 aCorner;
    attribute float aId;
    attribute float aSeed;

    uniform mat4 uProj;
    uniform mat4 uView;
    uniform float uN;
    uniform float uFormA;
    uniform float uFormB;
    uniform float uMorph;
    uniform float uTime;
    uniform float uShift;

    varying float vTone;
    varying float vGlow;
    varying vec2 vUv;

    vec3 hash3(float i) {
      return fract(sin(vec3(i * 12.9898, i * 78.233, i * 37.719)) * 43758.5453);
    }

    /* Six formations. Every one is a closed-form function of the instance index,
       so morphing is a mix() and no per-frame buffer upload is ever needed. */
    vec3 form(float f, float i, float n, float seed) {
      float a = i / n;
      vec3 h = hash3(i);

      if (f < 0.5) {
        /* 0 — dust: the raw material, a loose ellipsoidal cloud. */
        float th = seed * 6.2831;
        float ph = acos(2.0 * h.x - 1.0);
        float r = 10.0 + 8.0 * h.y;
        return vec3(r * sin(ph) * cos(th), r * sin(ph) * sin(th) * 0.55, r * cos(ph));
      }
      if (f < 1.5) {
        /* 1 — one widget: matter condenses into a single dense slab. */
        float cols = 46.0;
        float x = mod(i, cols);
        float y = floor(i / cols);
        float rows = ceil(n / cols);
        return vec3((x - cols * 0.5) * 0.30, -(y - rows * 0.5) * 0.30 * 0.62, sin(x * 0.25) * 0.18);
      }
      if (f < 2.5) {
        /* 2 — the canvas: the slab splits into four widgets on one screen. */
        float g = floor(a * 4.0);
        float k = fract(a * 4.0);
        float cols = 14.0;
        float idx = k * (n / 4.0);
        float x = mod(idx, cols);
        float y = floor(idx / cols);
        float rows = ceil((n / 4.0) / cols);
        vec3 base = vec3(g < 2.0 ? -4.6 : 4.6, mod(g, 2.0) < 1.0 ? 3.0 : -3.0, (g - 1.5) * 1.1);
        return base + vec3((x - cols * 0.5) * 0.30, -(y - rows * 0.5) * 0.30, 0.0);
      }
      if (f < 3.5) {
        /* 3 — connectors: a ring docking around the workspace. A torus, not a
         * circle: a one-dimensional wire of points is too thin to read as an
         * object once it is spread across the viewport. */
        float u = a * 6.2831 * 2.0;
        float v = h.x * 6.2831;
        float R = 8.2;
        float rt = 1.7;
        float ring = R + rt * cos(v);
        return vec3(ring * cos(u), ring * sin(u) * 0.46, rt * sin(v) + sin(u * 3.0) * 0.5);
      }
      if (f < 4.5) {
        /* 4 — the fan-out: one column of signal splitting into four branches. */
        float t = a;
        float br = floor(h.z * 4.0);
        float spread = smoothstep(0.42, 1.0, t);
        float ang = (br - 1.5) * 0.52;
        return vec3(
          sin(ang) * spread * 8.5 + (h.x - 0.5) * 0.5,
          (t - 0.5) * -13.0,
          cos(ang) * spread * 2.4 + (h.y - 0.5) * 0.5
        );
      }
      /* 5 — the harness: six clusters in slow orbit around a core. */
      float g = floor(h.z * 6.0);
      float th = g / 6.0 * 6.2831 + uTime * 0.12;
      vec3 c = vec3(cos(th) * 7.0, sin(th) * 7.0 * 0.45, sin(th * 2.0) * 1.6);
      return c + (h - 0.5) * 2.0;
    }

    void main() {
      vec3 pa = form(uFormA, aId, uN, aSeed);
      vec3 pb = form(uFormB, aId, uN, aSeed);
      /* Stagger the morph per instance so the change reads as matter flowing
         rather than every point cutting on the same frame. */
      float lead = aSeed * 0.35;
      float m = clamp((uMorph - lead) / (1.0 - lead * 0.5), 0.0, 1.0);
      m = m * m * (3.0 - 2.0 * m);
      vec3 p = mix(pa, pb, m);

      /* Billboard: offset in view space so every quad faces the camera. */
      vec4 mv = uView * vec4(p, 1.0);
      float size = 0.10 + aSeed * 0.17;
      mv.xy += aCorner * size;
      /* Slide the world into the scene column so it frames the copy rather
       * than sitting on top of it. Zero on narrow screens, where the layout
       * stacks and there is no column to sit beside. */
      mv.x += uShift;

      gl_Position = uProj * mv;

      float dist = -mv.z;
      vGlow = smoothstep(40.0, 3.0, dist);
      vTone = fract(aSeed + m * 0.35);
      vUv = aCorner;
    }
  `;

  const FRAG = `
    precision mediump float;
    uniform vec3 uC1;
    uniform vec3 uC2;
    uniform vec3 uC3;
    uniform float uAlpha;
    varying float vTone;
    varying float vGlow;
    varying vec2 vUv;

    void main() {
      float r = dot(vUv, vUv) * 4.0;
      if (r > 1.0) discard;
      float a = smoothstep(1.0, 0.0, r);
      vec3 col = mix(uC1, uC2, smoothstep(0.0, 0.55, vTone));
      col = mix(col, uC3, smoothstep(0.62, 1.0, vTone));
      gl_FragColor = vec4(col, a * vGlow * uAlpha);
    }
  `;

  type Handle = { stop: () => void };
  let handles: Handle[] = [];

  function compile(gl: WebGLRenderingContext, type: number, src: string) {
    const sh = gl.createShader(type);
    if (!sh) return null;
    gl.shaderSource(sh, src);
    gl.compileShader(sh);
    if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
      gl.deleteShader(sh);
      return null;
    }
    return sh;
  }

  /** Column-major perspective, the same one every GL tutorial derives. */
  function perspective(out: Float32Array, fovy: number, aspect: number, near: number, far: number) {
    const f = 1 / Math.tan(fovy / 2);
    out.fill(0);
    out[0] = f / aspect;
    out[5] = f;
    out[10] = (far + near) / (near - far);
    out[11] = -1;
    out[14] = (2 * far * near) / (near - far);
    return out;
  }

  /** Look-at with an assumed +Y up; the camera never rolls, so that is enough. */
  function lookAt(out: Float32Array, ex: number, ey: number, ez: number) {
    // Target is always the origin — the world is built around it.
    let zx = ex,
      zy = ey,
      zz = ez;
    let len = Math.hypot(zx, zy, zz) || 1;
    zx /= len;
    zy /= len;
    zz /= len;
    // x = normalize(cross(up, z)), up = (0, 1, 0)  ->  (z.z, 0, -z.x)
    let xx = zz,
      xy = 0,
      xz = -zx;
    len = Math.hypot(xx, xy, xz) || 1;
    xx /= len;
    xy /= len;
    xz /= len;
    // y = cross(z, x)
    const yx = zy * xz - zz * xy;
    const yy = zz * xx - zx * xz;
    const yz = zx * xy - zy * xx;

    out[0] = xx; out[1] = yx; out[2] = zx; out[3] = 0;
    out[4] = xy; out[5] = yy; out[6] = zy; out[7] = 0;
    out[8] = xz; out[9] = yz; out[10] = zz; out[11] = 0;
    out[12] = -(xx * ex + xy * ey + xz * ez);
    out[13] = -(yx * ex + yy * ey + yz * ez);
    out[14] = -(zx * ex + zy * ey + zz * ez);
    out[15] = 1;
    return out;
  }

  function readColor(probe: HTMLElement, token: string): [number, number, number] {
    probe.style.color = `var(${token})`;
    const m = getComputedStyle(probe).color.match(/[\d.]+/g);
    if (!m || m.length < 3) return [0.06, 0.77, 0.64];
    return [Number(m[0]) / 255, Number(m[1]) / 255, Number(m[2]) / 255];
  }

  function start(root: HTMLElement): Handle | null {
    const canvas = root.querySelector<HTMLCanvasElement>('.acts-field__canvas');
    const stage = root.closest<HTMLElement>('.acts-stage');
    if (!canvas || !stage) return null;

    /* One formation per act, in document order. Deriving the formation from a
     * single progress value across the whole stage drifted out of step, because
     * the acts are not all the same height and the closing gallery does not
     * pin at all. Reading each section's own rect keeps the world locked to
     * whatever the reader is actually looking at. */
    const scenes = Array.from(
      stage.querySelectorAll<HTMLElement>('.acts-stage__content > section'),
    );
    if (!scenes.length) return null;

    let gl: WebGLRenderingContext | null = null;
    try {
      gl = canvas.getContext('webgl', {
        alpha: true,
        antialias: false,
        depth: false,
        premultipliedAlpha: false,
      }) as WebGLRenderingContext | null;
    } catch {
      gl = null;
    }
    if (!gl) return null;
    const ctx = gl;

    const instanced = ctx.getExtension('ANGLE_instanced_arrays');
    if (!instanced) return null;

    const vs = compile(ctx, ctx.VERTEX_SHADER, VERT);
    const fs = compile(ctx, ctx.FRAGMENT_SHADER, FRAG);
    const prog = ctx.createProgram();
    if (!vs || !fs || !prog) return null;
    ctx.attachShader(prog, vs);
    ctx.attachShader(prog, fs);
    ctx.linkProgram(prog);
    if (!ctx.getProgramParameter(prog, ctx.LINK_STATUS)) return null;
    ctx.useProgram(prog);
    ctx.deleteShader(vs);
    ctx.deleteShader(fs);

    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const count = coarse || window.innerWidth < 900 ? COUNT_NARROW : COUNT_WIDE;

    // One quad, reused by every instance.
    const quad = new Float32Array([-0.5, -0.5, 0.5, -0.5, -0.5, 0.5, 0.5, 0.5]);
    const quadBuf = ctx.createBuffer();
    ctx.bindBuffer(ctx.ARRAY_BUFFER, quadBuf);
    ctx.bufferData(ctx.ARRAY_BUFFER, quad, ctx.STATIC_DRAW);
    const aCorner = ctx.getAttribLocation(prog, 'aCorner');
    ctx.enableVertexAttribArray(aCorner);
    ctx.vertexAttribPointer(aCorner, 2, ctx.FLOAT, false, 0, 0);

    // Per-instance id + seed. Deterministic LCG so the world is identical on
    // every load and nothing depends on Math.random ordering.
    const inst = new Float32Array(count * 2);
    let s = 0x9e3779b1;
    for (let i = 0; i < count; i++) {
      s = (s * 1664525 + 1013904223) >>> 0;
      inst[i * 2] = i;
      inst[i * 2 + 1] = s / 4294967296;
    }
    const instBuf = ctx.createBuffer();
    ctx.bindBuffer(ctx.ARRAY_BUFFER, instBuf);
    ctx.bufferData(ctx.ARRAY_BUFFER, inst, ctx.STATIC_DRAW);
    const aId = ctx.getAttribLocation(prog, 'aId');
    const aSeed = ctx.getAttribLocation(prog, 'aSeed');
    ctx.enableVertexAttribArray(aId);
    ctx.vertexAttribPointer(aId, 1, ctx.FLOAT, false, 8, 0);
    instanced.vertexAttribDivisorANGLE(aId, 1);
    ctx.enableVertexAttribArray(aSeed);
    ctx.vertexAttribPointer(aSeed, 1, ctx.FLOAT, false, 8, 4);
    instanced.vertexAttribDivisorANGLE(aSeed, 1);

    const u = (n: string) => ctx.getUniformLocation(prog, n);
    const uProj = u('uProj');
    const uView = u('uView');
    const uN = u('uN');
    const uFormA = u('uFormA');
    const uFormB = u('uFormB');
    const uMorph = u('uMorph');
    const uTime = u('uTime');
    const uAlpha = u('uAlpha');
    const uShift = u('uShift');
    const uC1 = u('uC1');
    const uC2 = u('uC2');
    const uC3 = u('uC3');
    ctx.uniform1f(uN, count);

    const proj = new Float32Array(16);
    const view = new Float32Array(16);

    const probe = document.createElement('span');
    probe.style.cssText = 'position:absolute;opacity:0;pointer-events:none';
    root.appendChild(probe);

    function paintTheme() {
      ctx.uniform3fv(uC1, readColor(probe, '--color-brand-400'));
      ctx.uniform3fv(uC2, readColor(probe, '--color-sky-500'));
      ctx.uniform3fv(uC3, readColor(probe, '--color-accent-400'));
    }
    ctx.enable(ctx.BLEND);
    // Always additive: this canvas only ever sits on the stage's dark ink.
    ctx.blendFunc(ctx.SRC_ALPHA, ctx.ONE);
    paintTheme();

    let dpr = 1;
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, coarse ? 1.5 : 2);
      const w = window.innerWidth;
      const h = window.innerHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx.viewport(0, 0, canvas!.width, canvas!.height);
      perspective(proj, 0.85, w / h, 0.1, 120);
      ctx.uniformMatrix4fv(uProj, false, proj);
      ctx.uniform1f(uShift, w >= 1024 ? 3.0 : 0);
    }
    resize();

    let frame = 0;
    let running = true;
    let t0 = 0;

    function draw(now: number) {
      frame = 0;
      if (!running) return;
      if (!t0) t0 = now;
      const seconds = (now - t0) / 1000;

      const rect = stage!.getBoundingClientRect();
      const vh = window.innerHeight;

      // Fade the world in and out at the stage's edges so it never bleeds onto
      // the hero above or the conversion sections below.
      const enter = Math.min(1, Math.max(0, (vh - rect.top) / (vh * 0.5)));
      const exit = Math.min(1, Math.max(0, rect.bottom / (vh * 0.5)));
      const presence = Math.min(enter, exit);
      root.style.opacity = String(presence);

      if (presence <= 0.001) {
        frame = requestAnimationFrame(draw);
        return;
      }

      // Which scene owns the middle of the viewport, and how far through it we
      // are. Hold the formation while it is being read, then flow into the next.
      const mid = vh * 0.5;
      let a = 0;
      let local = 0;
      for (let i = 0; i < scenes.length; i++) {
        const r = scenes[i].getBoundingClientRect();
        if (r.top <= mid && r.bottom >= mid) {
          a = i;
          local = Math.min(1, Math.max(0, (mid - r.top) / Math.max(r.height, 1)));
          break;
        }
        if (r.top > mid) break;
        a = i;
        local = 1;
      }
      const last = scenes.length - 1;
      const morph = Math.min(1, Math.max(0, (local - 0.62) / 0.38));
      // Overall progress, for the camera path.
      const p = Math.min(1, Math.max(0, (a + local) / Math.max(last, 1)));

      /* Formation 0 is the raw dust the world starts as, so section i gets
       * formation i + 1: widget→slab, canvas→four planes, connectors→ring,
       * bots→fan-out, agents→orbiting harness. */
      ctx.uniform1f(uFormA, Math.min(a + 1, 5));
      ctx.uniform1f(uFormB, Math.min(a + 2, 5));
      ctx.uniform1f(uMorph, morph);
      ctx.uniform1f(uTime, seconds);
      ctx.uniform1f(uAlpha, 0.72);

      // A camera that orbits as it dollies — this is what makes it read as a
      // world you are moving through rather than a picture that fades.
      const ang = -0.65 + p * 1.5;
      const dist = 19 - p * 4.5 + Math.sin(seconds * 0.25) * 0.4;
      lookAt(
        view,
        Math.sin(ang) * dist,
        4.0 * Math.sin(p * 3.4) + 1.2,
        Math.cos(ang) * dist,
      );
      ctx.uniformMatrix4fv(uView, false, view);

      ctx.clearColor(0, 0, 0, 0);
      ctx.clear(ctx.COLOR_BUFFER_BIT);
      instanced!.drawArraysInstancedANGLE(ctx.TRIANGLE_STRIP, 0, 4, count);
      frame = requestAnimationFrame(draw);
    }
    frame = requestAnimationFrame(draw);

    function onVisibility() {
      if (document.hidden) {
        running = false;
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
      } else if (!running) {
        running = true;
        t0 = 0;
        frame = requestAnimationFrame(draw);
      }
    }
    function onLost(e: Event) {
      e.preventDefault();
      running = false;
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      root.style.opacity = '0';
    }

    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', onVisibility);
    document.addEventListener('nexow:themechange', paintTheme);
    canvas.addEventListener('webglcontextlost', onLost);

    return {
      stop() {
        running = false;
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        window.removeEventListener('resize', resize);
        document.removeEventListener('visibilitychange', onVisibility);
        document.removeEventListener('nexow:themechange', paintTheme);
        canvas.removeEventListener('webglcontextlost', onLost);
        probe.remove();
        ctx.deleteBuffer(quadBuf);
        ctx.deleteBuffer(instBuf);
        ctx.deleteProgram(prog);
        ctx.getExtension('WEBGL_lose_context')?.loseContext();
      },
    };
  }

  function teardown() {
    for (const h of handles) h.stop();
    handles = [];
  }

  function init() {
    teardown();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    for (const root of document.querySelectorAll<HTMLElement>('.acts-field')) {
      const h = start(root);
      if (h) handles.push(h);
    }
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>

<style>
  .acts-field {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    /* The copy lives on the inline-start half. Dim the world there rather than
     * cutting it, so text stays comfortable to read while the scene still
     * wraps behind it. Mirrored for RTL below. */
    -webkit-mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.32),
      rgba(0, 0, 0, 0.40) 26%,
      #000 52%
    );
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.32),
      rgba(0, 0, 0, 0.40) 26%,
      #000 52%
    );
    /* No transition: opacity is written every frame from the stage's position,
     * and a transition would fight the scroll. */
  }

  :global([dir='rtl']) .acts-field {
    -webkit-mask-image: linear-gradient(
      to left,
      rgba(0, 0, 0, 0.32),
      rgba(0, 0, 0, 0.40) 26%,
      #000 52%
    );
    mask-image: linear-gradient(
      to left,
      rgba(0, 0, 0, 0.32),
      rgba(0, 0, 0, 0.40) 26%,
      #000 52%
    );
  }

  .acts-field__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
