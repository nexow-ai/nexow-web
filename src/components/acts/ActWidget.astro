---
/**
 * Act I — copy only. The playground SVG lives once in `PlaygroundSpan` and
 * stays on screen through Act II.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = useContent(lang).home.acts!.widget;
---

<Act id="widget" labelledBy="act-widget-title" height="205vh" class="tone-invert">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <ActCopyBlock copy={copy} headingId="act-widget-title" />
    <div class="act-scene pg-slot" aria-hidden="true"></div>
  </div>
</Act>

<style>
  .pg-slot {
    aspect-ratio: 640 / 400;
    width: 100%;
  }

  @media (max-width: 767.98px) {
    .pg-slot {
      display: none;
    }
  }
</style>
