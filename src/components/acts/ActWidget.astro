---
/**
 * Act I — a sentence becomes a running widget.
 *
 * The scene is the same playground chrome as the features page: type a prompt,
 * get a live set of widgets. The SVG runs that loop on its own clock — type,
 * generate, land, hold, reset — independent of the act's scroll ramps. The
 * copy beside it still lights beat by beat. Decorative, so it stays out of
 * the a11y tree. Reduced motion parks on the finished playground.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { ICON_PATHS } from '../icon-paths';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const copy = c.home.acts!.widget;
const prompt = c.home.hero.promptExample;

/** Fixed 7×5 fortnight of streak intensities — identical every render. */
const CELLS = [
  2, 3, 1, 0, 3, 2, 1, 0, 2, 3, 3, 1, 2, 0, 3, 2, 0, 1, 3, 2, 3, 1, 2, 2, 0, 3,
  1, 3, 2, 1, 0, 2, 3, 1, 2,
];

const TABS = [
  { label: 'Playground', on: true },
  { label: 'Markets', on: false },
  { label: 'Habits', on: false },
  { label: 'Research', on: false },
];

const WORKSPACES = [
  { label: 'Personal', tint: 'var(--color-brand-400)', on: true },
  { label: 'Trading', tint: 'var(--color-accent-400)', on: false },
  { label: 'Markets', tint: 'var(--color-sky-400)', on: false },
];

const MOOD = [
  { x: 144, y: 184, w: 148, h: 88, fill: 'var(--w-mood-1)' },
  { x: 300, y: 184, w: 68, h: 52, fill: 'var(--w-mood-2)' },
  { x: 376, y: 184, w: 56, h: 52, fill: 'var(--w-mood-3)' },
  { x: 300, y: 244, w: 132, h: 28, fill: 'var(--w-mood-4)' },
];

const GAME = [1, 8, 12, 4, 6, 13];
---

<Act id="widget" labelledBy="act-widget-title" height="205vh">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <ActCopyBlock copy={copy} headingId="act-widget-title" />

    <div class="act-scene w-scene" aria-hidden="true">
      <div class="w-slab"></div>
      <svg
        class="w-art"
        viewBox="0 0 640 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="presentation"
      >
        <defs>
          <pattern id="w-dots" width="14" height="14" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.7" fill="var(--w-dot)"></circle>
          </pattern>
          <clipPath id="w-frame-clip">
            <rect x="16" y="16" width="608" height="368" rx="18"></rect>
          </clipPath>
          <clipPath id="w-type-clip">
            <rect class="w-type-mask" x="180" y="80" width="400" height="36"></rect>
          </clipPath>
          <linearGradient id="w-glow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.22"></stop>
            <stop offset="100%" stop-color="var(--color-sky-400)" stop-opacity="0.08"></stop>
          </linearGradient>
          <filter id="w-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="10"></feGaussianBlur>
          </filter>
        </defs>

        <g clip-path="url(#w-frame-clip)">
          <rect x="16" y="16" width="608" height="368" rx="18" fill="var(--w-panel)"></rect>
          <rect x="16" y="16" width="608" height="368" rx="18" fill="url(#w-dots)" opacity="0.55"></rect>

          <!-- Header -->
          <rect x="16" y="16" width="608" height="40" fill="var(--w-panel-2)"></rect>
          <line x1="16" y1="56" x2="624" y2="56" stroke="var(--w-line)" stroke-width="1"></line>

          <image href="/favicon.png" x="28" y="26" width="16" height="16"></image>

          {
            TABS.map((tab, i) => (
              <g
                class:list={[!tab.on && 'w-tab-loop']}
                style={!tab.on ? `--i:${i - 1}` : undefined}
                transform={`translate(${56 + i * 76} 32)`}
              >
                <rect
                  x="0"
                  y="0"
                  width="70"
                  height="24"
                  rx="6"
                  fill={tab.on ? 'var(--w-tab-on)' : 'var(--w-tab)'}
                />
                <text
                  x="35"
                  y="16"
                  text-anchor="middle"
                  class="w-label"
                  fill={tab.on ? 'var(--w-text)' : 'var(--w-text-4)'}
                >
                  {tab.label}
                </text>
              </g>
            ))
          }

          <g class="w-add">
            <rect x="360" y="34" width="20" height="20" rx="5" stroke="var(--w-line)" stroke-dasharray="2 2"></rect>
            <path d="M370 39v10M365 44h10" stroke="var(--w-text-4)" stroke-width="1.4" stroke-linecap="round"></path>
          </g>

          <g transform="translate(490 28)">
            <circle cx="11" cy="11" r="11" fill="var(--color-accent-500)"></circle>
            <text x="11" y="15" text-anchor="middle" class="w-avatar">N</text>
            <text x="28" y="15" class="w-handle">@nova.eth</text>
            <path d="M98 8l4 4 4-4" stroke="var(--w-accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
          </g>

          <!-- Workspace rail -->
          <rect x="16" y="56" width="96" height="328" fill="var(--w-rail-bg)"></rect>
          <line x1="112" y1="56" x2="112" y2="384" stroke="var(--w-line)" stroke-width="1"></line>
          <text x="28" y="76" class="w-tiny" fill="var(--w-text-4)">WORKSPACES</text>

          {
            WORKSPACES.map((ws, i) => (
              <g
                class:list={[!ws.on && 'w-ws-loop']}
                style={!ws.on ? `--i:${i - 1}` : undefined}
                transform={`translate(24 ${88 + i * 28})`}
              >
                <rect
                  x="0"
                  y="0"
                  width="72"
                  height="22"
                  rx="6"
                  fill={ws.on ? 'var(--w-tab-on)' : 'transparent'}
                />
                <circle cx="12" cy="11" r="3" fill={ws.tint}></circle>
                <text
                  x="22"
                  y="15"
                  class="w-label"
                  fill={ws.on ? 'var(--w-accent)' : 'var(--w-text-4)'}
                >
                  {ws.label}
                </text>
              </g>
            ))
          }

          <g class="w-add">
            <rect x="24" y="176" width="22" height="22" rx="5" stroke="var(--color-brand-400)" stroke-opacity="0.55"></rect>
            <path d="M35 182v10M30 187h10" stroke="var(--color-brand-400)" stroke-width="1.4" stroke-linecap="round"></path>
          </g>

          <!-- Prompt — types on the shared loop, not on scroll. -->
          <g>
            <ellipse class="w-glow" cx="360" cy="100" rx="180" ry="46" fill="url(#w-glow)" filter="url(#w-soft)"></ellipse>
            <rect x="128" y="70" width="476" height="56" rx="14" class="w-card"></rect>
            <rect x="140" y="82" width="32" height="32" rx="8" fill="var(--w-icon-bg)"></rect>
            <g class="w-spark" transform="translate(146 88) scale(0.85)" stroke="var(--color-brand-400)" stroke-width="1.7" fill="none">
              <path d={ICON_PATHS.sparkles}></path>
            </g>
            <g clip-path="url(#w-type-clip)">
              <foreignObject x="180" y="82" width="400" height="36">
                <p xmlns="http://www.w3.org/1999/xhtml" class="w-prompt">{prompt}</p>
              </foreignObject>
            </g>
            <g class="w-caret">
              <rect class="w-caret-bar" x="180" y="86" width="2" height="18" rx="1" fill="var(--color-brand-400)"></rect>
            </g>
          </g>

          <g class="w-source">
            <text x="136" y="148" class="w-tiny" fill="var(--w-accent)">GENERATING</text>
            {[0, 1, 2, 3].map((i) => (
              <rect
                class="w-src-bar"
                style={`--i:${i}`}
                x="128"
                y={156 + i * 10}
                width={80 + i * 52}
                height="5"
                rx="2.5"
                fill="var(--w-src)"
              />
            ))}
          </g>

          <g class="w-widget" style="--i:0">
            <rect x="128" y="148" width="320" height="216" rx="14" class="w-card"></rect>
            <text x="144" y="172" class="w-card-title" fill="var(--w-text)">Moodboard</text>
            <rect x="400" y="158" width="32" height="8" rx="4" fill="var(--color-brand-400)" opacity="0.85"></rect>
            {MOOD.map((tile) => (
              <rect x={tile.x} y={tile.y} width={tile.w} height={tile.h} rx="8" fill={tile.fill}></rect>
            ))}
            <text x="144" y="348" class="w-note" fill="var(--w-text-4)">calm · clear</text>
          </g>

          <g class="w-widget" style="--i:1">
            <rect x="460" y="148" width="144" height="100" rx="14" class="w-card"></rect>
            <text x="472" y="168" class="w-card-title" fill="var(--w-text)">Habits</text>
            <text x="560" y="168" class="w-tiny" fill="var(--w-accent)">6/8</text>
            {CELLS.slice(0, 21).map((v, i) => (
              <rect
                x={472 + (i % 7) * 16}
                y={178 + Math.floor(i / 7) * 16}
                width="13"
                height="13"
                rx="2.5"
                fill="var(--color-brand-400)"
                opacity={0.12 + v * 0.26}
              />
            ))}
          </g>

          <g class="w-widget" style="--i:2">
            <rect x="460" y="260" width="144" height="104" rx="14" class="w-card"></rect>
            <text x="472" y="280" class="w-card-title" fill="var(--w-text)">Mini game</text>
            {Array.from({ length: 15 }).map((_, i) => (
              <rect
                x={472 + (i % 5) * 22}
                y={292 + Math.floor(i / 5) * 20}
                width="18"
                height="16"
                rx="3"
                fill={GAME.includes(i) ? 'var(--color-sky-400)' : 'var(--w-cell)'}
                opacity={GAME.includes(i) ? 0.7 : 0.45}
              />
            ))}
          </g>
        </g>

        <rect
          x="16"
          y="16"
          width="608"
          height="368"
          rx="18"
          stroke="var(--w-chrome)"
          stroke-width="1.4"
        ></rect>
      </svg>
    </div>
  </div>
</Act>

<style>
  .w-scene {
    position: relative;
    perspective: 880px;
    perspective-origin: 50% 42%;
  }

  .w-slab {
    position: absolute;
    inset: auto 8% -8% 8%;
    height: 42%;
    border-radius: 1.25rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 28%, transparent),
      transparent 70%
    );
    filter: blur(18px);
    pointer-events: none;
  }

  .w-art {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    filter: drop-shadow(0 28px 60px var(--w-shadow));
    --w-cycle: 12s;
    --w-step: 1.6s;
    --w-e: var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    /* Dark product glass in both themes. The cool look is mint chrome on
       ink; inverting those mixes onto white glass washes every tile into
       pastel. Scoped here so the page copy stays on the light surface. */
    --w-text: #fff;
    --w-text-2: var(--color-ink-200);
    --w-text-3: var(--color-ink-100);
    --w-text-4: var(--color-ink-300);
    --w-accent: var(--color-brand-300);
    --w-line: rgba(255, 255, 255, 0.12);
    --w-panel: rgba(9, 12, 20, 0.94);
    --w-panel-2: rgba(255, 255, 255, 0.05);
    --w-dot: rgba(255, 255, 255, 0.14);
    --w-tab: rgba(255, 255, 255, 0.06);
    --w-tab-on: color-mix(in oklab, var(--color-brand-400) 32%, transparent);
    --w-rail-bg: rgba(255, 255, 255, 0.035);
    --w-icon-bg: color-mix(in oklab, var(--color-brand-400) 22%, transparent);
    --w-src: color-mix(in oklab, var(--color-brand-400) 45%, var(--color-accent-500));
    --w-cell: rgba(255, 255, 255, 0.08);
    --w-chrome: color-mix(in oklab, var(--color-brand-400) 70%, rgba(255, 255, 255, 0.16));
    --w-mood-1: color-mix(in oklab, var(--color-brand-400) 48%, transparent);
    --w-mood-2: color-mix(in oklab, var(--color-accent-400) 52%, transparent);
    --w-mood-3: color-mix(in oklab, var(--color-sky-400) 46%, transparent);
    --w-mood-4: color-mix(in oklab, var(--color-brand-300) 28%, transparent);
  }

  :global(html:not(.dark)) .w-art {
    --w-shadow: rgba(15, 23, 42, 0.4);
    --w-panel: rgba(9, 12, 20, 0.96);
  }

  :global(html:not(.dark)) .w-slab {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 44%, transparent),
      transparent 70%
    );
  }

  .w-card {
    fill: var(--w-panel-2);
    stroke: var(--w-line);
    stroke-width: 1;
  }

  .w-label,
  .w-handle,
  .w-card-title,
  .w-tiny,
  .w-note,
  .w-avatar {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .w-label {
    font-size: 9px;
  }

  .w-handle {
    font-size: 10px;
    fill: var(--w-accent);
  }

  .w-avatar {
    font-size: 9px;
    font-weight: 700;
    fill: #fff;
    font-family: var(--font-display, ui-sans-serif);
  }

  .w-card-title {
    font-size: 11px;
    font-weight: 600;
  }

  .w-tiny {
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .w-note {
    font-size: 9px;
  }

  .w-prompt {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    line-height: 32px;
    white-space: nowrap;
    color: var(--w-text-3);
  }

  .w-type-mask,
  .w-caret,
  .w-widget,
  .w-source,
  .w-tab-loop,
  .w-ws-loop,
  .w-glow,
  .w-spark {
    transform-box: fill-box;
    transform-origin: center;
  }

  .w-type-mask {
    transform-origin: left center;
  }

  .w-caret {
    transform-origin: left center;
  }

  /* At rest — finished playground. The loop below only runs when motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .w-type-mask {
      animation: w-type var(--w-cycle) steps(22, end) infinite;
    }

    .w-caret {
      animation: w-caret-move var(--w-cycle) steps(22, end) infinite;
    }

    .w-caret-bar {
      animation: w-blink 0.9s steps(2, start) infinite;
    }

    .w-source {
      animation: w-source var(--w-cycle) var(--w-e) infinite;
    }

    .w-src-bar {
      transform-box: fill-box;
      transform-origin: left center;
      animation: w-src-bar var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }

    .w-widget {
      animation: w-widget var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.18s);
    }

    .w-tab-loop {
      animation: w-tab-life calc(var(--w-step) * 6) var(--w-e) infinite both;
      animation-delay: calc(var(--i) * var(--w-step));
    }

    .w-ws-loop {
      animation: w-ws-life calc(var(--w-step) * 6) var(--w-e) infinite both;
      animation-delay: calc(var(--i) * var(--w-step) + var(--w-step) / 2);
    }

    .w-add {
      animation: w-add-flash var(--w-step) ease-out infinite;
    }

    .w-glow {
      animation: w-glow var(--w-cycle) ease-in-out infinite;
    }

    .w-spark {
      animation: w-spark 2.4s ease-in-out infinite;
    }
  }

  /* Type 0–22%, hold through the widgets, wipe 90–100%. */
  @keyframes w-type {
    0% {
      transform: scaleX(0.02);
    }
    22%,
    88% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0.02);
    }
  }

  @keyframes w-caret-move {
    0% {
      transform: translateX(0);
      opacity: 1;
    }
    22% {
      transform: translateX(360px);
      opacity: 1;
    }
    24%,
    88% {
      transform: translateX(360px);
      opacity: 0;
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes w-blink {
    50% {
      opacity: 0;
    }
  }

  /* Generating sits between the typed prompt and the widgets. */
  @keyframes w-source {
    0%,
    20% {
      opacity: 0;
    }
    24%,
    34% {
      opacity: 1;
    }
    40%,
    100% {
      opacity: 0;
    }
  }

  @keyframes w-src-bar {
    0%,
    22% {
      transform: scaleX(0.08);
    }
    28%,
    36% {
      transform: scaleX(1);
    }
    42%,
    100% {
      transform: scaleX(0.08);
    }
  }

  @keyframes w-widget {
    0%,
    34% {
      opacity: 0;
      transform: translateY(14px) scale(0.96);
    }
    42%,
    88% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  @keyframes w-tab-life {
    0% {
      opacity: 0;
      transform: translateY(6px);
    }
    8%,
    70% {
      opacity: 1;
      transform: none;
    }
    80%,
    100% {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes w-ws-life {
    0% {
      opacity: 0;
      transform: translateX(-8px);
    }
    6%,
    24% {
      opacity: 1;
      transform: none;
    }
    30%,
    100% {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  @keyframes w-add-flash {
    0% {
      opacity: 1;
    }
    28%,
    100% {
      opacity: 0.45;
    }
  }

  @keyframes w-glow {
    0%,
    18% {
      opacity: 0.35;
    }
    28%,
    70% {
      opacity: 1;
    }
    90%,
    100% {
      opacity: 0.35;
    }
  }

  @keyframes w-spark {
    0%,
    100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w-type-mask,
    .w-caret,
    .w-caret-bar,
    .w-source,
    .w-src-bar,
    .w-widget,
    .w-tab-loop,
    .w-ws-loop,
    .w-add,
    .w-glow,
    .w-spark {
      animation: none !important;
    }

    .w-source {
      opacity: 0;
    }
  }
</style>
