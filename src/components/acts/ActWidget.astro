---
/**
 * Act I — a sentence becomes a running widget.
 *
 * The scene is the same playground chrome as the features page: type a prompt,
 * get a live set of widgets. The SVG runs that loop on its own clock — type,
 * generate, land, live, reset — independent of the act's scroll ramps. After
 * the cards land they keep working: the moodboard breathes, the heatmap fills,
 * the memory game matches pairs. Decorative, so it stays out of the a11y tree.
 * Reduced motion parks on the finished playground.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import { ICON_PATHS } from '../icon-paths';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const copy = c.home.acts!.widget;
const prompt = c.home.hero.promptExample;

/** Four weeks of streak intensities — a monthly heatmap, not a fortnight. */
const CELLS = [
  2, 3, 1, 0, 3, 2, 1, 0, 2, 3, 3, 1, 2, 0, 3, 2, 0, 1, 3, 2, 3, 1, 2, 2, 0, 3,
  1, 3, 2, 1,
];

const TABS = [
  { label: 'Playground', on: true },
  { label: 'Markets', on: false },
  { label: 'Habits', on: false },
  { label: 'Research', on: false },
];

const WORKSPACES = [
  { label: 'Personal', tint: 'var(--color-brand-400)', on: true },
  { label: 'Trading', tint: 'var(--color-accent-400)', on: false },
  { label: 'Markets', tint: 'var(--color-sky-400)', on: false },
];

const MOOD = [
  { x: 144, y: 176, w: 148, h: 72, fill: 'var(--w-mood-1)' },
  { x: 300, y: 176, w: 68, h: 40, fill: 'var(--w-mood-2)' },
  { x: 376, y: 176, w: 56, h: 40, fill: 'var(--w-mood-3)' },
  { x: 300, y: 224, w: 132, h: 24, fill: 'var(--w-mood-4)' },
];

const SWATCHES = [
  { x: 144, fill: 'var(--color-brand-400)' },
  { x: 166, fill: 'var(--color-accent-400)' },
  { x: 188, fill: 'var(--color-sky-400)' },
  { x: 210, fill: 'var(--color-brand-300)' },
];

/** Eight memory cards in 4×2. `pair` is which two flip together. */
const MEMORY = [
  { col: 0, row: 0, pair: 0 },
  { col: 1, row: 0, pair: 1 },
  { col: 2, row: 0, pair: 0 },
  { col: 3, row: 0, pair: 2 },
  { col: 0, row: 1, pair: 1 },
  { col: 1, row: 1, pair: 3 },
  { col: 2, row: 1, pair: 2 },
  { col: 3, row: 1, pair: 3 },
];

const PAIR_FILL = [
  'var(--color-brand-400)',
  'var(--color-accent-400)',
  'var(--color-sky-400)',
  'var(--color-brand-300)',
];

const SPARK = [28, 36, 32, 44, 50, 41, 56, 62, 54, 68, 74, 70];
const sparkPath = SPARK.map((v, i) => `${i ? 'L' : 'M'}${152 + i * 22} ${318 - v * 0.7}`).join(' ');
---

<Act id="widget" labelledBy="act-widget-title" height="205vh">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <ActCopyBlock copy={copy} headingId="act-widget-title" />

    <div class="act-scene w-scene" aria-hidden="true">
      <div class="w-slab"></div>
      <svg
        class="w-art"
        viewBox="0 0 640 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="presentation"
      >
        <defs>
          <pattern id="w-dots" width="14" height="14" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.7" fill="var(--w-dot)"></circle>
          </pattern>
          <clipPath id="w-frame-clip">
            <rect x="16" y="16" width="608" height="368" rx="18"></rect>
          </clipPath>
          <clipPath id="w-type-clip">
            <rect class="w-type-mask" x="180" y="80" width="400" height="36"></rect>
          </clipPath>
          <linearGradient id="w-glow" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.22"></stop>
            <stop offset="100%" stop-color="var(--color-sky-400)" stop-opacity="0.08"></stop>
          </linearGradient>
          <filter id="w-soft" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="10"></feGaussianBlur>
          </filter>
        </defs>

        <g clip-path="url(#w-frame-clip)">
          <rect x="16" y="16" width="608" height="368" rx="18" fill="var(--w-panel)"></rect>
          <rect x="16" y="16" width="608" height="368" rx="18" fill="url(#w-dots)" opacity="0.55"></rect>

          <!-- Header -->
          <rect x="16" y="16" width="608" height="40" fill="var(--w-panel-2)"></rect>
          <line x1="16" y1="56" x2="624" y2="56" stroke="var(--w-line)" stroke-width="1"></line>

          <image href="/favicon.png" x="28" y="26" width="16" height="16"></image>

          {
            TABS.map((tab, i) => (
              <g
                class:list={[!tab.on && 'w-tab-loop']}
                style={!tab.on ? `--i:${i - 1}` : undefined}
                transform={`translate(${56 + i * 76} 32)`}
              >
                <rect
                  x="0"
                  y="0"
                  width="70"
                  height="24"
                  rx="6"
                  fill={tab.on ? 'var(--w-tab-on)' : 'var(--w-tab)'}
                />
                <text
                  x="35"
                  y="16"
                  text-anchor="middle"
                  class="w-label"
                  fill={tab.on ? 'var(--w-text)' : 'var(--w-text-4)'}
                >
                  {tab.label}
                </text>
              </g>
            ))
          }

          <g class="w-add">
            <rect x="360" y="34" width="20" height="20" rx="5" stroke="var(--w-line)" stroke-dasharray="2 2"></rect>
            <path d="M370 39v10M365 44h10" stroke="var(--w-text-4)" stroke-width="1.4" stroke-linecap="round"></path>
          </g>

          <g transform="translate(490 28)">
            <circle cx="11" cy="11" r="11" fill="var(--color-accent-500)"></circle>
            <text x="11" y="15" text-anchor="middle" class="w-avatar">N</text>
            <text x="28" y="15" class="w-handle">@nova.eth</text>
            <path d="M98 8l4 4 4-4" stroke="var(--w-accent)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
          </g>

          <!-- Workspace rail -->
          <rect x="16" y="56" width="96" height="328" fill="var(--w-rail-bg)"></rect>
          <line x1="112" y1="56" x2="112" y2="384" stroke="var(--w-line)" stroke-width="1"></line>
          <text x="28" y="76" class="w-tiny" fill="var(--w-text-4)">WORKSPACES</text>

          {
            WORKSPACES.map((ws, i) => (
              <g
                class:list={[!ws.on && 'w-ws-loop']}
                style={!ws.on ? `--i:${i - 1}` : undefined}
                transform={`translate(24 ${88 + i * 28})`}
              >
                <rect
                  x="0"
                  y="0"
                  width="72"
                  height="22"
                  rx="6"
                  fill={ws.on ? 'var(--w-tab-on)' : 'transparent'}
                />
                <circle cx="12" cy="11" r="3" fill={ws.tint}></circle>
                <text
                  x="22"
                  y="15"
                  class="w-label"
                  fill={ws.on ? 'var(--w-accent)' : 'var(--w-text-4)'}
                >
                  {ws.label}
                </text>
              </g>
            ))
          }

          <g class="w-add">
            <rect x="24" y="176" width="22" height="22" rx="5" stroke="var(--color-brand-400)" stroke-opacity="0.55"></rect>
            <path d="M35 182v10M30 187h10" stroke="var(--color-brand-400)" stroke-width="1.4" stroke-linecap="round"></path>
          </g>

          <!-- Prompt — types on the shared loop, not on scroll. -->
          <g>
            <ellipse class="w-glow" cx="360" cy="100" rx="180" ry="46" fill="url(#w-glow)" filter="url(#w-soft)"></ellipse>
            <rect x="128" y="70" width="476" height="56" rx="14" class="w-card"></rect>
            <rect x="140" y="82" width="32" height="32" rx="8" fill="var(--w-icon-bg)"></rect>
            <g class="w-spark" transform="translate(146 88) scale(0.85)" stroke="var(--color-brand-400)" stroke-width="1.7" fill="none">
              <path d={ICON_PATHS.sparkles}></path>
            </g>
            <g clip-path="url(#w-type-clip)">
              <foreignObject x="180" y="82" width="400" height="36">
                <p xmlns="http://www.w3.org/1999/xhtml" class="w-prompt">{prompt}</p>
              </foreignObject>
            </g>
            <g class="w-caret">
              <rect class="w-caret-bar" x="180" y="86" width="2" height="18" rx="1" fill="var(--color-brand-400)"></rect>
            </g>
          </g>

          <g class="w-source">
            <text x="136" y="148" class="w-tiny" fill="var(--w-accent)">GENERATING</text>
            {[0, 1, 2, 3].map((i) => (
              <rect
                class="w-src-bar"
                style={`--i:${i}`}
                x="128"
                y={156 + i * 10}
                width={80 + i * 52}
                height="5"
                rx="2.5"
                fill="var(--w-src)"
              />
            ))}
          </g>

          <g class="w-widget" style="--i:0">
            <rect x="128" y="148" width="320" height="124" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="144" cy="166" r="3" fill="var(--color-brand-400)"></circle>
            <text x="154" y="170" class="w-card-title" fill="var(--w-text)">Moodboard</text>
            <rect x="392" y="158" width="40" height="8" rx="4" fill="var(--color-brand-400)" opacity="0.85"></rect>
            {
              MOOD.map((tile, i) => (
                <rect
                  class="w-mood-tile"
                  style={`--i:${i}`}
                  x={tile.x}
                  y={tile.y}
                  width={tile.w}
                  height={tile.h}
                  rx="8"
                  fill={tile.fill}
                />
              ))
            }
            <rect class="w-mood-pick" x="144" y="176" width="148" height="72" rx="10"></rect>
            {
              SWATCHES.map((s, i) => (
                <rect
                  class="w-swatch"
                  style={`--i:${i}`}
                  x={s.x}
                  y="254"
                  width="16"
                  height="8"
                  rx="2"
                  fill={s.fill}
                />
              ))
            }
            <text x="240" y="261" class="w-note" fill="var(--w-text-4)">calm · clear</text>
          </g>

          <g class="w-widget" style="--i:1">
            <rect x="460" y="148" width="144" height="124" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="476" cy="166" r="3" fill="var(--color-brand-400)"></circle>
            <text x="486" y="170" class="w-card-title" fill="var(--w-text)">Habits</text>
            <g class="w-streak">
              <text class="w-streak-n" style="--i:0" x="572" y="170" fill="var(--w-accent)">3/8</text>
              <text class="w-streak-n" style="--i:1" x="572" y="170" fill="var(--w-accent)">5/8</text>
              <text class="w-streak-n" style="--i:2" x="572" y="170" fill="var(--w-accent)">6/8</text>
            </g>
            {
              CELLS.slice(0, 28).map((v, i) => (
                <rect
                  class="w-heat"
                  style={`--i:${i};--heat:${0.12 + v * 0.26}`}
                  x={472 + (i % 7) * 16}
                  y={180 + Math.floor(i / 7) * 16}
                  width="13"
                  height="13"
                  rx="2.5"
                  fill="var(--color-brand-400)"
                />
              ))
            }
            <rect class="w-heat-today" x={472 + 6 * 16} y={180 + 3 * 16} width="13" height="13" rx="2.5"></rect>
          </g>

          <g class="w-widget" style="--i:2">
            <rect x="460" y="280" width="144" height="84" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="476" cy="296" r="3" fill="var(--color-sky-400)"></circle>
            <text x="486" y="300" class="w-card-title" fill="var(--w-text)">Memory</text>
            <text class="w-pairs" x="568" y="300" fill="var(--w-accent)">2 pairs</text>
            {
              MEMORY.map((card, i) => {
                const x = 472 + card.col * 30;
                const y = 310 + card.row * 22;
                return (
                  <g class="w-mem" style={`--i:${i};--p:${card.pair}`} transform={`translate(${x} ${y})`}>
                    <rect class="w-mem-back" x="0" y="0" width="26" height="18" rx="4" fill="var(--w-cell)"></rect>
                    <rect
                      class="w-mem-face"
                      x="0"
                      y="0"
                      width="26"
                      height="18"
                      rx="4"
                      fill={PAIR_FILL[card.pair]}
                    ></rect>
                  </g>
                );
              })
            }
          </g>

          <g class="w-widget" style="--i:3">
            <rect x="128" y="280" width="320" height="84" rx="14" class="w-card"></rect>
            <circle class="w-live" cx="144" cy="296" r="3" fill="var(--color-accent-400)"></circle>
            <text x="154" y="300" class="w-card-title" fill="var(--w-text)">Air quality</text>
            <text class="w-kpi" x="400" y="300" fill="var(--w-accent)">AQI 42</text>
            <path class="w-sparkline" d={sparkPath} stroke="var(--color-brand-400)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            {
              SPARK.map((v, i) => (
                <circle
                  class="w-spark-dot"
                  style={`--i:${i}`}
                  cx={152 + i * 22}
                  cy={318 - v * 0.7}
                  r="2.2"
                  fill="var(--color-brand-300)"
                />
              ))
            }
          </g>

          <g class="w-pointer">
            <path d="M0 0l11 9-4.4 1.2 2.2 6.4-3.2 1.2-2.2-6.4L0 14Z" fill="var(--w-text)" stroke="var(--w-panel)" stroke-width="1"></path>
            <circle class="w-click" cx="2" cy="2" r="10"></circle>
          </g>
        </g>

        <rect
          x="16"
          y="16"
          width="608"
          height="368"
          rx="18"
          stroke="var(--w-chrome)"
          stroke-width="1.4"
        ></rect>
      </svg>
    </div>
  </div>
</Act>

<style>
  .w-scene {
    position: relative;
    perspective: 880px;
    perspective-origin: 50% 42%;
  }

  .w-slab {
    position: absolute;
    inset: auto 8% -8% 8%;
    height: 42%;
    border-radius: 1.25rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 28%, transparent),
      transparent 70%
    );
    filter: blur(18px);
    pointer-events: none;
  }

  .w-art {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    filter: drop-shadow(0 28px 60px var(--w-shadow));
    --w-cycle: 16s;
    --w-step: 1.6s;
    --w-e: var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
    /* Dark product glass in both themes. The cool look is mint chrome on
       ink; inverting those mixes onto white glass washes every tile into
       pastel. Scoped here so the page copy stays on the light surface. */
    --w-text: #fff;
    --w-text-2: var(--color-ink-200);
    --w-text-3: var(--color-ink-100);
    --w-text-4: var(--color-ink-300);
    --w-accent: var(--color-brand-300);
    --w-line: rgba(255, 255, 255, 0.12);
    --w-panel: rgba(9, 12, 20, 0.94);
    --w-panel-2: rgba(255, 255, 255, 0.05);
    --w-dot: rgba(255, 255, 255, 0.14);
    --w-tab: rgba(255, 255, 255, 0.06);
    --w-tab-on: color-mix(in oklab, var(--color-brand-400) 32%, transparent);
    --w-rail-bg: rgba(255, 255, 255, 0.035);
    --w-icon-bg: color-mix(in oklab, var(--color-brand-400) 22%, transparent);
    --w-src: color-mix(in oklab, var(--color-brand-400) 45%, var(--color-accent-500));
    --w-cell: rgba(255, 255, 255, 0.08);
    --w-chrome: color-mix(in oklab, var(--color-brand-400) 70%, rgba(255, 255, 255, 0.16));
    --w-mood-1: color-mix(in oklab, var(--color-brand-400) 48%, transparent);
    --w-mood-2: color-mix(in oklab, var(--color-accent-400) 52%, transparent);
    --w-mood-3: color-mix(in oklab, var(--color-sky-400) 46%, transparent);
    --w-mood-4: color-mix(in oklab, var(--color-brand-300) 28%, transparent);
  }

  :global(html:not(.dark)) .w-art {
    --w-shadow: rgba(15, 23, 42, 0.4);
    --w-panel: rgba(9, 12, 20, 0.96);
  }

  :global(html:not(.dark)) .w-slab {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 44%, transparent),
      transparent 70%
    );
  }

  .w-card {
    fill: var(--w-panel-2);
    stroke: var(--w-line);
    stroke-width: 1;
  }

  .w-label,
  .w-handle,
  .w-card-title,
  .w-tiny,
  .w-note,
  .w-avatar,
  .w-streak-n,
  .w-pairs,
  .w-kpi {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .w-label {
    font-size: 9px;
  }

  .w-handle {
    font-size: 10px;
    fill: var(--w-accent);
  }

  .w-avatar {
    font-size: 9px;
    font-weight: 700;
    fill: #fff;
    font-family: var(--font-display, ui-sans-serif);
  }

  .w-card-title {
    font-size: 11px;
    font-weight: 600;
  }

  .w-tiny,
  .w-streak-n,
  .w-pairs,
  .w-kpi {
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .w-note {
    font-size: 9px;
  }

  .w-prompt {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    line-height: 32px;
    white-space: nowrap;
    color: var(--w-text-3);
  }

  .w-type-mask,
  .w-caret,
  .w-widget,
  .w-source,
  .w-tab-loop,
  .w-ws-loop,
  .w-glow,
  .w-spark,
  .w-mood-tile,
  .w-mood-pick,
  .w-swatch,
  .w-heat,
  .w-heat-today,
  .w-mem,
  .w-mem-back,
  .w-mem-face,
  .w-sparkline,
  .w-spark-dot,
  .w-pointer,
  .w-live,
  .w-streak-n {
    transform-box: fill-box;
    transform-origin: center;
  }

  .w-type-mask {
    transform-origin: left center;
  }

  .w-caret {
    transform-origin: left center;
  }

  .w-sparkline {
    transform-origin: left center;
    fill: none;
  }

  .w-mood-pick {
    fill: none;
    stroke: var(--color-brand-300);
    stroke-width: 1.4;
    opacity: 0;
  }

  .w-heat-today {
    fill: none;
    stroke: var(--color-brand-200, var(--color-brand-300));
    stroke-width: 1.3;
  }

  .w-mem-face {
    opacity: 0;
  }

  .w-pointer {
    offset-path: none;
    pointer-events: none;
  }

  .w-click {
    fill: none;
    stroke: var(--color-brand-300);
    stroke-width: 1.2;
    opacity: 0;
  }

  /* At rest — finished playground. The loop below only runs when motion is allowed. */
  @media (prefers-reduced-motion: no-preference) {
    .w-type-mask {
      animation: w-type var(--w-cycle) steps(26, end) infinite;
    }

    .w-caret {
      animation: w-caret-move var(--w-cycle) steps(26, end) infinite;
    }

    .w-caret-bar {
      animation: w-blink 0.9s steps(2, start) infinite;
    }

    .w-source {
      animation: w-source var(--w-cycle) var(--w-e) infinite;
    }

    .w-src-bar {
      transform-box: fill-box;
      transform-origin: left center;
      animation: w-src-bar var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }

    .w-widget {
      animation: w-widget var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.14s);
    }

    .w-tab-loop {
      animation: w-tab-life calc(var(--w-step) * 6) var(--w-e) infinite both;
      animation-delay: calc(var(--i) * var(--w-step));
    }

    .w-ws-loop {
      animation: w-ws-life calc(var(--w-step) * 6) var(--w-e) infinite both;
      animation-delay: calc(var(--i) * var(--w-step) + var(--w-step) / 2);
    }

    .w-add {
      animation: w-add-flash var(--w-step) ease-out infinite;
    }

    .w-glow {
      animation: w-glow var(--w-cycle) ease-in-out infinite;
    }

    .w-spark {
      animation: w-spark 2.4s ease-in-out infinite;
    }

    .w-live {
      animation: w-live 1.6s ease-in-out infinite;
    }

    .w-mood-tile {
      animation: w-mood-breathe 3.2s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.35s);
    }

    .w-mood-pick {
      animation: w-mood-pick var(--w-cycle) var(--w-e) infinite;
    }

    .w-swatch {
      animation: w-swatch var(--w-cycle) ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.7s);
    }

    .w-heat {
      animation: w-heat var(--w-cycle) var(--w-e) infinite;
      animation-delay: calc(var(--i) * 0.035s);
    }

    .w-heat-today {
      animation: w-today var(--w-cycle) ease-in-out infinite;
    }

    .w-streak-n {
      animation: w-streak var(--w-cycle) steps(1, end) infinite;
      animation-delay: calc(var(--i) * 1.8s);
    }

    .w-mem-back {
      animation: w-mem-back var(--w-cycle) var(--w-e) infinite;
