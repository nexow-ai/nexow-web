---
/**
 * Act II — the free-form canvas.
 *
 * Carries the `app-showcase` id because `UseCasePage.astro` links to it from
 * every `/for/*` page. Renaming this section breaks those links and
 * `tests/build/dist.test.ts` will not catch it (it only checks that anchors
 * resolve to a built *page*), so leave the id alone.
 *
 * Continues the widgets that Act I just generated. Scroll lays them onto a
 * screen, groups the ones that belong together, then draws Links. Same dark
 * playground chrome as Act I so the handoff is one product, not two mocks.
 * "Free-form", never "infinite" — the app has no pan or zoom.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = useContent(lang).home.acts!.canvas;

const TABS = [
  { label: 'Personal', on: true },
  { label: 'Trading', on: false },
  { label: 'Markets', on: false },
];

const CELLS = [2, 3, 1, 0, 3, 2, 1, 0, 2, 3, 3, 1, 2, 0];
const SPARK = [22, 28, 24, 34, 40, 32, 44, 48, 42, 52];
const sparkPath = SPARK.map((v, i) => `${i ? 'L' : 'M'}${140 + i * 16} ${332 - v * 0.55}`).join(' ');
const FEED = [
  { y: 278, w: 150 },
  { y: 300, w: 124 },
  { y: 322, w: 138 },
];
---

<Act id="app-showcase" labelledBy="act-canvas-title" height="210vh">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <ActCopyBlock copy={copy} headingId="act-canvas-title" />

    <div class="act-scene c-scene" aria-hidden="true">
      <div class="c-slab"></div>
      <svg
        class="c-art"
        viewBox="0 0 640 400"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        role="presentation"
        style="--c-panel:#0b0e14f5;--c-panel-2:#ffffff0d;--c-line:#ffffff1f;--c-text:#fff;--c-text-4:var(--color-ink-300);--c-accent:var(--color-brand-300);--c-chrome:color-mix(in oklab, var(--color-brand-400) 70%, #ffffff29);--c-dot:#ffffff24;--c-tab-on:color-mix(in oklab, var(--color-brand-400) 32%, transparent);--c-mood-1:color-mix(in oklab, var(--color-brand-400) 48%, transparent);--c-mood-2:color-mix(in oklab, var(--color-accent-400) 52%, transparent);--c-mood-3:color-mix(in oklab, var(--color-sky-400) 46%, transparent);--c-mood-4:color-mix(in oklab, var(--color-brand-300) 28%, transparent);--c-shadow:#0f172866"
      >
        <defs>
          <pattern id="c-dots" width="14" height="14" patternUnits="userSpaceOnUse">
            <circle cx="1" cy="1" r="0.7" fill="var(--c-dot)"></circle>
          </pattern>
        </defs>

        <g>
          <rect x="16" y="16" width="608" height="368" rx="18" fill="var(--c-panel, #0b0e14)"></rect>
          <rect x="16" y="16" width="608" height="368" rx="18" fill="url(#c-dots)" opacity="0.5"></rect>

          <rect x="16" y="16" width="608" height="40" fill="var(--c-panel-2)"></rect>
          <line x1="16" y1="56" x2="624" y2="56" stroke="var(--c-line)" stroke-width="1"></line>
          <image href="/favicon.png" x="28" y="26" width="16" height="16"></image>
          <text x="52" y="38" class="c-label" fill="var(--c-text-4)">Personal</text>

          {
            TABS.map((tab, i) => (
              <g class="c-tab" style={`--k:var(--k0, 1)`} transform={`translate(${140 + i * 84} 26)`}>
                <rect
                  x="0"
                  y="0"
                  width="76"
                  height="22"
                  rx="11"
                  fill={tab.on ? 'var(--c-tab-on)' : 'transparent'}
                  stroke="var(--c-line)"
                />
                <text
                  x="38"
                  y="15"
                  text-anchor="middle"
                  class="c-label"
                  fill={tab.on ? 'var(--c-accent)' : 'var(--c-text-4)'}
                >
                  {tab.label}
                </text>
              </g>
            ))
          }

          <text x="520" y="38" class="c-tiny" fill="var(--c-accent)">SCREEN · 01</text>

          <!-- Group stroke — mosaic around moodboard + habits, last-but-one beat. -->
          <rect
            class="c-group"
            x="112"
            y="68"
            width="496"
            height="176"
            rx="16"
            stroke="var(--color-brand-400)"
            stroke-dasharray="5 4"
          ></rect>
          <text class="c-group-label" x="128" y="86" fill="var(--c-accent)">MOSAIC</text>

          <g class="c-tile" style="--dx:70;--dy:36">
            <rect x="120" y="96" width="250" height="140" rx="14" class="c-card"></rect>
            <circle class="c-live" cx="136" cy="114" r="3" fill="var(--color-brand-400)"></circle>
            <text x="146" y="118" class="c-title" fill="var(--c-text)">Moodboard</text>
            <rect x="136" y="130" width="140" height="64" rx="8" fill="var(--c-mood-1)"></rect>
            <rect x="284" y="130" width="70" height="36" rx="8" fill="var(--c-mood-2)"></rect>
            <rect x="284" y="172" width="70" height="22" rx="6" fill="var(--c-mood-3)"></rect>
            <rect x="136" y="202" width="218" height="22" rx="6" fill="var(--c-mood-4)"></rect>
          </g>

          <g class="c-tile" style="--dx:-48;--dy:48">
            <rect x="382" y="96" width="210" height="68" rx="14" class="c-card"></rect>
            <circle class="c-live" cx="398" cy="114" r="3" fill="var(--color-brand-400)"></circle>
            <text x="408" y="118" class="c-title" fill="var(--c-text)">Habits</text>
            <text x="548" y="118" class="c-tiny" fill="var(--c-accent)">6/8</text>
            {
              CELLS.map((v, i) => (
                <rect
                  class="c-heat"
                  style={`--i:${i}`}
                  x={398 + (i % 7) * 24}
                  y={128 + Math.floor(i / 7) * 14}
                  width="20"
                  height="11"
                  rx="2.5"
                  fill="var(--color-brand-400)"
                  opacity={0.14 + v * 0.24}
                />
              ))
            }
          </g>

          <g class="c-tile" style="--dx:-36;--dy:8">
            <rect x="382" y="172" width="210" height="72" rx="14" class="c-card"></rect>
            <circle class="c-live" cx="398" cy="190" r="3" fill="var(--color-sky-400)"></circle>
            <text x="408" y="194" class="c-title" fill="var(--c-text)">Memory</text>
            <text x="536" y="194" class="c-tiny" fill="var(--c-accent)">2 pairs</text>
            {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
              <rect
                class="c-mem"
                style={`--i:${i}`}
                x={398 + (i % 4) * 44}
                y={204 + Math.floor(i / 4) * 16}
                width="38"
                height="12"
                rx="3"
                fill={i % 2 === 0 ? 'var(--color-brand-400)' : 'var(--color-sky-400)'}
                opacity={i < 4 ? 0.75 : 0.35}
              />
            ))}
          </g>

          <g class="c-tile" style="--dx:64;--dy:-28">
            <rect x="120" y="256" width="186" height="104" rx="14" class="c-card"></rect>
            <circle class="c-live" cx="136" cy="274" r="3" fill="var(--color-accent-400)"></circle>
            <text x="146" y="278" class="c-title" fill="var(--c-text)">Air quality</text>
            <text x="248" y="278" class="c-tiny" fill="var(--c-accent)">AQI 42</text>
            <path
              class="c-spark"
              d={sparkPath}
              stroke="var(--color-brand-400)"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </g>

          <g class="c-tile" style="--dx:-20;--dy:-32">
            <rect x="318" y="256" width="274" height="104" rx="14" class="c-card"></rect>
            <circle class="c-live" cx="334" cy="274" r="3" fill="var(--color-accent-400)"></circle>
            <text x="344" y="278" class="c-title" fill="var(--c-text)">Feed</text>
            <text x="548" y="278" class="c-tiny" fill="var(--c-accent)">live</text>
            {
              FEED.map((row, i) => (
                <g class="c-feed" style={`--i:${i}`}>
                  <rect x="334" y={row.y} width="10" height="10" rx="2" fill="var(--color-sky-400)" opacity="0.7"></rect>
                  <rect
                    x="350"
                    y={row.y + 2}
                    width={row.w}
                    height="6"
                    rx="3"
                    fill="var(--c-text)"
                    opacity="0.22"
                  ></rect>
                </g>
              ))
            }
          </g>

          <g class="c-links">
            <path class="c-link" d="M370 166 C 400 166, 400 130, 382 130" />
            <path class="c-link" d="M245 236 C 245 250, 200 250, 213 256" />
            <path class="c-link" d="M306 308 C 318 308, 318 308, 318 308" />
            <circle class="c-node" cx="370" cy="166" r="3.5" />
            <circle class="c-node" cx="382" cy="130" r="3.5" />
            <circle class="c-node" cx="213" cy="256" r="3.5" />
            <circle class="c-node" cx="318" cy="308" r="3.5" />
          </g>
        </g>

        <rect
          x="16"
          y="16"
          width="608"
          height="368"
          rx="18"
          fill="none"
          stroke="var(--c-chrome)"
          stroke-width="1.4"
        ></rect>
      </svg>
    </div>
  </div>
</Act>

<style>
  /* Playground chrome — same dark glass as Act I so 01→02 is one product. */
  .c-scene {
    position: relative;
    perspective: 900px;
    perspective-origin: 50% 40%;
  }

  .c-slab {
    position: absolute;
    inset: auto 8% -8% 8%;
    height: 42%;
    border-radius: 1.25rem;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 28%, transparent),
      transparent 70%
    );
    filter: blur(18px);
    pointer-events: none;
  }

  .c-art {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    filter: drop-shadow(0 28px 60px var(--c-shadow, rgba(15, 23, 42, 0.4)));
    --c-text: #fff;
    --c-text-4: var(--color-ink-300);
    --c-accent: var(--color-brand-300);
    --c-line: rgba(255, 255, 255, 0.12);
    --c-panel: rgba(9, 12, 20, 0.94);
    --c-panel-2: rgba(255, 255, 255, 0.05);
    --c-dot: rgba(255, 255, 255, 0.14);
    --c-tab-on: color-mix(in oklab, var(--color-brand-400) 32%, transparent);
    --c-chrome: color-mix(in oklab, var(--color-brand-400) 70%, rgba(255, 255, 255, 0.16));
    --c-shadow: rgba(0, 0, 0, 0.55);
    --c-mood-1: color-mix(in oklab, var(--color-brand-400) 48%, transparent);
    --c-mood-2: color-mix(in oklab, var(--color-accent-400) 52%, transparent);
    --c-mood-3: color-mix(in oklab, var(--color-sky-400) 46%, transparent);
    --c-mood-4: color-mix(in oklab, var(--color-brand-300) 28%, transparent);
  }

  :global(html:not(.dark)) .c-art {
    --c-shadow: rgba(15, 23, 42, 0.4);
    --c-panel: rgba(9, 12, 20, 0.96);
  }

  :global(html:not(.dark)) .c-slab {
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--color-brand-400) 44%, transparent),
      transparent 70%
    );
  }

  .c-card {
    fill: color-mix(in oklab, var(--c-panel-2) 70%, #ffffff14);
    stroke: var(--c-line);
    stroke-width: 1;
  }

  .c-label,
  .c-title,
  .c-tiny,
  .c-group-label {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .c-label {
    font-size: 9px;
  }

  .c-title {
    font-size: 11px;
    font-weight: 600;
  }

  .c-tiny,
  .c-group-label {
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .c-spark {
    fill: none;
  }

  .c-group,
  .c-group-label,
  .c-links {
    opacity: 0;
  }

  .c-tile,
  .c-tab,
  .c-heat,
  .c-mem,
  .c-live,
  .c-feed,
  .c-spark {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .c-live {
      animation: c-live 1.6s ease-in-out infinite;
    }

    .c-heat {
      animation: c-heat 2.8s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.08s);
    }

    .c-mem {
      animation: c-mem 3.4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.12s);
    }

    .c-feed {
      animation: c-feed 3.6s ease-in-out infinite;
      animation-delay: calc(var(--i) * 0.28s);
    }

    .c-spark {
      stroke-dasharray: 180;
      animation: c-draw 3.2s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1)) infinite;
    }

    @media (min-width: 768px) {
      :global(html.js) .c-tab {
        opacity: calc(0.45 + var(--k0, 1) * 0.55);
      }

      /* Always opaque — fading them made the handoff a blank slab. They
         start piled (--k1 = 0) and slide onto their seats as the screen beat
         lands. 2D only: translateZ inside an SVG clipPath paints nothing. */
      :global(html.js) .c-tile {
        opacity: 1;
        transform: translate(
          calc((1 - var(--k1, 1)) * var(--dx, 0) * 1px),
          calc((1 - var(--k1, 1)) * var(--dy, 0) * 1px)
        );
      }

      :global(html.js) .c-group,
      :global(html.js) .c-group-label {
        opacity: var(--k2, 1);
      }

      :global(html.js) .c-link {
        stroke-dasharray: 220;
        stroke-dashoffset: calc(220 - var(--k3, 1) * 220);
      }

      :global(html.js) .c-links,
      :global(html.js) .c-node {
        opacity: var(--k3, 1);
      }
    }
  }

  .c-link {
    stroke: var(--color-brand-400);
    stroke-width: 1.5;
    stroke-linecap: round;
    fill: none;
  }

  .c-node {
    fill: var(--color-brand-300);
  }

  .c-group {
    fill: color-mix(in oklab, var(--color-brand-400) 6%, transparent);
  }

  @keyframes c-live {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes c-heat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(0.86);
    }
  }

  @keyframes c-mem {
    0%,
    70%,
    100% {
      opacity: 0.75;
    }
    80% {
      opacity: 0.3;
    }
  }

  @keyframes c-feed {
    0%,
    100% {
      transform: translateX(0);
      opacity: 1;
    }
    50% {
      transform: translateX(4px);
      opacity: 0.7;
    }
  }

  @keyframes c-draw {
    0% {
      stroke-dashoffset: 180;
    }
    40%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .c-live,
    .c-heat,
    .c-mem,
    .c-feed,
    .c-spark {
      animation: none !important;
    }

    .c-group,
    .c-group-label,
    .c-links {
      opacity: 1;
    }
  }
</style>
