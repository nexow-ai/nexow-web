---
/**
 * Act II — the free-form canvas.
 *
 * Carries the `app-showcase` id because `UseCasePage.astro` links to it from
 * every `/for/*` page. Renaming this section breaks those links and
 * `tests/build/dist.test.ts` will not catch it (it only checks that anchors
 * resolve to a built *page*), so leave the id alone.
 *
 * The scene lays widget tiles onto a screen and then draws Links between them.
 * "Free-form", never "infinite" — the app has no pan or zoom.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = useContent(lang).home.acts!.canvas;

/** Tile layout on the screen: column span, row span, and which beat lands it. */
const TILES = [
  { c: 'span 4', r: 'span 2', k: '--k0', label: 'chart' },
  { c: 'span 2', r: 'span 1', k: '--k0', label: 'stat' },
  { c: 'span 2', r: 'span 2', k: '--k1', label: 'list' },
  { c: 'span 2', r: 'span 1', k: '--k1', label: 'note' },
  { c: 'span 3', r: 'span 1', k: '--k2', label: 'feed' },
  { c: 'span 3', r: 'span 1', k: '--k2', label: 'table' },
];
---

<Act id="app-showcase" labelledBy="act-canvas-title" height="210vh">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
    <ActCopyBlock copy={copy} headingId="act-canvas-title" />

    <div class="c-scene" aria-hidden="true">
      <div class="c-screen">
        <div class="c-chrome">
          <span class="c-tab c-tab--on">Personal</span>
          <span class="c-tab">Trading</span>
          <span class="c-tab">Markets</span>
        </div>

        <div class="c-grid">
          {
            TILES.map((t) => (
              <span
                class="c-tile"
                style={`grid-column:${t.c};grid-row:${t.r};--k:var(${t.k}, 1)`}
              >
                <span class="c-tile-label">{t.label}</span>
              </span>
            ))
          }
        </div>

        {/* Links — the data pipes between widgets, drawn on the last beat. */}
        <svg class="c-links" viewBox="0 0 340 220" fill="none" aria-hidden="true">
          <path class="c-link" d="M96 74 C 150 74, 168 128, 232 128" />
          <path class="c-link" d="M232 128 C 268 128, 268 172, 214 176" />
          <circle class="c-node" cx="96" cy="74" r="4" />
          <circle class="c-node" cx="232" cy="128" r="4" />
          <circle class="c-node" cx="214" cy="176" r="4" />
        </svg>
      </div>
    </div>
  </div>
</Act>

<style>
  .c-scene {
    perspective: 900px;
    perspective-origin: 50% 40%;
  }

  .c-screen {
    position: relative;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(9, 12, 20, 0.9);
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.9);
    padding: 0.9rem;
  }

  .c-chrome {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .c-tab {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-300);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .c-tab--on {
    color: var(--color-brand-300);
    border-color: color-mix(in oklab, var(--color-brand-400) 50%, transparent);
  }

  .c-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 3.1rem;
    gap: 0.5rem;
  }

  .c-tile {
    display: flex;
    align-items: flex-end;
    border-radius: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(
      145deg,
      color-mix(in oklab, var(--color-brand-500) 14%, transparent),
      rgba(255, 255, 255, 0.03)
    );
    padding: 0.35rem 0.45rem;
  }

  .c-tile-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-300);
  }

  .c-links {
    position: absolute;
    inset: 0.9rem;
    width: calc(100% - 1.8rem);
    height: calc(100% - 1.8rem);
    pointer-events: none;
  }

  .c-link {
    stroke: var(--color-brand-400);
    stroke-width: 1.5;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-brand-400) 60%, transparent));
  }

  .c-node {
    fill: var(--color-brand-300);
  }

  @media (prefers-reduced-motion: no-preference) {
    @media (min-width: 768px) {
      :global(html.js) .c-screen {
        transform: rotateX(calc(var(--psc, 0) * -9deg)) rotateY(calc(var(--psc, 0) * 13deg * var(--dir, 1)))
          translate3d(0, calc(var(--psc, 0) * -1rem), 0);
      }

      /* Tiles drop onto the screen a pair at a time. */
      :global(html.js) .c-tile {
        opacity: var(--k, 1);
        transform: translate3d(0, calc((1 - var(--k, 1)) * 1.5rem), calc((1 - var(--k, 1)) * -620px));
      }

      /* Links draw last, once there is something to connect. */
      :global(html.js) .c-link {
        stroke-dasharray: 200;
        stroke-dashoffset: calc(200 - var(--k3, 1) * 200);
      }

      :global(html.js) .c-node {
        opacity: var(--k3, 1);
      }
    }
  }
</style>
