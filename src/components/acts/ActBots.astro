---
/**
 * Act IV — bots.
 *
 * Deterministic watchers. Copy accuracy matters here: a bot has NO model in the
 * loop and only ever watches market candles, a broker account, or a public
 * wallet address — never a news or social feed, which is an agent's job. The
 * one thing this act must land is the four-way fan-out, because that is what
 * people do not expect.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = useContent(lang).home.acts!.bots;

const DELIVERIES = ['widget bus', 'alert inbox', 'webhook', 'database'];
---

<Act id="automate" labelledBy="act-bots-title" height="225vh">
  <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
    <ActCopyBlock copy={copy} headingId="act-bots-title" />

    <div class="b-scene" aria-hidden="true">
      <div class="b-chain">
        <span class="b-node b-node--source" style="--k:var(--k0, 1)">
          <span class="b-kind">source</span>
          <span class="b-name">BTC · 1h candles</span>
        </span>

        <span class="b-wire" style="--k:var(--k0, 1)"></span>

        <span class="b-node b-node--proc" style="--k:var(--k1, 1)">
          <span class="b-kind">processor</span>
          <span class="b-name">rsi(14) &lt; 30</span>
        </span>

        <span class="b-wire" style="--k:var(--k2, 1)"></span>

        <span class="b-node b-node--fire" style="--k:var(--k2, 1)">
          <span class="b-kind">signal</span>
          <span class="b-name">condition true</span>
        </span>
      </div>

      <div class="b-fan">
        {
          DELIVERIES.map((d, i) => (
            <span class="b-target" style={`--k:var(--k3, 1);--i:${i}`}>
              <span class="b-dot" />
              {d}
            </span>
          ))
        }
      </div>
      <p class="b-caption">one signal, four destinations, at the same time</p>
    </div>
  </div>
</Act>

<style>
  .b-scene {
    display: grid;
    gap: 1.4rem;
  }

  .b-chain {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .b-node {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1rem;
    border-radius: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    min-width: 14rem;
  }

  .b-node--fire {
    border-color: color-mix(in oklab, var(--color-brand-400) 55%, transparent);
    background: color-mix(in oklab, var(--color-brand-500) 12%, rgba(255, 255, 255, 0.04));
  }

  .b-kind {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-300);
  }

  .b-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-ink-100);
  }

  .b-wire {
    width: 2px;
    height: 1.5rem;
    margin-inline-start: 1.5rem;
    background: linear-gradient(to bottom, var(--color-brand-400), transparent);
  }

  .b-fan {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .b-target {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-100);
  }

  .b-dot {
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
    border-radius: 50%;
    background: var(--color-brand-400);
    box-shadow: 0 0 10px var(--color-brand-500);
  }

  .b-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-300);
  }

  @media (prefers-reduced-motion: no-preference) {
    @media (min-width: 768px) {
      :global(html.js) .b-node,
      :global(html.js) .b-wire {
        opacity: var(--k, 1);
        transform: translate3d(calc((1 - var(--k, 1)) * -1rem * var(--dir, 1)), 0, 0);
      }

      /* The four targets land together but not in lockstep — a short cascade
       * reads as "at the same time" far better than a single hard cut. */
      :global(html.js) .b-target {
        opacity: clamp(0, calc(var(--k, 1) * 3 - var(--i) * 0.45), 1);
        transform: translate3d(0, calc((1 - var(--k, 1)) * 0.75rem), 0);
      }

      :global(html.js) .b-caption {
        opacity: var(--k3, 1);
      }
    }
  }
</style>
