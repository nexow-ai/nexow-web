---
/**
 * Act III — live data.
 *
 * The logos are real, pulled from the generated catalogue rather than hand-typed,
 * so the act cannot drift out of sync with `src/data/connectors.ts`. The live
 * count is read from the same place for the same reason — copy never hardcodes it.
 *
 * Five groups match the five copy beats: Finance, Wallets, Services, Socials, APIs.
 * APIs is the catalogue `data` category (market-data APIs, databases, warehouses).
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import type { ConnectorCategory } from '../../data/connectors';
import { CONNECTORS, CONNECTOR_LIVE_COUNT } from '../../data/connectors';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const copy = c.home.acts!.connectors;

const pick = (category: ConnectorCategory, soon = false) =>
  CONNECTORS.filter(
    (x) =>
      x.category === category &&
      x.logo &&
      (x.status === 'live' || (soon && x.status === 'soon')),
  );

const GROUPS: {
  category: ConnectorCategory;
  k: string;
  items: ReturnType<typeof pick>;
}[] = [
  { category: 'finance', k: '--k0', items: pick('finance') },
  /* Wallets only has five live venues — include the rest of the catalogue so
     the group reads as a category, not a leftover row. */
  { category: 'wallets', k: '--k1', items: pick('wallets', true) },
  { category: 'services', k: '--k2', items: pick('services') },
  { category: 'socials', k: '--k3', items: pick('socials') },
  { category: 'data', k: '--k4', items: pick('data') },
];
---

<Act id="connectors" labelledBy="act-connectors-title" stages={5} height="250vh">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-center lg:gap-14">
    <ActCopyBlock copy={copy} headingId="act-connectors-title" />

    <div class="act-scene k-scene" aria-hidden="true">
      <div class="k-core">
        <span class="k-count">{CONNECTOR_LIVE_COUNT}</span>
        <span class="k-count-label">{c.home.connectors.countLabel}</span>
      </div>

      <div class="k-groups">
        {
          GROUPS.map((group, i) => (
            <div class="k-group" style={`--k:var(${group.k}, 1)`}>
              <p class="k-group-label">{copy.beats[i]?.label}</p>
              <div class="k-row">
                {group.items.map((item) => (
                  <span class:list={['k-pill', item.status === 'soon' && 'k-pill--soon']} title={item.name}>
                    <img src={item.logo} alt="" loading="lazy" decoding="async" width="16" height="16" />
                    <span>{item.name}</span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Act>

<style>
  /* Five even beats on this act only — other acts keep the global quarters. */
  @media (min-width: 768px) {
    :global(html.js #connectors.act) {
      --k0: clamp(0, calc(var(--ps, 0) * 6), 1);
      --k1: clamp(0, calc((var(--ps, 0) - 0.14) * 6), 1);
      --k2: clamp(0, calc((var(--ps, 0) - 0.28) * 6), 1);
      --k3: clamp(0, calc((var(--ps, 0) - 0.40) * 6), 1);
      --k4: clamp(0, calc((var(--ps, 0) - 0.50) * 7), 1);
    }
  }

  .k-scene {
    perspective: 900px;
    perspective-origin: 50% 45%;
    transform-style: preserve-3d;
    display: grid;
    gap: 0.85rem;
    justify-items: stretch;
  }

  .k-core {
    display: grid;
    justify-items: center;
    justify-self: center;
    gap: 0.15rem;
    padding: 0.65rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in oklab, var(--color-brand-400) 35%, transparent);
    background: radial-gradient(
      70% 70% at 50% 30%,
      color-mix(in oklab, var(--color-brand-500) 22%, transparent),
      transparent
    );
  }

  .k-count {
    font-family: var(--font-display);
    font-size: 2.15rem;
    line-height: 1;
    color: var(--w-text);
  }

  .k-count-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-accent);
  }

  .k-groups {
    display: grid;
    gap: 0.65rem;
    width: 100%;
  }

  @media (min-width: 640px) {
    .k-groups {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'finance finance'
        'wallets socials'
        'services apis';
      gap: 0.55rem 0.75rem;
    }

    .k-group:nth-child(1) { grid-area: finance; }
    .k-group:nth-child(2) { grid-area: wallets; }
    .k-group:nth-child(3) { grid-area: services; }
    .k-group:nth-child(4) { grid-area: socials; }
    .k-group:nth-child(5) { grid-area: apis; }
  }

  .k-group {
    display: grid;
    gap: 0.32rem;
    align-content: start;
  }

  .k-group-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-accent);
  }

  .k-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
  }

  .k-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.18rem 0.45rem 0.18rem 0.22rem;
    border-radius: 999px;
    border: 1px solid var(--w-line);
    background: var(--w-panel-2);
    font-size: 0.625rem;
    line-height: 1.2;
    color: var(--w-text-3);
  }

  .k-pill--soon {
    opacity: 0.55;
  }

  .k-pill img {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 0.2rem;
    object-fit: contain;
    background: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    @media (min-width: 768px) {
      /* Each category docks on its own beat, arriving from depth. */
      :global(html.js) .k-group {
        opacity: var(--k, 1);
        transform: translate3d(0, calc((1 - var(--k, 1)) * 1.2rem), calc((1 - var(--k, 1)) * -560px));
      }

      :global(html.js) .k-core {
        transform: scale(calc(0.94 + var(--k0, 1) * 0.06));
      }
    }
  }
</style>
