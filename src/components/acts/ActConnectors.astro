---
/**
 * Act III — live data.
 *
 * The logos are real, pulled from the generated catalogue rather than hand-typed,
 * so the act cannot drift out of sync with `src/data/connectors.ts`. The live
 * count is read from the same place for the same reason — copy never hardcodes it.
 *
 * Six groups match the six copy beats: Finance, Wallets, Services, Socials,
 * Databases, APIs. Databases and APIs both come from the catalogue `data`
 * category, split by kind so SQL / NoSQL / warehouse / vector venues dock
 * before market-data/analytics APIs.
 */
import type { Lang } from '../../i18n/config';
import { useContent } from '../../i18n/content';
import type { ConnectorCategory } from '../../data/connectors';
import { CONNECTORS, CONNECTOR_LIVE_COUNT } from '../../data/connectors';
import Act from './Act.astro';
import ActCopyBlock from './ActCopyBlock.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = useContent(lang);
const copy = c.home.acts!.connectors;

const API_KINDS = new Set(['data', 'analytics']);
const DATABASE_KINDS = new Set(['sql', 'nosql', 'warehouse', 'vector']);

const pick = (
  category: ConnectorCategory,
  opts: { soon?: boolean; kinds?: Set<string> } = {},
) =>
  CONNECTORS.filter(
    (x) =>
      x.category === category &&
      x.logo &&
      (x.status === 'live' || (opts.soon && x.status === 'soon')) &&
      (!opts.kinds || opts.kinds.has(x.kind)),
  );

const GROUPS: {
  category: ConnectorCategory;
  k: string;
  items: ReturnType<typeof pick>;
}[] = [
  { category: 'finance', k: '--k0', items: pick('finance') },
  /* Wallets only has five live venues — include the rest of the catalogue so
     the group reads as a category, not a leftover row. */
  { category: 'wallets', k: '--k1', items: pick('wallets', { soon: true }) },
  { category: 'services', k: '--k2', items: pick('services') },
  { category: 'socials', k: '--k3', items: pick('socials') },
  { category: 'data', k: '--k4', items: pick('data', { kinds: DATABASE_KINDS }) },
  { category: 'data', k: '--k5', items: pick('data', { kinds: API_KINDS }) },
];
---

<Act id="connectors" labelledBy="act-connectors-title" stages={6} height="280vh">
  <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-center lg:gap-14">
    <ActCopyBlock copy={copy} headingId="act-connectors-title" />

    <div class="act-scene k-scene" aria-hidden="true">
      <div class="k-core">
        <span class="k-count">{CONNECTOR_LIVE_COUNT}</span>
        <span class="k-count-label">{c.home.connectors.countLabel}</span>
      </div>

      <div class="k-groups">
        {
          GROUPS.map((group, i) => (
            <div class="k-group" style={`--k:var(${group.k}, 1)`}>
              <p class="k-group-label">{copy.beats[i]?.label}</p>
              <div class="k-row">
                {group.items.map((item) => (
                  <span class="k-pill" title={item.name}>
                    <img src={item.logo} alt="" loading="lazy" decoding="async" width="16" height="16" />
                    <span>{item.name}</span>
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Act>

<style>
  /* Six even beats on this act only — other acts keep the global quarters. */
  @media (min-width: 768px) {
    :global(html.js #connectors.act) {
      --k0: clamp(0, calc(var(--ps, 0) * 6), 1);
      --k1: clamp(0, calc((var(--ps, 0) - 0.12) * 6), 1);
      --k2: clamp(0, calc((var(--ps, 0) - 0.24) * 6), 1);
      --k3: clamp(0, calc((var(--ps, 0) - 0.36) * 6), 1);
      --k4: clamp(0, calc((var(--ps, 0) - 0.48) * 6), 1);
      --k5: clamp(0, calc((var(--ps, 0) - 0.60) * 6), 1);
    }
  }

  .k-scene {
    perspective: 900px;
    perspective-origin: 50% 45%;
    transform-style: preserve-3d;
    display: grid;
    gap: 0.85rem;
    justify-items: stretch;
  }

  .k-core {
    display: grid;
    justify-items: center;
    justify-self: center;
    gap: 0.15rem;
    padding: 0.65rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in oklab, var(--color-brand-400) 35%, transparent);
    background: radial-gradient(
      70% 70% at 50% 30%,
      color-mix(in oklab, var(--color-brand-500) 22%, transparent),
      transparent
    );
  }

  .k-count {
    font-family: var(--font-display);
    font-size: 2.15rem;
    line-height: 1;
    color: var(--w-text);
  }

  .k-count-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-accent);
  }

  .k-groups {
    display: grid;
    gap: 0.65rem;
    width: 100%;
    overflow: visible;
  }

  @media (min-width: 640px) {
    .k-groups {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'finance finance'
        'wallets socials'
        'services databases'
        'services apis';
      gap: 0.55rem 0.75rem;
    }

    .k-group:nth-child(1) { grid-area: finance; }
    .k-group:nth-child(2) { grid-area: wallets; }
    .k-group:nth-child(3) { grid-area: services; }
    .k-group:nth-child(4) { grid-area: socials; }
    .k-group:nth-child(5) { grid-area: databases; }
    .k-group:nth-child(6) { grid-area: apis; }
  }

  .k-group {
    display: grid;
    gap: 0.32rem;
    align-content: start;
    overflow: visible;
  }

  .k-group-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
    /* Accent pulled toward the primary text token so the label stays teal
       but clears AA on both the light stage and the dark one. */
    color: color-mix(in oklab, var(--w-accent) 40%, var(--w-text));
  }

  .k-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    overflow: visible;
  }

  .k-pill {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.18rem 0.45rem 0.18rem 0.22rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--w-text) 18%, var(--w-surface));
    background: color-mix(in oklab, var(--w-text) 10%, var(--w-surface));
    opacity: 1;
    font-size: 0.625rem;
    line-height: 1.2;
    color: var(--w-text-3);
    transform: scale(1);
    transform-origin: center center;
    transition:
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      color 0.28s ease;
  }

  .k-pill:hover {
    z-index: 8;
    color: var(--w-text);
    border-color: color-mix(in oklab, var(--color-brand-400) 60%, var(--w-line));
    box-shadow: 0 0 28px color-mix(in oklab, var(--color-brand-400) 38%, transparent);
  }

  .k-pill img {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 0.2rem;
    object-fit: contain;
    background: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .k-pill:hover {
      transform: scale(1.7);
    }

    @media (min-width: 768px) {
      /* Each category docks on its own beat, arriving from depth. */
      :global(html.js) .k-group {
        opacity: var(--k, 1);
        transform: translate3d(0, calc((1 - var(--k, 1)) * 1.2rem), calc((1 - var(--k, 1)) * -560px));
      }

      :global(html.js) .k-core {
        transform: scale(calc(0.94 + var(--k0, 1) * 0.06));
      }
    }
  }
</style>
