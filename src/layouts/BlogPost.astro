---
import { SITE, type Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import { localizePath, dateLocale } from '../i18n/utils';
import Layout from './Layout.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  tags: string[];
  heroImage?: ImageMetadata;
  minutes: number;
}
const { lang, slug, title, description, pubDate, updatedDate, author, tags, heroImage, minutes } =
  Astro.props;
const t = useContent(lang).blog;
const route = `/blog/${slug}`;

const dtFmt = new Intl.DateTimeFormat(dateLocale(lang), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL('/logo-black.png', SITE.url).href },
  },
  mainEntityOfPage: new URL(localizePath(route, lang), SITE.url).href,
  keywords: tags.join(', '),
};

const cta = useContent(lang).home.cta;
const sections = [
  { id: 'article', label: title },
  { id: 'cta', label: cta.primary },
];
---

<Layout
  lang={lang}
  route={route}
  title={`${title} — ${SITE.name}`}
  description={description}
  type="article"
  schema={[articleSchema]}
  sections={sections}
>
  <article id="article" class="relative scroll-mt-20 overflow-hidden pt-28 sm:pt-36">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="aurora-mesh absolute inset-[-10%] opacity-70 dark:opacity-60"></div>
      <div
        class="aurora-a absolute -top-24 left-[8%] size-[min(70vw,480px)] rounded-full opacity-50 blur-3xl dark:opacity-40"
        style="background:radial-gradient(circle, var(--aurora-1), transparent 65%)"
      ></div>
      <div
        class="aurora-b absolute -top-16 right-[6%] size-[min(60vw,420px)] rounded-full opacity-40 blur-3xl dark:opacity-30"
        style="background:radial-gradient(circle, var(--aurora-2), transparent 65%)"
      ></div>
    </div>

    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <a
          href={localizePath('/blog', lang)}
          class="-my-1 inline-flex items-center gap-1.5 py-1 font-mono text-sm text-ink-500 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-white"
        >
          <Icon name="arrow" class="size-4 rotate-180" />
          {t.backToBlog}
        </a>

        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-brand-50 px-2.5 py-1 font-mono text-xs text-brand-700 ring-1 ring-brand-500/10 dark:bg-brand-400/12 dark:text-brand-300 dark:ring-brand-400/25">
              #{tag}
            </span>
          ))}
        </div>

        <h1 class="mt-4 text-balance font-display text-4xl font-semibold leading-[1.1] tracking-tight text-ink-950 dark:text-white sm:text-5xl">
          {title}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-ink-600 dark:text-ink-300">{description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-ink-900/8 dark:border-white/8 pb-8 font-mono text-sm text-ink-500 dark:text-ink-400">
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{dtFmt.format(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes} {t.minRead}</span>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>{t.updated} {dtFmt.format(updatedDate)}</span>
            </>
          )}
        </div>
      </div>
    </div>

    {
      heroImage && (
        <div class="container-page mt-10">
          <figure class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-ink-900/8 bg-ink-950 shadow-xl shadow-brand-900/5 dark:border-white/10">
            <img
              src={heroImage.src}
              alt={title}
              width={heroImage.width}
              height={heroImage.height}
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/9] w-full object-cover"
            />
          </figure>
        </div>
      )
    }

    <div class="container-page mt-10">
      <div
        class="prose prose-lg mx-auto max-w-3xl dark:prose-invert prose-headings:font-display prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-2xl prose-a:text-brand-700 prose-a:no-underline hover:prose-a:underline prose-strong:text-ink-900 prose-blockquote:border-l-brand-500 prose-blockquote:bg-brand-50/40 prose-blockquote:py-1 prose-blockquote:not-italic prose-code:font-mono prose-code:text-brand-700 prose-code:before:content-none prose-code:after:content-none dark:prose-a:text-brand-300 dark:prose-strong:text-white dark:prose-blockquote:bg-brand-400/10 dark:prose-code:text-brand-300"
      >
        <slot />
      </div>
    </div>

    <div id="cta" class="container-page scroll-mt-20 mt-16 mb-24">
      <div class="mx-auto max-w-3xl rounded-2xl border border-ink-900/8 dark:border-white/8 bg-slate-50/70 dark:bg-white/[0.03] p-8 text-center">
        <h2 class="font-display text-2xl font-semibold text-ink-950 dark:text-white">{cta.title}</h2>
        <p class="mx-auto mt-2 max-w-md text-ink-600 dark:text-ink-300">{cta.subtitle}</p>
        <div class="mt-6 flex justify-center">
          <Button href={SITE.appUrl} size="lg" external iconRight="arrow">
            {cta.primary}
          </Button>
        </div>
      </div>
    </div>
  </article>
</Layout>
