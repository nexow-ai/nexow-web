---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import DotField from '../components/DotField.astro';
import TextAppear from '../components/TextAppear.astro';
import SectionNav from '../components/SectionNav.astro';
import PageNav from '../components/PageNav.astro';
import TourHud from '../components/TourHud.astro';
import TourSound from '../components/TourSound.astro';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../i18n/config';
import { useContent } from '../i18n/content';
import { getPageAccent } from '../i18n/accent';
import { dir } from '../i18n/utils';
import { slidePages } from '../lib/pageTransition';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  route: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /**
   * Forced page surface. When set, locks the chrome to that tone and skips the
   * user theme preference. Omit to honour light/dark mode from the toggle.
   */
  theme?: 'light' | 'dark';
  /**
   * Set when the page opens straight into a full-bleed dark world (see
   * `components/world/World.astro`). The header floats over ink rather than
   * over the page surface before the first scroll, and `global.css` repaints
   * light-theme chrome for that one case.
   */
  world?: boolean;
  /** In-page section rail (right side, desktop). Omit to hide. */
  sections?: { id: string; label: string }[];
  /** Accessible label for the section rail. */
  sectionNavLabel?: string;
  /**
   * Locales where this exact route exists. Omit for pages that ship in every
   * locale; set it where content is translated gradually, so hreflang and the
   * language switcher never point at a page that isn't there.
   */
  availableLangs?: Lang[];
}

const { lang, theme, route, sections, sectionNavLabel, world, ...head } = Astro.props;
const { availableLangs } = head;
const accent = getPageAccent(route);
const themeLocked = theme === 'light' || theme === 'dark';
const chrome = useContent(lang).nav;
const skipLabel = chrome.skipToContent ?? 'Skip to content';
const railLabel = sectionNavLabel ?? chrome.onThisPage ?? 'On this page';

---

<!doctype html>
<html
  lang={lang}
  dir={dir(lang)}
  class:list={['scroll-smooth', theme === 'dark' && 'dark']}
  data-accent={accent}
  data-theme={theme ?? undefined}
  data-theme-locked={themeLocked ? '' : undefined}
  data-world={world ? '' : undefined}
>
  <head>
    <script is:inline>
      // Mark JS-capable before paint so scroll-reveal hiding only applies with JS.
      document.documentElement.classList.add('js');
    </script>
    {
      !themeLocked && (
        <script is:inline>
          (function () {
            try {
              var stored = localStorage.getItem('nexow-theme');
              var dark =
                stored === 'dark' ||
                (stored !== 'light' &&
                  window.matchMedia('(prefers-color-scheme: dark)').matches);
              document.documentElement.classList.toggle('dark', dark);
              document.documentElement.dataset.theme = dark ? 'dark' : 'light';
            } catch (e) {}
          })();
        </script>
      )
    }
    <BaseHead lang={lang} route={route} {...head} />
    <ClientRouter />
  </head>
  <body class="min-h-dvh antialiased bg-white text-ink-900 dark:bg-ink-950 dark:text-ink-200">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      {skipLabel}
    </a>

    {/* Dot field backdrop — light/dark ink via DotField tone inheritance. */}
    <DotField class="fixed inset-0 z-0" />

    <Header switchRoute={head.noindex ? '/' : route} availableLangs={availableLangs} />

    {
      sections && sections.length > 0 && (
        <SectionNav sections={sections} label={railLabel} />
      )
    }

    <main id="main" class="relative z-10" transition:animate={slidePages}>
      <slot />
    </main>

    {/* Home stages the footer as the world's last beat so the 3D never cuts. */}
    {!world && <Footer />}

    <PageNav />

    {/* Only ever on screen while the scroll tour is running (`Header.astro`),
        and its soundtrack, which is silent — and unfetched — until then. */}
    <TourHud />
    <TourSound />

    <ScrollMotion />
    <TextAppear />

    <script>
      // Which way the page slides. Astro would use history direction, which
      // sends every link — the "previous page" arrow included — the same way;
      // position in the tour (or, for a language switch, in the picker) is
      // what the motion should mirror instead.
      import { navigationDirection } from '../lib/pageTransition';

      document.addEventListener('astro:before-preparation', (event) => {
        event.direction = navigationDirection(event.from, event.to);
      });
    </script>

    <script>
      // Scroll-reveal: re-init after client-side navigations (view transitions).
      let revealObserver: IntersectionObserver | null = null;

      function initScrollReveal() {
        revealObserver?.disconnect();
        revealObserver = null;

        const els = document.querySelectorAll('.reveal, .reveal-stagger');
        if (!els.length) return;

        if ('IntersectionObserver' in window) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  revealObserver?.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );
          els.forEach((el) => {
            el.classList.remove('is-visible');
            revealObserver!.observe(el);
          });
        } else {
          els.forEach((el) => el.classList.add('is-visible'));
        }
      }

      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
