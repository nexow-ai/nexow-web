---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter, fade } from 'astro:transitions';
import type { Lang } from '../i18n/config';
import { getPageAccent, type PageAccent } from '../i18n/accent';
import { faviconDataUri } from '../lib/favicon';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  route: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Page surface: 'dark' renders the terminal-style dark chrome (home). */
  theme?: 'light' | 'dark';
}

const { lang, theme = 'light', route, ...head } = Astro.props;
const accent = getPageAccent(route);
const mainFade = fade({ duration: '0.32s' });

const faviconByAccent = (['brand', 'gold', 'sky', 'violet', 'amber', 'rose'] as PageAccent[]).reduce(
  (acc, key) => {
    acc[key] = faviconDataUri(key);
    return acc;
  },
  {} as Record<PageAccent, string>,
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-accent={accent}>
  <head>
    <script is:inline>
      // Mark JS-capable before paint so scroll-reveal hiding only applies with JS.
      document.documentElement.classList.add('js');
    </script>
    <BaseHead lang={lang} route={route} accent={accent} {...head} />
    <ClientRouter />
  </head>
  <body class:list={['min-h-dvh antialiased', theme === 'dark' ? 'bg-ink-950' : 'bg-white']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <Header tone={theme} />

    <main id="main" transition:animate={mainFade}>
      <slot />
    </main>

    <Footer />

    <script is:inline define:vars={{ faviconByAccent }}>
      function syncFavicon() {
        const accent = document.documentElement.dataset.accent ?? 'brand';
        const href = faviconByAccent[accent] ?? faviconByAccent.brand;
        let link = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
        if (!link) {
          link = document.createElement('link');
          link.rel = 'icon';
          link.type = 'image/svg+xml';
          document.head.prepend(link);
        }
        if (link.getAttribute('href') !== href) link.setAttribute('href', href);
      }
      document.addEventListener('astro:page-load', syncFavicon);
    </script>
    <script>
      // Scroll-reveal: re-init after client-side navigations (view transitions).
      let revealObserver: IntersectionObserver | null = null;

      function initScrollReveal() {
        revealObserver?.disconnect();
        revealObserver = null;

        const els = document.querySelectorAll('.reveal, .reveal-stagger');
        if (!els.length) return;

        if ('IntersectionObserver' in window) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  revealObserver?.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );
          els.forEach((el) => {
            el.classList.remove('is-visible');
            revealObserver!.observe(el);
          });
        } else {
          els.forEach((el) => el.classList.add('is-visible'));
        }
      }

      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
