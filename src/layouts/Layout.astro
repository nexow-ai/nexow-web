---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import DotField from '../components/DotField.astro';
import SectionNav from '../components/SectionNav.astro';
import { ClientRouter, fade } from 'astro:transitions';
import type { Lang } from '../i18n/config';
import { getPageAccent } from '../i18n/accent';
import { dir } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  route: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Page surface: 'dark' renders the terminal-style dark chrome (home). */
  theme?: 'light' | 'dark';
  /** In-page section rail (right side, desktop). Omit to hide. */
  sections?: { id: string; label: string }[];
  /** Accessible label for the section rail. */
  sectionNavLabel?: string;
}

const { lang, theme = 'light', route, sections, sectionNavLabel, ...head } = Astro.props;
const accent = getPageAccent(route);
const mainFade = fade({ duration: '0.32s' });

---

<!doctype html>
<html lang={lang} dir={dir(lang)} class="scroll-smooth" data-accent={accent}>
  <head>
    <script is:inline>
      // Mark JS-capable before paint so scroll-reveal hiding only applies with JS.
      document.documentElement.classList.add('js');
    </script>
    <BaseHead lang={lang} route={route} {...head} />
    <ClientRouter />
  </head>
  <body
    class:list={[
      'min-h-dvh antialiased',
      // `dark` switches every `dark:` variant on the page — see the semantic
      // surface tokens in global.css.
      theme === 'dark' ? 'dark bg-ink-950 text-ink-200' : 'bg-white',
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink-950 focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    {
      /* The dot field is a page-wide backdrop, not a per-section one: sections
         render on translucent surfaces so one continuous light travels the
         whole page. */
      theme === 'dark' && <DotField class="fixed inset-0 z-0" />
    }

    <Header tone={theme} />

    {
      sections && sections.length > 0 && (
        <SectionNav sections={sections} tone={theme} label={sectionNavLabel} />
      )
    }

    <main id="main" class="relative z-10" transition:animate={mainFade}>
      <slot />
    </main>

    <Footer tone={theme} />

    <ScrollMotion />

    <script>
      // Scroll-reveal: re-init after client-side navigations (view transitions).
      let revealObserver: IntersectionObserver | null = null;

      function initScrollReveal() {
        revealObserver?.disconnect();
        revealObserver = null;

        const els = document.querySelectorAll('.reveal, .reveal-stagger');
        if (!els.length) return;

        if ('IntersectionObserver' in window) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-visible');
                  revealObserver?.unobserve(e.target);
                }
              }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
          );
          els.forEach((el) => {
            el.classList.remove('is-visible');
            revealObserver!.observe(el);
          });
        } else {
          els.forEach((el) => el.classList.add('is-visible'));
        }
      }

      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
